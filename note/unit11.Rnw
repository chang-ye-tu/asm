%==============================================================================
\section{Cost-Complexity Pruning}\label{sec:11.1}
%==============================================================================

\begin{reading}
ISLR §8.1.1, tree pruning (both reading lists). \ SRM learning outcome 4(a).
\end{reading}

\begin{remark}[ISLR §8.1.1]
A tree grown until every leaf is nearly pure fits the training data and overfits. A threshold
on the split gain is not the repair: a split worth little on its own can make the next split
worth a great deal, and a threshold discards it first. ISLR's remedy, Algorithm 8.1, is to grow
a large tree and prune it.
\end{remark}

\subsection{The pruning family}\label{sec:11.1.1}

\begin{definition}[Tree, branch, pruned subtree]\label{def:pruned}
$T_{\max}$ is a finite binary tree: each node $t$ has either two children $t_L,t_R$ or none,
in which case it is a \emph{leaf} of $T_{\max}$. The \emph{branch} $T_{\max,t}$ is the set of
descendants of $t$, including $t$; ISLR calls the segments joining the nodes branches, and here,
as in the pruning literature, the branch at $t$ in §\ref{sec:11.1} is the whole subtree below it. A \emph{pruned subtree rooted at $t$}, written
$S\preccurlyeq T_{\max,t}$, is obtained from $T_{\max,t}$ by choosing a set of nodes and
deleting everything strictly below each of them; $\calS(t)$ denotes the collection of these,
a finite set containing both $\{t\}$ and $T_{\max,t}$. More generally, for $S',S\in\calS(t)$,
write $S'\preccurlyeq S$ if every node of $S'$ is a node of $S$ (equivalently, $S'$ is obtained
from $S$ in the same way), and $S'\prec S$, or $S\succ S'$, if moreover $S'\neq S$. Write
$|S|$ for the number of leaves of $S$.
\end{definition}

\begin{definition}[Node cost]\label{def:nodecost}
A \emph{node cost} assigns $R(t)\geqslant0$ to every node, the cost incurred if $t$ is made a
leaf, and a tree is charged the sum over its leaves,
\begin{equation}\label{eq:treecost}
R(S)=\sum_{t\ \text{leaf of}\ S}R(t) .
\end{equation}
It satisfies the \emph{refinement property} if $R(t)\geqslant R(t_L)+R(t_R)$ at every
internal node.
\end{definition}

\begin{proposition}[The three costs of this unit refine]\label{prop:refine}
Let node $t$ hold $n_t\geqslant1$ observations, and each of its children at least one. Each of
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{cost:rss} the residual sum of squares $R(t)=\sum_{i\in t}(y_i-\bar y_t)^2$,
\item\label{cost:mis} the misclassification count $R(t)=n_t-\max_kn_{tk}$, where $n_{tk}$ is
      the number of class $k$ observations in $t$,
\item\label{cost:imp} $R(t)=n_t\,\phi(\bp_t)$ for any concave $\phi\geqslant0$ on the probability
      simplex, $\bp_t$ being the vector of class proportions in $t$,
\end{enumerate}
satisfies the refinement property, and~\ref{cost:mis} is the case
$\phi(\bp)=1-\max_k p_k$ of~\ref{cost:imp}.
\end{proposition}

\begin{proof}
\ref{cost:rss} is the analysis of variance identity of Unit 10, whose third term
$n_Ln_R(\bar y_L-\bar y_R)^2/n_t$ is non-negative.

\ref{cost:imp} The class counts add, $n_{tk}=n_{Lk}+n_{Rk}$, so
$\bp_t=(n_L/n_t)\bp_L+(n_R/n_t)\bp_R$, and concavity gives
$\phi(\bp_t)\geqslant(n_L/n_t)\phi(\bp_L)+(n_R/n_t)\phi(\bp_R)$; multiplying by $n_t$ gives
$R(t)\geqslant R(t_L)+R(t_R)$.

\ref{cost:mis} $\bp\mapsto\max_kp_k$ is a maximum of linear functions, hence convex, so
$1-\max_kp_k$ is concave and~\ref{cost:imp} applies. Directly:
$\max_k(n_{Lk}+n_{Rk})\leqslant\max_kn_{Lk}+\max_kn_{Rk}$.
\end{proof}

\begin{definition}[Cost complexity; ISLR (8.4)]\label{def:costcomplexity}
For $\alpha\geqslant0$ and $S\in\calS(t)$,
\begin{equation}\label{eq:Ralpha}
R_\alpha(S)=R(S)+\alpha\,|S| .
\end{equation}
\end{definition}

\begin{remark}
The number of pruned subtrees can grow faster than any polynomial in the size of $T_{\max}$: a
complete binary tree of depth $d$ has $N_d$ pruned subtrees with $N_0=1$ and
$N_{d}=1+N_{d-1}^2$, since such a subtree is either the root alone or a pair of pruned
subtrees of the two branches. That gives $N_5=458{,}330$ and $N_6>2\times10^{11}$ on a tree
of $127$ nodes. Minimising~\eqref{eq:Ralpha} by enumeration is not available.
\end{remark}

\subsection{The minimising subtree}\label{sec:11.1.2}

\begin{definition}[Value function]\label{def:mvalue}
$m_\alpha(t)=\min_{S\in\calS(t)}R_\alpha(S)$.
\end{definition}

\begin{lemma}[Recursion]\label{lem:dp}
If $t$ is a leaf of $T_{\max}$ then $m_\alpha(t)=R(t)+\alpha$. Otherwise
\begin{equation}\label{eq:dp}
m_\alpha(t)=\min\bigl\{\,R(t)+\alpha,\ \ m_\alpha(t_L)+m_\alpha(t_R)\,\bigr\} .
\end{equation}
\end{lemma}

\begin{proof}
A pruned subtree rooted at an internal $t$ either is $\{t\}$, of cost complexity
$R(t)+\alpha$, or retains both children, in which case it is determined by a pair
$S_L\in\calS(t_L)$, $S_R\in\calS(t_R)$ and its leaves are those of $S_L$ together with those
of $S_R$. Both $R$ and $|\cdot|$ add over that partition of the leaves, so
$R_\alpha(S)=R_\alpha(S_L)+R_\alpha(S_R)$, and minimising over the pair minimises the two
terms separately.
\end{proof}

\begin{lemma}[Shape in $\alpha$]\label{lem:shape}
$\alpha\mapsto m_\alpha(t)$ is the minimum of the finitely many affine functions
$\alpha\mapsto R(S)+\alpha|S|$, $S\in\calS(t)$. It is therefore continuous, piecewise
linear, concave, and strictly increasing, every slope $|S|$ being at least $1$.
\end{lemma}

\begin{proof}
Definition~\ref{def:mvalue} is exactly that minimum, over a finite set. A minimum of
finitely many affine functions is concave and piecewise linear, and it is strictly
increasing because each of them is.
\end{proof}

\begin{theorem}[Every internal node has a pruning threshold]\label{thm:threshold}
Assume the refinement property and let $t$ be internal in $T_{\max}$. Put
\begin{equation}\label{eq:hdef}
h_t(\alpha)=m_\alpha(t_L)+m_\alpha(t_R)-R(t)-\alpha .
\end{equation}
Then $h_t$ is continuous, piecewise linear and strictly increasing with every slope at least
$1$, $h_t(0)\leqslant0$, and $h_t(\alpha)\to\infty$. Hence there is a unique
$\alpha_t\in[0,\infty)$ with
\begin{equation}\label{eq:threshold}
h_t(\alpha)<0 \ \ \text{for}\ \alpha<\alpha_t ,
\qquad
h_t(\alpha)\geqslant0 \ \ \text{for}\ \alpha\geqslant\alpha_t .
\end{equation}
\end{theorem}

\begin{proof}
By Lemma~\ref{lem:shape} each of $m_\alpha(t_L)$ and $m_\alpha(t_R)$ is piecewise linear with
slopes at least $1$, so their sum has slopes at least $2$ and $h_t$ has slopes at least
$2-1=1$: it is continuous, piecewise linear, strictly increasing, and unbounded above.

At $\alpha=0$ the minimum in Definition~\ref{def:mvalue} is over $R(S)$ alone, and iterating
the refinement property down the branch shows $R(T_{\max,t})\leqslant R(S)$ for every
$S\in\calS(t)$, so $m_0(t)=R(T_{\max,t})$. Hence
$h_t(0)=R(T_{\max,t_L})+R(T_{\max,t_R})-R(t)=R(T_{\max,t})-R(t)\leqslant0$, again by
refinement. A continuous strictly increasing function that is non-positive at $0$ and
unbounded above has a unique zero $\alpha_t\geqslant0$, and~\eqref{eq:threshold} follows.
\end{proof}

\begin{definition}[The canonical subtree]\label{def:Talpha}
Assume the refinement property, so that every $\alpha_t$ of Theorem~\ref{thm:threshold}
exists; it is assumed to the end of §\ref{sec:11.1}. $S_\alpha(t)$ is defined upward from the leaves: $S_\alpha(t)=\{t\}$ if $t$ is a leaf of
$T_{\max}$ or if $\alpha\geqslant\alpha_t$; otherwise $S_\alpha(t)$ is $t$ together with
$S_\alpha(t_L)$ and $S_\alpha(t_R)$. Write $T(\alpha)=S_\alpha(r)$ at the root $r$.
\end{definition}

\begin{theorem}[$T(\alpha)$ is the smallest minimiser]\label{thm:Talpha}
For every $\alpha\geqslant0$ and every node $t$,
\begin{equation}\label{eq:Talpha}
R_\alpha\bigl(S_\alpha(t)\bigr)=m_\alpha(t) ,
\qquad\text{and}\qquad
S_\alpha(t)\preccurlyeq S \ \text{ for every minimiser } S\in\calS(t) .
\end{equation}
In particular $T(\alpha)$ minimises $R_\alpha$ over $\calS(r)$ and is a pruned subtree of
every other minimiser.
\end{theorem}

\begin{proof}
Induction on the height of $t$. If $t$ is a leaf of $T_{\max}$ then $\calS(t)=\{\{t\}\}$ and
both statements are trivial.

Let $t$ be internal. If $\alpha\geqslant\alpha_t$ then $h_t(\alpha)\geqslant0$, that is
$R(t)+\alpha\leqslant m_\alpha(t_L)+m_\alpha(t_R)$, so~\eqref{eq:dp} gives
$m_\alpha(t)=R(t)+\alpha=R_\alpha(\{t\})$; and $S_\alpha(t)=\{t\}$ is a pruned subtree of
every member of $\calS(t)$.

If $\alpha<\alpha_t$ then $h_t(\alpha)<0$, so $m_\alpha(t)=m_\alpha(t_L)+m_\alpha(t_R)$ and
the inequality $R(t)+\alpha>m_\alpha(t)$ is strict: no minimiser is $\{t\}$. Every minimiser
$S$ therefore retains both children and splits as a pair $(S_L,S_R)$ with
$R_\alpha(S_L)+R_\alpha(S_R)=m_\alpha(t_L)+m_\alpha(t_R)$, which forces $S_L$ and $S_R$ to
be minimisers at $t_L$ and $t_R$. By the induction hypothesis
$R_\alpha(S_\alpha(t_L))+R_\alpha(S_\alpha(t_R))=m_\alpha(t)$, which is the first claim, and
$S_\alpha(t_L)\preccurlyeq S_L$, $S_\alpha(t_R)\preccurlyeq S_R$, which is the second.
\end{proof}

\begin{theorem}[Nesting]\label{thm:nesting}
If $0\leqslant\alpha<\alpha'$ then $T(\alpha')\preccurlyeq T(\alpha)$.
\end{theorem}

\begin{proof}
Induction on the height of $t$, proving $S_{\alpha'}(t)\preccurlyeq S_\alpha(t)$. For a leaf
of $T_{\max}$ both are $\{t\}$. For internal $t$, if $\alpha'\geqslant\alpha_t$ then
$S_{\alpha'}(t)=\{t\}$, which is a pruned subtree of anything. Otherwise
$\alpha<\alpha'<\alpha_t$, so both $S_{\alpha'}(t)$ and $S_\alpha(t)$ retain both children,
and the induction hypothesis applies at $t_L$ and $t_R$.
\end{proof}

\begin{corollary}[A finite nested sequence; ISLR §8.1.1]\label{cor:sequence}
There are $\alpha$ values $0=\eta_0<\eta_1<\cdots<\eta_B$ and trees
$T(0)=T^{(0)}\succ T^{(1)}\succ\cdots\succ T^{(B)}=\{r\}$ with
$T(\alpha)=T^{(j)}$ for $\alpha\in[\eta_j,\eta_{j+1})$ and $T(\alpha)=T^{(B)}$ for
$\alpha\geqslant\eta_B$, where $T(0)$, the smallest minimiser of $R$, is $T_{\max}$ when
$R(T_{\max,t})<R(t)$ at every internal $t$. Moreover $B<|T_{\max}|$, so cross-validation
over $\alpha$ is a search over at most $|T_{\max}|$ candidate trees.
\end{corollary}

\begin{proof}
By Definition~\ref{def:Talpha}, $T(\alpha)$ depends on $\alpha$ only through which of the
finitely many inequalities $\alpha\geqslant\alpha_t$ hold, so it is piecewise constant with
breakpoints among $\{\alpha_t\}$. By Theorem~\ref{thm:nesting} the distinct values are
strictly nested, and each strict pruning removes at least one leaf, so there are at most
$|T_{\max}|$ of them. At $\alpha=0$ the definition expands exactly where $\alpha_t>0$, that
is where $R(T_{\max,t})<R(t)$ (Theorem~\ref{thm:threshold}: $\alpha_t=0$ exactly when
$h_t(0)=0$, and its proof gives $h_t(0)=R(T_{\max,t})-R(t)$), so the value is $T_{\max}$ when this holds at every internal $t$; for $\alpha$
past every $\alpha_t$ it is $\{r\}$.
\end{proof}

\begin{corollary}[Weakest link; ISLR §8.1.1]\label{cor:weakestlink}
Let $t$ be internal and let $T_t$ be $t$ together with $S_{\alpha_t}(t_L)$ and
$S_{\alpha_t}(t_R)$; it has $|T_t|\geqslant2$ leaves, at least one from each side. Then
\begin{equation}\label{eq:weakest}
\alpha_t=\frac{R(t)-R(T_t)}{|T_t|-1} .
\end{equation}
\end{corollary}

\begin{proof}
$h_t(\alpha_t)=0$ reads $m_{\alpha_t}(t_L)+m_{\alpha_t}(t_R)=R(t)+\alpha_t$, and by
Theorem~\ref{thm:Talpha} the left side is $R_{\alpha_t}(T_t)=R(T_t)+\alpha_t|T_t|$. Solve
for $\alpha_t$.
\end{proof}

\begin{remark}
Equation~\eqref{eq:weakest} is the quantity every implementation reports: the cost saved by
keeping the branch, per extra leaf. \texttt{tree} prints it as the vector \texttt{k} of a
pruning sequence, which lists the $\alpha_t$ at which $T(\alpha)$ changes; \texttt{rpart} prints \texttt{cp}, which is~\eqref{eq:weakest} divided by
the cost of the root, so that \texttt{cp} is a fraction of the total.
\end{remark}

\begin{remark}
The proof is an algorithm. One sweep from the leaves upward evaluates $m_\alpha$ and
$T(\alpha)$ at a given $\alpha$ by~\eqref{eq:dp} in a number of operations proportional to
the number of nodes, against a count of pruned subtrees that can grow exponentially in the number of nodes.
\end{remark}

\subsection{Choosing the penalty}\label{sec:11.1.3}

\begin{definition}[Cross-validation over the sequence; ISLR Algorithm 8.1]\label{def:cvtree}
Split the data into $K$ folds. For each fold $k$, grow a tree on the other $K-1$ folds,
form its own pruning sequence, and record the cost on fold $k$ of the subtree selected at
each $\alpha$ in a common grid. Average over folds to obtain $\CV(\alpha)$ and take
$\hat\alpha=\argmin_\alpha \CV(\alpha)$. The tree reported is $T(\hat\alpha)$ from the
sequence grown on all the data.
\end{definition}

\begin{remark}
The grid must be common to all folds, and the fold sequences have their own breakpoints, so
the grid is taken from the full-data sequence. Two consequences are easy to overlook. The
subtree a fold contributes at a given $\alpha$ need not have the number of leaves that the
full-data tree has at that $\alpha$, so the size axis of a cross-validation plot is a label
from the full data and not a property of what was scored; and the whole tree, not only its
pruning, must be regrown inside each fold, since choosing the splits on all the data and
cross-validating only the pruning would evaluate a rule that has already seen the held-out observations.
\end{remark}

\begin{definition}[One standard error rule; Unit 5]\label{def:1se}
Let $\widehat{\se}(\alpha)$ be the standard error over folds of the cross-validated cost.
The \emph{one standard error rule} selects the largest $\alpha$, that is the smallest tree,
with
\begin{equation}\label{eq:1se}
\CV(\alpha)\ \leqslant\ \CV(\hat\alpha)+\widehat{\se}(\hat\alpha) .
\end{equation}
\end{definition}

\begin{remark}
Corollary~\ref{cor:sequence} makes Definition~\ref{def:cvtree} feasible: the
candidate set is a nested sequence of at most $|T_{\max}|$ trees, not the collection of
all pruned subtrees. Nothing here shows that $\hat\alpha$ estimates the minimiser of the
test error well; that is the cross-validation question of Unit 1.
\end{remark}

% \periodmark{End of period 1 of 3.}

%==============================================================================
\section{Classification Trees}\label{sec:11.2}
%==============================================================================

\begin{reading}
ISLR §8.1.2. \ SRM learning outcomes 4(a), 4(b).
\end{reading}

\subsection{Leaf labels}\label{sec:11.2.1}

\begin{definition}[Classification tree; ISLR §8.1.2]\label{def:classtree}
The response takes values in $\{1,\ldots,K\}$; from here on $K$ counts classes, not
folds. A classification tree assigns to each leaf
$t$ the class proportions $\bp_t=(p_{t1},\ldots,p_{tK})$ with
$p_{tk}=n_{tk}/n_t$, and predicts a single class $\hat k(t)$ for every observation falling
in $t$.
\end{definition}

\begin{proposition}[Majority vote; ISLR §8.1.2]\label{prop:majority}
The label minimising the number of training errors in leaf $t$ is any modal class
$\hat k(t)\in\argmax_kn_{tk}$, and the resulting error count is $n_t-\max_kn_{tk}
=n_t\,M(\bp_t)$ with $M(\bp)=1-\max_kp_k$.
\end{proposition}

\begin{proof}
Labelling $t$ with class $k$ misclassifies the $n_t-n_{tk}$ observations of other classes,
which is smallest when $n_{tk}$ is largest.
\end{proof}

\begin{remark}
Unit 1 proved that the classifier minimising the error probability assigns $\bx$ to
$\argmax_k\prb\{Y=k\mid X=\bx\}$. Proposition~\ref{prop:majority} is that rule with the
conditional probabilities replaced by the proportions in the leaf, so a classification tree
is an estimate of the Bayes classifier in which the conditioning event is the box rather
than the point. The class proportions themselves, not only the label, are part of the
output: two leaves may share a label and differ entirely in how confident it is.
\end{remark}

\subsection{Impurity}\label{sec:11.2.2}

\begin{definition}[Impurity function]\label{def:impurity}
An \emph{impurity} is a continuous concave $\phi:\Delta^{K-1}\to[0,\infty)$ on the
probability simplex $\Delta^{K-1}=\{\bp\geqslant\bzero:\sum_kp_k=1\}$ with
$\phi(\mathbf{e}_k)=0$ at every vertex. The impurity of a tree is
$R(T)=\sum_{t\ \text{leaf}}n_t\phi(\bp_t)$ and the \emph{gain} of a split is
\begin{equation}\label{eq:impgain}
\Delta_\phi=\phi(\bp_t)-\frac{n_L}{n_t}\phi(\bp_L)-\frac{n_R}{n_t}\phi(\bp_R) .
\end{equation}
\end{definition}

\begin{definition}[The three impurities; ISLR (8.5)--(8.7)]\label{def:three}
\begin{equation}\label{eq:three}
M(\bp)=1-\max_kp_k ,
\qquad
G(\bp)=\sum_{k}p_k(1-p_k)=1-\sum_kp_k^2 ,
\qquad
H(\bp)=-\sum_kp_k\ln p_k ,
\end{equation}
the \emph{misclassification rate}, the \emph{Gini index} and the \emph{entropy}, with
$0\ln0=0$.
\end{definition}

\begin{proposition}[Concavity]\label{prop:concave}
$M$, $G$ and $H$ are impurities. $G$ and $H$ are strictly concave on the simplex; $M$ is
concave but affine on every region where a single class is strictly modal.
\end{proposition}

\begin{proof}
All three vanish at the vertices and are continuous, $x\ln x\to0$ as $x\downarrow0$ giving
continuity of $H$.

$G$: along every line, $u\mapsto G(\bp+u\bv)$ has second derivative $-2\|\bv\|^2<0$ for
$\bv\neq\mathbf0$, so $G$ is strictly concave on the simplex by the lemma on convexity from
the derivative (prerequisites), which reduces strict concavity to restrictions to lines.

$H$: $\psi(x)=-x\ln x$ is continuous on $[0,1]$ with $\psi'(x)=-\ln x-1$ strictly
decreasing on $(0,1)$, so $\psi$ is strictly concave on the closed interval $[0,1]$ by the
same lemma. If $\bp\neq\bq$ in the simplex, some coordinate differs, so for $0<\lambda<1$
every term satisfies $\psi(\lambda p_k+(1-\lambda)q_k)\geqslant\lambda\psi(p_k)+(1-\lambda)\psi(q_k)$,
strictly for that coordinate; summing gives
$H(\lambda\bp+(1-\lambda)\bq)>\lambda H(\bp)+(1-\lambda)H(\bq)$, boundary points included.

$M$: $\max_kp_k$ is a maximum of linear functions, hence convex, so $M$ is concave. On the
set where class $k^\ast$ is strictly modal, $M(\bp)=1-p_{k^\ast}$ is affine.
\end{proof}

\begin{theorem}[A split never hurts, and when it does nothing]\label{thm:gain}
For any impurity $\phi$, $\Delta_\phi\geqslant0$. If $\phi$ is strictly concave and both
children are non-empty, $\Delta_\phi=0$ if and only if $\bp_L=\bp_R$.
\end{theorem}

\begin{proof}
The class counts add, so $\bp_t=(n_L/n_t)\bp_L+(n_R/n_t)\bp_R$ and concavity gives
$\phi(\bp_t)\geqslant(n_L/n_t)\phi(\bp_L)+(n_R/n_t)\phi(\bp_R)$, which
is~\eqref{eq:impgain}$\,\geqslant0$. Strict concavity makes the inequality strict unless
$\bp_L=\bp_R$, in which case both sides equal $\phi(\bp_t)$.
\end{proof}

\begin{theorem}[Misclassification is blind to a split that keeps the modal class]
\label{thm:Mblind}
If the same class $k^\ast$ is modal in the parent, in the left child and in the right child,
then $\Delta_M=0$ exactly.
\end{theorem}

\begin{proof}
Under the hypothesis, $n_tM(\bp_t)=n_t-n_{tk^\ast}$ and likewise for the children, and the
counts add: $n_LM(\bp_L)+n_RM(\bp_R)=(n_L-n_{Lk^\ast})+(n_R-n_{Rk^\ast})
=n_t-n_{tk^\ast}=n_tM(\bp_t)$. Divide by $n_t$.
\end{proof}

\begin{remark}
Trees are therefore not grown on the error count. A split that leaves both
children with the same modal class scores exactly zero on $M$ however differently the two
children are composed, so a greedy search on $M$ has no gradient to follow and stops. Under
$G$ or $H$ the same split has strictly positive gain unless the two child distributions
coincide (Theorem~\ref{thm:gain}), and the search continues.
\end{remark}

\begin{theorem}[Ordering]\label{thm:ordering}
For every $\bp\in\Delta^{K-1}$,
\begin{equation}\label{eq:ordering}
M(\bp)\ \leqslant\ G(\bp)\ \leqslant\ H(\bp) ,
\end{equation}
and for $K=2$ also $G(\bp)\leqslant2M(\bp)$, with equality only at the vertices (while
$M=G$ at $\bp=(\tfrac12,\tfrac12)$).
\end{theorem}

\begin{proof}
For the first inequality, $\sum_kp_k^2\leqslant(\max_kp_k)\sum_kp_k=\max_kp_k$, so
$G=1-\sum_kp_k^2\geqslant1-\max_kp_k=M$.

For the second, $\ln u\leqslant u-1$ for $u>0$, applied at $u=p_k$, gives
$-\ln p_k\geqslant1-p_k$ and hence
$H=\sum_kp_k(-\ln p_k)\geqslant\sum_kp_k(1-p_k)=G$, the terms with $p_k=0$ contributing $0$
to both sides.

For $K=2$ write $\bp=(p,1-p)$ and $q=\min\{p,1-p\}$, so $M=q$ and
$G=2p(1-p)=2q(1-q)\leqslant2q$ since $1-q\leqslant1$. Equality needs $q^2=0$, that is
$q=0$, where both sides vanish.
\end{proof}

\begin{proposition}[What the Gini index measures]\label{prop:gini-meaning}
Let $U,V$ be independent draws from $\bp$. Then $G(\bp)=\prb\{U\neq V\}$: it is the error
rate of the rule that guesses a class at random from the leaf's own proportions. For $K=2$,
$G(\bp)=2\var(\indc\{U=1\})$.
\end{proposition}

\begin{proof}
$\prb\{U=V\}=\sum_kp_k^2$. For $K=2$, $\var(\indc\{U=1\})=p(1-p)$ and $G=2p(1-p)$.
\end{proof}

\begin{proposition}[Entropy and the reported deviance; ISLR §8.3.1]\label{prop:deviance}\leavevmode\newline
The quantity $-2\sum_{t\ \text{leaf}}\sum_kn_{tk}\ln p_{tk}$, which \texttt{tree} prints as
the deviance of a classification tree, equals $2\sum_{t\ \text{leaf}}n_tH(\bp_t)$. It is the
deviance of Unit 8 (the definition of deviance there): twice the log
likelihood ratio of the saturated model, which gives each observation its own class
probability one, against the fitted leaf probabilities.
\end{proposition}

\begin{proof}
$\sum_kn_{tk}\ln p_{tk}=n_t\sum_kp_{tk}\ln p_{tk}=-n_tH(\bp_t)$. For the second sentence,
the log likelihood of the individual observations in leaf $t$ is $\sum_kn_{tk}\ln p_{tk}$,
and the saturated model puts each observation's own class at probability
one, with log likelihood $0$.
\end{proof}

\begin{remark}
The three quantities therefore serve different roles. $G$ or $H$ grows the tree, because
Theorem~\ref{thm:Mblind} says $M$ cannot. $M$ prunes it, because
Corollary~\ref{cor:sequence} needs a cost and the cost one actually cares about is the error
count. Both are legitimate node costs by Proposition~\ref{prop:refine}, and the two choices can
select trees of very different sizes on the same data.
\end{remark}

\subsection{Two classes}\label{sec:11.2.3}

\begin{theorem}[A two-class Gini split is a regression split on the indicator]
\label{thm:gini-is-rss}
Let $K=2$ and code $y_i=\indc\{\text{observation }i\text{ is in class }2\}$. Then for any
split of node $t$,
\begin{equation}\label{eq:gini-rss}
n_L\,G(\bp_L)+n_R\,G(\bp_R)=2\Bigl\{\sum_{i\in L}(y_i-\bar y_L)^2+\sum_{i\in R}
(y_i-\bar y_R)^2\Bigr\} ,
\end{equation}
so minimising the weighted Gini impurity and minimising the residual sum of squares of the
$0$--$1$ response select the same split, and the Gini gain~\eqref{eq:impgain} is
$2n_Ln_R(\bar y_L-\bar y_R)^2/n_t^2$, which is $2/n_t$ times Unit 10's gain.
\end{theorem}

\begin{proof}
In a node holding $m$ observations, with a proportion $\bar y$ of them coded $1$,
$\sum_i(y_i-\bar y)^2=m\bar y(1-\bar y)$ because $y_i^2=y_i$. The class proportions are
$\bp=(1-\bar y,\bar y)$, so $G(\bp)=2\bar y(1-\bar y)$ and $mG(\bp)=2\sum_i(y_i-\bar y)^2$.
Applying this in each child gives~\eqref{eq:gini-rss}. The gain expression is the analysis
of variance identity of Unit 10 applied to the $0$--$1$ response, multiplied by $2/n_t$.
\end{proof}

\begin{remark}
Nothing new has to be implemented for two-class Gini splitting: it is the regression
splitter of Unit 10 run on the indicator. The identity also explains why the Gini gain
carries Unit 10's $n_Ln_R/n_t$ weight, divided by the constant $n_t/2$, so a split peeling off a handful of observations is
penalised for the same reason.
\end{remark}

\subsection{Categorical predictors}\label{sec:11.2.4}

\begin{remark}[Qualitative predictors; ISLR §8.1.2]
A split on an unordered predictor with $L$ levels sends a non-empty proper subset of the levels
to the left, and a subset and its complement give the same split, so there are $2^{L-1}-1$
splits: $2^{31}-1$ at $L=32$.
\end{remark}

\begin{theorem}[Ordered search suffices]\label{thm:ordered-levels}
Let $x$ be categorical with levels $1,\ldots,L$, let $\bar y_l$ be the mean response of the
observations at level $l$, and suppose the $\bar y_l$ are distinct and ordered
$\bar y_1<\cdots<\bar y_L$. Then some subset $A^\ast$ minimising
\begin{equation}\label{eq:catcrit}
Q(A)=\sum_{i:\,x_i\in A}(y_i-\bar y_A)^2+\sum_{i:\,x_i\notin A}(y_i-\bar y_{A^c})^2
\end{equation}
over non-trivial $A$ is an initial segment $\{1,\ldots,m\}$. By
Theorem~\ref{thm:gini-is-rss} the same holds for a two-class Gini split, with $\bar y_l$
the proportion of class $2$ at level $l$.
\end{theorem}

\begin{proof}
Write $Q(A)=\min_{a,b}F(A,a,b)$ with
$F(A,a,b)=\sum_{x_i\in A}(y_i-a)^2+\sum_{x_i\notin A}(y_i-b)^2$, the minimum over $a$ and
$b$ being attained at the two group means. So a minimiser of $Q$ is part of a minimiser of
$F$ over all three arguments.

Fix $a$ and $b$ and minimise $F$ over $A$. All observations at a level move together, and
level $l$ contributes $\sum_{i\in l}(y_i-a)^2$ if $l\in A$ and $\sum_{i\in l}(y_i-b)^2$
otherwise. Splitting each at $\bar y_l$,
\[
\sum_{i\in l}(y_i-a)^2-\sum_{i\in l}(y_i-b)^2
= n_l\bigl\{(\bar y_l-a)^2-(\bar y_l-b)^2\bigr\}
= n_l(b-a)\bigl(2\bar y_l-a-b\bigr) ,
\]
the within-level sums of squares cancelling. Hence, when $a<b$, the contribution is smaller
by putting $l$ in $A$ exactly when $\bar y_l<(a+b)/2$, and larger exactly when
$\bar y_l>(a+b)/2$.

Let $A^\ast$ minimise $Q$ and put $a=\bar y_{A^\ast}$, $b=\bar y_{A^{\ast c}}$. If $a=b$ the
analysis of variance identity makes $Q(A^\ast)$ equal to the total sum of squares in the
node, so no split reduces it and every $A$, the initial segments included, is a minimiser.
Otherwise assume $a<b$, exchanging the names of $A^\ast$ and $A^{\ast c}$ if necessary.
Since $(A^\ast,a,b)$ minimises $F$, no level can be moved to reduce it (a move that empties
$A^\ast$ or its complement gives the trivial split, whose $F$ is at least the total sum of
squares, hence at least $Q(A^\ast)$), so every $l\in
A^\ast$ has $\bar y_l\leqslant(a+b)/2$ and every $l\notin A^\ast$ has
$\bar y_l\geqslant(a+b)/2$. Since the $\bar y_l$ are distinct, every level in $A^\ast$
therefore precedes every level outside it in the ordering: $A^\ast$ is an initial segment.
\end{proof}

\begin{remark}
The proof is the two-mean assignment step: put each level with whichever of the two fitted
values it is closer to. Sorting the levels once and scanning the $L-1$ cutpoints therefore
finds an optimal split at the cost of Unit 10's continuous case.
Theorem~\ref{thm:ordered-levels} needs a scalar $\bar y_l$ to sort by, so it covers
regression and two-class classification; with $K>2$ classes there is no such ordering and
implementations fall back on heuristics.
\end{remark}

% \periodmark{End of period 2 of 3.}

%==============================================================================
\section{Trees Against Linear Models}\label{sec:11.3}
%==============================================================================

\begin{reading}
ISLR §8.1.3--8.1.4. \ SRM learning outcome 4(a).
\end{reading}

\begin{remark}[ISLR (8.8)--(8.9)]
A linear model fits $f(\bx)=\beta_0+\sum_j\beta_jx_j$ and a tree fits
$f(\bx)=\sum_mc_m\indc\{\bx\in R_m\}$; neither class contains the other, and which predicts
better depends on the truth, as the theorems of this section quantify.
\end{remark}

\subsection{The cost of a staircase}\label{sec:11.3.1}

\begin{theorem}[Approximating a linear function by boxes]\label{thm:staircase}
Let $X$ be uniform on $[0,1]$ and $f(x)=\beta_0+\beta_1x$. Among all partitions of $[0,1]$
into $J$ intervals, the mean squared error of the best piecewise-constant approximation,
\begin{equation}\label{eq:staircase}
\min_{\text{partitions}}\ \expc\bigl[\{f(X)-\expc[f(X)\mid X\in I(X)]\}^2\bigr]
=\frac{\beta_1^2}{12J^2} ,
\end{equation}
is attained by the $J$ intervals of equal width. In $p$ dimensions, with $X$ uniform on
$[0,1]^p$, $f(\bx)=\beta_0+\bb'\bx$ and a grid of $J=m^p$ equal boxes,
\begin{equation}\label{eq:staircase-p}
\expc\bigl[\{f(X)-\expc[f(X)\mid \text{box}]\}^2\bigr]=\frac{\|\bb\|^2}{12\,J^{2/p}} .
\end{equation}
\end{theorem}

\begin{proof}
On an interval $I$ of width $w$ the conditional law of $X$ is uniform, so
$\var(f(X)\mid X\in I)=\beta_1^2w^2/12$, and the error contributed by $I$ is
$\prb\{X\in I\}\var(f(X)\mid X\in I)=\beta_1^2w^3/12$. Summing,
the error is $(\beta_1^2/12)\sum_jw_j^3$ subject to $\sum_jw_j=1$. The function
$u\mapsto u^3$ is convex, so Jensen's inequality (prerequisites) gives
$J^{-1}\sum_jw_j^3\geqslant(J^{-1}\sum_jw_j)^3=J^{-3}$, that is
$\sum_jw_j^3\geqslant J^{-2}$, with equality when all $w_j$ are equal.
That is~\eqref{eq:staircase}.

In $p$ dimensions the coordinates of $X$ are independent, and on a box of side $1/m$ in
every coordinate the conditional variance of $\bb'X$ is $\sum_j\beta_j^2/(12m^2)$, free of
which box. With $J=m^p$, $m^2=J^{2/p}$.
\end{proof}

\begin{remark}
Halving the error of a linear truth costs $\sqrt2$ times as many leaves in one dimension.
On the grid of equal boxes in $p$ dimensions it costs $2^{p/2}$ times as many leaves: at
$p=10$ a factor of $32$. When only some coordinates of $\bb$ are non-zero, a tree can cut
along those alone, and $p$ is then their number. A linear model has no such error at all. The difficulty is dimensional, not a matter of
sample size.
\end{remark}

\subsection{Where a tree is exactly right}\label{sec:11.3.2}

\begin{theorem}[A single step]\label{thm:step}
Let $X$ be uniform on $[0,1]$ and $f(x)=\indc\{x>c\}$ with $c\in(0,1)$. The best linear
predictor of $f(X)$ has mean squared error
\begin{equation}\label{eq:step-linear}
c(1-c)\bigl\{1-3c(1-c)\bigr\} ,
\end{equation}
which is $1/16$ at $c=\tfrac12$, while the two-leaf tree that splits at $c$ has mean squared
error $0$. Moreover the split gain of Unit 10, in population form
$s\mapsto\prb\{X\leqslant s\}\prb\{X>s\}\{\expc[f\mid X\leqslant s]-\expc[f\mid X>s]\}^2$,
is maximised at $s=c$, so greedy splitting finds the right cut.
\end{theorem}

\begin{proof}
The best linear predictor $a+bX$ minimises
$\expc[(f-a-bX)^2]=\var(f-bX)+(\expc f-a-b\expc X)^2$; the second term vanishes at
$a=\expc f-b\expc X$, and $\var(f)-2b\cov(f,X)+b^2\var(X)$ is least at
$b=\cov(f,X)/\var(X)$, with value $\var(f)\{1-\corr^2\}$.
$\expc[f]=1-c$ and $f^2=f$, so $\var(f)=c(1-c)$; $\var(X)=1/12$ and
$\cov(f,X)=\int_c^1x\,\dd x-(1-c)/2=(1-c^2)/2-(1-c)/2=c(1-c)/2$. The squared correlation is
therefore $\{c(1-c)/2\}^2/\{c(1-c)/12\}=3c(1-c)$, and the best linear predictor leaves
$\var(f)\{1-\corr^2\}$, which is~\eqref{eq:step-linear}; at $c=\tfrac12$ it is
$\tfrac14(1-\tfrac34)=\tfrac1{16}$. The tree that splits at $c$ predicts $0$ below and $1$
above, reproducing $f$.

For the gain, take $s\leqslant c$: the left piece has $f\equiv0$ so its mean is $0$, and the
right piece has mean $(1-c)/(1-s)$, giving
$s(1-s)\{(1-c)/(1-s)\}^2=s(1-c)^2/(1-s)$, increasing in $s$ on $[0,c]$. For $s\geqslant c$
the right piece has $f\equiv1$ and the left has mean $(s-c)/s$, giving
$s(1-s)\{1-(s-c)/s\}^2=(1-s)c^2/s$, decreasing in $s$. Both expressions equal $c(1-c)$ at
$s=c$.
\end{proof}

\begin{theorem}[A structure a tree can hold but greedy growing cannot find]
\label{thm:checkerboard}
Let $X=(X_1,X_2)$ be uniform on $[0,1]^2$ and
$f(\bx)=1$ when $x_1>\tfrac12$ and $x_2>\tfrac12$ both hold or both fail, and $f(\bx)=0$
otherwise, that is $f=1$ on two
opposite quarters and $0$ on the other two. Then
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{cb:i} a tree with four leaves reproduces $f$ exactly;
\item\label{cb:ii} the best linear predictor of $f(X)$ is the constant $\tfrac12$, with mean
      squared error $\tfrac14$;
\item\label{cb:iii} every single axis-aligned split of $[0,1]^2$ has population split gain
      exactly $0$.
\end{enumerate}
\end{theorem}

\begin{proof}
\ref{cb:i} Split at $x_1=\tfrac12$ and then each half at $x_2=\tfrac12$.

\ref{cb:ii} $\expc[f]=\tfrac12$. For the covariance with $X_1$,
\[
\expc[fX_1]=\int_{1/2}^{1}\!\!\int_{1/2}^{1}x_1+\int_{0}^{1/2}\!\!\int_{0}^{1/2}x_1
=\tfrac12\int_{1/2}^{1}x\,\dd x+\tfrac12\int_{0}^{1/2}x\,\dd x
=\tfrac12\cdot\tfrac38+\tfrac12\cdot\tfrac18=\tfrac14 ,
\]
which equals $\expc[f]\expc[X_1]$, so $\cov(f,X_1)=0$, and by symmetry
$\cov(f,X_2)=0$. As in the proof of Theorem~\ref{thm:step}, the best
$a+b_1X_1+b_2X_2$ takes $a=\expc f-b_1\expc X_1-b_2\expc X_2$ and minimises
$\var(f-b_1X_1-b_2X_2)=\var(f)-2\sum_jb_j\cov(f,X_j)+\sum_jb_j^2/12$, using that $X_1,X_2$
are independent with variance $1/12$; with both covariances $0$ this is least at
$b_1=b_2=0$. The best linear predictor is therefore the constant $\expc[f]=\tfrac12$
and its error is $\var(f)=\tfrac14$.

\ref{cb:iii} Take a split at $X_1=s$ with $s\leqslant\tfrac12$. On the left, $x_1\leqslant
s\leqslant\tfrac12$, so $f=\indc\{x_2\leqslant\tfrac12\}$ and the mean is $\tfrac12$. On the
right, conditionally on $X_1$ the mean of $f$ is $\tfrac12$ whichever side of $\tfrac12$
$X_1$ falls, so the mean is $\tfrac12$ there too. The two conditional means coincide and the
gain, which by Unit 10 is a positive multiple of their squared difference, vanishes. The
cases $s>\tfrac12$ and splits on $X_2$ are the same computation.
\end{proof}

\begin{remark}
Part~\ref{cb:iii} is the limitation that matters and it is not the one usually stated. The
target is a partition predictor with four boxes, exactly the class a tree fits, and the
tree still fails: the greedy criterion of Unit 10 sees nothing at the first split, so
whatever the algorithm does next is driven by sampling noise. What a tree can represent and what growing it finds are different questions.
\end{remark}

\subsection{Instability}\label{sec:11.3.3}

\begin{remark}
A tree is a discontinuous function of the data. The split chosen at a node is the
$\argmax$ of finitely many gains, so an arbitrarily small perturbation that reverses the
order of the top two changes the split, and every box below it. Nothing above bounds the resulting
change in the fitted function.
\end{remark}

\begin{remark}[Advantages and disadvantages; ISLR §8.1.4]
ISLR lists for trees: they are easy to explain, even more so than linear regression, arguably closer to human decision-making, can
be displayed graphically and read by non-experts, and handle qualitative predictors without
dummy variables; against them, their predictive accuracy is generally below that of other
methods, and they are not robust, a small change in the data changing the tree a great deal,
which is the instability above.
\end{remark}

\section{Computation in R}\label{sec:11.4}
%==============================================================================

\begin{reading}
ISLR §8.3.1--8.3.2 (labs). \ SRM learning outcomes 4(a), 4(b).
\end{reading}

\subsection{The ISLR labs}\label{sec:11.4.1}

\begin{example}[Classification trees on \texttt{Carseats}; ISLR §8.3.1]\label{ex:lab-carseats}
\texttt{Sales} of child car seats at $400$ stores, recoded as $\texttt{High}=\texttt{Yes}$ when
$\texttt{Sales}>8$; the full tree, then a tree grown on $200$ training stores, pruned by
cross-validation on the error count, with ISLR's seeds:
<<lab-carseats>>=
suppressMessages({library(ISLR2); library(tree); library(rpart)})
Car <- Carseats; Car$High <- factor(ifelse(Car$Sales <= 8, "No", "Yes"))
tc <- tree(High ~ . - Sales, Car); sc <- summary(tc)
c(leaves = sc$size, deviance = sc$dev, residual_df = sc$df, training_errors = sc$misclass[1])
set.seed(2); trn <- sample(1:nrow(Car), 200)
tt <- tree(High ~ . - Sales, Car, subset = trn)
acc <- function(m) mean(predict(m, Car[-trn, ], type = "class") == Car$High[-trn])
pc <- predict(tt, Car[-trn, ], type = "class"); table(predicted = pc, observed = Car$High[-trn])
set.seed(7); cm <- cv.tree(tt, FUN = prune.misclass); rbind(size = cm$size, cv_errors = cm$dev)
pt <- prune.misclass(tt, best = 9)
c(full_accuracy = mean(pc == Car$High[-trn]), pruned9_accuracy = acc(pt),
  pruned14_accuracy = acc(prune.misclass(tt, best = 14)))
@
ISLR's numbers are reproduced: $27$ leaves, training error $36/400=9\%$ and residual mean
deviance $170.66/373$; on the test stores $(104+50)/200=77\%$ correct; cross-validation
chooses $9$ leaves with $74$ errors, and the pruned tree classifies $77.5\%$ correctly, the
$14$-leaf tree $77\%$. The full-tree accuracy is computed from the same predictions as the
table: \texttt{predict.tree} breaks a tie between equal class proportions in a leaf at random,
so a second call can classify a store differently.
\end{example}

\begin{example}[A regression tree on \texttt{Boston}; ISLR §8.3.2]\label{ex:lab-boston}
<<lab-boston>>=
set.seed(1); trb <- sample(1:nrow(Boston), nrow(Boston) / 2)
tbl <- tree(medv ~ ., Boston, subset = trb); sb <- summary(tbl)
as.character(sb$used); sb$size
set.seed(1); cvl <- cv.tree(tbl); rbind(size = cvl$size, cv_deviance = round(cvl$dev))
yhb <- predict(tbl, newdata = Boston[-trb, ])
c(test_mse = mean((yhb - Boston$medv[-trb])^2),
  root_mse = sqrt(mean((yhb - Boston$medv[-trb])^2)),
  leaf_rm_above_7.553 = tbl$frame$yval[tbl$frame$var == "<leaf>"][7])
@
Four variables enter, \texttt{rm}, \texttt{lstat}, \texttt{crim} and \texttt{age}; tracts with
$\texttt{rm}\geqslant7.553$ are predicted at $\$45{,}400$; the test mean squared error of the
seven-leaf tree is $35.29$, a root mean squared error of about $\$5{,}941$. All are ISLR's.
The cross-validated deviance is smallest at six leaves ($4322$), only $15$ below the full
tree's $4337$; ISLR keeps the full tree, and the two are practically tied.
\end{example}

\begin{example}[Pruning the \texttt{Hitters} tree; ISLR §8.1.1, Figures 8.4--8.5]\label{ex:hitters-prune}
$\log(\texttt{Salary})$ on nine predictors, half the $263$ players for training, the tree grown
by \texttt{tree} and its cost-complexity sequence judged by six-fold cross-validation, by the
training error and by the test error:
<<hitters-prune>>=
Hp <- na.omit(Hitters); Hp$lsal <- log(Hp$Salary)
set.seed(1); trh <- sample(nrow(Hp), 132)
th <- tree(lsal ~ Years + Hits + RBI + PutOuts + Walks + Runs + Assists + HmRun + Errors,
           Hp, subset = trh)
set.seed(1); cvh <- cv.tree(th, K = 6)
fitk <- function(k, d) if (k == 1) rep(mean(Hp$lsal[trh]), nrow(d)) else
  predict(prune.tree(th, best = k), d)
round(rbind(size = cvh$size, cv_mse = cvh$dev / 132,
  train = sapply(cvh$size, function(k) mean((fitk(k, Hp[trh, ]) - Hp$lsal[trh])^2)),
  test = sapply(cvh$size, function(k) mean((fitk(k, Hp[-trh, ]) - Hp$lsal[-trh])^2))), 3)
@
The grown tree has $10$ leaves. The training error falls with every leaf, as it must; the test
error is smallest at $3$ leaves, ISLR's choice; cross-validation is smallest at $8$ leaves, though
its curve is nearly flat from $3$ to $10$, where every value lies within $0.03$ of the
minimum. With $132$ observations the cross-validation curve is noisy, and the size it picks is
correspondingly uncertain.
\end{example}

\begin{example}[A classification tree for \texttt{Heart}; ISLR §8.1.2, Figure 8.6]\label{ex:heart-tree}
The $297$ complete records of ISLR's \texttt{Heart} data, heart disease \texttt{AHD} on $13$
predictors, among them the qualitative \texttt{Thal} and \texttt{ChestPain}:
<<heart-tree>>=
Hd <- na.omit(read.csv("data/islr/Heart.csv", stringsAsFactors = TRUE)[, -1])
tHd <- tree(AHD ~ ., Hd); c(leaves = sum(tHd$frame$var == "<leaf>"))
print(prune.misclass(tHd, best = 6), digits = 3)
@
The unpruned tree has $20$ leaves. Its first split is on \texttt{Thal}, a qualitative predictor
split into two groups of its levels, as in ISLR's figure, and the six-leaf pruned tree uses only
\texttt{Thal}, \texttt{Ca}, \texttt{ChestPain} and \texttt{ExAng}. ISLR points out splits in
its tree whose two leaves predict the same class; such a split leaves the error count unchanged
(Theorem~\ref{thm:Mblind}) but lowers the Gini index or the deviance by making one leaf purer,
which is why trees are grown on those and not on the error count.
\end{example}


The checks below use \texttt{Boston} in full ($n=506$) for regression and \texttt{Car} for
classification.

<<setup-data>>=
tb <- tree(medv ~ ., Boston)
c(n_boston = nrow(Boston), leaves_boston = sum(tb$frame$var == "<leaf>"))
@

\subsection{The pruning sequence (§\ref{sec:11.1.2})}\label{sec:11.4.2}

<<pruning-thresholds>>=
fr <- tb$frame; id <- as.integer(rownames(fr))
Rn <- setNames(fr$dev, id); lf <- setNames(fr$var == "<leaf>", id)
mval <- function(a, t) { k <- as.character(t)
  if (lf[[k]]) Rn[[k]] + a else
    min(Rn[[k]] + a, mval(a, 2*t) + mval(a, 2*t + 1)) }
alpha_t <- function(t) uniroot(function(a)
  mval(a, 2*t) + mval(a, 2*t + 1) - Rn[[as.character(t)]] - a,
  c(0, 1e7), tol = 1e-9)$root
manual <- sort(sapply(id[!lf], alpha_t))
pk <- prune.tree(tb)$k[-1]
signif(rbind(manual_thresholds = manual, package_k = pk,
             difference = manual - pk), 5)
@

<<canonical-subtree>>=
leafset <- function(a, t) { k <- as.character(t)
  if (lf[[k]] || Rn[[k]] + a <= mval(a, 2*t) + mval(a, 2*t + 1)) t
  else c(leafset(a, 2*t), leafset(a, 2*t + 1)) }
grid <- c(0, (head(manual, -1) + tail(manual, -1))/2, max(manual) + 1)
t(sapply(grid, function(a)
  c(alpha = a, manual_leaves = length(leafset(a, 1)),
    package_leaves = sum(prune.tree(tb, k = a)$frame$var == "<leaf>"))))
@

\texttt{rpart} reports the same thresholds divided by the cost of the root
(Corollary~\ref{cor:weakestlink}).

<<rpart-cp>>=
rp <- rpart(medv ~ ., Boston, control = rpart.control(cp = 0, xval = 0))
R0 <- sum((Boston$medv - mean(Boston$medv))^2)
signif(rbind(cp = head(rp$cptable[, "CP"], 4),
             cp_times_root_cost = head(rp$cptable[, "CP"], 4)*R0,
             tree_thresholds = rev(manual)[1:4]), 5)
@

The first three agree exactly: both packages make the same first three splits, so they
prune the same branches at the same prices. They part at the fourth because their stopping
rules differ, \texttt{tree} using \texttt{mindev} and \texttt{minsize} where \texttt{rpart}
uses \texttt{minsplit} and \texttt{minbucket}, so the trees being pruned are not the same
tree. Figure~\ref{fig:envelope} draws the lower envelope and the leaf count of the
\texttt{Boston} pruning sequence.

\begin{figure}[H]\centering
<<envelope-fig, echo=FALSE, fig.width=6.4, fig.height=2.9>>=
sizes <- prune.tree(tb)$size; devs <- prune.tree(tb)$dev
ax <- seq(0, 22000, length.out = 400)
op <- par(mfrow = c(1, 2), mar = c(4, 4.2, 1.6, 0.8), cex = 0.85)
plot(range(ax), c(0, 80000), type = "n", xlab = expression(alpha),
     ylab = expression(R[alpha](S)), main = "the affine family")
for (j in seq_along(sizes))
  lines(ax, devs[j] + ax*sizes[j], col = "grey70")
lines(ax, sapply(ax, function(a) min(devs + a*sizes)), col = "#1E3A8A", lwd = 2.5)
abline(v = manual, col = "#B45309", lty = 3)
plot(ax, sapply(ax, function(a) length(leafset(a, 1))), type = "s", lwd = 2,
     col = "#B45309", xlab = expression(alpha),
     ylab = expression(paste("leaves of ", T(alpha))),
     main = "the nested sequence")
abline(v = manual, col = "grey75", lty = 3)
par(op)
@
\caption{Left: for each subtree in the sequence, the line $\alpha\mapsto R(S)+\alpha|S|$,
with the value function $m_\alpha(r)$ of Definition~\ref{def:mvalue} as their lower envelope
(Lemma~\ref{lem:shape}), concave and piecewise linear; the dotted verticals are the
thresholds of Theorem~\ref{thm:threshold}. Right: the leaf count of $T(\alpha)$, a decreasing
step function (Theorem~\ref{thm:nesting}) jumping here at every threshold (in general at
some, Corollary~\ref{cor:sequence}).}\label{fig:envelope}
\end{figure}

\subsection{Cross-validation (§\ref{sec:11.1.3})}\label{sec:11.4.3}

\texttt{cv.tree} forms its folds by drawing a fold label for each observation independently,
so the folds are not of equal size.

<<cv-folds>>=
set.seed(3); K <- 10; n <- nrow(Boston)
fold <- sample(K, n, replace = TRUE)
c(intended_size = n/K, smallest = min(table(fold)),
  largest = max(table(fold)))
@

Each fold's tree is pruned at the \emph{full-data} thresholds, so the subtree a fold
contributes at a given $\alpha$ need not have the number of leaves printed against it.

<<cv-sizes>>=
mf <- model.frame(tb)
sz <- sapply(1:4, function(i) {
  tl <- tree(model = mf[fold != i, , drop = FALSE])
  sapply(manual, function(a) sum(prune.tree(tl, k = a)$frame$var == "<leaf>")) })
rbind(alpha = round(manual), full_data_size = prune.tree(tb)$size[-1], t(sz))
@

<<cv-boston>>=
set.seed(3); cvb <- cv.tree(tb, K = 10)
rbind(size = cvb$size, cv_deviance = round(cvb$dev))
@

Cross-validation keeps the whole tree here: the deviance is smallest at nine leaves, the
largest the growing rule produced. Pruning is not always an improvement, and the sequence is
a family to search, not a prescription to shrink.

The one standard error rule of Definition~\ref{def:1se} needs a standard error, which
\texttt{rpart} supplies as \texttt{xstd}.

<<one-se>>=
set.seed(5)
rp2 <- rpart(medv ~ ., Boston, control = rpart.control(cp = 0.001, xval = 10))
ct <- rp2$cptable; j <- which.min(ct[, "xerror"])
thr <- ct[j, "xerror"] + ct[j, "xstd"]
c(minimising_nsplit = ct[j, "nsplit"], min_xerror = ct[j, "xerror"],
  one_se_threshold = thr,
  one_se_nsplit = ct[which(ct[, "xerror"] <= thr)[1], "nsplit"])
@

\subsection{Impurity (§\ref{sec:11.2.2})}\label{sec:11.4.4}

<<impurity-ordering>>=
Mf <- function(p) 1 - max(p); Gf <- function(p) 1 - sum(p^2)
Hf <- function(p) { p <- p[p > 0]; -sum(p*log(p)) }
set.seed(1); P <- matrix(rexp(4000*4), ncol = 4); P <- P/rowSums(P)
c(smallest_G_minus_M = min(apply(P, 1, Gf) - apply(P, 1, Mf)),
  smallest_H_minus_G = min(apply(P, 1, Hf) - apply(P, 1, Gf)),
  largest_G_minus_2M_two_classes = max(sapply(seq(0, 1, 0.001),
    function(p) Gf(c(p, 1 - p)) - 2*Mf(c(p, 1 - p)))))
@

Two splits of a node holding $400$ of each class: A into $(300,100)$ and $(100,300)$, B into
$(200,400)$ and $(200,0)$.

<<impurity-tie>>=
wt <- function(nL, nR, f) { N <- sum(nL) + sum(nR)
  sum(nL)/N*f(nL/sum(nL)) + sum(nR)/N*f(nR/sum(nR)) }
imp <- function(nL, nR) c(M = wt(nL, nR, Mf), G = wt(nL, nR, Gf),
                          H = wt(nL, nR, Hf))
round(rbind(parent = c(M = Mf(c(.5, .5)), G = Gf(c(.5, .5)),
                       H = Hf(c(.5, .5))),
            split_A = imp(c(300, 100), c(100, 300)),
            split_B = imp(c(200, 400), c(200, 0))), 4)
@

Both splits reduce $M$ from $0.50$ to $0.25$, so the error count cannot choose between
them; $G$ and $H$ both prefer B, which produces a pure leaf. Proposition~\ref{prop:deviance}
identifies what \texttt{tree} prints for a classification tree.

<<deviance-check>>=
lc <- tc$frame$var == "<leaf>"
c(package_deviance = deviance(tc),
  manual_2_sum_n_H = 2*sum(tc$frame$n[lc]*apply(tc$frame$yprob[lc, ], 1, Hf)),
  training_errors = sum(tc$frame$n[lc]*apply(tc$frame$yprob[lc, ], 1, Mf)))
@

\begin{figure}[H]\centering
<<impurity-fig, echo=FALSE, fig.width=6.4, fig.height=2.7>>=
p <- seq(0, 1, length.out = 400)
op <- par(mar = c(4, 4.2, 1.4, 0.8), cex = 0.85)
plot(p, sapply(p, function(q) Hf(c(q, 1 - q))), type = "l", lwd = 2,
     col = "#B45309", ylim = c(0, 0.72), xlab = expression(p),
     ylab = "impurity", main = "")
lines(p, sapply(p, function(q) Gf(c(q, 1 - q))), lwd = 2, col = "#1E3A8A")
lines(p, sapply(p, function(q) Mf(c(q, 1 - q))), lwd = 2, col = "grey45")
lines(p, 2*sapply(p, function(q) Mf(c(q, 1 - q))), lwd = 1, lty = 3,
      col = "grey45")
legend("topleft", bty = "n", cex = 0.85, lwd = c(2, 2, 2, 1),
       lty = c(1, 1, 1, 3),
       col = c("#B45309", "#1E3A8A", "grey45", "grey45"),
       legend = c("entropy H", "Gini G", "misclassification M", "2M"))
par(op)
@
\caption{The three impurities for two classes. Theorem~\ref{thm:ordering} places $M$ below
$G$ below $H$ and traps $G$ between $M$ and $2M$; all three vanish at $p=0$ and $p=1$ and
peak at $p=\tfrac12$. Only $M$ has a corner there, and it is affine on each side, which is
Theorem~\ref{thm:Mblind} in one picture.}\label{fig:impurity}
\end{figure}

\subsection{Categorical predictors (§\ref{sec:11.2.4})}\label{sec:11.4.5}

<<categorical>>=
set.seed(4); m <- 300; L <- 8
lv <- factor(sample(letters[1:L], m, TRUE))
yc <- c(2, 9, 4, 7, 1, 5, 8, 3)[as.integer(lv)] + rnorm(m, 0, 2)
Q <- function(A) { i <- lv %in% levels(lv)[A]
  if (!any(i) || all(i)) Inf else
    sum((yc[i] - mean(yc[i]))^2) + sum((yc[!i] - mean(yc[!i]))^2) }
subs <- lapply(1:(2^(L - 1) - 1),
               function(b) which(as.integer(intToBits(b))[1:L] == 1))
ord <- order(tapply(yc, lv, mean))
c(subsets_tried = length(subs), ordered_tried = L - 1,
  best_exhaustive = min(sapply(subs, Q)),
  best_ordered = min(sapply(1:(L - 1), function(k) Q(ord[1:k]))),
  difference = min(sapply(1:(L - 1), function(k) Q(ord[1:k]))) -
               min(sapply(subs, Q)))
@

\subsection{Trees against linear models (§\ref{sec:11.3.1}--§\ref{sec:11.3.2})}\label{sec:11.4.6}

With $\beta_1=3$ the predicted error is $9/(12J^2)$.

<<staircase>>=
set.seed(8); N <- 2e5; xu <- runif(N)
t(sapply(c(2, 4, 8, 16), function(J) {
  b <- cut(xu, seq(0, 1, length.out = J + 1))
  c(J = J, mse = mean((3*xu - ave(3*xu, b))^2), theory = 9/(12*J^2)) }))
@

<<step>>=
fs <- as.numeric(xu > 0.5)
c(linear_mse = mean(residuals(lm(fs ~ xu))^2),
  theory = 0.25*(1 - 3*0.25),
  two_leaf_tree_mse = mean((fs - ave(fs, xu > 0.5))^2))
@

On a sample of $400$ the first-split gains are noise.

<<checkerboard>>=
set.seed(11); q <- 400; z1 <- runif(q); z2 <- runif(q)
fx <- as.numeric((z1 > .5) == (z2 > .5)); yx <- fx + rnorm(q, 0, .3)
gn <- function(s, v) { i <- if (v == 1) z1 < s else z2 < s
  sum(i)*sum(!i)/q*(mean(yx[i]) - mean(yx[!i]))^2 }
ss <- c(.2, .35, .5, .65, .8)
round(rbind(cut = ss, gain_x1 = sapply(ss, gn, v = 1),
            gain_x2 = sapply(ss, gn, v = 2),
            percent_of_total_x2 = 100*sapply(ss, gn, v = 2)/
              sum((yx - mean(yx))^2)), 4)
@

The largest gain in the table is at $x_2<0.2$ and is $1.7\%$ of the total sum of squares,
while splitting $x_1$ at the cut that matters, $\tfrac12$, has the smallest gain of the ten.
A greedy tree splits where the noise is. Figure~\ref{fig:compare} draws the staircase
error and the checkerboard.

\begin{figure}[H]\centering
<<compare-fig, echo=FALSE, fig.width=6.4, fig.height=2.9>>=
op <- par(mfrow = c(1, 2), mar = c(4, 4.2, 1.6, 0.8), cex = 0.85)
Js <- 2:24
plot(Js, 9/(12*Js^2), type = "l", lwd = 2, col = "#1E3A8A", log = "y",
     ylim = c(0.001, 0.6), xlab = "leaves J", ylab = "mean squared error",
     main = "linear truth in p dimensions")
for (pp in c(2, 4)) lines(Js, 9/(12*Js^(2/pp)), lwd = 2, col = "#B45309",
                          lty = pp/2)
legend("bottomleft", bty = "n", cex = 0.8, lwd = 2,
       col = c("#1E3A8A", "#B45309", "#B45309"), lty = c(1, 1, 2),
       legend = c("p = 1", "p = 2", "p = 4"))
plot(z1, z2, pch = 16, cex = 0.5, col = ifelse(fx == 1, "#1E3A8A", "grey70"),
     xlab = expression(x[1]), ylab = expression(x[2]),
     main = "every first split is worthless")
abline(v = 0.5, h = 0.5, col = "#B45309", lwd = 2, lty = 2)
par(op)
@
\caption{Left: Theorem~\ref{thm:staircase}, the error of the $J$-box grid approximation to a
linear truth, on a log scale; the decay $J^{-2/p}$ flattens as the dimension grows. Right:
the checkerboard truth of Theorem~\ref{thm:checkerboard}, which four boxes fit exactly and
which no single split improves at all.}\label{fig:compare}
\end{figure}

\subsection{Instability (§\ref{sec:11.3.3})}\label{sec:11.4.7}

<<instability>>=
set.seed(9); Rt <- replicate(200, {
  i <- sample(nrow(Boston), nrow(Boston)/2)
  a <- tree(medv ~ ., Boston[i, ]); b <- tree(medv ~ ., Boston[-i, ])
  c(as.character(a$frame$var[1]), as.character(b$frame$var[1]),
    sqrt(mean((predict(a, Boston) - predict(b, Boston))^2))) })
sort(table(c(Rt[1, ], Rt[2, ])), decreasing = TRUE)
c(agree_on_root_variable = mean(Rt[1, ] == Rt[2, ]),
  rms_prediction_difference = mean(as.numeric(Rt[3, ])),
  sd_of_medv = sd(Boston$medv))
@

The two halves choose \texttt{rm} and \texttt{lstat} in nearly equal numbers, agree on the
root variable under a fifth of the time, and their predictions on the same observations
differ in root mean square by $45\%$ of the standard deviation of the response itself.


\subsection{Growing, pruning and selecting in practice}\label{sec:11.4.8}

\subsubsection*{Stopping early instead of pruning}

Growing while the gain exceeds a threshold and pruning a large tree are not the same
procedure. The checkerboard truth of Theorem~\ref{thm:checkerboard} is the extreme case: no
first split has any population gain at all, so every threshold above zero stops at the root.

<<pitfall-stopping>>=
set.seed(15); q <- 800; w1 <- runif(q); w2 <- runif(q)
fw <- as.numeric((w1 > .5) == (w2 > .5))
dw <- data.frame(w1, w2, y = fw + rnorm(q, 0, .3))
t(sapply(c(0.05, 0.01, 0.002, 0), function(md) {
  g <- tree(y ~ w1 + w2, dw,
            control = tree.control(q, mindev = md, minsize = 10))
  c(mindev = md, grown_leaves = sum(g$frame$var == "<leaf>"),
    mse_of_fit = mean((predict(g, dw) - fw)^2)) }))
c(variance_of_f = mean((fw - mean(fw))^2))
@

At the default \texttt{mindev} of $0.01$ the tree is the root and its mean squared error is
the variance of the target: nothing has been learnt. Growing without a threshold and pruning
afterwards does better than either extreme.

<<pitfall-stopping-2>>=
g0 <- tree(y ~ w1 + w2, dw, control = tree.control(q, mindev = 0, minsize = 10))
t(sapply(c(2, 4, 8, 16, 40, 130), function(J) {
  pj <- prune.tree(g0, best = J)
  c(requested = J, leaves = sum(pj$frame$var == "<leaf>"),
    mse = mean((predict(pj, dw) - fw)^2)) }))
@

The symptom is a tree with one leaf on data whose structure is known to be richer, and
a fit that improves sharply the moment the stopping rule is loosened.
Grow past the point where splits look worthwhile, then prune
(Algorithm 8.1 of ISLR, §\ref{sec:11.1}). The best pruned tree here has mean squared error $0.0020$ against the
$0.2500$ the default stopping rule delivers, a factor of $123$, and against $0.0372$ for the
fully grown tree that was pruned. Both halves are needed: growing finds the structure,
pruning removes what the growing added afterwards. Note also that \texttt{best} requests a
size and returns the smallest tree in the sequence with at least that many leaves, so $2$
and $4$ both return five leaves.

\subsubsection*{Pruning with the criterion used for growing}

Both the error count and the deviance are legitimate node costs
(Proposition~\ref{prop:refine}), and they select different trees.

<<pitfall-criterion>>=
tf <- tree(High ~ . - Sales, Car)
t(sapply(1:6, function(s) { set.seed(s)
  a <- cv.tree(tf, FUN = prune.misclass); b <- cv.tree(tf)
  c(seed = s, chosen_by_error_count = a$size[which.min(a$dev)],
    chosen_by_deviance = b$size[which.min(b$dev)]) }))
@

The symptom is two runs of the same pipeline reporting trees of two and of twenty-seven
leaves.
Prune on the loss the model will be judged by. The deviance of
Proposition~\ref{prop:deviance} is a log likelihood and punishes a confident wrong leaf
without limit; the error count of Proposition~\ref{prop:majority} does not. If the tree
will be scored by its error rate, use \texttt{FUN = prune.misclass}. Note also that the
error-count choice is itself unstable across folds, ranging over most of the sequence as the
seed changes, which is the instability of §\ref{sec:11.3.3} appearing in the selection step.

\subsubsection*{Reading the training curve}

<<pitfall-training>>=
pr <- prune.tree(tb)
rbind(leaves = pr$size, training_deviance = round(pr$dev),
      cv_deviance = round(cvb$dev))
@

The symptom is a cost that falls monotonically with the number of leaves, used to
choose the number of leaves.
The training cost is decreasing in the tree by the refinement property
(Proposition~\ref{prop:refine}), so its minimiser is always $T_{\max}$ and it carries no
information about size. Only the cross-validated column can be minimised. On these data both
columns happen to point at nine leaves, which is a coincidence of this example and not a
reason to trust the first.

\subsubsection*{Cross-validating the pruning but not the growing}

<<pitfall-leak>>=
set.seed(21); B <- 40; n <- nrow(Boston)
res <- t(replicate(B, {
  f <- sample(10, n, replace = TRUE)
  full <- tree(medv ~ ., Boston)
  honest <- leaky <- 0
  for (k in 1:10) {
    ho <- Boston[f == k, ]
    h <- prune.tree(tree(medv ~ ., Boston[f != k, ]), best = 5)
    honest <- honest + sum((ho$medv - predict(h, ho))^2)
    leaky <- leaky + sum((ho$medv - predict(prune.tree(full, best = 5), ho))^2)
  }
  c(honest, leaky)/n }))
c(honest_cv_mse = mean(res[, 1]), leaky_cv_mse = mean(res[, 2]),
  ratio = mean(res[, 2])/mean(res[, 1]))
@

The symptom is a cross-validation loop in which only the pruning, or only the choice of
$\alpha$, is redone inside the fold while the splits come from a tree fitted to everything.
The leaky loop above is the extreme case, in which nothing is refit inside the fold: it
reports the training error of the full-data five-leaf tree.
Refit from the raw data inside each fold, as Definition~\ref{def:cvtree}
requires. The splits are chosen by looking at the response, so a tree grown on all the data
has already seen every held-out observation. The optimism is not small here: the leaky loop
reports $30\%$ less error than the honest one, which would turn a mediocre tree into a good
one on paper.

\subsubsection*{Reading a single tree as a statement about variables}

<<pitfall-importance>>=
set.seed(31); imp <- replicate(200, {
  i <- sample(nrow(Boston), replace = TRUE)
  as.character(tree(medv ~ ., Boston[i, ])$frame$var[1]) })
round(sort(prop.table(table(imp)), decreasing = TRUE), 3)
@

The symptom is a report that names the root split variable as the most important
predictor.
Resample and look at the distribution. Here two variables share the root
almost equally, and which one appears is a property of the sample and not of the population.
Importance measures averaged over many trees are the only form in which the question has a
stable answer. Figure~\ref{fig:trees} shows how much of the five-leaf \texttt{Boston} tree
the first split carries.

\begin{figure}[H]\centering
<<tree-fig, echo=FALSE, fig.width=6.4, fig.height=3.0>>=
op <- par(mfrow = c(1, 2), mar = c(0.6, 0.6, 2.0, 0.6), cex = 0.62)
p5 <- prune.tree(tb, best = 5)
plot(p5); text(p5, pretty = 0, digits = 3, cex = 1.15)
title("Boston, branches drawn to scale", cex.main = 1.35)
plot(pt, type = "uniform"); text(pt, pretty = 0, cex = 0.9)
title("Carseats, 9 leaves, uniform", cex.main = 1.35)
par(op)
@
\caption{Left, \texttt{Boston} pruned to five leaves with branch lengths proportional to the
drop in the node cost, so a long branch is a split that mattered: the first split on
\texttt{rm} accounts for most of the tree. Right, the \texttt{Carseats} tree of
Example~\ref{ex:lab-carseats} drawn with uniform branches, which nine leaves need to stay legible. It
splits on \texttt{ShelveLoc} directly, with no dummy coding.}\label{fig:trees}
\end{figure}

% \periodmark{End of period 3 of 3.}

%==============================================================================
\section{Exercises}\label{sec:11.5}
%==============================================================================

\begin{exercise}[ISLR §8.4, exercise 3]\label{ex:i8-3}
With two classes, plot the Gini index, the classification error and the entropy as functions
of $\hat p_{m1}$.
\end{exercise}

\begin{solution}
With $\hat p_{m1}=p$, $M=\min\{p,1-p\}$, $G=2p(1-p)$ and $H=-p\ln p-(1-p)\ln(1-p)$
(Definition~\ref{def:three}); Figure~\ref{fig:impurity} is the plot. All three vanish at
$p\in\{0,1\}$ and peak at $p=\tfrac12$ with values $\tfrac12$, $\tfrac12$ and $\ln2=0.693$, and
$M\leqslant G\leqslant H$ throughout (Theorem~\ref{thm:ordering}); only $M$ has a corner at
$\tfrac12$, the source of Theorem~\ref{thm:Mblind}.
\end{solution}

\begin{exercise}[ISLR §8.4, exercise 6]\label{ex:i8-6}
Explain in detail the algorithm used to fit a regression tree.
\end{exercise}

\begin{solution}
(1) Grow: starting from the whole predictor space, choose the predictor $j$ and cutpoint $s$
minimising the residual sum of squares of the two resulting boxes (Unit 10's split criterion,
equivalently maximising $n_Ln_R(\bar y_L-\bar y_R)^2/n$), and repeat within each box until each
contains fewer than a minimum number of observations; each leaf predicts its mean. (2) Prune:
for each $\alpha\geqslant0$ the subtree minimising $R(S)+\alpha|S|$ (Definition~\ref{def:costcomplexity})
is the canonical $T(\alpha)$ of Theorem~\ref{thm:Talpha}, and as $\alpha$ grows these form a
finite nested sequence (Corollary~\ref{cor:sequence}) computed by the recursion of
Lemma~\ref{lem:dp}. (3) Choose $\alpha$ by cross-validation over folds, regrowing and pruning in
each fold (Definition~\ref{def:cvtree}). (4) Return $T(\hat\alpha)$ from the tree grown on all
the data.
\end{solution}

\begin{exercise}[ISLR §8.4, exercise 8, parts (a)--(c)]\label{ex:i8-8}
For \texttt{Carseats} with \texttt{Sales} as a quantitative response: (a) split into training
and test sets; (b) fit a regression tree, interpret it and give the test mean squared error;
(c) choose the tree size by cross-validation and say whether pruning improves the test mean
squared error. Parts (d)--(f) are bagging, random forests and BART, Unit 12's and beyond the
syllabus.
\end{exercise}

\begin{solution}
<<i8-8>>=
set.seed(1); tr8 <- sample(nrow(Carseats), 200)
ts8 <- tree(Sales ~ ., Carseats, subset = tr8)
mse8 <- function(m) mean((predict(m, Carseats[-tr8, ]) - Carseats$Sales[-tr8])^2)
as.character(summary(ts8)$used); c(leaves = summary(ts8)$size, test_mse = mse8(ts8))
set.seed(1); cv8 <- cv.tree(ts8); rbind(size = cv8$size, cv_deviance = round(cv8$dev, 1))
round(sapply(c(18, 8, 5), function(k) mse8(prune.tree(ts8, best = k))), 3)
@
(a) $200$ stores train and $200$ test. (b) The $18$-leaf tree splits first on
\texttt{ShelveLoc} and then on \texttt{Price}, \texttt{Age}, \texttt{Advertising},
\texttt{CompPrice} and \texttt{US}: good shelving and low prices raise sales. Its test mean
squared error is $4.92$. (c) Cross-validation selects the full $18$ leaves; pruning to $8$ or
$5$ leaves raises the test error to $5.11$ and $5.19$, so pruning does not help here.
\end{solution}

\begin{exercise}[ISLR §8.4, exercise 9]\label{ex:i8-9}
For \texttt{OJ}, with \texttt{Purchase} the response: (a) take $800$ training observations;
(b) fit a tree and give the training error rate and number of leaves; (c) interpret one leaf
of the printed tree; (d) plot and interpret it; (e) give the test confusion matrix and error
rate; (f)--(h) choose the size by cross-validation on the error count; (i) prune to that size,
or to five leaves if the full tree is chosen; (j), (k) compare training and test error rates of
the pruned and unpruned trees.
\end{exercise}

\begin{solution}
<<i8-9>>=
set.seed(1); tro <- sample(nrow(OJ), 800); to <- tree(Purchase ~ ., OJ, subset = tro)
so <- summary(to); c(leaves = so$size, training_errors = so$misclass[1],
  training_error_rate = so$misclass[1] / 800)
print(to, digits = 4)
po <- predict(to, OJ[-tro, ], type = "class"); table(predicted = po, observed = OJ$Purchase[-tro])
set.seed(1); cvo <- cv.tree(to, FUN = prune.misclass); rbind(size = cvo$size, cv_errors = cvo$dev)
pp <- prune.misclass(to, best = 5); sp <- summary(pp)
round(c(pruned_leaves = sp$size, unpruned_train = so$misclass[1] / 800,
        pruned_train = sp$misclass[1] / 800, unpruned_test = mean(po != OJ$Purchase[-tro]),
        pruned_test = mean(predict(pp, OJ[-tro, ], type = "class") != OJ$Purchase[-tro])), 4)
@
(b) Nine leaves, training error $127/800=15.9\%$; only \texttt{LoyalCH}, \texttt{PriceDiff},
\texttt{SpecialCH}, \texttt{ListPriceDiff} and \texttt{PctDiscMM} are used. (c) Leaf 8,
$\texttt{LoyalCH}<0.0356$: $59$ customers, $98.3\%$ of whom bought Minute Maid, so the leaf
predicts \texttt{MM} with near certainty and deviance $10.14$. (d) Brand loyalty
\texttt{LoyalCH} makes the first three splits; prices matter only for customers of middling
loyalty. (e) The test error rate is $46/270=17.0\%$. (f)--(h) The cross-validated error count is
smallest, $145$, at $9$ and $8$ leaves; the full tree is among the minimisers. (i) The request
for five leaves returns the smallest size of at least five in the pruning sequence, seven
(Corollary~\ref{cor:sequence}). (j) The pruned tree's training error is higher, $16.3\%$ against
$15.9\%$, as Proposition~\ref{prop:refine} requires. (k) Its test error is lower, $16.3\%$
against $17.0\%$.
\end{solution}

\begin{exercise}[SOA sample question 9]\label{ex:soa-9}
Of $100$ policies, $30$ lapsed. Split 1 gives nodes of $20$ (with $12$ lapses) and $80$ (with
$18$); split 2 gives nodes of $10$ (with $8$) and $90$ (with $22$). Totals are node impurities
weighted by node size. Which is true? I. Split 1 is preferred on the total Gini index. II. Split
1 is preferred on the total entropy. III. Split 1 is preferred on the number of classification
errors. (A) I only; (B) II only; (C) III only; (D) I, II and III; (E) none of these.
\end{exercise}

\begin{solution}
By Definition~\ref{def:three}:
<<soa-9>>=
Gs <- function(n1, n) { p <- n1 / n; n * 2 * p * (1 - p) }
Hs <- function(n1, n) { p <- c(n1, n - n1) / n; -n * sum(ifelse(p > 0, p * log(p), 0)) }
Ms <- function(n1, n) min(n1, n - n1)
sp <- list(split1 = c(12, 20, 18, 80), split2 = c(8, 10, 22, 90))
round(t(sapply(sp, function(v) c(Gini = (Gs(v[1], v[2]) + Gs(v[3], v[4])) / 100,
  entropy = (Hs(v[1], v[2]) + Hs(v[3], v[4])) / 100, errors = Ms(v[1], v[2]) + Ms(v[3], v[4])))), 4)
@
Split 2 has the smaller total Gini index ($0.3644$ against $0.375$), entropy ($0.5506$ against
$0.5611$) and error count ($24$ against $26$), so I, II and III are all false: (E).
\end{solution}

\begin{exercise}[SOA sample question 25]\label{ex:soa-25}
Which is true of tree pruning? I. Recursive binary splitting can overfit the data. II. A tree
with more splits tends to have lower variance. III. With cost complexity pruning, $\alpha=0$
gives a very large tree. (A) none; (B) I and II only; (C) I and III only; (D) II and III only;
(E) none of these.
\end{exercise}

\begin{solution}
I: splitting reduces the training cost at every step (Proposition~\ref{prop:refine}), so
growing to small leaves fits noise. II is false: more splits mean leaves estimated from fewer
observations, hence more variance. III: at $\alpha=0$ the minimum of $R$ is attained by $T_{\max}$
(proof of Theorem~\ref{thm:threshold}), so the selected tree is as large as the growing
produced, up to branches that reduce no cost (Corollary~\ref{cor:sequence}). (C).
\end{solution}

\begin{exercise}[SOA sample question 26]\label{ex:soa-26}
In each of the three panels the plane is shaded in two classes. Which can a classification tree
fit with no error?\\[2pt]
I \hfill II \hfill III\\
\includegraphics[width=0.3\linewidth]{../srm/assets/figs/srm_q26a.pdf}\hfill
\includegraphics[width=0.3\linewidth]{../srm/assets/figs/srm_q26b.pdf}\hfill
\includegraphics[width=0.3\linewidth]{../srm/assets/figs/srm_q26c.pdf}\\
(A) I only; (B) II only; (C) III only; (D) I, II and III; (E) none of these.
\end{exercise}

\begin{solution}
A tree's regions are boxes cut by axis-parallel lines (Unit 10's definition of a split). Panel I is
three boxes cut by two axis-parallel lines; II has a curved boundary and III a diagonal one, which finitely many axis-parallel
cuts cannot reproduce exactly. (A).
\end{solution}

\begin{exercise}[SOA sample question 29]\label{ex:soa-29}
Which considerations may make trees preferable? I. Trees are easily interpretable. II. Trees can
be displayed graphically. III. Trees are easier to explain than linear regression. (A) none;
(B) I and II only; (C) I and III only; (D) II and III only; (E) none of these.
\end{exercise}

\begin{solution}
All three are among ISLR's advantages of trees (the remark of §\ref{sec:11.3.3}), so (A)--(D)
are all wrong: (E).
\end{solution}

\begin{exercise}[SOA sample question 33]\label{ex:soa-33}
The regression tree below predicts the log claim amount (LCA) from age category
(\texttt{agecat}) and vehicle age (\texttt{veh\_age}).
\begin{center}\includegraphics[width=0.55\linewidth]{../srm/assets/figs/srm_q33.pdf}\end{center}
Rank the predictions for I (\texttt{agecat} $1$, \texttt{veh\_age} $4$), II (\texttt{agecat}
$5$, \texttt{veh\_age} $5$) and III (\texttt{agecat} $5$, \texttt{veh\_age} $3$): (A)
I $<$ II $<$ III; (B) I $<$ III $<$ II; (C) II $<$ I $<$ III; (D) II $<$ III $<$ I; (E) III
$<$ II $<$ I.
\end{exercise}

\begin{solution}
I fails $\texttt{agecat}\geqslant1.5$ and lands in the right leaf, $8.146$. II and III satisfy
it and have $\texttt{veh\_age}\geqslant2.5$ and $\texttt{agecat}\geqslant4.5$; then
$\texttt{veh\_age}<3.5$ separates III ($7.771$) from II ($8.028$). So III $<$ II $<$ I: (E).
\end{solution}

\begin{exercise}[SOA sample question 48]\label{ex:soa-48}
Which partition represents the tree below (the left branch is the true inequality)?
\begin{center}\includegraphics[width=0.4\linewidth]{../srm/assets/figs/srm_q48.pdf}\end{center}
\begin{center}
(A)\includegraphics[width=0.17\linewidth]{../srm/assets/figs/srm_q48a.pdf}\
(B)\includegraphics[width=0.17\linewidth]{../srm/assets/figs/srm_q48b.pdf}\
(C)\includegraphics[width=0.17\linewidth]{../srm/assets/figs/srm_q48c.pdf}\
(D)\includegraphics[width=0.17\linewidth]{../srm/assets/figs/srm_q48d.pdf}\
(E)\includegraphics[width=0.17\linewidth]{../srm/assets/figs/srm_q48e.pdf}
\end{center}
\end{exercise}

\begin{solution}
The root $X_1<t_1$ is a horizontal line at height $t_1$ ($X_1$ is on the vertical axis); the
second split $X_2<t_2$ acts only below it, a vertical segment up to $t_1$; the third,
$X_1<t_3$, acts only to the left of that segment, and its true branch is the leaf C. Only (B)
has all three in that nesting with C below $t_3$.
\end{solution}

\begin{exercise}[SOA sample question 51]\label{ex:soa-51}
The tree below predicts the weight of ducks.
\begin{center}\includegraphics[width=0.5\linewidth]{../srm/assets/figs/srm_q51.pdf}\end{center}
Order the predictions for X (wing span $5.5$ cm, male, age $7$), Y ($5.8$ cm, female, age $5$)
and Z ($5.7$ cm, male, age $8$): (A) X $<$ Y $<$ Z; (B) X $<$ Z $<$ Y; (C) Y $<$ X $<$ Z;
(D) Y $<$ Z $<$ X; (E) Z $<$ X $<$ Y.
\end{exercise}

\begin{solution}
X: age $\leqslant7.5$, male: $0.90$ kg. Y: age $\leqslant7.5$, female: $0.80$ kg. Z: age
$>7.5$, male, wing span $>5.3$: $1.25$ kg. So Y $<$ X $<$ Z: (C).
\end{solution}

\begin{exercise}[SOA sample question 57]\label{ex:soa-57}
For the nine observations below and the regression tree shown, calculate the mean response of
each leaf.
\begin{center}\small
\begin{tabular}{c|ccccccccc}
$R$ & 4.75 & 4.67 & 4.67 & 4.56 & 4.53 & 3.91 & 3.90 & 3.90 & 3.89\\
$X$ & M & F & M & F & M & F & F & M & M\\
$Y$ & A & A & D & D & B & C & B & D & B\\
$Z$ & 2 & 4 & 1 & 3 & 2 & 2 & 5 & 5 & 1
\end{tabular}
\end{center}
\begin{center}\includegraphics[width=0.45\linewidth]{../srm/assets/figs/srm_q57.pdf}\end{center}
{\raggedright
(A) $4.39, 4.38, 4.29, 3.90$; (B) $4.26, 4.38, 4.62, 3.90$; (C) $4.26, 4.39, 3.90, 4.29$;
(D) $4.64, 4.29, 4.38, 3.90$; (E) $4.64, 4.38, 4.39, 3.90$ (for T1, T2, T3, T4).\par}
\end{exercise}

\begin{solution}
By Unit 10's proposition \emph{the region constants are the region means}, each leaf predicts the mean of its observations:
<<soa-57>>=
R <- c(4.75, 4.67, 4.67, 4.56, 4.53, 3.91, 3.90, 3.90, 3.89)
X <- c("M", "F", "M", "F", "M", "F", "F", "M", "M"); Y <- c("A", "A", "D", "D", "B", "C", "B", "D", "B")
Z <- c(2, 4, 1, 3, 2, 2, 5, 5, 1)
leaf <- ifelse(Z <= 3, ifelse(Y %in% c("A", "B"), "T1", "T2"), ifelse(X == "F", "T3", "T4"))
round(tapply(R, leaf, mean), 2)
@
T1 holds observations 1, 5, 9; T2 holds 3, 4, 6; T3 holds 2, 7, with mean
$(4.67+3.90)/2=4.285$, which R prints as $4.28$ and the answer key rounds to $4.29$; T4 holds 8:
(A).
\end{solution}

\begin{exercise}[SOA sample question 63]\label{ex:soa-63}
For the regression tree below of car-seat sales (thousands), predict sales for a store with
\texttt{ShelveLoc} Good, \texttt{Price} $120$, \texttt{Age} $57$, \texttt{Advertising} $12$.
\begin{center}\includegraphics[width=0.5\linewidth]{../srm/assets/figs/srm_q63.pdf}\end{center}
(A) 4.7; (B) 6.6; (C) 7.4; (D) 9.2; (E) 9.4.
\end{exercise}

\begin{solution}
\texttt{ShelveLoc} is not Bad or Medium, so the right branch; $\texttt{Price}=120\geqslant110$,
so its left leaf: $9.2$ thousand. (D).
\end{solution}

\begin{exercise}[SOA sample question 66]\label{ex:soa-66}
Which set of regions represents the regression tree below (left branches are the true
inequalities)?
\begin{center}\includegraphics[width=0.45\linewidth]{../srm/assets/figs/srm_q66.pdf}\end{center}
(A) $R_3=\{X_1>5\}$; (B) $R_3=\{X_1>5,X_2\leqslant60\}$; (C) $R_1=\{X_1\leqslant5,X_2>40\}$,
$R_2=\{X_1\leqslant5,X_2\leqslant40\}$; (D) $R_1=\{X_1\leqslant5,X_2\leqslant40\}$,
$R_2=\{X_1\leqslant5,X_2>40\}$, $R_3=\{5<X_1\leqslant10\}$, $R_4=\{X_1>10,X_2\leqslant60\}$,
$R_5=\{X_1>10,X_2>60\}$; (E) as (B) with $R_4$ and $R_5$ exchanged.
\end{exercise}

\begin{solution}
Each region is the intersection of the inequalities on its path from the root: $R_1$ and $R_2$
lie under $X_1\leqslant5$ and divide at $X_2=40$; $R_3$ is $X_1>5$ and $X_1\leqslant10$; $R_4$ and
$R_5$ lie under $X_1>10$ and divide at $X_2=60$. That is (D); (A), (B) and (E) give $R_3$ the
wrong box and (C) exchanges $R_1$ and $R_2$.
\end{solution}

\begin{exercise}[SOA sample question 73]\label{ex:soa-73}
The plot shows cross-validation, test and training mean squared errors against tree size under
cost complexity pruning. Determine the size of the optimal pruned tree.
\begin{center}\includegraphics[width=0.5\linewidth]{../srm/assets/figs/srm_q73.pdf}\end{center}
(A) 2; (B) 5; (C) 6; (D) 9; (E) 10.
\end{exercise}

\begin{solution}
The size is chosen by minimising the cross-validated error (Definition~\ref{def:cvtree}), not
the training error, which decreases in the size (Proposition~\ref{prop:refine}), nor the test
error, which is not available when choosing. The cross-validation curve is lowest at $5$: (B).
\end{solution}

