%==============================================================================
\section{Data, Correlation and the Model}\label{sec:2.1}
%==============================================================================

\begin{reading}
FREES §2.1--2.2, §3.1, §3.2.1--3.2.3 · ISLR §3.1, §3.2 · CLM §1. \ SRM learning
outcomes 2(a), 2(c).
\end{reading}

\subsection{Scatter plots and correlation}\label{sec:2.1.1}

\begin{example}[Wisconsin lottery sales; FREES §2.1]\label{ex:lottery}
Average weekly online lottery sales in dollars (\texttt{SALES}) over forty weeks of
1998--99 and the population (\texttt{POP}) of $50$ Wisconsin ZIP-code areas chosen at
random.
<<lottery>>=
lottery <- read.csv("data/frees/csv/WiscLottery.csv")
descr <- function(v) c(mean = mean(v), median = median(v), sd = sd(v), min = min(v),
                       max = max(v))
round(rbind(POP = descr(lottery$POP), SALES = descr(lottery$SALES)), 1)
@
<<lottery-fig, fig.height=2.4, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 3), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
hist(lottery$POP, breaks = 15, main = "", xlab = "POP", col = "grey85", border = "white")
hist(lottery$SALES, breaks = 15, main = "", xlab = "SALES", col = "grey85", border = "white")
plot(lottery$POP, lottery$SALES, xlab = "POP", ylab = "SALES", pch = 16, cex = 0.7)
par(op)
@
\begin{figure}[H]\centering
\caption{The lottery data: histograms of population and of sales, and the scatter plot
of sales against population (FREES Figures 2.1--2.2).}
\end{figure}
Both variables are skewed to the right, each mean well above its median; the scatter
plot shows sales rising with population.
\end{example}

\begin{definition}[Pearson correlation; FREES §2.1, ISLR §3.1.3]\label{def:corr}
For pairs $(x_i,y_i)$, $i=1,\ldots,n$, with $s_x^2=(n-1)^{-1}\sum_i(x_i-\bar x)^2$ and
$s_y^2$ likewise,
\begin{equation}\label{eq:corr}
r = \frac{1}{(n-1)s_xs_y}\sum_{i=1}^n(x_i-\bar x)(y_i-\bar y)
  = \frac{\sum_i(x_i-\bar x)(y_i-\bar y)}
         {\sqrt{\sum_i(x_i-\bar x)^2}\sqrt{\sum_i(y_i-\bar y)^2}} .
\end{equation}
The variables are \emph{positively correlated} if $r>0$ and \emph{negatively
correlated} if $r<0$.
\end{definition}

\begin{proposition}[Bounds and invariance]\label{prop:corr-bounds}
$-1\leqslant r\leqslant1$; $r=1$ iff the points lie on a line of positive slope and
$r=-1$ iff they lie on a line of negative slope. Replacing $x_i$ by $a+bx_i$ and $y_i$ by
$c+dy_i$ leaves $r$ unchanged when $bd>0$ and changes its sign when $bd<0$.
\end{proposition}

\begin{proof}
\textbf{Step 1: the bound.} Put $u_i=x_i-\bar x$ and $v_i=y_i-\bar y$. By the
Cauchy--Schwarz inequality of the prerequisites,
$(\sum_iu_iv_i)^2\leqslant(\sum_iu_i^2)(\sum_iv_i^2)$, with equality iff the vectors
$(u_i)$ and $(v_i)$ are proportional. When neither variable is constant the right side
is positive, and dividing by it gives $r^2\leqslant1$.

\textbf{Step 2: the cases of equality.} Equality means $v_i=cu_i$ for every $i$ and some
$c\neq0$, that is $y_i-\bar y=c(x_i-\bar x)$: the points lie on the line through
$(\bar x,\bar y)$ of slope $c$, and then
$r=c\sum_iu_i^2\big/\sqrt{\sum_iu_i^2\cdot c^2\sum_iu_i^2}=c/|c|$, which is $1$ for
$c>0$ and $-1$ for $c<0$. Conversely, points on a line $y=\alpha+\beta x$ with
$\beta\neq0$ have $v_i=\beta u_i$, so equality holds.

\textbf{Step 3: invariance.} The transformed deviations are $bu_i$ and $dv_i$, so the
numerator of~\eqref{eq:corr} is multiplied by $bd$ and the denominator by $|b|\,|d|$;
the ratio is $r$ when $bd>0$ and $-r$ when $bd<0$.
\end{proof}

\begin{remark}[What $r$ measures; FREES §2.1]
$r$ is dimensionless and measures \emph{linear} association only. The five points
$(-2,4),(-1,1),(0,0),(1,1),(2,4)$ lie on $y=x^2$ and have $r=0$: with $\bar x=0$ and
$\bar y=2$, $\sum_ix_i(y_i-2)=(-2)(2)+(-1)(-1)+0+(1)(-1)+(2)(2)=0$.
\end{remark}

\begin{example}[Lottery sales, continued; FREES §2.1]\label{ex:lottery-r}
<<lottery-cor>>=
cor(lottery$POP, lottery$SALES)
@
Sales and population are strongly and positively correlated.
\end{example}

\begin{example}[Term life insurance; FREES §3.1]\label{ex:termlife}
The 2004 Survey of Consumer Finances: of $500$ households with positive income, the
$275$ that bought term life insurance, with the policy face amount \texttt{FACE}, annual
\texttt{INCOME}, years of \texttt{EDUCATION} of the respondent and the household size
\texttt{NUMHH}. Face amount and income are analysed in logarithms.
<<termlife>>=
term <- subset(read.csv("data/frees/csv/TermLife.csv"), FACE > 0)
term$LNFACE <- log(term$FACE); term$LNINCOME <- log(term$INCOME)
nrow(term)
round(t(sapply(term[, c("FACE", "INCOME", "EDUCATION", "NUMHH", "LNFACE", "LNINCOME")],
               descr)), 3)
round(cor(term[, c("NUMHH", "EDUCATION", "LNINCOME", "LNFACE")]), 3)
@
<<termlife-fig, fig.height=2.4, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 2), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(term$INCOME, term$FACE, xlab = "INCOME", ylab = "FACE", pch = 16, cex = 0.5)
plot(term$LNINCOME, term$LNFACE, xlab = "LNINCOME", ylab = "LNFACE", pch = 16, cex = 0.5)
par(op)
@
\begin{figure}[H]\centering
\caption{Face amount against income, in dollars and in logarithms (FREES Figure 3.1).}
\end{figure}
In dollars the points cluster in the lower left corner and the relation is far from
linear; in logarithms a line is a reasonable summary. The correlation matrix
summarises the pairwise scatter plots: each entry is a pairwise linear association and
cannot show how the response depends on several variables jointly.
\end{example}

\begin{example}[Advertising; ISLR §2.1, §3.1--3.2]\label{ex:advertising}
Sales of a product in thousands of units (\texttt{sales}) in $200$ markets, with the
advertising budgets in thousands of dollars for \texttt{TV}, \texttt{radio} and
\texttt{newspaper}. The file is distributed at the book's site and is not in
\texttt{ISLR2}.
<<advertising>>=
adv <- read.csv("data/islr/Advertising.csv")[, -1]
round(cor(adv), 4)
@
<<advertising-fig, fig.height=2.4, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 3), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
for (v in c("TV", "radio", "newspaper"))
  plot(adv[[v]], adv$sales, xlab = v, ylab = "sales", pch = 16, cex = 0.5)
par(op)
@
\begin{figure}[H]\centering
\caption{Sales against each advertising budget (ISLR Figure 2.1).}
\end{figure}
\end{example}

\subsection{The model and its assumptions}\label{sec:2.1.2}

\begin{definition}[Multiple linear regression model; FREES §3.2, ISLR §3.2]\label{def:model}
Given $n$ observations, each consisting of a response $Y_i$ and $k$ explanatory
variables $X_{i1},\ldots,X_{ik}$, the \emph{multiple linear regression model} is
\begin{equation}\label{eq:model-scalar}
Y_i = \beta_0 + \beta_1 X_{i1} + \beta_2 X_{i2} + \cdots + \beta_k X_{ik} + \varepsilon_i,
\qquad i = 1,\ldots,n,
\end{equation}
or in matrix form
\begin{equation}\label{eq:model-matrix}
\bY = \bX\bb + \be ,
\end{equation}
\[
\bY = \begin{pmatrix} Y_1 \\ \vdots \\ Y_n \end{pmatrix}, \quad
\bX = \begin{pmatrix} 1 & X_{11} & \cdots & X_{1k} \\
                      \vdots & \vdots & \ddots & \vdots \\
                      1 & X_{n1} & \cdots & X_{nk} \end{pmatrix}, \quad
\bb = \begin{pmatrix} \beta_0 \\ \beta_1 \\ \vdots \\ \beta_k \end{pmatrix}, \quad
\be = \begin{pmatrix} \varepsilon_1 \\ \vdots \\ \varepsilon_n \end{pmatrix}.
\]
$\bX$ is the $n\times(k+1)$ \emph{design matrix}, whose first column $\bone$ carries the
intercept; $\bx_i'$ is its $i$-th row, so $Y_i=\bx_i'\bb+\varepsilon_i$. The
\emph{regression function} is $\expc[Y\mid X_1,\ldots,X_k]=\beta_0+\beta_1X_1+\cdots+\beta_kX_k$,
linear in the parameters.
\end{definition}

\begin{remark}[Counts and notation; FREES §3.1, ISLR §3.2]
$k$ is the number of explanatory variables, $k+1$ the number of parameters and of columns
of $\bX$, and $n-k-1$ the residual degrees of freedom. FREES writes $k$ and $\mathbf b$
for the estimate of $\bb$; ISLR writes $p$ for $k$ and $\hat\beta$; the SOA questions
use both. The case $k=1$, $\bX=[\bone\ \bx]$, is FREES's \emph{basic} and ISLR's
\emph{simple} linear regression, and fitting~\eqref{eq:model-matrix} is called
\emph{regressing $Y$ on $X_1,\ldots,X_k$}.
\end{remark}

\begin{definition}[Classical assumptions; FREES §2.2, §3.2.3, ISLR §3.1.2]\label{def:assumptions}
On model~\eqref{eq:model-matrix}:
\begin{enumerate}[label=\textup{(A\arabic*)}]
\item\Atarget{1} \emph{Linearity}: $\expc[\bY\mid\bX] = \bX\bb$.
\item\Atarget{2} \emph{Zero conditional mean}: $\expc[\be\mid\bX] = \bzero$.
\item\Atarget{3} \emph{Spherical errors}: $\var(\be\mid\bX) = \sigma^2\bI_n$, that is
      $\var(\varepsilon_i)=\sigma^2$ for every $i$ (\emph{homoscedasticity}) and
      $\cov(\varepsilon_i,\varepsilon_j)=0$ for $i\neq j$.
\item\Atarget{4} \emph{Full rank}: $\rank(\bX)=k+1$, which requires $n\geqslant k+1$;
      inference requires $n>k+1$.
\item\Atarget{5} \emph{Normality}: $\be\mid\bX \sim N(\bzero,\sigma^2\bI_n)$.
\end{enumerate}
\Aref{1}--\Aref{4} are the \emph{Gauss--Markov assumptions}; \Aref{5} is used only for
exact finite-sample distributions. $\bX$ is treated as fixed, and every expectation,
variance and distribution is conditional on it, with the conditioning suppressed.
\end{definition}

\begin{remark}[FREES's two representations; FREES §2.2, §3.2.3]
FREES states the model through \emph{observables} assumptions F1--F5, namely
$\expc[y_i]=\bx_i'\bb$, nonstochastic $x_{ij}$, $\var(y_i)=\sigma^2$, independent $y_i$,
normal $y_i$, or through \emph{error} assumptions E1--E5 on
$\varepsilon_i=y_i-\bx_i'\bb$. The two sets are equivalent, and
\Aref{1}--\Aref{3} and \Aref{5} are their matrix form with independence weakened to
zero covariance, which is all the proofs use; \Aref{4} is FREES's requirement that the
explanatory variables are not linear combinations of one another. Nonstochastic $x$'s
are motivated by stratified sampling: at each value of $\bx_i$ a response is drawn from
the population at that value, so $\bX$ is fixed and the responses are independent. Since
$\bY=\bX\bb+\be$, \Aref{1} and \Aref{2} are the same statement.
\end{remark}

\begin{remark}[Interpretation of the coefficients; FREES §3.2.1, ISLR §3.1.2, §3.2.1]
$\beta_0=\expc[Y\mid X_1=\cdots=X_k=0]$ sets the height of the plane and is rarely of
interest. For $j\geqslant1$,
$\beta_j=\partial\,\expc[Y\mid X_1,\ldots,X_k]/\partial X_j$ is the expected change in
$Y$ per unit change in $X_j$ with the other explanatory variables held fixed; ISLR's
phrase is the average effect on $Y$ of a one-unit increase in $X_j$, holding all other
predictors fixed. For $k=1$ the equation $Y=\beta_0+\beta_1X+\varepsilon$ is the
\emph{population regression line}, and $\varepsilon$ collects what the line misses:
curvature, omitted variables and measurement error.
\end{remark}

%==============================================================================
\section{Least Squares}\label{sec:2.2}
%==============================================================================

\begin{reading}
FREES §2.1, §3.1, §3.2.2 · ISLR §3.1.1, §3.2.1 · CLM §2. \ SRM learning outcomes 2(a),
2(c).
\end{reading}

\subsection{The normal equations}\label{sec:2.2.1}

\begin{definition}[Least squares; FREES §2.1, §3.1, ISLR §3.1.1]\label{def:ols}
The \emph{least squares estimator} $\hat\bb$ minimises the \emph{residual sum of squares}
\begin{equation}\label{eq:sse-obj}
Q(\bb^\ast)=\sum_{i=1}^n(Y_i-\bx_i'\bb^\ast)^2
=(\bY-\bX\bb^\ast)'(\bY-\bX\bb^\ast)=\|\bY-\bX\bb^\ast\|^2
\end{equation}
over $\bb^\ast\in\Real^{k+1}$. The \emph{fitted values} are $\hat Y_i=\bx_i'\hat\bb$,
the \emph{residuals} $e_i=Y_i-\hat Y_i$, and
$\hat y=\hat\beta_0+\hat\beta_1x_1+\cdots+\hat\beta_kx_k$ is the \emph{fitted regression
plane}, a line when $k=1$.
\end{definition}

\begin{theorem}[The least squares estimator]\label{thm:ols}
Under \Aref{4} the minimiser of~\eqref{eq:sse-obj} is unique and equals
\begin{equation}\label{eq:ols}
\hat\bb=(\bX'\bX)^{-1}\bX'\bY .
\end{equation}
\end{theorem}

\begin{proof}
\textbf{Step 1: expand.} The scalar $\bY'\bX\bb$ equals its transpose $\bb'\bX'\bY$, so
\begin{equation}\label{eq:sse-expand}
Q(\bb)=\bY'\bY-\bY'\bX\bb-\bb'\bX'\bY+\bb'\bX'\bX\bb
=\bY'\bY-2\bb'\bX'\bY+\bb'\bX'\bX\bb .
\end{equation}

\textbf{Step 2: differentiate.} By the two rules of matrix differentiation of the
prerequisites, $\partial(\ba'\bb)/\partial\bb'=\ba'$ and
$\partial(\bb'\bA\bb)/\partial\bb'=2\bb'\bA$ for symmetric $\bA$, applied with
$\ba=\bX'\bY$ and $\bA=\bX'\bX$,
\[
\frac{\partial Q}{\partial\bb'}=-2\bY'\bX+2\bb'\bX'\bX .
\]
Setting this to $\bzero'$ and transposing gives the \emph{normal equations}
\begin{equation}\label{eq:normal-eq}
\bX'\bX\hat\bb=\bX'\bY .
\end{equation}
Row $j$ of~\eqref{eq:normal-eq} is $\sum_ix_{ij}(Y_i-\bx_i'\hat\bb)=0$, which is
$\partial Q/\partial\beta_j=0$; for $k=1$ the two rows are
$\sum_i(Y_i-b_0-b_1x_i)=0$ and $\sum_ix_i(Y_i-b_0-b_1x_i)=0$.

\textbf{Step 3: $\bX'\bX$ is invertible.} $\bX'\bX$ and $\bX$ have the same null space:
$\bX\bv=\bzero$ gives $\bX'\bX\bv=\bzero$, and $\bX'\bX\bv=\bzero$ gives
$\bv'\bX'\bX\bv=\|\bX\bv\|^2=0$, hence $\bX\bv=\bzero$. Both matrices have $k+1$
columns, so by the rank--nullity theorem of the prerequisites they have the same rank,
which is $k+1$ under \Aref{4}. The square matrix $\bX'\bX$ is therefore invertible
and~\eqref{eq:normal-eq} has the unique solution~\eqref{eq:ols}.

\textbf{Step 4: it is the minimum.} For any $\bb$ put $\bd=\bb-\hat\bb$. Expanding
$Q(\bb)=\|(\bY-\bX\hat\bb)-\bX\bd\|^2$ and using $\bX'(\bY-\bX\hat\bb)=\bzero$, which
is~\eqref{eq:normal-eq} rearranged,
\[
Q(\bb)=Q(\hat\bb)-2\bd'\bX'(\bY-\bX\hat\bb)+\bd'\bX'\bX\bd
=Q(\hat\bb)+\|\bX\bd\|^2\geqslant Q(\hat\bb),
\]
with equality iff $\bX\bd=\bzero$, that is iff $\bd=\bzero$ by \Aref{4}. So
$\hat\bb$ is the unique global minimiser.
\end{proof}

\begin{remark}[Without full rank; FREES §3.1]
Only Step 3 uses \Aref{4}. If one column of $\bX$ is a linear combination of the
others, $\bX'\bX$ is singular, the normal equations have infinitely many solutions, all
with the same fitted vector by Step 4, and R reports \texttt{NA} for the redundant
coefficients.
\end{remark}

\subsection{Orthogonal projection}\label{sec:2.2.2}

\begin{theorem}[Least squares as projection]\label{thm:ols-proj}
$\hat\bY=\bX\hat\bb$ is the orthogonal projection of $\bY$ onto the column space
$\calC(\bX)$: it is the unique point of $\calC(\bX)$ closest to $\bY$, and
$\bY-\hat\bY\perp\calC(\bX)$.
\end{theorem}

\begin{proof}
Minimising $\|\bY-\bX\bb\|^2$ over $\bb$ is finding the point of $\calC(\bX)$ closest
to $\bY$.

\textbf{Step 1: closest iff orthogonal residual.} A point $\hat\bY\in\calC(\bX)$
minimises $\|\bY-\tilde\bY\|^2$ over $\tilde\bY\in\calC(\bX)$ iff
$\bY-\hat\bY\perp\calC(\bX)$.
($\Leftarrow$) For $\tilde\bY\in\calC(\bX)$, $\hat\bY-\tilde\bY\in\calC(\bX)$, so
$(\bY-\hat\bY)\perp(\hat\bY-\tilde\bY)$ and Pythagoras gives
\[
\|\bY-\tilde\bY\|^2=\|\bY-\hat\bY\|^2+\|\hat\bY-\tilde\bY\|^2\geqslant\|\bY-\hat\bY\|^2,
\]
with equality iff $\tilde\bY=\hat\bY$.
($\Rightarrow$) If some unit vector $\bv\in\calC(\bX)$ had $\bv'(\bY-\hat\bY)\neq0$,
then $\tilde\bY=\hat\bY+t\bv\in\calC(\bX)$ gives
$\|\bY-\tilde\bY\|^2=\|\bY-\hat\bY\|^2-2t\,\bv'(\bY-\hat\bY)+t^2$, strictly smaller at
$t=\bv'(\bY-\hat\bY)$, contradicting optimality.

\textbf{Step 2: the orthogonality condition is the normal equations.} $\bY-\hat\bY$ is
orthogonal to $\calC(\bX)$ iff it is orthogonal to each column of $\bX$, that is
$\bX'(\bY-\hat\bY)=\bzero$; with $\hat\bY=\bX\hat\bb$ this is~\eqref{eq:normal-eq},
whose solution Theorem~\ref{thm:ols} gives. Uniqueness of the closest point is the
equality case of Step 1.
\end{proof}

\begin{definition}[Hat matrix and residual maker; CLM §2]\label{def:hat-matrix}
\begin{equation}\label{eq:hat}
\bH = \bX(\bX'\bX)^{-1}\bX', \qquad \bM = \bI_n - \bH ,
\end{equation}
so that $\hat\bY = \bH\bY$ and $\mathbf{e} = \bM\bY$.
\end{definition}

\begin{theorem}[Properties of $\bH$ and $\bM$]\label{thm:HM}
\leavevmode
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{HM:i}   $\bH$ and $\bM$ are symmetric and idempotent.
\item\label{HM:ii}  $\bH\bX = \bX$ and $\bM\bX = \bzero$.
\item\label{HM:iii} $\bH\bM = \bM\bH = \bzero$.
\item\label{HM:iv}  $\tr(\bH) = k+1$ and $\tr(\bM) = n-k-1$.
\end{enumerate}
\end{theorem}

\begin{proof}
\textbf{(i)} $(\bX'\bX)^{-1}$ is symmetric, being the inverse of a symmetric matrix, so
\[
\bH'=\bX[(\bX'\bX)^{-1}]'\bX'=\bH ,\qquad
\bH^2=\bX(\bX'\bX)^{-1}\underbrace{\bX'\bX(\bX'\bX)^{-1}}_{\bI_{k+1}}\bX'=\bH .
\]
Then $\bM'=\bI-\bH'=\bM$ and $\bM^2=\bI-2\bH+\bH^2=\bI-\bH=\bM$.

\textbf{(ii)} $\bH\bX=\bX(\bX'\bX)^{-1}\bX'\bX=\bX$, hence $\bM\bX=\bX-\bX=\bzero$.

\textbf{(iii)} $\bH\bM=\bH-\bH^2=\bzero$, and $\bM\bH=\bH-\bH^2=\bzero$.

\textbf{(iv)} By the prerequisites' lemma \emph{trace equals rank} for idempotent
matrices, $\tr(\bH)=\rank(\bH)$. Now $\calC(\bH)=\calC(\bX)$: every column of $\bH$ is
$\bX$ times a vector, and $\bH\bX=\bX$ from~\ref{HM:ii} puts every column of $\bX$ in
$\calC(\bH)$. By \Aref{4}, $\dim\calC(\bX)=k+1$, so $\tr(\bH)=k+1$ and
$\tr(\bM)=\tr(\bI_n)-\tr(\bH)=n-k-1$.
\end{proof}

\begin{remark}
$\bH$ is symmetric, idempotent, with $\calC(\bH)=\calC(\bX)$; by the prerequisites'
proposition \emph{projections are the symmetric idempotents}, $\bH$ is the orthogonal
projection onto $\calC(\bX)$, so Theorem~\ref{thm:ols-proj} and
Definition~\ref{def:hat-matrix} describe one object, and $\bM$ is the projection onto
$\calC(\bX)^{\perp}$, of dimension $n-k-1$.
\end{remark}

\begin{lemma}[The intercept projection]\label{lem:HH0}
Let $\bH_0=\tfrac1n\bone\bone'$ and suppose $\bone\in\calC(\bX)$. Then
$\bH\bH_0=\bH_0\bH=\bH_0$; $\bH-\bH_0$ is symmetric idempotent with
$\tr(\bH-\bH_0)=k$, and is the orthogonal projection onto $\calC(\bX)\cap\bone^\perp$;
and $(\bH-\bH_0)\bM=\bzero$.
\end{lemma}

\begin{proof}
$\bH_0$ is symmetric, and $\bH_0^2=\tfrac1{n^2}\bone(\bone'\bone)\bone'=\bH_0$ since
$\bone'\bone=n$; so $\bH_0$ is the projection onto $\calC(\bone)$. Since $\bH$ projects
onto $\calC(\bX)\ni\bone$, $\bH\bone=\bone$ and
$\bH\bH_0=\tfrac1n(\bH\bone)\bone'=\bH_0$; transposing, $\bH_0\bH=\bH_0$. Hence
$\bH-\bH_0$ is symmetric and
\[
(\bH-\bH_0)^2=\bH-\bH\bH_0-\bH_0\bH+\bH_0^2=\bH-\bH_0-\bH_0+\bH_0=\bH-\bH_0 ,
\]
with $\tr(\bH-\bH_0)=\tr(\bH)-\tr(\bH_0)=(k+1)-1=k$ by
Theorem~\ref{thm:HM}\ref{HM:iv} and $\tr(\bH_0)=\tfrac1n\tr(\bone\bone')=1$. Its column
space: $(\bH-\bH_0)\bv=\bH\bv-\bH_0\bv$ lies in $\calC(\bX)$, and
$\bone'(\bH-\bH_0)\bv=\bone'\bH\bv-\bone'\bH_0\bv=\bone'\bv-\bone'\bv=0$ using
$\bone'\bH=(\bH\bone)'=\bone'$ and $\bone'\bH_0=\bone'$; conversely a vector
$\bu\in\calC(\bX)$ with $\bone'\bu=0$ has $(\bH-\bH_0)\bu=\bu-\bzero=\bu$. So
$\bH-\bH_0$ is the symmetric idempotent with column space $\calC(\bX)\cap\bone^\perp$.
Finally $(\bH-\bH_0)\bM=\bH\bM-\bH_0\bH\bM=\bzero$ by
Theorem~\ref{thm:HM}\ref{HM:iii} and $\bH_0=\bH_0\bH$.
\end{proof}

\subsection{Residuals and leverage}\label{sec:2.2.3}

\begin{theorem}[Residual identities]\label{thm:normal-eq}
The least squares residuals satisfy
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{ne:i}   $\bX'\mathbf{e} = \bzero$;
\item\label{ne:ii}  $\sum_i e_i = 0$ and $\overline{\hat Y}=\bar Y$, provided the model
      contains an intercept;
\item\label{ne:iii} $\hat\bY'\mathbf{e} = 0$.
\end{enumerate}
\end{theorem}

\begin{proof}
\textbf{(i)} Rearranging~\eqref{eq:normal-eq}, $\bX'(\bY-\bX\hat\bb)=\bzero$.
\textbf{(ii)} The first column of $\bX$ is $\bone$, so the first component of
$\bX'\mathbf e=\bzero$ is $\bone'\mathbf e=\sum_ie_i=0$; then
$\bone'\hat\bY=\bone'(\bY-\mathbf e)=\bone'\bY$, and dividing by $n$ gives
$\overline{\hat Y}=\bar Y$.
\textbf{(iii)} $\hat\bY'\mathbf e=\hat\bb'\bX'\mathbf e=0$ by (i).
\end{proof}

\begin{remark}[Errors versus residuals; FREES §2.3.2, §3.3]
The \emph{error} $\varepsilon_i=Y_i-\bx_i'\bb$ is unobservable; the \emph{residual}
$e_i=Y_i-\bx_i'\hat\bb$ is observable. Since $\bM\bX=\bzero$,
\begin{equation}\label{eq:e-Me}
\mathbf e=\bM\bY=\bM(\bX\bb+\be)=\bM\be ,
\end{equation}
a linear map of rank $n-k-1$ of the errors: the residuals satisfy the $k+1$
constraints~\ref{ne:i} whatever the data, and FREES's phrase is that only $n-(k+1)$ of
them are free. The identities hold for every fit, so a residual mean of zero is not
evidence that the model is right.
\end{remark}

\begin{definition}[Leverage; ISLR §3.3.3]\label{def:leverage}
The \emph{leverage} of observation $i$ is $h_{ii}$, the $i$-th diagonal entry of $\bH$,
so that $\hat Y_i=\sum_jh_{ij}Y_j$ and $h_{ii}=\partial\hat Y_i/\partial Y_i$.
\end{definition}

\begin{theorem}[Properties of leverage]\label{thm:leverage}
\leavevmode
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{lev:i}  $0\leqslant h_{ii}\leqslant1$, and $h_{ii}=1$ forces $h_{ij}=0$ for
      $j\neq i$ and $e_i=0$;
\item\label{lev:ii} $\sum_{i=1}^n h_{ii}=k+1$, so the mean leverage is $(k+1)/n$;
\item\label{lev:iii} with an intercept, $h_{ii}\geqslant1/n$, and for $k=1$
\begin{equation}\label{eq:lev-k1}
h_{ii}=\frac1n+\frac{(x_i-\bar x)^2}{\sum_j(x_j-\bar x)^2} .
\end{equation}
\end{enumerate}
\end{theorem}

\begin{proof}
\textbf{(i)} $\bH=\bH'\bH$ by Theorem~\ref{thm:HM}\ref{HM:i}; comparing $(i,i)$ entries
with $h_{ji}=h_{ij}$,
\[
h_{ii}=\sum_{j=1}^nh_{ij}^2=h_{ii}^2+\sum_{j\neq i}h_{ij}^2 .
\]
The left equality gives $h_{ii}\geqslant0$; dropping the sum gives
$h_{ii}\geqslant h_{ii}^2$, hence $h_{ii}\leqslant1$. At $h_{ii}=1$ the sum
$\sum_{j\neq i}h_{ij}^2$ must vanish, so $\hat Y_i=\sum_jh_{ij}Y_j=Y_i$ and $e_i=0$.

\textbf{(ii)} $\sum_ih_{ii}=\tr(\bH)=k+1$ by Theorem~\ref{thm:HM}\ref{HM:iv}.

\textbf{(iii)} With $\mathbf u_i$ the $i$-th coordinate vector and $\bH_0=\tfrac1n\bone\bone'$,
whose diagonal entries are $1/n$, Lemma~\ref{lem:HH0} gives
$h_{ii}-1/n=\mathbf u_i'(\bH-\bH_0)\mathbf u_i=\|(\bH-\bH_0)\mathbf u_i\|^2\geqslant0$.
For $k=1$, $\bX=[\bone\ \bx]$ and, with $S_{xx}=\sum_j(x_j-\bar x)^2$,
\[
\bX'\bX=\begin{pmatrix} n & n\bar x\\ n\bar x & \sum_jx_j^2\end{pmatrix},\qquad
(\bX'\bX)^{-1}=\frac{1}{nS_{xx}}\begin{pmatrix}\sum_jx_j^2 & -n\bar x\\ -n\bar x & n\end{pmatrix},
\]
the determinant being $n\sum_jx_j^2-n^2\bar x^2=nS_{xx}$. Then with $\bx_i'=(1,x_i)$,
\[
h_{ii}=\bx_i'(\bX'\bX)^{-1}\bx_i
=\frac{\sum_jx_j^2-2n\bar xx_i+nx_i^2}{nS_{xx}}
=\frac{S_{xx}+n(x_i-\bar x)^2}{nS_{xx}}
=\frac1n+\frac{(x_i-\bar x)^2}{S_{xx}},
\]
using $\sum_jx_j^2=S_{xx}+n\bar x^2$.
\end{proof}

\begin{remark}[ISLR §3.3.3]
$h_{ii}$ depends on $\bX$ alone and measures how far $\bx_i$ lies from the centre of
the design: with one explanatory variable it is a quadratic in $x_i-\bar x$ with minimum
$1/n$. The conventional flag is $h_{ii}>2(k+1)/n$, twice the mean.
\end{remark}

\subsection{The case \texorpdfstring{$k=1$}{k=1}}\label{sec:2.2.4}

\begin{corollary}[The fitted line; FREES §2.1, ISLR §3.1.1]\label{cor:slr-ls}
With one explanatory variable and an intercept, and $x_1,\ldots,x_n$ not all equal,
\begin{equation}\label{eq:slr-ls}
b_1=\frac{\sum_i(x_i-\bar x)(y_i-\bar y)}{\sum_i(x_i-\bar x)^2}
=\frac{\sum_ix_iy_i-n\bar x\bar y}{\sum_ix_i^2-n\bar x^2}
=r\,\frac{s_y}{s_x},
\qquad b_0=\bar y-b_1\bar x ,
\end{equation}
so the fitted line $\hat y=b_0+b_1x$ passes through $(\bar x,\bar y)$ and
$\hat y_i-\bar y=b_1(x_i-\bar x)$.
\end{corollary}

\begin{proof}
With $\bX=[\bone\ \bx]$ the normal equations~\eqref{eq:normal-eq} are
\[
\begin{pmatrix} n & \sum_ix_i\\ \sum_ix_i & \sum_ix_i^2\end{pmatrix}
\begin{pmatrix} b_0\\ b_1\end{pmatrix}
=\begin{pmatrix}\sum_iy_i\\ \sum_ix_iy_i\end{pmatrix}.
\]
The first row is $nb_0+b_1\sum_ix_i=\sum_iy_i$, that is $b_0=\bar y-b_1\bar x$.
Substituting into the second row,
$\sum_ix_iy_i=(\bar y-b_1\bar x)n\bar x+b_1\sum_ix_i^2$, so
$b_1(\sum_ix_i^2-n\bar x^2)=\sum_ix_iy_i-n\bar x\bar y$, the middle form
of~\eqref{eq:slr-ls}. The identities
$\sum_i(x_i-\bar x)^2=\sum_ix_i^2-2\bar x\sum_ix_i+n\bar x^2=\sum_ix_i^2-n\bar x^2$ and
$\sum_i(x_i-\bar x)(y_i-\bar y)=\sum_ix_iy_i-\bar y\sum_ix_i-\bar x\sum_iy_i+n\bar x\bar y
=\sum_ix_iy_i-n\bar x\bar y$ give the first form, and dividing numerator and denominator
by $n-1$ gives $b_1=\{(n-1)s_xs_yr\}/\{(n-1)s_x^2\}=r\,s_y/s_x$. Finally
$\hat y_i-\bar y=b_0+b_1x_i-\bar y=b_1(x_i-\bar x)$.
\end{proof}

\begin{corollary}[Regression through the origin; FREES exercise 2.7, ISLR §3.7]\label{cor:origin}
For the model $y_i=\beta x_i+\varepsilon_i$ without an intercept, the least squares
estimate is $\hat\beta=\sum_ix_iy_i/\sum_ix_i^2$ and $\hat y_i=x_i\hat\beta$.
\end{corollary}

\begin{proof}
Here $\bX=\bx$, so $\bX'\bX=\sum_ix_i^2$, a positive scalar when some $x_i\neq0$, and
$\bX'\bY=\sum_ix_iy_i$; Theorem~\ref{thm:ols} gives the ratio.
\end{proof}

\begin{example}[Lottery sales, continued; FREES §2.1]\label{ex:lottery-fit}
From Example~\ref{ex:lottery-r} and the summary statistics,
$b_1=r\,s_y/s_x=0.886(8103)/11{,}098=0.647$ and
$b_0=\bar y-b_1\bar x=6495-0.647(9311)=470$: the fitted line is
$\widehat{\texttt{SALES}}=470+0.647\,\texttt{POP}$, and at a population of $10{,}000$
it gives $470+6470=6940$ dollars of sales.
<<lottery-fit>>=
r <- cor(lottery$POP, lottery$SALES)
b1 <- r * sd(lottery$SALES) / sd(lottery$POP)
b0 <- mean(lottery$SALES) - b1 * mean(lottery$POP)
fit_lot <- lm(SALES ~ POP, data = lottery)
rbind(formula = c(b0 = b0, b1 = b1), lm = coef(fit_lot))
c(at_10000 = b0 + b1 * 10000, predict = unname(predict(fit_lot, data.frame(POP = 10000))))
@
\end{example}

\begin{example}[Advertising, continued; ISLR §3.1.1]\label{ex:adv-tv}
Regressing \texttt{sales} on \texttt{TV} gives $\hat\beta_0=7.03$ and
$\hat\beta_1=0.0475$: an additional $\$1{,}000$ of television advertising is associated
with about $47.5$ additional units sold.
<<adv-tv>>=
fit_tv <- lm(sales ~ TV, data = adv)
coef(fit_tv)
@
<<adv-tv-fig, fig.height=2.6, fig.width=6.4, out.width="0.6\\linewidth", echo=FALSE>>=
op <- par(mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(adv$TV, adv$sales, xlab = "TV", ylab = "sales", pch = 16, cex = 0.5)
abline(fit_tv, lwd = 2)
segments(adv$TV, adv$sales, adv$TV, fitted(fit_tv), col = "grey60")
par(op)
@
\begin{figure}[H]\centering
\caption{The least squares line for sales on television advertising; each grey segment
is a residual (ISLR Figure 3.1).}
\end{figure}
\end{example}

\begin{example}[Term life insurance, continued; FREES §3.1--3.2]\label{ex:termlife-fit}
The regression of \texttt{LNFACE} on \texttt{EDUCATION}, \texttt{NUMHH} and
\texttt{LNINCOME} has $n=275$ and $k=3$; the first rows of $\bX$ and $\bY$ and the fitted
plane $\hat y=2.584+0.206x_1+0.306x_2+0.494x_3$:
<<termlife-fit>>=
fit_term <- lm(LNFACE ~ EDUCATION + NUMHH + LNINCOME, data = term)
X_term <- model.matrix(fit_term)
round(cbind(X_term, LNFACE = term$LNFACE)[c(1, 2, 275), ], 3)
round(coef(fit_term), 3)
@
The three slopes are positive: with income and education fixed, a larger household
demands more insurance; with household size and education fixed, a household with more
income buys more; more education, other things equal, goes with more insurance.
\end{example}

\begin{remark}[Reading a coefficient on a logarithmic scale; FREES §3.2.2]
With $y$ in logarithms, $\partial\ln y/\partial x=(\partial y/\partial x)/y$: a small
change in $\ln y$ is a small proportional change in $y$, and a change of $\delta$ in
$x_j$ changes $y$ by a factor $e^{\beta_j\delta}\approx1+\beta_j\delta$. With $x_j$ also
in logarithms, $\beta_j=\partial\ln y/\partial\ln x_j=(\partial y/y)/(\partial x_j/x_j)$
is the ratio of the percentage changes, an \emph{elasticity}. Natural logarithms are
used because these identities need them.
\end{remark}

\begin{example}[Term life insurance, continued; FREES §3.2.2]\label{ex:termlife-interp}
Holding \texttt{NUMHH} and \texttt{LNINCOME} at their sample means and moving
\texttt{EDUCATION} in steps of $0.1$ year raises $\widehat{\texttt{LNFACE}}$ by a
constant $0.0206$ per step, and the fitted face amount by a constant $2.08\%$ per step;
the continuous version is $0.206\times0.1=2.06\%$. Moving \texttt{LNINCOME} in steps of
$0.1$ raises income by $10.52\%$ per step and the fitted face amount by $5.06\%$, a
ratio of $0.481$ against the coefficient $0.494$.
<<termlife-interp>>=
b <- coef(fit_term); mN <- mean(term$NUMHH); mL <- mean(term$LNINCOME)
ed <- c(14, 14.1, 14.2, 14.3)
lnface_ed <- b[1] + b[2] * ed + b[3] * mN + b[4] * mL
round(rbind(EDUCATION = ed, LNFACE = lnface_ed, FACE = exp(lnface_ed),
            pct_change = c(NA, 100 * diff(exp(lnface_ed)) / exp(lnface_ed)[-4])), 3)
li <- c(11, 11.1, 11.2, 11.3)
lnface_li <- b[1] + b[2] * mean(term$EDUCATION) + b[3] * mN + b[4] * li
inc_pct <- 100 * diff(exp(li)) / exp(li)[-4]
face_pct <- 100 * diff(exp(lnface_li)) / exp(lnface_li)[-4]
round(rbind(LNINCOME = li, INCOME_pct = c(NA, inc_pct), FACE_pct = c(NA, face_pct),
            ratio = c(NA, face_pct / inc_pct)), 3)
@
So, holding household size and education fixed, a $1\%$ increase in income is associated
with about a $0.48\%$ increase in the face amount.
\end{example}

\begin{example}[Simple against multiple regression; ISLR §3.2.1]\label{ex:adv-newspaper}
Regressed alone on \texttt{newspaper}, sales rise by $0.055$ thousand units per thousand
dollars; with \texttt{TV} and \texttt{radio} in the same model the coefficient is
$-0.001$.
<<adv-newspaper>>=
fit_all <- lm(sales ~ TV + radio + newspaper, data = adv)
rbind(alone    = coef(lm(sales ~ newspaper, data = adv))["newspaper"],
      together = coef(fit_all)["newspaper"])
round(coef(fit_all), 4)
@
The simple coefficient measures the association ignoring the other media; the multiple
coefficient measures it with \texttt{TV} and \texttt{radio} held fixed. The two differ
because \texttt{newspaper} and \texttt{radio} spending are correlated ($0.35$ in
Example~\ref{ex:advertising}): markets that spend on radio, which does raise sales, also
spend on newspapers, so newspaper spending stands in for radio spending when radio is
left out. ISLR's illustration is a regression of shark attacks on ice cream sales, which
is positive until temperature is added.
\end{example}

%==============================================================================
\section{Sampling Properties of Least Squares}\label{sec:2.3}
%==============================================================================

\begin{reading}
FREES §2.3.2, §2.4, §3.2.4, §3.3 · ISLR §3.1.2 · CLM §3. \ SRM learning outcome 2(a).
\end{reading}

\begin{definition}[Sums of squares, mean squares and the residual standard deviation; FREES §2.3, §3.3, ISLR §3.1.3]\label{def:sumsq}
For the fitted model $\hat\bY=\bX\hat\bb$,
\[
\SST=\sum_i(Y_i-\bar Y)^2,\qquad
\SSR=\sum_i(\hat Y_i-\bar Y)^2,\qquad
\SSE=\sum_i(Y_i-\hat Y_i)^2=\mathbf e'\mathbf e ,
\]
\[
\MSE=s^2=\frac{\SSE}{n-k-1},\qquad \MSR=\frac{\SSR}{k}.
\]
$s$ is the \emph{residual standard deviation} (FREES) or \emph{residual standard error},
RSE (ISLR). FREES writes \emph{Total SS}, \emph{Regression SS} and \emph{Error SS};
ISLR writes $\TSS$ and $\RSS$ for $\SST$ and $\SSE$; the SOA questions use both.
\end{definition}

\begin{proposition}[Coefficients are weighted sums of the responses; FREES §2.4, §3.2.4]\label{prop:weights}
$\hat\bb=\bW\bY$ with $\bW=(\bX'\bX)^{-1}\bX'$ fixed by the design, so each
$\hat\beta_j=\sum_iw_{ji}Y_i$. For $k=1$,
\begin{equation}\label{eq:weights}
b_1=\sum_{i=1}^nw_iY_i,\qquad w_i=\frac{x_i-\bar x}{(n-1)s_x^2},\qquad
\sum_iw_i=0,\quad \sum_iw_ix_i=1,\quad \sum_iw_i^2=\frac{1}{(n-1)s_x^2}.
\end{equation}
\end{proposition}

\begin{proof}
The first statement is~\eqref{eq:ols}. For $k=1$, Corollary~\ref{cor:slr-ls} gives
$b_1=\sum_i(x_i-\bar x)(Y_i-\bar Y)/\{(n-1)s_x^2\}=\sum_iw_i(Y_i-\bar Y)
=\sum_iw_iY_i-\bar Y\sum_iw_i$, and $\sum_iw_i=\sum_i(x_i-\bar x)/\{(n-1)s_x^2\}=0$.
Next $\sum_iw_ix_i=\sum_i(x_i-\bar x)x_i/\{(n-1)s_x^2\}$, and
$\sum_i(x_i-\bar x)x_i=\sum_i(x_i-\bar x)^2+\bar x\sum_i(x_i-\bar x)=(n-1)s_x^2$, so
the sum is $1$. Finally
$\sum_iw_i^2=\sum_i(x_i-\bar x)^2/\{(n-1)s_x^2\}^2=1/\{(n-1)s_x^2\}$.
\end{proof}

\subsection{Unbiasedness and variance}\label{sec:2.3.1}

\begin{theorem}[Unbiasedness]\label{thm:unbiased}
Under \Aref{1}--\Aref{2} and \Aref{4}, $\expc[\hat\bb]=\bb$.
\end{theorem}

\begin{proof}
Substituting $\bY=\bX\bb+\be$ into~\eqref{eq:ols},
\begin{equation}\label{eq:beta-decomp}
\hat\bb=(\bX'\bX)^{-1}\bX'\bX\bb+(\bX'\bX)^{-1}\bX'\be=\bb+(\bX'\bX)^{-1}\bX'\be ,
\end{equation}
and $\expc[\be]=\bzero$ by \Aref{2}, so $\expc[\hat\bb]=\bb+(\bX'\bX)^{-1}\bX'\bzero=\bb$.
\end{proof}

\begin{theorem}[Variance--covariance matrix]\label{thm:var-beta}
Under \Aref{1}--\Aref{4}, $\var(\hat\bb)=\sigma^2(\bX'\bX)^{-1}$; in particular
$\var(\hat\beta_j)=\sigma^2[(\bX'\bX)^{-1}]_{jj}$ and
$\cov(\hat\beta_i,\hat\beta_j)=\sigma^2[(\bX'\bX)^{-1}]_{ij}$.
\end{theorem}

\begin{proof}
By \Aref{3}, $\var(\bY)=\var(\be)=\sigma^2\bI_n$. By~\eqref{eq:beta-decomp} and the
prerequisites' proposition \emph{variance under a linear map},
$\var(\bA\bz)=\bA\var(\bz)\bA'$, with $\bA=(\bX'\bX)^{-1}\bX'$,
\[
\var(\hat\bb)=(\bX'\bX)^{-1}\bX'(\sigma^2\bI_n)\bX(\bX'\bX)^{-1}
=\sigma^2(\bX'\bX)^{-1}\bX'\bX(\bX'\bX)^{-1}=\sigma^2(\bX'\bX)^{-1}. \qedhere
\]
\end{proof}

\begin{corollary}[The case $k=1$; FREES §2.4, ISLR §3.1.2]\label{cor:slr-var}
With $S_{xx}=\sum_i(x_i-\bar x)^2=(n-1)s_x^2$,
\begin{equation}\label{eq:slr-var}
\var(b_1)=\frac{\sigma^2}{S_{xx}},\qquad
\var(b_0)=\sigma^2\Bigl(\frac1n+\frac{\bar x^2}{S_{xx}}\Bigr),\qquad
\cov(b_0,b_1)=-\frac{\sigma^2\bar x}{S_{xx}} .
\end{equation}
\end{corollary}

\begin{proof}
Reading $\sigma^2(\bX'\bX)^{-1}$ off the explicit inverse in the proof of
Theorem~\ref{thm:leverage}\ref{lev:iii}: the $(2,2)$ entry is $\sigma^2n/(nS_{xx})$, the
$(1,1)$ entry $\sigma^2\sum_ix_i^2/(nS_{xx})=\sigma^2(S_{xx}+n\bar x^2)/(nS_{xx})$, and the
off-diagonal entry $-\sigma^2n\bar x/(nS_{xx})$. FREES's route is
Proposition~\ref{prop:weights}: the $Y_i$ are uncorrelated with common variance, so
$\var(b_1)=\sum_iw_i^2\sigma^2=\sigma^2/\{(n-1)s_x^2\}$.
\end{proof}

\begin{remark}[The three determinants of precision; FREES §2.4, ISLR §3.1.2]
$\var(b_1)=\sigma^2/\{(n-1)s_x^2\}$ falls with more observations, with less scatter about
the line, and with more spread in the explanatory variable: doubling $s_x$ at fixed $n$
and $\sigma$ halves the standard deviation of the slope, which is what ISLR means by
more \emph{leverage} to estimate a slope. The spread of $x$ is a design choice.
$\var(b_0)$ reduces to $\sigma^2/n$, the variance of a sample mean, when $\bar x=0$, in
which case $b_0=\bar Y$.
\end{remark}

\subsection{The Gauss--Markov theorem}\label{sec:2.3.2}

\begin{theorem}[Gauss--Markov; FREES §3.2.4]\label{thm:gm}
Under \Aref{1}--\Aref{4}, $\hat\bb$ is the \emph{best linear unbiased estimator} of
$\bb$: for any estimator $\tilde\bb=\bC\bY$ with $\bC$ a constant matrix and
$\expc[\tilde\bb]=\bb$ for every $\bb$, the matrix $\var(\tilde\bb)-\var(\hat\bb)$ is
positive semi-definite, so $\var(\tilde\beta_j)\geqslant\var(\hat\beta_j)$ for every $j$,
and equality of the two variance matrices forces $\tilde\bb=\hat\bb$.
\end{theorem}

\begin{proof}
\textbf{Step 1: unbiasedness constrains $\bC$.}
$\expc[\tilde\bb]=\bC\expc[\bY]=\bC\bX\bb$, and this equals $\bb$ for every
$\bb\in\Real^{k+1}$ iff $\bC\bX=\bI_{k+1}$.

\textbf{Step 2: decompose $\bC$.} Write $\bC=(\bX'\bX)^{-1}\bX'+\bD$. Then
$\bD\bX=\bC\bX-(\bX'\bX)^{-1}\bX'\bX=\bI_{k+1}-\bI_{k+1}=\bzero$.

\textbf{Step 3: expand the variance.} By the prerequisites' \emph{variance under a
linear map} and \Aref{3}, $\var(\tilde\bb)=\bC(\sigma^2\bI)\bC'=\sigma^2\bC\bC'$, and
\begin{align*}
\bC\bC' &= \bigl[(\bX'\bX)^{-1}\bX'+\bD\bigr]\bigl[\bX(\bX'\bX)^{-1}+\bD'\bigr]\\
&= (\bX'\bX)^{-1}\bX'\bX(\bX'\bX)^{-1}+(\bX'\bX)^{-1}\bX'\bD'+\bD\bX(\bX'\bX)^{-1}+\bD\bD' .
\end{align*}
The first term is $(\bX'\bX)^{-1}$. The third vanishes because $\bD\bX=\bzero$, and the
second is its transpose, $(\bD\bX(\bX'\bX)^{-1})'=\bzero$. Hence
\[
\var(\tilde\bb)=\sigma^2(\bX'\bX)^{-1}+\sigma^2\bD\bD'=\var(\hat\bb)+\sigma^2\bD\bD' .
\]

\textbf{Step 4: the difference is positive semi-definite.} For any $\bv$,
$\bv'\bD\bD'\bv=\|\bD'\bv\|^2\geqslant0$. Taking $\bv$ the $j$-th coordinate vector
gives $\var(\tilde\beta_j)\geqslant\var(\hat\beta_j)$. If $\bD\bD'=\bzero$ then every
row of $\bD$ has zero length, so $\bD=\bzero$ and $\tilde\bb=\hat\bb$.
\end{proof}

\begin{remark}
The theorem ranks least squares within the estimators that are linear in $\bY$ and
unbiased; it uses no normality and says nothing about prediction error on new data.
Biased estimators, such as those that shrink $\hat\bb$ toward zero, can have smaller
mean squared error.
\end{remark}

\subsection{Estimating the error variance}\label{sec:2.3.3}

\begin{theorem}[Unbiasedness of the mean square error; FREES §2.3.2, §3.3]\label{thm:mse-unbiased}
Under \Aref{1}--\Aref{4}, $\expc[\SSE]=(n-k-1)\sigma^2$, so $\expc[s^2]=\sigma^2$.
\end{theorem}

\begin{proof}
By~\eqref{eq:e-Me} and the symmetry and idempotency of $\bM$,
$\SSE=\mathbf e'\mathbf e=\be'\bM'\bM\be=\be'\bM\be$. The prerequisites' lemma
\emph{expectation of a quadratic form}, $\expc[\bz'\bA\bz]=\tr(\bA\bSig)+\bmu'\bA\bmu$
for $\expc[\bz]=\bmu$ and $\var(\bz)=\bSig$, applied with $\bz=\be$, $\bmu=\bzero$ and
$\bSig=\sigma^2\bI_n$, gives
$\expc[\SSE]=\tr(\bM\sigma^2\bI_n)=\sigma^2\tr(\bM)=\sigma^2(n-k-1)$ by
Theorem~\ref{thm:HM}\ref{HM:iv}. Dividing by $n-k-1$ gives $\expc[s^2]=\sigma^2$.
\end{proof}

\begin{remark}[The divisor; FREES §2.3.2, §3.3]
The divisor is $n-k-1=\tr(\bM)$ because the residual vector lies in the
$(n-k-1)$-dimensional space $\calC(\bX)^\perp$: $k+1$ observations determine the plane
exactly and leave no residual, and a further observation is needed before there is any
variation about it. Dividing $\SSE$ by $n$ gives an estimator biased downward by the
factor $(n-k-1)/n$.
\end{remark}

\begin{theorem}[Variance of the residuals]\label{thm:var-resid}
Under \Aref{1}--\Aref{4}, $\var(\mathbf e)=\sigma^2\bM$: $\var(e_i)=\sigma^2(1-h_{ii})$
and $\cov(e_i,e_j)=-\sigma^2h_{ij}$.
\end{theorem}

\begin{proof}
By~\eqref{eq:e-Me} and \emph{variance under a linear map},
$\var(\mathbf e)=\bM(\sigma^2\bI_n)\bM'=\sigma^2\bM^2=\sigma^2\bM$; the $(i,i)$ entry of
$\bI-\bH$ is $1-h_{ii}$ and the $(i,j)$ entry is $-h_{ij}$.
\end{proof}

\begin{definition}[Standard errors; FREES §2.4, §3.4, ISLR §3.1.2]\label{def:se}
The \emph{standard error} of $\hat\beta_j$ is its estimated standard deviation,
\begin{equation}\label{eq:se}
\SE(\hat\beta_j)=s\sqrt{[(\bX'\bX)^{-1}]_{jj}},\qquad
\SE(b_1)=\frac{s}{s_x\sqrt{n-1}},\qquad
\SE(b_0)=s\sqrt{\frac1n+\frac{\bar x^2}{(n-1)s_x^2}} ,
\end{equation}
the last two for $k=1$, by Theorem~\ref{thm:var-beta} and Corollary~\ref{cor:slr-var} with
$\sigma$ replaced by $s$. ISLR writes $\mathrm{SE}(\hat\beta_j)$ for the same quantity and notes that,
strictly, it is an estimate.
\end{definition}

\begin{example}[Lottery sales, continued; FREES §2.4]\label{ex:lottery-se}
With $s=3792$, $s_x=11{,}098$ and $n=50$,
$\SE(b_1)=3792/(11{,}098\sqrt{49})=0.0488$.
<<lottery-se>>=
s_lot <- summary(fit_lot)$sigma
c(s = s_lot, se_b1 = s_lot / (sd(lottery$POP) * sqrt(49)),
  se_b1_lm = coef(summary(fit_lot))["POP", "Std. Error"])
@
\end{example}

\begin{example}[Advertising, continued; ISLR §3.1.2]\label{ex:adv-se}
The standard errors of ISLR Table 3.1, from the formulas~\eqref{eq:se} and from
\texttt{lm}:
<<adv-se>>=
s_tv <- summary(fit_tv)$sigma; xt <- adv$TV; n_adv <- nrow(adv)
rbind(formula = c(intercept = s_tv * sqrt(1/n_adv + mean(xt)^2 / sum((xt - mean(xt))^2)),
                  TV = s_tv / sqrt(sum((xt - mean(xt))^2))),
      lm = coef(summary(fit_tv))[, "Std. Error"])
@
\end{example}

\begin{example}[The population line and the least squares line; ISLR §3.1.2]\label{ex:pop-line}
ISLR Figure 3.3 draws $100$ observations from $Y=2+3X+\varepsilon$ and fits a line;
repeated on ten independent samples, the fitted lines scatter about the population line,
and averaged over many samples they reproduce it, which is Theorem~\ref{thm:unbiased}.
<<pop-line>>=
set.seed(2)
x_pop <- runif(100, -2, 2)
fits <- replicate(2000, coef(lm(I(2 + 3 * x_pop + rnorm(100, sd = 2)) ~ x_pop)))
rbind(true = c(2, 3), mean_of_fits = rowMeans(fits), sd_of_fits = apply(fits, 1, sd))
@
<<pop-line-fig, fig.height=2.6, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 2), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
set.seed(3); y1 <- 2 + 3 * x_pop + rnorm(100, sd = 2)
plot(x_pop, y1, pch = 16, cex = 0.5, xlab = "X", ylab = "Y")
abline(2, 3, col = "#B45309", lwd = 2); abline(lm(y1 ~ x_pop), col = "steelblue", lwd = 2)
plot(x_pop, y1, type = "n", xlab = "X", ylab = "Y")
for (j in 1:10) abline(fits[, j], col = "lightblue")
abline(2, 3, col = "#B45309", lwd = 2); abline(lm(y1 ~ x_pop), col = "steelblue", lwd = 2)
par(op)
@
\begin{figure}[H]\centering
\caption{Left: the population line $2+3X$ (orange) and the least squares line (blue)
for one sample. Right: ten least squares lines from ten samples (ISLR Figure 3.3).}
\end{figure}
The mean of $2000$ fitted intercepts and slopes agrees with $(2,3)$ within $0.01$, and
the spread of the fits is the standard deviation~\eqref{eq:slr-var}.
\end{example}

\periodmark{End of period 1 of 3.}

%==============================================================================
\section{Goodness of Fit}\label{sec:2.4}
%==============================================================================

\begin{reading}
FREES §2.3, §3.3 · ISLR §3.1.3, §3.2.2 · CLM §6. \ SRM learning outcome 2(e).
\end{reading}

\subsection{The analysis of variance}\label{sec:2.4.1}

\begin{definition}[Centering matrix]\label{def:centering}
$\bM_0=\bI_n-\tfrac1n\bone\bone'=\bI_n-\bH_0$, so that $\bM_0\bv=\bv-\bar v\bone$.
$\bM_0$ is the residual maker of the intercept-only model: symmetric idempotent, with
$\tr(\bM_0)=n-1$, projecting onto $\bone^\perp$.
\end{definition}

\begin{theorem}[Variance decomposition; FREES §2.3.1, §3.3, ISLR §3.1.3]\label{thm:anova}
In a model with an intercept,
\begin{equation}\label{eq:anova}
\SST=\SSR+\SSE ,
\end{equation}
with $\SST=\bY'\bM_0\bY$, $\SSR=\hat\bY'\bM_0\hat\bY=\|(\bH-\bH_0)\bY\|^2$ and
$\SSE=\mathbf e'\mathbf e=\bY'\bM\bY$.
\end{theorem}

\begin{proof}
\textbf{Step 1: the matrix forms.} For any $\bv$, since $\bM_0'\bM_0=\bM_0$,
$\bv'\bM_0\bv=\|\bM_0\bv\|^2=\|\bv-\bar v\bone\|^2=\sum_i(v_i-\bar v)^2$. With $\bv=\bY$
this is $\SST$; with $\bv=\hat\bY$ it is $\SSR$, because $\overline{\hat Y}=\bar Y$ by
Theorem~\ref{thm:normal-eq}\ref{ne:ii}. Also $\bM_0\hat\bY=\bM_0\bH\bY=(\bH-\bH_0)\bY$,
since $\bH_0\bH=\bH_0$ by Lemma~\ref{lem:HH0}; and
$\bY'\bM\bY=\|\bM\bY\|^2=\|\mathbf e\|^2$.

\textbf{Step 2: decompose.} Since $\bar e=0$, $\bM_0\mathbf e=\mathbf e$ and
\begin{equation}\label{eq:M0-decomp}
\bM_0\bY=\bM_0(\hat\bY+\mathbf e)=\bM_0\hat\bY+\mathbf e .
\end{equation}

\textbf{Step 3: expand.} $\SST=\|\bM_0\hat\bY+\mathbf e\|^2
=\SSR+2\,\mathbf e'\bM_0\hat\bY+\SSE$.

\textbf{Step 4: the cross term vanishes.}
$\mathbf e'\bM_0\hat\bY=\mathbf e'\hat\bY-\bar Y\,\mathbf e'\bone=0-0$ by
Theorem~\ref{thm:normal-eq}\ref{ne:iii} and \ref{ne:ii}.
\end{proof}

\begin{remark}[FREES §2.3.1]
Equation~\eqref{eq:anova} is FREES's ``total deviation equals unexplained deviation plus
explained deviation'', $y_i-\bar y=(y_i-\hat y_i)+(\hat y_i-\bar y)$, squared and summed;
the cross products sum to zero for the least squares fit and for no other line, because
Step 4 uses the normal equations. Without an intercept $\bar e\neq0$, the cross term
survives and~\eqref{eq:anova} fails.
\end{remark}

\begin{ctab}[\small]
\begin{tabular}{@{}lccc@{}}
\toprule
Source & Sum of squares & $\df$ & Mean square \\
\midrule
Regression & $\SSR$ & $k$       & $\MSR=\SSR/k$ \\
Error      & $\SSE$ & $n-k-1$   & $\MSE=\SSE/(n-k-1)=s^2$ \\
\midrule
Total      & $\SST$ & $n-1$     & \\
\bottomrule
\end{tabular}
\end{ctab}

\begin{remark}[The ANOVA table; FREES §2.3.2, §3.3]
The degrees of freedom are the dimensions of the three subspaces of
Lemma~\ref{lem:HH0}: $\bM_0\bY$ lies in $\bone^\perp$ ($n-1$), and splits into
$(\bH-\bH_0)\bY\in\calC(\bX)\cap\bone^\perp$ ($k$) and $\mathbf e\in\calC(\bX)^\perp$
($n-k-1$). For $k=1$ the regression sum of squares equals its mean square.
\end{remark}

\begin{example}[Lottery sales, continued; FREES §2.3]\label{ex:lottery-anova}
<<lottery-anova>>=
anova(fit_lot)
c(R2 = summary(fit_lot)$r.squared, s = s_lot, s_y = sd(lottery$SALES))
@
The regression explains $78.5\%$ of the variation and the typical deviation from the
line is $s=3792$ against $s_y=8103$ without the explanatory variable.
\end{example}

\subsection{The coefficient of determination}\label{sec:2.4.2}

\begin{definition}[$R^2$ and adjusted $R^2$; FREES §2.3.1, §3.3, ISLR §3.1.3]\label{def:R2}
\begin{equation}\label{eq:R2}
R^2=\frac{\SSR}{\SST}=1-\frac{\SSE}{\SST},
\qquad
R_a^2=1-\frac{\SSE/(n-k-1)}{\SST/(n-1)}=1-\frac{s^2}{s_y^2}=1-\frac{n-1}{n-k-1}(1-R^2),
\end{equation}
the proportion of the variation in $Y$ explained by the regression and its version
adjusted for degrees of freedom; $R_a^2$ can be negative. $R=\sqrt{R^2}$ is the
\emph{multiple correlation coefficient}.
\end{definition}

\begin{proposition}[Bounds and monotonicity; FREES §2.3, §3.3, ISLR §3.2.2]\label{prop:R2-bounds}
In a model with an intercept, $0\leqslant R^2\leqslant1$; $R^2=1$ iff every residual is
zero and $R^2=0$ iff $\hat\bY=\bar Y\bone$. Adding an explanatory variable cannot decrease
$R^2$, and can decrease $R_a^2$.
\end{proposition}

\begin{proof}
$\SSR\geqslant0$ and $\SST>0$ give $R^2\geqslant0$, with equality iff $\hat Y_i=\bar Y$
for every $i$; $\SST=\SSR+\SSE$ with $\SSE\geqslant0$ gives $R^2\leqslant1$, with
equality iff $\SSE=0$. For monotonicity let $\calC_k\subseteq\calC_{k+1}$ be the column
spaces of the smaller and the enlarged design. By Theorem~\ref{thm:ols-proj},
$\hat\bY_{k+1}$ is the point of $\calC_{k+1}$ closest to $\bY$, and
$\hat\bY_k\in\calC_k\subseteq\calC_{k+1}$, so
$\SSE_{k+1}=\|\bY-\hat\bY_{k+1}\|^2\leqslant\|\bY-\hat\bY_k\|^2=\SSE_k$, while $\SST$
does not involve the design; hence $R^2_{k+1}\geqslant R^2_k$. For $R_a^2$, $\SST$ and
$n-1$ are fixed and $s^2=\SSE/(n-k-1)$ rises whenever $\SSE$ falls by less than the
factor $(n-k-2)/(n-k-1)$.
\end{proof}

\begin{proposition}[$R^2$ as a squared correlation; FREES §3.3, ISLR §3.2.2]\label{prop:R2-cor}
In a model with an intercept, $R^2=\cor(Y,\hat Y)^2$, the squared sample correlation
between the responses and the fitted values; and among all vectors $\bv\in\calC(\bX)$
that are not constant, $\cor(Y,v)^2$ is largest at $\bv=\hat\bY$.
\end{proposition}

\begin{proof}
\textbf{Step 1: the correlation with $\hat\bY$.} By Theorem~\ref{thm:normal-eq}\ref{ne:ii},
$\overline{\hat Y}=\bar Y$, so the numerator of $\cor(Y,\hat Y)$ is
\[
\sum_i(Y_i-\bar Y)(\hat Y_i-\bar Y)=\hat\bY'\bM_0\bY
=\hat\bY'\bM_0(\hat\bY+\mathbf e)=\SSR+\hat\bY'\mathbf e=\SSR ,
\]
using $\bM_0\mathbf e=\mathbf e$ and Theorem~\ref{thm:normal-eq}\ref{ne:iii}. The two
sums of squares in the denominator are $\SST$ and $\SSR$, so
$\cor(Y,\hat Y)^2=\SSR^2/(\SST\cdot\SSR)=R^2$.

\textbf{Step 2: the maximum.} Let $\bv\in\calC(\bX)$ and put $\tilde\bY=\bM_0\bY$,
$\tilde\bv=\bM_0\bv$. Since $\bv\in\calC(\bX)$ and $\bH_0\bv\in\calC(\bone)\subseteq\calC(\bX)$,
$\tilde\bv=\bv-\bH_0\bv$ lies in $\calC(\bX)\cap\bone^\perp$, the column space of
$\bP=\bH-\bH_0$ (Lemma~\ref{lem:HH0}), so $\bP\tilde\bv=\tilde\bv$ and
$\tilde\bY'\tilde\bv=\tilde\bY'\bP\tilde\bv=(\bP\tilde\bY)'\tilde\bv$. By the
Cauchy--Schwarz inequality of the prerequisites,
\[
\cor(Y,v)^2=\frac{(\tilde\bY'\tilde\bv)^2}{\|\tilde\bY\|^2\|\tilde\bv\|^2}
\leqslant\frac{\|\bP\tilde\bY\|^2\|\tilde\bv\|^2}{\|\tilde\bY\|^2\|\tilde\bv\|^2}
=\frac{\|\bP\bM_0\bY\|^2}{\SST}=\frac{\|(\bH-\bH_0)\bY\|^2}{\SST}=R^2 ,
\]
using $\bP\bM_0=\bP-\bP\bH_0=\bP$ (as $\bH\bH_0=\bH_0$ and $\bH_0^2=\bH_0$) and
Theorem~\ref{thm:anova}. Equality holds when $\tilde\bv$ is proportional to
$\bP\tilde\bY=\bM_0\hat\bY$, which is the case $\bv=\hat\bY$ by Step 1.
\end{proof}

\begin{lemma}[Adding one explanatory variable; CLM §6]\label{lem:sse-reduction}
Let $\bX_+=[\bX\ \ \bz]$ with $\bz\notin\calC(\bX)$, so that $\bz'\bM\bz>0$, and let
$\hat\gamma$ be the coefficient of $\bz$ in the enlarged fit, with residual sum of squares
$\SSE_+$. Then
\begin{equation}\label{eq:sse-reduction}
\hat\gamma=\frac{\bz'\bM\bY}{\bz'\bM\bz},\qquad
\SSE-\SSE_+=\hat\gamma^2\,\bz'\bM\bz=\frac{(\bz'\bM\bY)^2}{\bz'\bM\bz},\qquad
\var(\hat\gamma)=\frac{\sigma^2}{\bz'\bM\bz},
\end{equation}
and the standard error of $\hat\gamma$ in the enlarged model is
$\SE(\hat\gamma)=s_+/\sqrt{\bz'\bM\bz}$ with $s_+^2=\SSE_+/(n-k-2)$.
\end{lemma}

\begin{proof}
\textbf{Step 1: the partitioned normal equations.} Write the enlarged coefficient vector
as $(\hat\bb_+',\hat\gamma)'$. The normal equations $\bX_+'\bX_+(\hat\bb_+',\hat\gamma)'=\bX_+'\bY$
split into
\[
\text{(a)}\ \ \bX'\bX\hat\bb_++\bX'\bz\hat\gamma=\bX'\bY,\qquad
\text{(b)}\ \ \bz'\bX\hat\bb_++\bz'\bz\hat\gamma=\bz'\bY .
\]
From (a), $\hat\bb_+=(\bX'\bX)^{-1}\bX'(\bY-\bz\hat\gamma)=\hat\bb-(\bX'\bX)^{-1}\bX'\bz\hat\gamma$.
Substituting into (b), with $\bH=\bX(\bX'\bX)^{-1}\bX'$,
\[
\bz'\bH\bY-\bz'\bH\bz\hat\gamma+\bz'\bz\hat\gamma=\bz'\bY
\ifff \bz'(\bI-\bH)\bz\,\hat\gamma=\bz'(\bI-\bH)\bY ,
\]
which is the first formula.

\textbf{Step 2: the residuals.} Multiplying the expression for $\hat\bb_+$ by $\bX$,
$\bX\hat\bb_+=\hat\bY-\bH\bz\hat\gamma$, so
$\hat\bY_+=\bX\hat\bb_++\bz\hat\gamma=\hat\bY+\bM\bz\hat\gamma$ and
$\mathbf e_+=\mathbf e-\hat\gamma\bM\bz$. Taking squared lengths, with
$\mathbf e=\bM\bY$ and $\bM^2=\bM$,
\[
\SSE_+=\SSE-2\hat\gamma\,\bY'\bM\bz+\hat\gamma^2\bz'\bM\bz
=\SSE-2\hat\gamma^2\bz'\bM\bz+\hat\gamma^2\bz'\bM\bz=\SSE-\hat\gamma^2\bz'\bM\bz ,
\]
substituting $\bY'\bM\bz=\bz'\bM\bY=\hat\gamma\,\bz'\bM\bz$.

\textbf{Step 3: the variance.} $\hat\gamma=\bz'\bM\bY/(\bz'\bM\bz)$ is a linear map of
$\bY$, so by \emph{variance under a linear map} and \Aref{3},
$\var(\hat\gamma)=\sigma^2\bz'\bM\bM'\bz/(\bz'\bM\bz)^2=\sigma^2/(\bz'\bM\bz)$; the
standard error replaces $\sigma^2$ by the enlarged model's $s_+^2$.
\end{proof}

\begin{theorem}[Adjusted $R^2$ rises iff $|t|>1$; CLM §6]\label{thm:adj-R2}
Adding one explanatory variable raises $R_a^2$ iff the $t$ statistic
$t=\hat\gamma/\SE(\hat\gamma)$ of the new variable in the enlarged model satisfies
$|t|>1$.
\end{theorem}

\begin{proof}
By~\eqref{eq:R2}, $R_a^2=1-s^2/s_y^2$ with $s_y^2$ fixed, so $R_a^2$ rises iff
$s_+^2<s^2$, that is
\begin{align*}
\frac{\SSE_+}{n-k-2}<\frac{\SSE}{n-k-1}
&\ifff (n-k-1)\SSE_+<(n-k-2)\SSE\\
&\ifff \SSE_+<(n-k-2)(\SSE-\SSE_+) ,
\end{align*}
subtracting $(n-k-2)\SSE_+$ from both sides. Dividing by
$\SSE_+=(n-k-2)s_+^2>0$ gives $1<(\SSE-\SSE_+)/s_+^2$, and by
Lemma~\ref{lem:sse-reduction}
\[
\frac{\SSE-\SSE_+}{s_+^2}=\frac{\hat\gamma^2\,\bz'\bM\bz}{s_+^2}
=\frac{\hat\gamma^2}{\SE(\hat\gamma)^2}=t^2 . \qedhere
\]
\end{proof}

\begin{corollary}[The case $k=1$; FREES §2.5.1, ISLR §3.1.3]\label{cor:R2-r2}
With one explanatory variable and an intercept, $R^2=r^2$,
$\SSR=b_1^2(n-1)s_x^2$, and
\begin{equation}\label{eq:capm-decomp}
s_y^2=b_1^2s_x^2+s^2\,\frac{n-2}{n-1} .
\end{equation}
\end{corollary}

\begin{proof}
By Corollary~\ref{cor:slr-ls}, $\hat y_i-\bar y=b_1(x_i-\bar x)$, so
$\SSR=b_1^2\sum_i(x_i-\bar x)^2=b_1^2(n-1)s_x^2$; substituting $b_1=r\,s_y/s_x$ gives
$\SSR=r^2(n-1)s_y^2=r^2\SST$, that is $R^2=r^2$. Dividing~\eqref{eq:anova} by $n-1$
and using $\SSE=(n-2)s^2$ gives~\eqref{eq:capm-decomp}.
\end{proof}

\begin{remark}[ISLR §3.1.3, §3.2.2]
For $k=1$ the sign of the association is carried by $r$ and its strength by
$R^2=r^2$, so ISLR's $R^2=0.61$ for sales on television advertising is $r=0.78$ from
Example~\ref{ex:advertising}. For $k>1$, $R^2$ is the squared correlation of $Y$ with
the fitted combination of all the explanatory variables (Proposition~\ref{prop:R2-cor}),
not with any one of them. What counts as a good $R^2$ depends on the field: near $1$ in
a physical law with small measurement error, well below $0.1$ in a social or marketing
setting where the linear model is a rough approximation.
\end{remark}

\begin{example}[Term life insurance, continued; FREES §3.3]\label{ex:termlife-anova}
<<termlife-anova>>=
a <- anova(fit_term)
SSR_t <- sum(a[["Sum Sq"]][1:3]); SSE_t <- a[["Sum Sq"]][4]; SST_t <- SSR_t + SSE_t
rbind(Regression = c(SS = SSR_t, df = 3, MS = SSR_t / 3),
      Error      = c(SS = SSE_t, df = 271, MS = SSE_t / 271),
      Total      = c(SS = SST_t, df = 274, MS = NA))
c(R2 = SSR_t / SST_t, s = sqrt(SSE_t / 271), s_y = sqrt(SST_t / 274),
  R2_adj = 1 - (SSE_t / 271) / (SST_t / 274))
@
\texttt{anova} prints one row per variable, sequential sums of squares whose total is
$\SSR$. The three explanatory variables explain $34.3\%$ of the variation in the
logarithmic face amount; the typical error falls from $s_y=1.871$ to $s=1.525$, and
$R_a^2=1-s^2/s_y^2=0.335$.
\end{example}

\begin{example}[Advertising, continued; ISLR §3.1.3, §3.2.2]\label{ex:adv-fit}
<<adv-fit>>=
fit_two <- lm(sales ~ TV + radio, data = adv)
fit_stats <- function(m) c(RSE = summary(m)$sigma, R2 = summary(m)$r.squared,
                           adj_R2 = summary(m)$adj.r.squared)
round(rbind(TV_only = fit_stats(fit_tv), TV_radio = fit_stats(fit_two),
            all_three = fit_stats(fit_all)), 5)
sprintf("R2: TV+radio %.5f, all three %.5f", summary(fit_two)$r.squared, summary(fit_all)$r.squared)
@
Television alone explains $61\%$ of the variation with a residual standard error of
$3.26$, so a market's sales deviate from the line by about $3{,}260$ units, $23\%$ of
the mean sales of about $14{,}000$. Adding radio raises $R^2$ to $0.897$ and lowers the
residual standard error to $1.68$. Adding newspaper raises $R^2$ from $0.89719$ to
$0.89721$, the increase Proposition~\ref{prop:R2-bounds} guarantees, while the residual
standard error \emph{rises} from $1.681$ to $1.686$: the decrease in $\SSE$ is smaller
than the loss of a degree of freedom, and by Theorem~\ref{thm:adj-R2} the newspaper $t$
statistic must be below $1$ in absolute value, which Example~\ref{ex:adv-newspaper}'s
coefficient of $-0.001$ against its standard error confirms.
\end{example}

%==============================================================================
\section{Exact Inference Under Normality}\label{sec:2.5}
%==============================================================================

\begin{reading}
FREES §2.5, §2.7, §3.2.4 · ISLR §3.1.2, §3.2.2 · CLM §4--5, §7, §9. \ SRM learning
outcomes 2(e), 2(f). \Aref{5} is in force throughout.
\end{reading}

\subsection{Sampling distributions}\label{sec:2.5.1}

\begin{theorem}[Normality of $\hat\bb$; FREES §3.2.4]\label{thm:beta-dist}
Under \Aref{1}--\Aref{5}, $\hat\bb\sim N\bigl(\bb,\,\sigma^2(\bX'\bX)^{-1}\bigr)$, and
for any constant $\bc$, $\bc'\hat\bb\sim N(\bc'\bb,\,\sigma^2\bc'(\bX'\bX)^{-1}\bc)$.
\end{theorem}

\begin{proof}
By~\eqref{eq:beta-decomp}, $\hat\bb=\bb+\bA\be$ with $\bA=(\bX'\bX)^{-1}\bX'$ and
$\be\sim N(\bzero,\sigma^2\bI_n)$. By the prerequisites' theorem \emph{closure under
affine maps}, $\hat\bb\sim N(\bb,\,\sigma^2\bA\bA')$, and
$\bA\bA'=(\bX'\bX)^{-1}\bX'\bX(\bX'\bX)^{-1}=(\bX'\bX)^{-1}$. Applying the same theorem
to the map $\hat\bb\mapsto\bc'\hat\bb$ gives the second statement.
\end{proof}

\begin{theorem}[Distribution of $\SSE$ and independence from $\hat\bb$]\label{thm:sse-dist}
Under \Aref{1}--\Aref{5}, $\SSE/\sigma^2\sim\chi^2_{n-k-1}$, and $\SSE$ is independent
of $\hat\bb$.
\end{theorem}

\begin{proof}
\textbf{Step 1.} With $\bz=\be/\sigma\sim N(\bzero,\bI_n)$ and~\eqref{eq:e-Me},
$\SSE/\sigma^2=\be'\bM\be/\sigma^2=\bz'\bM\bz$.

\textbf{Step 2.} $\bM$ is symmetric idempotent with $\tr(\bM)=n-k-1$
(Theorem~\ref{thm:HM}), so by the prerequisites' theorem \emph{chi-square quadratic
forms}, $\bz'\bM\bz\sim\chi^2_{n-k-1}$.

\textbf{Step 3.} The stacked vector
\[
\begin{pmatrix}\hat\bb-\bb\\ \mathbf e\end{pmatrix}
=\begin{pmatrix}(\bX'\bX)^{-1}\bX'\\ \bM\end{pmatrix}\be
\]
is one affine map of one normal vector, hence jointly normal by \emph{closure under
affine maps}, with cross-covariance
$(\bX'\bX)^{-1}\bX'(\sigma^2\bI_n)\bM'=\sigma^2(\bX'\bX)^{-1}\bX'\bM=\bzero$, since
$\bX'\bM=(\bM\bX)'=\bzero$ by Theorem~\ref{thm:HM}\ref{HM:ii}. By the prerequisites'
theorem \emph{uncorrelated blocks are independent}, $\hat\bb$ and $\mathbf e$ are
independent, and $\SSE=\mathbf e'\mathbf e$ is a function of $\mathbf e$ alone.
\end{proof}

\begin{remark}
A $t$ statistic is a standard normal divided by $\sqrt{\chi^2_\nu/\nu}$ with numerator
and denominator \emph{independent}. Here the numerator comes from $\hat\bb$ and the
denominator from $\SSE$; Step 3 supplies the independence, and without \Aref{5} zero
covariance would not give it.
\end{remark}

\subsection{Tests and confidence intervals for a coefficient}\label{sec:2.5.2}

\begin{theorem}[The $t$ statistic; FREES §2.4--2.5, §3.4, ISLR §3.1.2]\label{thm:t-test}
Under \Aref{1}--\Aref{5}, for any constant $\bc$,
\begin{equation}\label{eq:t-pivot}
\frac{\bc'\hat\bb-\bc'\bb}{s\sqrt{\bc'(\bX'\bX)^{-1}\bc}}\sim t_{n-k-1} ;
\end{equation}
in particular $(\hat\beta_j-\beta_j)/\SE(\hat\beta_j)\sim t_{n-k-1}$, and for $k=1$,
$(b_1-\beta_1)/\SE(b_1)\sim t_{n-2}$.
\end{theorem}

\begin{proof}
\textbf{Step 1: a standard normal.} By Theorem~\ref{thm:beta-dist},
$Z=(\bc'\hat\bb-\bc'\bb)/\{\sigma\sqrt{\bc'(\bX'\bX)^{-1}\bc}\}\sim N(0,1)$.

\textbf{Step 2: an independent chi-square.} By Theorem~\ref{thm:sse-dist},
$V=\SSE/\sigma^2\sim\chi^2_{n-k-1}$ is independent of $\hat\bb$, hence of $Z$, which is
a function of $\hat\bb$ alone.

\textbf{Step 3: the ratio.} By the prerequisites' definition of Student's $t$,
$Z/\sqrt{V/(n-k-1)}\sim t_{n-k-1}$, and
\[
\frac{Z}{\sqrt{V/(n-k-1)}}
=\frac{\bc'\hat\bb-\bc'\bb}{\sigma\sqrt{\bc'(\bX'\bX)^{-1}\bc}}\cdot
 \frac{\sigma}{\sqrt{\SSE/(n-k-1)}}
=\frac{\bc'\hat\bb-\bc'\bb}{s\sqrt{\bc'(\bX'\bX)^{-1}\bc}} ,
\]
since $s=\sqrt{\SSE/(n-k-1)}$. Taking $\bc$ the $j$-th coordinate vector gives the
statement for $\hat\beta_j$, and $k=1$ gives $n-2$ degrees of freedom.
\end{proof}

\begin{definition}[$t$ tests, $p$-values and confidence intervals; FREES §2.5.1--2.5.2, ISLR §3.1.2]\label{def:ttest}
To test $H_0\colon\beta_j=d$ at significance level $\alpha$, compute the \emph{$t$ ratio}
$t(\hat\beta_j)=(\hat\beta_j-d)/\SE(\hat\beta_j)$ and, with $t_{\nu,q}$ the $q$-th
quantile of $t_\nu$ and $\nu=n-k-1$:
\begin{ctab}[\small]
\begin{tabular}{@{}lll@{}}
\toprule
Alternative $H_a$ & Reject $H_0$ if & $p$-value \\
\midrule
$\beta_j>d$ & $t(\hat\beta_j)>t_{\nu,1-\alpha}$ & $\prb(t_\nu>t(\hat\beta_j))$\\
$\beta_j<d$ & $t(\hat\beta_j)<-t_{\nu,1-\alpha}$ & $\prb(t_\nu<t(\hat\beta_j))$\\
$\beta_j\neq d$ & $|t(\hat\beta_j)|>t_{\nu,1-\alpha/2}$ & $\prb(|t_\nu|>|t(\hat\beta_j)|)$\\
\bottomrule
\end{tabular}
\end{ctab}
The $p$-value is the probability, under $H_0$, of a $t$ ratio at least as extreme as the
one observed, and $H_0$ is rejected at level $\alpha$ iff $p<\alpha$. The usual test is
$H_0\colon\beta_j=0$ against $\beta_j\neq0$, whose $t$ ratio $\hat\beta_j/\SE(\hat\beta_j)$
and $p$-value software prints for every coefficient. A $100(1-\alpha)\%$
\emph{confidence interval} for $\beta_j$ is
\begin{equation}\label{eq:ci-beta}
\hat\beta_j\pm t_{n-k-1,1-\alpha/2}\,\SE(\hat\beta_j) ,
\end{equation}
and for $\bc'\bb$ it is $\bc'\hat\bb\pm t_{n-k-1,1-\alpha/2}\,s\sqrt{\bc'(\bX'\bX)^{-1}\bc}$.
\end{definition}

\begin{proposition}[Validity of the procedures]\label{prop:ttest-valid}
Under \Aref{1}--\Aref{5} each test of Definition~\ref{def:ttest} rejects a true $H_0$
with probability exactly $\alpha$, and the interval~\eqref{eq:ci-beta} contains
$\beta_j$ with probability exactly $1-\alpha$.
\end{proposition}

\begin{proof}
Under $H_0\colon\beta_j=d$ the ratio $t(\hat\beta_j)$ is~\eqref{eq:t-pivot} with $\bc$ the
$j$-th coordinate vector, hence $t_{n-k-1}$ by Theorem~\ref{thm:t-test}. For the
two-sided test, $\prb(|t_\nu|>t_{\nu,1-\alpha/2})=2\prb(t_\nu>t_{\nu,1-\alpha/2})=\alpha$
by the symmetry of $t_\nu$, which follows from the symmetry of $Z$ in its definition;
the one-sided cases are $\prb(t_\nu>t_{\nu,1-\alpha})=\alpha$ and its mirror image. For
the interval, with $T=(\hat\beta_j-\beta_j)/\SE(\hat\beta_j)\sim t_\nu$,
\[
1-\alpha=\prb\bigl(-t_{\nu,1-\alpha/2}\leqslant T\leqslant t_{\nu,1-\alpha/2}\bigr)
=\prb\bigl(\hat\beta_j-t_{\nu,1-\alpha/2}\SE(\hat\beta_j)\leqslant\beta_j
\leqslant\hat\beta_j+t_{\nu,1-\alpha/2}\SE(\hat\beta_j)\bigr),
\]
rearranging the inequalities inside the probability. The same argument with
\eqref{eq:t-pivot} covers $\bc'\bb$.
\end{proof}

\begin{remark}[ISLR's factor of two; ISLR §3.1.2]
ISLR writes the $95\%$ interval as $\hat\beta_j\pm2\,\mathrm{SE}(\hat\beta_j)$; the
exact multiplier is $t_{n-k-1,0.975}$, which is $2.01$ at $48$ degrees of freedom and
$1.97$ at $198$, and the $t$ law itself rests on \Aref{5}. Rejecting $H_0\colon\beta_1=0$
is ISLR's ``there is a relationship between $X$ and $Y$''; the $p$-value cutoffs $5\%$
and $1\%$ correspond, at $n=30$, to $|t|$ of about $2$ and $2.75$.
\end{remark}

\begin{example}[Lottery sales, continued; FREES §2.5]\label{ex:lottery-t}
With $b_1=0.647$ and $\SE(b_1)=0.0488$, $t(b_1)=13.3$ on $n-2=48$ degrees of freedom:
the slope is $13$ standard errors above zero, far beyond $t_{48,0.975}=2.011$, so
$H_0\colon\beta_1=0$ is rejected against $\beta_1\neq0$ at $5\%$, with $p$-value
$10^{-17}$. The $95\%$ confidence interval $0.647\pm2.011(0.0488)=(0.549,0.745)$ says
that ZIP codes differing by $1{,}000$ in population are expected to differ in sales by
between $\$549$ and $\$745$; the $90\%$ interval is narrower.
<<lottery-t>>=
coef(summary(fit_lot))
c(t_crit = qt(0.975, 48))
confint(fit_lot, level = 0.95)
confint(fit_lot, level = 0.90)
@
\end{example}

\begin{example}[Advertising, continued; ISLR §3.1.2, §3.2.1]\label{ex:adv-t}
For sales on television advertising both $t$ ratios are large and both $p$-values are
below $10^{-4}$; the $95\%$ intervals are $[6.13,7.94]$ for the intercept, so sales
without advertising fall between $6{,}130$ and $7{,}935$ units on average, and
$[0.042,0.053]$ for the slope. In the three-medium model the newspaper $p$-value is
$0.86$: with television and radio held fixed there is no evidence that newspaper
advertising is associated with sales.
<<adv-t>>=
round(coef(summary(fit_tv)), 4)
round(confint(fit_tv), 4)
round(coef(summary(fit_all)), 4)
@
\end{example}

\subsection{The overall \texorpdfstring{$F$}{F} test}\label{sec:2.5.3}

\begin{theorem}[Overall $F$ test; ISLR §3.2.2]\label{thm:F-test}
Under \Aref{1}--\Aref{5}, for $H_0\colon\beta_1=\cdots=\beta_k=0$,
\begin{equation}\label{eq:F}
F=\frac{\MSR}{\MSE}=\frac{\SSR/k}{\SSE/(n-k-1)}
=\frac{(\SST-\SSE)/k}{\SSE/(n-k-1)}
=\frac{R^2/k}{(1-R^2)/(n-k-1)}
\end{equation}
is distributed as $F_{k,\,n-k-1}$ under $H_0$; and $\expc[\SSR/k]=\sigma^2+\bb_1'\bX_1'\bM_0\bX_1\bb_1/k\geqslant\sigma^2$ in general,
with equality iff $H_0$ holds, where $\bX_1$ holds the non-intercept columns and $\bb_1$
the slopes.
\end{theorem}

\begin{proof}
\textbf{Step 1: $\SSR$ as a quadratic form in the errors.} By Theorem~\ref{thm:anova},
$\SSR=\bY'(\bH-\bH_0)\bY$ with $\bP=\bH-\bH_0$ symmetric idempotent
(Lemma~\ref{lem:HH0}). Since $\bP\bone=\bH\bone-\bH_0\bone=\bone-\bone=\bzero$,
$\bP\bX\bb=\bP(\beta_0\bone+\bX_1\bb_1)=\bP\bX_1\bb_1$, and under $H_0$ this is
$\bzero$, so $\bP\bY=\bP\be$ and $\SSR=\be'\bP\be$.

\textbf{Step 2: the two chi-squares.} With $\bz=\be/\sigma\sim N(\bzero,\bI_n)$, under
$H_0$, $\SSR/\sigma^2=\bz'\bP\bz$ and $\SSE/\sigma^2=\bz'\bM\bz$. Both $\bP$ and $\bM$
are symmetric idempotent, with traces $k$ and $n-k-1$, so by \emph{chi-square quadratic
forms} they are $\chi^2_k$ and $\chi^2_{n-k-1}$.

\textbf{Step 3: independence.} $\bP\bM=\bzero$ by Lemma~\ref{lem:HH0}, so by the
prerequisites' \emph{Cochran theorem} the two quadratic forms are independent.

\textbf{Step 4: the ratio.} By the prerequisites' definition of the $F$ law, the ratio
of independent chi-squares each divided by its degrees of freedom is $F_{k,n-k-1}$.
The other forms of~\eqref{eq:F} substitute $\SSR=\SST-\SSE$ and then divide numerator
and denominator by $\SST$.

\textbf{Step 5: the expectation.} Without $H_0$, $\bP\bY=\bP\bX_1\bb_1+\bP\be$, so by
\emph{expectation of a quadratic form} with mean $\bP\bX_1\bb_1$ and variance
$\sigma^2\bI_n$,
$\expc[\SSR]=\expc[\bY'\bP\bY]=\sigma^2\tr(\bP)+\bb_1'\bX_1'\bP\bX_1\bb_1
=k\sigma^2+\bb_1'\bX_1'\bM_0\bX_1\bb_1$, using $\bP\bX_1=\bM_0\bX_1-\bM\bX_1=\bM_0\bX_1$,
which holds since $\bM\bX_1=\bzero$ and $\bP=\bH-\bH_0=(\bI-\bH_0)-(\bI-\bH)=\bM_0-\bM$.
The quadratic form $\|\bM_0\bX_1\bb_1\|^2$ is zero iff $\bX_1\bb_1$ is constant, which
by \Aref{4} happens iff $\bb_1=\bzero$.
\end{proof}

\begin{corollary}\label{cor:R2-from-F}
$\ds R^2=\frac{kF}{kF+n-k-1}$, so $F$ determines $R^2$ without $\SSE$ and $\SST$.
\end{corollary}

\begin{proof}
Solving the last form of~\eqref{eq:F}, $F(1-R^2)(n-k-1)=R^2k$, for $R^2$.
\end{proof}

\begin{remark}[Why $F$ and not the $k$ separate $t$ tests; ISLR §3.2.2]
$\expc[\MSE]=\sigma^2$ always and $\expc[\MSR]=\sigma^2$ under $H_0$, so $F$ near $1$ is
consistent with no relation and $F$ well above $1$ is evidence of one; how far above
depends on $n$ and $k$ through the $F_{k,n-k-1}$ quantile, and a value barely above $1$
can be decisive when $n$ is large. With $k=100$ true null slopes, about five of the
individual $p$-values fall below $0.05$ by chance and the smallest almost surely does, so
declaring a relation whenever some $t$ test rejects has a false-alarm rate far above
$5\%$; the $F$ test rejects a true $H_0$ with probability exactly $5\%$ whatever $k$.
When $k\geqslant n$ least squares cannot be fitted and neither statistic exists.
\end{remark}

\begin{proposition}[$t^2=F$ for one explanatory variable; ISLR §3.2.2]\label{prop:t2F}
Let $\bz$ be one of the explanatory variables in a fitted model, $t$ its $t$ ratio for
$H_0\colon\gamma=0$, $\SSE_0$ the residual sum of squares of the model without $\bz$,
and $\SSE$ that of the full model, with $n-k-1$ residual degrees of freedom. Then
\begin{equation}\label{eq:t2F}
\frac{(\SSE_0-\SSE)/1}{\SSE/(n-k-1)}=t^2 ,
\end{equation}
and under \Aref{1}--\Aref{5} and $H_0$ this statistic is $F_{1,n-k-1}$. For $k=1$ the
overall $F$ of~\eqref{eq:F} is $t(b_1)^2$.
\end{proposition}

\begin{proof}
Apply Lemma~\ref{lem:sse-reduction} with the model without $\bz$ as the base:
$\SSE_0-\SSE=\hat\gamma^2\bz'\bM_0\bz$ where $\bM_0$ is now the residual maker of the
base model, and $\SE(\hat\gamma)^2=s^2/(\bz'\bM_0\bz)$, so the left side
of~\eqref{eq:t2F} is $\hat\gamma^2\bz'\bM_0\bz/s^2=\hat\gamma^2/\SE(\hat\gamma)^2=t^2$.
Under $H_0$, $t\sim t_{n-k-1}$ by Theorem~\ref{thm:t-test}, and by the prerequisites'
corollary \emph{the square of a $t$ is an $F$}, $t^2\sim F_{1,n-k-1}$. For $k=1$ the
base model is the intercept alone, whose residual sum of squares is $\SST$, and
\eqref{eq:t2F} is~\eqref{eq:F}.
\end{proof}

\begin{example}[Advertising, continued; ISLR §3.2.2]\label{ex:adv-F}
For the three-medium model $F=570$ on $(3,196)$ degrees of freedom, with a $p$-value
that is zero to machine precision: at least one medium is associated with sales.
<<adv-F>>=
sm <- summary(fit_all); Fst <- sm$fstatistic
SSE_a <- sum(residuals(fit_all)^2); SST_a <- sum((adv$sales - mean(adv$sales))^2)
c(F_lm = Fst[["value"]], F_formula = ((SST_a - SSE_a) / 3) / (SSE_a / 196),
  F_from_R2 = (sm$r.squared / 3) / ((1 - sm$r.squared) / 196),
  p = pf(Fst[["value"]], 3, 196, lower.tail = FALSE))
c(t2_newspaper = coef(sm)["newspaper", "t value"]^2,
  F_drop_newspaper = anova(fit_two, fit_all)[["F"]][2])
@
Dropping newspaper from the full model gives an $F$ equal to the square of its $t$ ratio,
which is Proposition~\ref{prop:t2F}.
\end{example}

\subsection{Prediction}\label{sec:2.5.4}

\begin{theorem}[Confidence and prediction intervals; FREES §2.5.3, ISLR §3.2.2]\label{thm:pred}
Let $\bx_0$ be a new vector of explanatory variables, $\hat Y_0=\bx_0'\hat\bb$, and
$h_0=\bx_0'(\bX'\bX)^{-1}\bx_0$. Under \Aref{1}--\Aref{5}:
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{pred:i} $\var(\hat Y_0)=\sigma^2h_0$, and a $100(1-\alpha)\%$ confidence
      interval for the mean response $\expc[Y_0]=\bx_0'\bb$ is
      $\hat Y_0\pm t_{n-k-1,1-\alpha/2}\,s\sqrt{h_0}$;
\item\label{pred:ii} for a new response $Y_0=\bx_0'\bb+\varepsilon_0$ with
      $\varepsilon_0\sim N(0,\sigma^2)$ independent of $\be$,
      $\var(Y_0-\hat Y_0)=\sigma^2(1+h_0)$, and a $100(1-\alpha)\%$ \emph{prediction
      interval} for $Y_0$ is $\hat Y_0\pm t_{n-k-1,1-\alpha/2}\,s\sqrt{1+h_0}$;
\item\label{pred:iii} for $k=1$,
      $\SE(\mathrm{pred})=s\sqrt{1+h_0}=s\sqrt{1+\dfrac1n+\dfrac{(x_0-\bar x)^2}{(n-1)s_x^2}}$;
\item\label{pred:iv} at an observed point $\bx_0=\bx_i$, $\var(\hat Y_i)=\sigma^2h_{ii}$
      and $\var(\hat Y_i)+\var(e_i)=\sigma^2$.
\end{enumerate}
\end{theorem}

\begin{proof}
\textbf{(i)} $\hat Y_0=\bx_0'\hat\bb$ is the case $\bc=\bx_0$ of
Theorem~\ref{thm:beta-dist}: $\hat Y_0\sim N(\bx_0'\bb,\sigma^2h_0)$, and the interval is
Definition~\ref{def:ttest}'s interval for $\bc'\bb$ with
Proposition~\ref{prop:ttest-valid}.

\textbf{(ii)} $Y_0-\hat Y_0=\varepsilon_0-\bx_0'(\hat\bb-\bb)$, and
$\hat\bb-\bb=(\bX'\bX)^{-1}\bX'\be$ is a function of $\be$, independent of
$\varepsilon_0$. Hence the variance is the sum
$\sigma^2+\bx_0'\var(\hat\bb)\bx_0=\sigma^2+\sigma^2h_0$, and the difference of two
independent normals is normal: $Y_0-\hat Y_0\sim N(0,\sigma^2(1+h_0))$. It is
independent of $\SSE$, which is a function of $\mathbf e=\bM\be$: $(\hat\bb-\bb,\mathbf e)$
are independent by Theorem~\ref{thm:sse-dist}, and $\varepsilon_0$ is independent of
both. So $(Y_0-\hat Y_0)/\{s\sqrt{1+h_0}\}$ is a standard normal over an independent
$\sqrt{\chi^2_{n-k-1}/(n-k-1)}$, hence $t_{n-k-1}$, and the interval follows as in
Proposition~\ref{prop:ttest-valid}.

\textbf{(iii)} Equation~\eqref{eq:lev-k1} with $x_0$ in place of $x_i$ and
$\sum_j(x_j-\bar x)^2=(n-1)s_x^2$.

\textbf{(iv)} $h_0=h_{ii}$ by Definition~\ref{def:leverage}, and
$\var(e_i)=\sigma^2(1-h_{ii})$ by Theorem~\ref{thm:var-resid}.
\end{proof}

\begin{remark}[ISLR §3.2.2, FREES §2.5.3]
The confidence interval measures the reducible error, the uncertainty in the estimated
plane, and shrinks to nothing as $n$ grows, since $h_0\to0$; the prediction interval
adds the irreducible error $\varepsilon_0$, is always the wider, and cannot be narrower
than $2t\,s$. Both are centred at $\hat Y_0$. Leverage is the share of $\sigma^2$ that a
point's own fitted value carries, and $1-h_{ii}$ the share left in its residual. Model
bias, the error from a linear model being only an approximation, is excluded from both
intervals.
\end{remark}

\begin{example}[Lottery sales, continued; FREES §2.5.3]\label{ex:lottery-pred}
At $x_0=10{,}000$ the point prediction is $6{,}940$ and
\[
\SE(\mathrm{pred})=3792\sqrt{1+\frac1{50}+\frac{(10{,}000-9{,}311)^2}{49(11{,}098)^2}}=3830 ,
\]
so the $95\%$ prediction interval is $6940\pm2.011(3830)$, which \texttt{predict}
gives as $(-759,\,14{,}641)$: of many ZIP codes with population $10{,}000$, about $19$
in $20$ would have sales between $0$ and $\$14{,}641$, the negative lower limit being
truncated at zero.
<<lottery-pred>>=
x0 <- 10000; xp <- lottery$POP
h0 <- 1/50 + (x0 - mean(xp))^2 / sum((xp - mean(xp))^2)
c(se_pred = s_lot * sqrt(1 + h0), se_mean = s_lot * sqrt(h0))
predict(fit_lot, data.frame(POP = x0), interval = "prediction")
predict(fit_lot, data.frame(POP = x0), interval = "confidence")
@
\end{example}

\begin{example}[Advertising, continued; ISLR §3.2.2]\label{ex:adv-pred}
With $\$100{,}000$ on television and $\$20{,}000$ on radio, the fitted sales are
$11{,}256$ units; the $95\%$ confidence interval for the \emph{average} sales of such
markets is $[10{,}985,\,11{,}528]$ and the prediction interval for one such market is
$[7{,}930,\,14{,}583]$.
<<adv-pred>>=
nd <- data.frame(TV = 100, radio = 20)
rbind(confidence = predict(fit_two, nd, interval = "confidence"),
      prediction = predict(fit_two, nd, interval = "prediction"))
@
\end{example}

\begin{example}[The capital asset pricing model; FREES §2.7]\label{ex:capm}
Monthly returns of the Lincoln National Insurance Corporation ($y$) and of the equally
weighted S\&P 500 index ($x$) over $1986$--$1990$, $n=60$. The CAPM posits
$\expc[r]=\beta_0+\beta_1r_m$; $\beta_1$ measures the return attributed to the market,
and securities with $\beta_1>1$ are called \emph{aggressive}, with $\beta_1<1$
\emph{defensive}.
<<capm>>=
capm <- read.csv("data/frees/csv/CAPM.csv")
round(rbind(LINCOLN = descr(capm$LINCOLN), MARKET = descr(capm$MARKET)), 4)
fit_capm <- lm(LINCOLN ~ MARKET, data = capm)
round(coef(summary(fit_capm)), 4)
c(s = summary(fit_capm)$sigma, R2 = summary(fit_capm)$r.squared,
  crash_month = which.min(capm$MARKET), z_crash = (min(capm$MARKET) - mean(capm$MARKET)) / sd(capm$MARKET))
@
<<capm-fig, fig.height=2.6, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 2), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(1:60, capm$LINCOLN, type = "l", xlab = "month (from January 1986)", ylab = "monthly return")
lines(1:60, capm$MARKET, lty = 2)
legend("topright", c("LINCOLN", "MARKET"), lty = 1:2, bty = "n", cex = 0.7)
plot(capm$MARKET, capm$LINCOLN, xlab = "MARKET", ylab = "LINCOLN", pch = 16, cex = 0.6)
abline(fit_capm)
par(op)
@
\begin{figure}[H]\centering
\caption{Time series plots of the two returns, and Lincoln's return against the
market's with the fitted line (FREES Figures 2.10--2.11).}
\end{figure}
The fitted line is $\widehat{\texttt{LINCOLN}}=-0.00214+0.973\,\texttt{MARKET}$ with
$t(b_1)=5.64$: the market is clearly a determinant, yet $R^2=35.4\%$, so it explains
only a third of the variation in Lincoln's return. Lincoln is riskier than the market,
$s_y=0.0859>0.0525=s_x$, and its five-year mean return, $0.51\%$ a month, is below the
market's $0.74\%$. The smallest market return, $-0.221$, is $4.3$ standard deviations
below its mean; it is October 1987, the month of the crash, a high leverage point.
Corollary~\ref{cor:R2-r2} splits the risk of the security into a market component and a
diversifiable one, $s_y^2=b_1^2s_x^2+s^2(n-2)/(n-1)$:
<<capm-decomp>>=
b1c <- coef(fit_capm)[["MARKET"]]; sc <- summary(fit_capm)$sigma
c(s_y2 = var(capm$LINCOLN), market = b1c^2 * var(capm$MARKET),
  diversifiable = sc^2 * 58 / 59, sum = b1c^2 * var(capm$MARKET) + sc^2 * 58 / 59)
@
The CAPM question is whether $\beta_1=1$, the market's own sensitivity. By
Definition~\ref{def:ttest} with $d=1$, $t=(0.973-1)/\SE(b_1)$, and the hypothesis is
not rejected:
<<capm-test>>=
se_b1c <- coef(summary(fit_capm))["MARKET", "Std. Error"]
c(t_beta1_equals_1 = (b1c - 1) / se_b1c, p = 2 * pt(-abs((b1c - 1) / se_b1c), 58))
@
Refitting without the crash month gives $\widehat{\texttt{LINCOLN}}=-0.00181+0.956\,\texttt{MARKET}$
with $R^2=26.4\%$: removing the high leverage point \emph{lowers} $R^2$, because that
month showed the relation over a range the other months do not cover.
<<capm-nocrash>>=
fit_capm1 <- lm(LINCOLN ~ MARKET, data = capm[-22, ])
c(coef(fit_capm1), R2 = summary(fit_capm1)$r.squared, s = summary(fit_capm1)$sigma,
  t = coef(summary(fit_capm1))["MARKET", "t value"])
@
\end{example}

\subsection{Maximum likelihood (beyond the syllabus)}\label{sec:2.5.5}

\begin{reading}
CLM §5. Not in the SRM or PA reading lists.
\end{reading}

\begin{proposition}[Least squares is maximum likelihood]\label{prop:mle}
Under \Aref{1}--\Aref{5}, $\hat\bb$ is the maximum likelihood estimator of $\bb$, and
$\hat\sigma^2_{\mathrm{MLE}}=\SSE/n$, which is biased downward by the factor
$(n-k-1)/n$.
\end{proposition}

\begin{proof}
$\bY\sim N(\bX\bb,\sigma^2\bI_n)$ has density
$(2\pi\sigma^2)^{-n/2}\exp\{-(\bY-\bX\bb)'(\bY-\bX\bb)/(2\sigma^2)\}$, so
\begin{equation}\label{eq:loglik}
\ell(\bb,\sigma^2)=-\frac n2\ln(2\pi)-\frac n2\ln\sigma^2-\frac{Q(\bb)}{2\sigma^2} .
\end{equation}
For fixed $\sigma^2$ only the last term involves $\bb$, with the negative coefficient
$-1/(2\sigma^2)$, so $\ell$ is maximised over $\bb$ where $Q$ is minimised, at $\hat\bb$
by Theorem~\ref{thm:ols}, whatever $\sigma^2$. Substituting $Q(\hat\bb)=\SSE$,
\[
\frac{\partial\ell}{\partial\sigma^2}=-\frac{n}{2\sigma^2}+\frac{\SSE}{2\sigma^4}=0
\ifff \sigma^2=\frac{\SSE}{n},
\]
and $\partial^2\ell/\partial(\sigma^2)^2=n/(2\sigma^4)-\SSE/\sigma^6$ is negative
there, equal to $-n^3/(2\SSE^2)$, so it is a maximum. Its expectation is
$(n-k-1)\sigma^2/n$ by Theorem~\ref{thm:mse-unbiased}.
\end{proof}

\periodmark{End of period 2 of 3.}

%==============================================================================
\section{Residual Analysis and Unusual Points}\label{sec:2.6}
%==============================================================================

\begin{reading}
FREES §2.6 · ISLR §3.1.1 · CLM §2. \ SRM learning outcome 2(d).
\end{reading}

\begin{definition}[Standardised residuals, outliers, high leverage points; FREES §2.6]\label{def:outlier}
The \emph{standardised residual} of observation $i$ is
$e_i/\{s\sqrt{1-h_{ii}}\}$, the residual divided by its estimated standard deviation
(Theorem~\ref{thm:var-resid}); FREES's approximation $e_i/s$ ignores the leverage. An
observation is an \emph{outlier} if it is unusual in the vertical direction, its
standardised residual exceeding $2$ in absolute value, and a \emph{high leverage point}
if it is unusual in the horizontal direction, $h_{ii}$ exceeding $2(k+1)/n$. A point can
be both.
\end{definition}

\begin{remark}[Model discrepancies; FREES §2.6]
Residual analysis checks the assumptions of Definition~\ref{def:assumptions} against the
residuals, which stand in for the unobservable errors, and uses any pattern found to
respecify the model. FREES lists five discrepancies: lack of independence among the
errors; heteroscedasticity, a variance that changes with the observation; a relation
between the errors and an explanatory variable, which means the variable could predict
better; non-normal errors, which invalidate the exact inference of §\ref{sec:2.5}; and
unusual points, single observations that move the fit. Standardised residuals have a
standard normal reference distribution under \Aref{5}, and are dimensionless, so
experience of their size transfers between data sets.
\end{remark}

\begin{example}[Outliers and high leverage points; FREES §2.6]\label{ex:outlier}
FREES's fictitious data: $19$ base points and three unusual points A, B and C.
<<outlier>>=
ol <- read.csv("data/frees/csv/OutlierExample.csv")
one_fit <- function(rows) {
  m <- lm(Y ~ X, data = ol[rows, ])
  c(b0 = coef(m)[[1]], b1 = coef(m)[[2]], s = summary(m)$sigma,
    R2_pct = 100 * summary(m)$r.squared, t_b1 = coef(summary(m))["X", "t value"])
}
round(rbind(base = one_fit(1:19), base_A = one_fit(1:20),
            base_B = one_fit(c(1:19, 21)), base_C = one_fit(c(1:19, 22))), 3)
round(rbind(std_resid = sapply(20:22, function(i) rstandard(lm(Y ~ X, ol[c(1:19, i), ]))[20]),
            leverage  = sapply(20:22, function(i) hatvalues(lm(Y ~ X, ol[c(1:19, i), ]))[20]),
            flag_lev  = 2 * 2 / 20), 3)
@
<<outlier-fig, fig.height=2.6, fig.width=6.4, out.width="0.6\\linewidth", echo=FALSE>>=
op <- par(mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(ol$X, ol$Y, xlim = c(0, 10), ylim = c(2, 9), xlab = "X", ylab = "Y", pch = 16, cex = 0.7)
text(c(4.5, 9.7, 9.7), c(8.0, 8.0, 2.5), c("A", "B", "C"))
abline(lm(Y ~ X, ol[1:19, ]))
par(op)
@
\begin{figure}[H]\centering
\caption{Nineteen base points with the line fitted to them, and the three unusual
points (FREES Figure 2.7).}
\end{figure}
The base points are well fitted: $R^2=89\%$, $s=0.29$, $t(b_1)=11.7$. Adding A, an
outlier at an ordinary $x$, leaves the line much where it was but drops $R^2$ to $54\%$
and triples $s$. B has A's $y$-value at a large $x$ and lies near the base line: it is a
high leverage point but not an outlier, and it \emph{raises} $R^2$ to $95\%$ by
enlarging $\SST$ while leaving $\SSE$ nearly unchanged. C has B's $x$ and a low
$y$-value, so it is both: the slope falls from $0.61$ to $0.16$, $R^2$ to $10\%$, and
the $t$ ratio to $1.4$. One point in twenty can do this, because the coefficients are
weighted sums of the responses (Proposition~\ref{prop:weights}) with weights that grow
with $|x_i-\bar x|$. Removing an outlier always improves the fit; removing a high
leverage point need not.
\end{example}

\begin{example}[Lottery sales, continued: Kenosha; FREES §2.6]\label{ex:kenosha}
The point at the upper left of the scatter plot is the ZIP code containing Kenosha, on
the Illinois border, whose sales are far above what its population predicts.
<<kenosha>>=
i_ken <- which.max(residuals(fit_lot))
c(row = i_ken, POP = lottery$POP[i_ken], SALES = lottery$SALES[i_ken],
  std_resid = rstandard(fit_lot)[i_ken], leverage = hatvalues(fit_lot)[i_ken])
fit_ken <- lm(SALES ~ POP, data = lottery[-i_ken, ])
round(rbind(with_Kenosha = one_fit_lot <- c(coef(fit_lot), s = s_lot,
                R2_pct = 100 * summary(fit_lot)$r.squared,
                t_b1 = coef(summary(fit_lot))["POP", "t value"]),
            without = c(coef(fit_ken), s = summary(fit_ken)$sigma,
                R2_pct = 100 * summary(fit_ken)$r.squared,
                t_b1 = coef(summary(fit_ken))["POP", "t value"])), 3)
@
<<kenosha-fig, fig.height=2.6, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 2), mar = c(3.2, 3.4, 1.6, 0.6), mgp = c(1.9, 0.6, 0))
qqnorm(rstandard(fit_lot), main = "all 50 ZIP codes", cex = 0.6); qqline(rstandard(fit_lot))
qqnorm(rstandard(fit_ken), main = "without Kenosha", cex = 0.6); qqline(rstandard(fit_ken))
par(op)
@
\begin{figure}[H]\centering
\caption{Normal quantile plots of the standardised residuals with and without Kenosha
(FREES Figure 2.9).}
\end{figure}
Kenosha is an outlier with a standardised residual of $4.9$ and ordinary leverage. The
slope and its $t$ ratio barely change when it is removed, but $R^2$ rises from $78.5\%$
to $88.3\%$ and $s$ falls by more than $\$1{,}000$, which matters for prediction
intervals. The quantile plot with Kenosha climbs away from the line at the upper end;
without it the points follow the line much more closely, with mild departures in both
tails, so the apparent non-normality was one observation, not skewness shared by all.
\end{example}

%==============================================================================
\section{Computation in R}\label{sec:2.7}
%==============================================================================

\begin{reading}
FREES §2.8 · ISLR §3.6.1--3.6.3.
\end{reading}

\subsection{Reading regression output}\label{sec:2.7.1}

FREES §2.8 annotates the output of Excel, SAS and R for the lottery regression; every
printed quantity is a formula of this unit.
<<lottery-output>>=
summary(fit_lot)
anova(fit_lot)
@
<<lottery-legend>>=
X_l <- model.matrix(fit_lot); y_l <- lottery$SALES; n_l <- nrow(X_l)
b_l <- solve(crossprod(X_l), crossprod(X_l, y_l))           # (X'X)^{-1} X'y
e_l <- y_l - X_l %*% b_l
SSE_l <- sum(e_l^2); SST_l <- sum((y_l - mean(y_l))^2); SSR_l <- SST_l - SSE_l
s2_l <- SSE_l / (n_l - 2)
se_l <- sqrt(s2_l * diag(solve(crossprod(X_l))))
t_l <- drop(b_l) / se_l
c(n = n_l, b0 = b_l[1], b1 = b_l[2], se_b0 = se_l[1], se_b1 = se_l[2], t_b0 = t_l[1], t_b1 = t_l[2])
c(p_b0 = 2 * pt(-abs(t_l[1]), n_l - 2), p_b1 = 2 * pt(-abs(t_l[2]), n_l - 2),
  s = sqrt(s2_l), R2 = SSR_l / SST_l, R2_adj = 1 - s2_l / (SST_l / (n_l - 1)),
  multiple_R = sqrt(SSR_l / SST_l))
c(SSR = SSR_l, SSE = SSE_l, SST = SST_l, MSR = SSR_l / 1, MSE = s2_l,
  F = (SSR_l / 1) / s2_l, p_F = pf((SSR_l / 1) / s2_l, 1, n_l - 2, lower.tail = FALSE))
@
The coefficient table holds $\hat\beta_j$, $\SE(\hat\beta_j)$, the $t$ ratio for
$H_0\colon\beta_j=0$ and its two-sided $p$-value (Definition~\ref{def:ttest}); the
residual standard error is $s$ on $n-k-1$ degrees of freedom; \texttt{Multiple
R-squared} and \texttt{Adjusted R-squared} are~\eqref{eq:R2}; the $F$ statistic
is~\eqref{eq:F} on $(k,n-k-1)$ degrees of freedom; and \texttt{anova} prints the
regression and error rows of the ANOVA table, the total row being their sum.

\subsection{The ISLR lab}\label{sec:2.7.2}

The \texttt{Boston} data of \texttt{ISLR2}: the median house value \texttt{medv} of
$506$ census tracts with $12$ predictors, among them \texttt{lstat}, the percentage of
households of low socioeconomic status.
<<lab-slr>>=
lm.fit <- lm(medv ~ lstat, data = Boston)
summary(lm.fit)
names(lm.fit)
coef(lm.fit)
confint(lm.fit)
@
\texttt{predict} gives the confidence interval for the mean response and the prediction
interval for a new response at chosen values of the predictor
(Theorem~\ref{thm:pred}): at $\texttt{lstat}=10$ the fitted value is $25.05$, the
confidence interval $(24.47,25.63)$ and the prediction interval $(12.83,37.28)$.
<<lab-predict>>=
predict(lm.fit, data.frame(lstat = c(5, 10, 15)), interval = "confidence")
predict(lm.fit, data.frame(lstat = c(5, 10, 15)), interval = "prediction")
@
<<lab-plot, fig.height=2.6, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 3), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(Boston$lstat, Boston$medv, xlab = "lstat", ylab = "medv", pch = 16, cex = 0.4)
abline(lm.fit, lwd = 2, col = "#B45309")
plot(predict(lm.fit), residuals(lm.fit), xlab = "fitted", ylab = "residual", pch = 16, cex = 0.4)
abline(h = 0, lty = 2)
plot(hatvalues(lm.fit), xlab = "observation", ylab = "leverage", pch = 16, cex = 0.4)
abline(h = 2 * 2 / 506, lty = 2)
par(op)
@
\begin{figure}[H]\centering
\caption{\texttt{medv} against \texttt{lstat} with the least squares line; residuals
against fitted values; leverages with the flag $2(k+1)/n$.}
\end{figure}
The residuals bend: negative in the middle, positive at both ends, so the relation is not
linear. Leverage is computed by \texttt{hatvalues}, and \texttt{which.max} names the
observation with the largest.
<<lab-leverage>>=
c(max_leverage = max(hatvalues(lm.fit)), at = which.max(hatvalues(lm.fit)),
  mean_leverage = 2 / 506, lstat_there = Boston$lstat[which.max(hatvalues(lm.fit))],
  max_lstat = max(Boston$lstat))
@
Several predictors are joined by \texttt{+}, all of them by \texttt{.}, and all but one
by \texttt{- age}; \texttt{update} refits with a changed formula.
<<lab-mlr, output.lines=18>>=
lm.fit2 <- lm(medv ~ lstat + age, data = Boston)
round(coef(summary(lm.fit2)), 5)
lm.fit3 <- lm(medv ~ ., data = Boston)
summary(lm.fit3)
@
<<lab-mlr-2>>=
c(R2 = summary(lm.fit3)$r.squared, RSE = summary(lm.fit3)$sigma)
lm.fit4 <- update(lm.fit3, ~ . - age)
c(R2_without_age = summary(lm.fit4)$r.squared, RSE_without_age = summary(lm.fit4)$sigma)
@
Dropping \texttt{age}, whose $p$-value is $0.96$, leaves $R^2$ unchanged to three
decimals and lowers the residual standard error, as Theorem~\ref{thm:adj-R2} requires
of a variable with $|t|<1$.

\subsection{Formulas against package output}\label{sec:2.7.3}

The fit is \texttt{medv} on \texttt{lstat}, \texttt{age} and \texttt{rm}, $k=3$.
<<data-setup>>=
fit <- lm(medv ~ lstat + age + rm, data = Boston)
X <- model.matrix(fit); y <- Boston$medv; e <- residuals(fit)
n <- nrow(X); k <- ncol(X) - 1L
c(n = n, k = k, df = n - k - 1L)
@
<<ols-by-hand>>=
XtX   <- t(X) %*% X
b_man <- drop(solve(XtX, t(X) %*% y))         # (X'X)^{-1} X'Y without forming the inverse
cbind(manual = b_man, lm = coef(fit), diff = b_man - coef(fit))
@
\texttt{lm} does not form $\bX'\bX$ at all; it factors $\bX=\bQ\bR$, which avoids
squaring the condition number. Equation~\eqref{eq:ols} is how least squares is reasoned
about, not how it is computed.
<<vcov-check>>=
s2    <- sum(e^2) / (n - k - 1)               # MSE
V_man <- s2 * solve(XtX)                      # s^2 (X'X)^{-1}
c(max_abs_diff = max(abs(V_man - vcov(fit))), s2_manual = s2, s2_lm = summary(fit)$sigma^2)
@
<<hat-matrix>>=
H <- X %*% solve(XtX) %*% t(X); M <- diag(n) - H
c(symmetric = max(abs(H - t(H))), idempotent = max(abs(H %*% H - H)),
  HM_zero = max(abs(H %*% M)), MX_zero = max(abs(M %*% X)),
  tr_H = sum(diag(H)), tr_M = sum(diag(M)))
c(fitted = max(abs(drop(H %*% y) - fitted(fit))), resid = max(abs(drop(M %*% y) - e)),
  leverage = max(abs(diag(H) - hatvalues(fit))),
  Xt_e = max(abs(t(X) %*% e)), sum_e = sum(e), yhat_t_e = sum(fitted(fit) * e))
@
<<rstandard-check>>=
r_man <- e / (sqrt(s2) * sqrt(1 - hatvalues(fit)))
c(max_abs_diff = max(abs(r_man - rstandard(fit))), h_min = min(hatvalues(fit)),
  h_max = max(hatvalues(fit)))
@
<<inference-check>>=
se_man <- sqrt(diag(V_man)); t_man <- coef(fit) / se_man
p_man  <- 2 * pt(abs(t_man), df = n - k - 1, lower.tail = FALSE)
tab    <- coef(summary(fit))
round(cbind(se_man, se_lm = tab[, 2], t_man, t_lm = tab[, 3], p_man, p_lm = tab[, 4]), 8)
@
<<anova-check>>=
SSE <- sum(e^2); SST <- sum((y - mean(y))^2); SSR <- SST - SSE
seq_ss <- anova(fit)[["Sum Sq"]]                # sequential sums of squares
c(SSR = SSR, sum_sequential = sum(seq_ss[1:k]), SSE = SSE, anova_residual = seq_ss[k + 1L],
  SSR_projection = sum(((H - matrix(1/n, n, n)) %*% y)^2))
R2 <- 1 - SSE / SST; adjR2 <- 1 - (n - 1) / (n - k - 1) * (1 - R2)
F_man <- (SSR / k) / (SSE / (n - k - 1))
c(R2 = R2, R2_lm = summary(fit)$r.squared, R2_cor2 = cor(y, fitted(fit))^2,
  adj = adjR2, adj_lm = summary(fit)$adj.r.squared,
  F = F_man, F_lm = summary(fit)$fstatistic[["value"]],
  F_anova_null = anova(lm(medv ~ 1, data = Boston), fit)[["F"]][2],
  R2_from_F = k * F_man / (k * F_man + n - k - 1))
@
<<predict-check>>=
x0 <- c(1, lstat = 10, age = 60, rm = 6.5); nd0 <- data.frame(lstat = 10, age = 60, rm = 6.5)
lev0 <- drop(t(x0) %*% solve(XtX) %*% x0); tq <- qt(0.975, n - k - 1)
pr <- predict(fit, nd0, se.fit = TRUE)
c(yhat_manual = sum(x0 * coef(fit)), yhat_R = unname(pr$fit),
  se_fit_manual = sqrt(s2 * lev0), se_fit_R = pr$se.fit, width_ratio = sqrt((1 + lev0) / lev0))
rbind(manual = c(pr$fit + c(-1, 1) * tq * sqrt(s2 * lev0), pr$fit + c(-1, 1) * tq * sqrt(s2 * (1 + lev0))),
      R      = c(predict(fit, nd0, interval = "confidence")[2:3],
                 predict(fit, nd0, interval = "prediction")[2:3]))
@
At this point the prediction interval is $21$ times as wide as the confidence interval,
the ratio being $\sqrt{(1+h_0)/h_0}$ by Theorem~\ref{thm:pred}.
<<nointercept-check>>=
m_no <- lm(medv ~ lstat - 1, data = Boston)
c(R2_with = summary(lm.fit)$r.squared, R2_without = summary(m_no)$r.squared,
  SSE_with = sum(residuals(lm.fit)^2), SSE_without = sum(residuals(m_no)^2),
  sum_resid_without = sum(residuals(m_no)))
@
Without an intercept the residuals do not sum to zero, Theorem~\ref{thm:anova} does not
apply, and R switches to an uncentred $R^2$ that is larger although $\SSE$ is larger:
the two $R^2$ values are not comparable.

\subsection{Maximum likelihood in R (beyond the syllabus)}\label{sec:2.7.4}

<<loglik-check>>=
s2_mle <- SSE / n
ll_man <- -n/2 * log(2*pi) - n/2 * log(s2_mle) - SSE / (2 * s2_mle)
c(s2_unbiased = s2, s2_mle = s2_mle, ratio = s2_mle / s2, factor = (n - k - 1) / n,
  loglik_manual = ll_man, loglik_R = as.numeric(logLik(fit)), npar_R = attr(logLik(fit), "df"))
@
\texttt{logLik} uses $\hat\sigma^2_{\mathrm{MLE}}$ of Proposition~\ref{prop:mle} and counts
$k+2$ parameters, the coefficients and $\sigma$.

\subsection{The sampling theory by simulation}\label{sec:2.7.5}

The design is held fixed, as \Aref{1}--\Aref{5} require, and only the errors are
redrawn: the means of the estimates, their variances, the moments of $\SSE/\sigma^2$
and its independence from $\hat\bb$ are Theorems~\ref{thm:unbiased},
\ref{thm:var-beta}, \ref{thm:sse-dist}.
<<simulation>>=
set.seed(1)
Xs <- X[1:60, ]; ns <- nrow(Xs); ks <- ncol(Xs) - 1L
beta_true <- c(10, -0.5, 0.02, 3); sigma <- 4; B <- 5000
bhat <- matrix(NA_real_, B, ks + 1L); sse <- numeric(B)
for (bb in seq_len(B)) {
  ysim <- drop(Xs %*% beta_true) + rnorm(ns, sd = sigma)
  f <- lm.fit(Xs, ysim)
  bhat[bb, ] <- f$coefficients; sse[bb] <- sum(f$residuals^2)
}
rbind(true = beta_true, mean_bhat = colMeans(bhat))
round(cbind(empirical = apply(bhat, 2, var), theory = sigma^2 * diag(solve(t(Xs) %*% Xs))), 5)
c(mean_SSE_over_s2 = mean(sse) / sigma^2, df = ns - ks - 1L,
  var_SSE_over_s2 = var(sse / sigma^2), two_df = 2 * (ns - ks - 1L))
round(cor(bhat, sse), 4)
@
<<sse-hist, fig.height=2.4, fig.width=6.4, out.width="0.6\\linewidth", echo=FALSE>>=
op <- par(mar = c(3.2, 3.4, 1, 1), mgp = c(1.9, 0.6, 0))
hist(sse / sigma^2, breaks = 40, freq = FALSE, col = "grey88", border = "white",
     main = "", xlab = expression(SSE/sigma^2))
curve(dchisq(x, df = ns - ks - 1), add = TRUE, lwd = 2, col = "#B45309")
par(op)
@
\begin{figure}[H]\centering
\caption{Simulated $\SSE/\sigma^2$ over $5000$ replications on a fixed design of $60$
rows against the $\chi^2_{56}$ density.}
\end{figure}
The mean and variance of $\SSE/\sigma^2$ are those of $\chi^2_{56}$, $56$ and $112$, and
its correlations with the four estimates are zero to Monte-Carlo error.

\periodmark{End of period 3 of 3.}

%==============================================================================
\section{Exercises}\label{sec:2.8}
%==============================================================================

\begin{exercise}[FREES exercise 2.1]\label{ex:f2-1}
For the data $x=(2,-6,7)$, $y=(3,4,6)$, fit a line by least squares: determine $r$, $b_1$
and $b_0$.
\end{exercise}

\begin{solution}
$\bar x=1$ and $\bar y=13/3$; the deviations are $(1,-7,6)$ and $(-4/3,-1/3,5/3)$, so
$\sum_i(x_i-\bar x)(y_i-\bar y)=-4/3+7/3+10=11$, $\sum_i(x_i-\bar x)^2=1+49+36=86$ and
$\sum_i(y_i-\bar y)^2=(16+1+25)/9=14/3$. By~\eqref{eq:corr} and
Corollary~\ref{cor:slr-ls},
\[
r=\frac{11}{\sqrt{86\cdot14/3}}=0.549,\qquad b_1=\frac{11}{86}=0.128,\qquad
b_0=\frac{13}{3}-\frac{11}{86}=4.205 .
\]
<<ex-f2-1>>=
xa <- c(2, -6, 7); ya <- c(3, 4, 6)
c(r = cor(xa, ya), b1 = 11/86, b0 = 13/3 - 11/86); coef(lm(ya ~ xa))
@
\end{solution}

\begin{exercise}[FREES exercise 2.2]\label{ex:f2-2}
For $x=(-2,-1,0,1,2)$ and $y=x^2=(4,1,0,1,4)$: (a) graph the data; (b) check that $r=0$.
\end{exercise}

\begin{solution}
<<ex-f2-2, fig.height=2.4, fig.width=3.0, out.width="0.4\\linewidth">>=
xq <- -2:2; yq <- xq^2
c(r = cor(xq, yq), cross_products = sum((xq - mean(xq)) * (yq - mean(yq))))
plot(xq, yq, pch = 16, xlab = "x", ylab = "y")
@
(b) $\bar x=0$ and $\bar y=2$, so $\sum_i(x_i-\bar x)(y_i-\bar y)=\sum_ix_i(y_i-2)
=(-2)(2)+(-1)(-1)+0+(1)(-1)+(2)(2)=0$ and $r=0$: a perfect relation that is not linear
has zero correlation, since by Proposition~\ref{prop:corr-bounds} $|r|=1$ needs a
straight line.
\end{solution}

\begin{exercise}[FREES exercise 2.3]\label{ex:f2-3}
With $a$ and $c$ constants and standardised values $u_i=(x_i-\bar x)/s_x$,
$v_i=(y_i-\bar y)/s_y$: (a) verify
$0\leqslant(n-1)^{-1}\sum_i(au_i-cv_i)^2=a^2+c^2-2acr$; (b) deduce
$2ac(r-1)\leqslant(a-c)^2$; (c) take $a=c$ to show $r\leqslant1$; (d) take $a=-c$ to show
$r\geqslant-1$; (e) when is $r=-1$, and when $r=1$?
\end{exercise}

\begin{solution}
(a) The left side is a mean of squares, hence non-negative. Expanding,
$(n-1)^{-1}\sum_i(au_i-cv_i)^2=a^2(n-1)^{-1}\sum_iu_i^2+c^2(n-1)^{-1}\sum_iv_i^2
-2ac(n-1)^{-1}\sum_iu_iv_i$, and $(n-1)^{-1}\sum_iu_i^2=s_x^2/s_x^2=1$, likewise for
$v$, while $(n-1)^{-1}\sum_iu_iv_i=r$ by~\eqref{eq:corr}.
(b) $a^2+c^2-2acr\geqslant0$ is $2acr\leqslant a^2+c^2$; subtracting $2ac$ from both
sides, $2ac(r-1)\leqslant a^2-2ac+c^2=(a-c)^2$.
(c) With $a=c\neq0$, (b) reads $2a^2(r-1)\leqslant0$, so $r\leqslant1$.
(d) With $a=-c\neq0$, (b) reads $-2a^2(r-1)\leqslant4a^2$, that is $r-1\geqslant-2$, so
$r\geqslant-1$.
(e) $r=1$ iff the sum in (a) vanishes at $a=c$, that is $u_i=v_i$ for every $i$: each
$y_i$ is the same number of standard deviations from its mean as $x_i$, the points lying
on a line of positive slope $s_y/s_x$. $r=-1$ iff $u_i=-v_i$ for every $i$, a line of
negative slope. This is Proposition~\ref{prop:corr-bounds} by another route.
\end{solution}

\begin{exercise}[FREES exercise 2.4]\label{ex:f2-4}
Show that $b_0=\sum_iw_{i,0}y_i$ is a weighted sum of the responses and express
$w_{i,0}$ through the slope weights $w_i$ of Proposition~\ref{prop:weights}.
\end{exercise}

\begin{solution}
$b_0=\bar y-b_1\bar x=\sum_i\tfrac1ny_i-\bar x\sum_iw_iy_i=\sum_i(\tfrac1n-\bar xw_i)y_i$,
so $w_{i,0}=1/n-\bar xw_i$. The weights sum to $1$, since $\sum_iw_i=0$, and $b_0$ is the
mean of the responses when $\bar x=0$.
\end{solution}

\begin{exercise}[FREES exercise 2.5]\label{ex:f2-5}
(a) With $\mathit{slope}_i=(y_i-\bar y)/(x_i-\bar x)$ the slope from $(\bar x,\bar y)$
to $(x_i,y_i)$, show $b_1=\sum_i\mathit{weight}_i\,\mathit{slope}_i/\sum_i\mathit{weight}_i$
and identify $\mathit{weight}_i$. (b) With $\bar x=4$, $\bar y=3$, $x_1=2$, $y_1=6$,
find $\mathit{slope}_1$ and $\mathit{weight}_1$.
\end{exercise}

\begin{solution}
(a) With $\mathit{weight}_i=(x_i-\bar x)^2$,
$\sum_i\mathit{weight}_i\,\mathit{slope}_i=\sum_i(x_i-\bar x)(y_i-\bar y)$ and
$\sum_i\mathit{weight}_i=\sum_i(x_i-\bar x)^2$, whose ratio is $b_1$ by
Corollary~\ref{cor:slr-ls}: the least squares slope is the average of the point slopes
weighted by squared distance from $\bar x$, which is why distant points dominate.
(b) $\mathit{slope}_1=(6-3)/(2-4)=-1.5$ and $\mathit{weight}_1=(2-4)^2=4$.
\end{solution}

\begin{exercise}[FREES exercise 2.6]\label{ex:f2-6}
Let $b_{y|x}$ be the slope from regressing $y$ on $x$ and $b_{x|y}$ that from regressing
$x$ on $y$, both with intercepts. Show $|r|=\sqrt{b_{y|x}\,b_{x|y}}$.
\end{exercise}

\begin{solution}
By Corollary~\ref{cor:slr-ls}, $b_{y|x}=r\,s_y/s_x$ and, exchanging the roles of the
variables, $b_{x|y}=r\,s_x/s_y$. Their product is $r^2$, so $|r|=\sqrt{b_{y|x}b_{x|y}}$;
the two slopes share the sign of $r$. Drawn on the same axes the second line has slope
$1/b_{x|y}=s_y/(rs_x)$, and the ratio of the first slope to it is $r^2$: the lines
coincide iff $r^2=1$, and otherwise the regression of $y$ on $x$ is the flatter. In
standard units the fitted line is $\hat v=ru$, so a value one standard deviation above
average in $x$ is predicted $|r|<1$ standard deviations above average in $y$, the
regression toward the mean of Unit 1.
\end{solution}

\begin{exercise}[FREES exercise 2.7]\label{ex:f2-7}
For regression through the origin, $y_i=\beta_1x_i+\varepsilon_i$: (a) verify
$b_1=\sum_ix_iy_i/\sum_ix_i^2$; (b) find the least squares estimate in the model
$y_i=\beta_1z_i^2+\varepsilon_i$.
\end{exercise}

\begin{solution}
(a) $\mathrm{d}\sum_i(y_i-bx_i)^2/\mathrm{d}b=-2\sum_ix_i(y_i-bx_i)=0$ gives
$b\sum_ix_i^2=\sum_ix_iy_i$, and the second derivative $2\sum_ix_i^2>0$ makes it the
minimum; this is Corollary~\ref{cor:origin}. (b) The model is linear in $\beta_1$ with
explanatory variable $x_i=z_i^2$, so $b_1=\sum_iz_i^2y_i/\sum_iz_i^4$.
\end{solution}

\begin{exercise}[FREES exercise 2.8]\label{ex:f2-8}
Show (a) $\sum_i(y_i-\bar y)^2=\sum_iy_i^2-n\bar y^2$;
(b) $\sum_i(y_i-\bar y)(x_i-\bar x)=\sum_ix_iy_i-n\bar x\bar y$;
(c) $b_1=\sum_i(y_i-\bar y)(x_i-\bar x)/\sum_i(x_i-\bar x)^2$; and
(d) $b_1=(\sum_ix_iy_i-n\bar x\bar y)/(\sum_ix_i^2-n\bar x^2)$.
\end{exercise}

\begin{solution}
(a) $\sum_i(y_i-\bar y)^2=\sum_iy_i^2-2\bar y\sum_iy_i+n\bar y^2=\sum_iy_i^2-2n\bar y^2+n\bar y^2$.
(b) $\sum_i(y_i-\bar y)(x_i-\bar x)=\sum_ix_iy_i-\bar x\sum_iy_i-\bar y\sum_ix_i+n\bar x\bar y
=\sum_ix_iy_i-n\bar x\bar y$.
(c) is the first form of~\eqref{eq:slr-ls}, from the normal equations. (d) Substitute
(a), applied to $x$, and (b) into (c).
\end{solution}

\begin{exercise}[FREES exercise 2.9]\label{ex:f2-9}
Suppose $x_i$ takes only the values $0$ and $1$: $n_1$ observations have $x=0$ with mean
response $\bar y_1$, and $n_2=n-n_1$ have $x=1$ with mean $\bar y_2$. Show
$b_1=\bar y_2-\bar y_1$ and $b_0=\bar y_1$, and give $\SE(b_1)$ in terms of $n_1$, $n_2$
and $s$.
\end{exercise}

\begin{solution}
$\bar x=n_2/n$ and $x_i^2=x_i$, so
$\sum_i(x_i-\bar x)^2=\sum_ix_i^2-n\bar x^2=n_2-n_2^2/n=n_1n_2/n$, and
$\sum_i(x_i-\bar x)(y_i-\bar y)=\sum_ix_iy_i-n\bar x\bar y
=n_2\bar y_2-\tfrac{n_2}{n}(n_1\bar y_1+n_2\bar y_2)=\tfrac{n_1n_2}{n}(\bar y_2-\bar y_1)$.
By Corollary~\ref{cor:slr-ls} the ratio is $b_1=\bar y_2-\bar y_1$, and
$b_0=\bar y-b_1\bar x=\tfrac1n(n_1\bar y_1+n_2\bar y_2)-\tfrac{n_2}{n}(\bar y_2-\bar y_1)=\bar y_1$.
The fitted values are the two group means, so $\SSE$ is the within-group sum of squares
and $s^2$ the pooled variance on $n-2$ degrees of freedom; by
Corollary~\ref{cor:slr-var},
\[
\SE(b_1)=\frac{s}{\sqrt{n_1n_2/n}}=s\sqrt{\frac1{n_1}+\frac1{n_2}} ,
\]
so $t(b_1)$ is the pooled two-sample $t$ statistic: regression on one indicator is the
two-sample comparison of means.
\end{solution}

\begin{exercise}[FREES exercise 2.10]\label{ex:f2-10}
Nursing home data of 2000 (\texttt{WiscNursingHome}, Unit 1). Part 1: (a) the
correlations (i) between \texttt{TPY} and $\texttt{LOGTPY}=\ln\texttt{TPY}$, (ii) among
\texttt{TPY}, \texttt{NUMBED} and \texttt{SQRFOOT}, (iii) between \texttt{TPY} and
$\texttt{NUMBED}/10$; (b) scatter plots of \texttt{TPY} against \texttt{NUMBED} and
against \texttt{SQRFOOT}; (c) regressions of \texttt{TPY} on \texttt{NUMBED}, of
\texttt{TPY} on \texttt{SQRFOOT}, of \texttt{LOGTPY} on $\ln\texttt{NUMBED}$ and of
\texttt{LOGTPY} on $\ln\texttt{SQRFOOT}$, each summarised by $R^2$ and the $t$ ratio
of the slope. Part 2: refit \texttt{TPY} on \texttt{NUMBED} for 2001.
\end{exercise}

\begin{solution}
<<ex-f2-10>>=
nh <- read.csv("data/frees/csv/WiscNursingHome.csv")
nh0 <- subset(nh, CRYEAR == 2000); nh1 <- subset(nh, CRYEAR == 2001)
c(cor_TPY_logTPY = cor(nh0$TPY, log(nh0$TPY)), cor_TPY_NUMBED_over_10 = cor(nh0$TPY, nh0$NUMBED / 10))
round(cor(nh0[, c("TPY", "NUMBED", "SQRFOOT")], use = "complete.obs"), 3)
one_slr <- function(f, d) { m <- lm(f, d)
  c(n = nobs(m), b1 = coef(m)[[2]], R2 = summary(m)$r.squared, t_b1 = coef(summary(m))[2, 3]) }
round(rbind(TPY_NUMBED = one_slr(TPY ~ NUMBED, nh0), TPY_SQRFOOT = one_slr(TPY ~ SQRFOOT, nh0),
            logTPY_logNUMBED = one_slr(log(TPY) ~ log(NUMBED), nh0),
            logTPY_logSQRFOOT = one_slr(log(TPY) ~ log(SQRFOOT), nh0),
            TPY_NUMBED_2001 = one_slr(TPY ~ NUMBED, nh1)), 3)
@
<<ex-f2-10-fig, fig.height=2.4, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 2), mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(nh0$NUMBED, nh0$TPY, xlab = "NUMBED", ylab = "TPY", pch = 16, cex = 0.5)
plot(nh0$SQRFOOT, nh0$TPY, xlab = "SQRFOOT", ylab = "TPY", pch = 16, cex = 0.5)
par(op)
@
(a)(i) The correlation between \texttt{TPY} and its logarithm is $0.937$: the
logarithm is increasing, so the association is strong, but it is not linear, so $r<1$.
(ii) \texttt{TPY} and \texttt{NUMBED} are correlated at $0.979$, the square footage
with either at about $0.82$. (iii) Dividing \texttt{NUMBED} by $10$ leaves the
correlation at $0.979$, by the scale invariance of Proposition~\ref{prop:corr-bounds}.
(b) Patient years rise linearly with beds along a tight band; against square footage the
band is wider. (c) On \texttt{NUMBED}, $R^2=0.959$ with $t=91$; on \texttt{SQRFOOT},
$R^2=0.680$ with $t=27$ on the $357$ facilities that report it, so beds fit far better.
In logarithms the slope on $\ln\texttt{NUMBED}$ is $1.01$, an elasticity of one, with
$R^2=0.948$; on $\ln\texttt{SQRFOOT}$, $R^2=0.677$. Part 2: in 2001 the slope on
\texttt{NUMBED} is $0.932$ against $0.921$ in 2000, with $R^2=0.976$: the relation is
stable.
\end{solution}

\begin{exercise}[FREES exercise 2.11]\label{ex:f2-11}
For $n=3$, $e_2=24$ and $e_3=-1$; determine $e_1$.
\end{exercise}

\begin{solution}
By Theorem~\ref{thm:normal-eq}\ref{ne:ii} the residuals of a fit with an intercept sum
to zero, so $e_1=-(24-1)=-23$.
\end{solution}

\begin{exercise}[FREES exercise 2.12]\label{ex:f2-12}
With $r=0$, $n=15$ and $s_y=10$, determine $s$.
\end{exercise}

\begin{solution}
By Corollary~\ref{cor:R2-r2}, $R^2=r^2=0$, so $\SSR=0$ and
$\SSE=\SST=(n-1)s_y^2=14(100)=1400$; then $s^2=\SSE/(n-2)=1400/13=107.7$ and
$s=10.38$. The line explains nothing, and $s$ exceeds $s_y$ because a degree of freedom
was spent on the useless slope.
\end{solution}

\begin{exercise}[FREES exercise 2.13]\label{ex:f2-13}
(a) Show $\hat y_i-\bar y=b_1(x_i-\bar x)$; (b) deduce
$\SSR=b_1^2s_x^2(n-1)$; (c) establish $R^2=r^2$.
\end{exercise}

\begin{solution}
(a) $\hat y_i-\bar y=b_0+b_1x_i-\bar y=(\bar y-b_1\bar x)+b_1x_i-\bar y=b_1(x_i-\bar x)$.
(b) Squaring and summing, $\SSR=b_1^2\sum_i(x_i-\bar x)^2=b_1^2(n-1)s_x^2$.
(c) With $b_1=r\,s_y/s_x$, $\SSR=r^2(n-1)s_y^2=r^2\SST$, so $R^2=\SSR/\SST=r^2$; this
is Corollary~\ref{cor:R2-r2}.
\end{solution}

\begin{exercise}[FREES exercise 2.14]\label{ex:f2-14}
Show that the average residual is zero.
\end{exercise}

\begin{solution}
The first normal equation, $\sum_i(y_i-b_0-b_1x_i)=0$, is $\sum_ie_i=0$; in general it is
the first row of $\bX'\mathbf e=\bzero$, Theorem~\ref{thm:normal-eq}\ref{ne:ii}, and
holds because the intercept column $\bone$ is in the design.
\end{solution}

\begin{exercise}[FREES exercise 2.15]\label{ex:f2-15}
(a) If $\bar x=0$ or $\bar y=0$, show that $r(y,x)=0$ iff $\sum_iy_ix_i=0$. (b) Show
that the residuals are uncorrelated with the explanatory variable, and (c) with the
fitted values.
\end{exercise}

\begin{solution}
(a) $\sum_i(y_i-\bar y)(x_i-\bar x)=\sum_iy_ix_i-n\bar x\bar y$ by
Exercise~\ref{ex:f2-8}(b), and the second term vanishes when either mean is zero; so the
numerator of $r$ is $\sum_iy_ix_i$ and, the denominator being positive, $r=0$ iff the
sum is zero. (b) $\bar e=0$ by Exercise~\ref{ex:f2-14}, and
$\sum_ix_ie_i=0$ is the second normal equation (Theorem~\ref{thm:normal-eq}\ref{ne:i}),
so by (a) with $y$ replaced by $e$, $r(e,x)=0$. (c) $\sum_i\hat y_ie_i=0$ is
Theorem~\ref{thm:normal-eq}\ref{ne:iii}, and $\bar e=0$ again gives $r(e,\hat y)=0$.
\end{solution}

\begin{exercise}[FREES exercise 2.16]\label{ex:f2-16}
Show (a) $R^2=1-\frac{n-2}{n-1}\,\frac{s^2}{s_y^2}$;
(b) $s=s_y\sqrt{(1-r^2)\frac{n-1}{n-2}}$; (c) $t(b_1)=\sqrt{n-2}\,\dfrac{r}{\sqrt{1-r^2}}$.
\end{exercise}

\begin{solution}
(a) $R^2=1-\SSE/\SST$ with $\SSE=(n-2)s^2$ and $\SST=(n-1)s_y^2$.
(b) Solve (a) for $s^2$ using $R^2=r^2$: $s^2=s_y^2(1-r^2)(n-1)/(n-2)$.
(c) By Definition~\ref{def:se} and Corollary~\ref{cor:slr-ls},
\begin{align*}
t(b_1)&=\frac{b_1}{\SE(b_1)}=\frac{r\,s_y/s_x}{s/(s_x\sqrt{n-1})}=\frac{r\,s_y\sqrt{n-1}}{s}\\
&=\frac{r\,s_y\sqrt{n-1}}{s_y\sqrt{(1-r^2)(n-1)/(n-2)}}=\sqrt{n-2}\,\frac{r}{\sqrt{1-r^2}} .
\end{align*}
The $t$ statistic is a function of $r$ and $n$ alone, symmetric in $x$ and $y$, so
regressing $x$ on $y$ gives the same $t$; for the lottery data,
$\sqrt{48}\,(0.886)/\sqrt{1-0.785}=13.3$.
\end{solution}

\begin{exercise}[FREES exercise 2.17]\label{ex:f2-17}
In a regression with one predictor on $n=100$ observations the tenth residual is large.
What percentage of $\SSE$ is due to it if (a) $e_{10}=8s$; (b) $e_{10}=4s$; (c)
$e_{10}=4s$ with $n=20$?
\end{exercise}

\begin{solution}
$\SSE=(n-2)s^2$, so $e_{10}^2/\SSE=c^2/(n-2)$ when $e_{10}=cs$: (a) $64/98=65.3\%$;
(b) $16/98=16.3\%$; (c) $16/18=88.9\%$. A residual of $8s$ at $n=100$ owns two thirds
of the error sum of squares, and $c^2\leqslant n-2$ is forced, since one squared
residual cannot exceed their sum.
\end{solution}

\begin{exercise}[FREES exercise 2.18]\label{ex:f2-18}
With $n=20$, $\bar x=0$, $\bar y=9$, $s_x=1$, $s_y=10$ and $s=7$, determine the standard
error of a prediction at $x_\ast=1$.
\end{exercise}

\begin{solution}
By Theorem~\ref{thm:pred}\ref{pred:iii},
\[
\SE(\mathrm{pred})=7\sqrt{1+\frac1{20}+\frac{(1-0)^2}{19(1)}}=7\sqrt{1.1026}=7.35 ,
\]
almost all of it the $\sigma$ of the new observation; $\bar y$ and $s_y$ are not needed.
\end{solution}

\begin{exercise}[FREES exercise 2.19]\label{ex:f2-19}
Anscombe's data (\texttt{AnscombesData}): (a) compute the means and standard deviations
of each column; (b) regress $y_1$, $y_2$, $y_3$ on $x_1$ and $y_4$ on $x_2$, and verify
$b_0\approx3.0$, $b_1\approx0.5$, $s\approx1.237$, $R^2\approx0.677$ in each case;
(c) draw the four scatter plots; (d) discuss.
\end{exercise}

\begin{solution}
<<ex-f2-19>>=
an <- read.csv("data/frees/csv/AnscombesData.csv")
round(sapply(an[, -1], function(v) c(mean = mean(v), sd = sd(v))), 3)
one_fit_a <- function(f) { m <- lm(f, an)
  c(b0 = coef(m)[[1]], b1 = coef(m)[[2]], s = summary(m)$sigma, R2 = summary(m)$r.squared) }
round(rbind(y1_x1 = one_fit_a(y1 ~ x1), y2_x1 = one_fit_a(y2 ~ x1),
            y3_x1 = one_fit_a(y3 ~ x1), y4_x2 = one_fit_a(y4 ~ x2)), 3)
@
<<ex-f2-19-fig, fig.height=2.2, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 4), mar = c(3.2, 3.2, 1.2, 0.4), mgp = c(1.9, 0.6, 0))
for (p in list(c("x1", "y1"), c("x1", "y2"), c("x1", "y3"), c("x2", "y4"))) {
  plot(an[[p[1]]], an[[p[2]]], xlab = p[1], ylab = p[2], pch = 16, cex = 0.7)
  abline(lm(an[[p[2]]] ~ an[[p[1]]]))
}
par(op)
@
(a)--(b) The two $x$ columns share mean $9.00$ and standard deviation $3.32$, the four
$y$ columns mean $7.50$ and standard deviation $2.03$, and the four fits agree in
$b_0$, $b_1$, $s$ and $R^2$ to two decimals. (c)--(d) The plots differ entirely: a
linear relation with scatter; a smooth curve that a line misrepresents; a linear
relation with one outlier that tilts the line; and a single high leverage point that
alone determines the slope, the other ten $x$ values being equal. Summary statistics and
the fitted line cannot distinguish the four, so a regression is read with its scatter
plot.
\end{solution}

\begin{exercise}[FREES exercise 2.20]\label{ex:f2-20}
Nursing home data of 2001, $\texttt{LOGTPY}=\ln\texttt{TPY}$ on
$\texttt{LOGNUMBED}=\ln\texttt{NUMBED}$: (a) summary statistics, the correlation and a
scatter plot; (b) the fit, with $R^2$, the slope and its $t$ ratio; (c) at the $5\%$
level, with $p$-values, test $H_0\colon\beta_1=0$ against $\beta_1\neq0$ and
$H_0\colon\beta_1=1$ against $\beta_1\neq1$, $\beta_1>1$ and $\beta_1<1$; (d) a point
estimate and $95\%$ and $99\%$ confidence intervals for the expected change in
\texttt{LOGTPY} when \texttt{LOGNUMBED} changes by $2$; (e) at $100$ beds, the predicted
\texttt{LOGTPY}, its standard error of prediction, a $95\%$ prediction interval, the
same converted to patient years, and a $90\%$ interval.
\end{exercise}

\begin{solution}
<<ex-f2-20>>=
nh1$LOGTPY <- log(nh1$TPY); nh1$LOGNUMBED <- log(nh1$NUMBED)
round(rbind(LOGTPY = descr(nh1$LOGTPY), LOGNUMBED = descr(nh1$LOGNUMBED)), 3)
fit_nh <- lm(LOGTPY ~ LOGNUMBED, data = nh1)
c(cor = cor(nh1$LOGTPY, nh1$LOGNUMBED), R2 = summary(fit_nh)$r.squared, n = nobs(fit_nh))
round(coef(summary(fit_nh)), 4)
b1n <- coef(fit_nh)[["LOGNUMBED"]]; se1n <- coef(summary(fit_nh))["LOGNUMBED", 2]; t1 <- (b1n - 1) / se1n
c(t_beta1_is_1 = t1, crit_two = qt(0.975, 353), crit_one = qt(0.95, 353),
  p_two = 2 * pt(-abs(t1), 353), p_greater = pt(t1, 353, lower.tail = FALSE), p_less = pt(t1, 353))
rbind(estimate = 2 * b1n, CI95 = 2 * (b1n + c(-1, 1) * qt(0.975, 353) * se1n),
      CI99 = 2 * (b1n + c(-1, 1) * qt(0.995, 353) * se1n))
nd_nh <- data.frame(LOGNUMBED = log(100))
pr_nh <- predict(fit_nh, nd_nh, se.fit = TRUE)
c(fit = pr_nh$fit, se_pred = sqrt(summary(fit_nh)$sigma^2 + pr_nh$se.fit^2))
rbind(log_scale_95 = predict(fit_nh, nd_nh, interval = "prediction"),
      patient_years_95 = exp(predict(fit_nh, nd_nh, interval = "prediction")),
      patient_years_90 = exp(predict(fit_nh, nd_nh, interval = "prediction", level = 0.90)))
@
<<ex-f2-20-fig, fig.height=2.4, fig.width=6.4, out.width="0.5\\linewidth", echo=FALSE>>=
op <- par(mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(nh1$LOGNUMBED, nh1$LOGTPY, xlab = "LOGNUMBED", ylab = "LOGTPY", pch = 16, cex = 0.5)
abline(fit_nh)
par(op)
@
(a)--(b) The two logarithms are correlated at $0.983$; the slope is $1.019$ with
standard error $0.010$, $t=101$ and $R^2=0.966$. (c) $H_0\colon\beta_1=0$ is rejected
at any level. For $H_0\colon\beta_1=1$ the $t$ ratio is $(1.019-1)/0.010=1.90$: against
$\beta_1\neq1$ it is below $t_{353,0.975}=1.97$, so $H_0$ is not rejected, $p=0.058$;
against $\beta_1>1$ it exceeds $t_{353,0.95}=1.65$, so $H_0$ is rejected, $p=0.029$;
against $\beta_1<1$ it is not rejected, $p=0.971$. (d) The expected change is
$2b_1=2.04$, with intervals $(2.00,2.08)$ and $(1.99,2.09)$, twice those for $\beta_1$
by Definition~\ref{def:ttest} with $\bc=(0,2)'$. (e) At $\ln100=4.605$ the prediction
is $4.52$ with standard error of prediction $0.094$, nearly all of it $s$; the $95\%$
interval $(4.33,4.70)$ becomes $(76.3,110.4)$ patient years around $91.7$ after
exponentiation, and the $90\%$ interval is $(78.6,107.1)$.
\end{solution}

\begin{exercise}[FREES exercise 2.21]\label{ex:f2-21}
Initial public offerings (\texttt{IPO}): one-year \texttt{RETURN} and 1997 revenue
\texttt{REV} in millions of dollars for the $110$ of $116$ firms reporting both, with
$\texttt{LnREV}=\ln\texttt{REV}$. (a) With $r(\texttt{RETURN},\texttt{REV})=-0.0175$:
(i) fit \texttt{RETURN} on \texttt{REV} from the summary statistics; (ii) the fitted
return of Hyperion Telecommunications, $\texttt{REV}=95.55$. (b) With the fit on
\texttt{LnREV}: (i) the fitted return of Hyperion, compared with a(ii); (ii) test at
$10\%$ whether logarithmic revenue affects returns; (iii) test at $10\%$ the null of no
relation against a positive relation. (c) The correlation between \texttt{LnREV} and
\texttt{RETURN}. (d) At $\texttt{LnREV}=2$, the point prediction and a $95\%$ prediction
interval. (e) Inktomi, $\texttt{LnREV}=1.76$ and $\texttt{RETURN}=4.333$: (i) its
residual; (ii) its share of $\SSE$; (iii) the definition of a high leverage point;
(iv) whether Inktomi is one.
\end{exercise}

\begin{solution}
<<ex-f2-21>>=
ipo <- read.csv("data/frees/csv/IPO.csv"); ipo <- ipo[complete.cases(ipo[, c("RETURN", "REV")]), ]
round(t(sapply(ipo[, c("RETURN", "REV", "LnREV")], descr)), 3)
b1_rev <- cor(ipo$RETURN, ipo$REV) * sd(ipo$RETURN) / sd(ipo$REV)
b0_rev <- mean(ipo$RETURN) - b1_rev * mean(ipo$REV)
c(r = cor(ipo$RETURN, ipo$REV), b1 = b1_rev, b0 = b0_rev, hyperion_REV = b0_rev + b1_rev * 95.55)
fit_ipo <- lm(RETURN ~ LnREV, data = ipo)
round(coef(summary(fit_ipo)), 4)
c(s = summary(fit_ipo)$sigma, R2 = summary(fit_ipo)$r.squared, r_LnREV = cor(ipo$LnREV, ipo$RETURN),
  hyperion_LnREV = unname(predict(fit_ipo, data.frame(LnREV = log(95.55)))),
  crit_two_10 = qt(0.95, 108), crit_one_10 = qt(0.90, 108))
predict(fit_ipo, data.frame(LnREV = 2), interval = "prediction")
i_ink <- which.max(ipo$RETURN)
c(company = ipo$COMPANY[i_ink], LnREV = ipo$LnREV[i_ink], RETURN = ipo$RETURN[i_ink])
c(residual = residuals(fit_ipo)[[i_ink]], share_of_SSE = residuals(fit_ipo)[[i_ink]]^2 / sum(residuals(fit_ipo)^2),
  leverage = hatvalues(fit_ipo)[[i_ink]], mean_leverage = 2 / 110, flag = 4 / 110,
  std_resid = rstandard(fit_ipo)[[i_ink]])
@
(a) $b_1=r\,s_y/s_x=-0.0175(0.824)/261.9=-5.5\times10^{-5}$ and
$b_0=0.106-b_1(134.5)=0.113$; Hyperion's fitted return is $0.113-5.5\times10^{-5}(95.55)=0.108$.
(b)(i) On the logarithmic scale the fit is $0.438-0.090\,\texttt{LnREV}$ and Hyperion's
fitted return is $0.438-0.090\ln95.55=0.027$: two models, two fitted values.
(ii) $H_0\colon\beta_1=0$ against $\beta_1\neq0$ at $10\%$: $|t|=1.97$ exceeds
$t_{108,0.95}=1.66$, so $H_0$ is rejected, with $p=0.052$. (iii) Against
$\beta_1>0$ the rejection region is $t>t_{108,0.90}=1.29$, and $t=-1.97$ is not in it:
$H_0$ is not rejected, the evidence pointing the other way. (c) $r=-0.186$, negative
like the slope, and $r^2=0.0345=R^2$. (d) $0.438-0.090(2)=0.258$, with prediction
interval $(-1.37,1.89)$: the interval is $3.3$ wide because $s=0.81$ is large relative
to the fitted values. (e)(i) Inktomi's residual is $4.333-\{0.438-0.090(1.76)\}=4.05$;
(ii) its square is $23\%$ of $\SSE$; (iii) a high leverage point is unusual in the
explanatory variable, with $h_{ii}$ above $2(k+1)/n$ (Definition~\ref{def:outlier});
(iv) its leverage $0.021$ is barely above the mean $0.018$ and below the flag $0.036$,
since $1.76$ is one standard deviation below the mean of \texttt{LnREV}: Inktomi is an
outlier, with standardised residual $5.0$, and not a high leverage point.
\end{solution}

\begin{exercise}[FREES exercise 2.22]\label{ex:f2-22}
Regress \texttt{LIFEEXP} on \texttt{FERTILITY} (\texttt{UNLifeExpectancy}, Unit 1).
(a) The fitted life expectancy of the United States, $\texttt{FERTILITY}=2.0$; (b) a
$95\%$ prediction interval for Dominica, not in the regression, at $2.0$; (c) China,
$\texttt{FERTILITY}=1.7$ and $\texttt{LIFEEXP}=72.5$: its residual and the residual as a
multiple of $s$; (d) test at $5\%$ the prior hypothesis that the slope is $-6.0$ against
the alternative that it is greater, with an approximate $p$-value.
\end{exercise}

\begin{solution}
<<ex-f2-22>>=
un <- read.csv("data/frees/csv/UNLifeExpectancy.csv")
fit_un <- lm(LIFEEXP ~ FERTILITY, data = un)
round(coef(summary(fit_un)), 4)
c(n = nobs(fit_un), s = summary(fit_un)$sigma, R2 = summary(fit_un)$r.squared)
rbind(US = predict(fit_un, data.frame(FERTILITY = 2.0)),
      Dominica = predict(fit_un, data.frame(FERTILITY = 2.0), interval = "prediction"))
res_china <- 72.5 - predict(fit_un, data.frame(FERTILITY = 1.7))
c(residual = unname(res_china), multiple_of_s = unname(res_china) / summary(fit_un)$sigma)
b1u <- coef(fit_un)[["FERTILITY"]]; se1u <- coef(summary(fit_un))["FERTILITY", 2]
c(t = (b1u + 6) / se1u, crit = qt(0.95, nobs(fit_un) - 2), p = pt((b1u + 6) / se1u, nobs(fit_un) - 2, lower.tail = FALSE))
@
The regression uses the $181$ countries reporting fertility:
$\widehat{\texttt{LIFEEXP}}=83.7-5.27\,\texttt{FERTILITY}$, $s=6.6$, $R^2=0.65$.
(a) At $2.0$ births per woman the fitted life expectancy is $73.2$ years.
(b) Dominica's prediction interval is $(60.1,86.3)$, about $\pm2s$. (c) China's fitted
value is $74.8$, so its residual is $-2.3$ years, $0.34$ of $s$: unremarkable.
(d) $H_0\colon\beta_1=-6$ against $\beta_1>-6$: $t=(-5.27+6)/0.289=2.52$ exceeds
$t_{179,0.95}=1.65$, so $H_0$ is rejected with $p=0.006$; the slope is less steep than
$-6$.
\end{solution}

\begin{exercise}[FREES exercise 3.1]\label{ex:f3-1}
A data set of $n=100$ observations has $s_y=80$; a regression on three explanatory
variables gives $s=50$. (a) Calculate $R_a^2$; (b) complete the ANOVA table; (c)
calculate $R^2$.
\end{exercise}

\begin{solution}
Two mean squares determine everything: $\SST=(n-1)s_y^2$ and $\SSE=(n-k-1)s^2$, and
$\SSR=\SST-\SSE$ by Theorem~\ref{thm:anova}.
<<ex-f3-1>>=
nA <- 100; kA <- 3; syA <- 80; sA <- 50
SSTa <- (nA - 1) * syA^2; SSEa <- (nA - kA - 1) * sA^2; SSRa <- SSTa - SSEa
c(SST = SSTa, SSR = SSRa, SSE = SSEa, MSR = SSRa / kA, MSE = sA^2, F = (SSRa / kA) / sA^2,
  R2 = SSRa / SSTa, R2_adj = 1 - sA^2 / syA^2)
@
(a) $R_a^2=1-s^2/s_y^2=1-2500/6400=0.609$, from~\eqref{eq:R2} without any sum of
squares. (b)
\begin{center}
\begin{tabular}{lrrr}
\toprule
Source & Sum of squares & $\df$ & Mean square\\
\midrule
Regression & $393{,}600$ & $3$  & $131{,}200$\\
Error      & $240{,}000$ & $96$ & $2{,}500$\\
\midrule
Total      & $633{,}600$ & $99$ & \\
\bottomrule
\end{tabular}
\end{center}
(c) $R^2=393{,}600/633{,}600=0.621$, above $R_a^2$ as always when $k\geqslant1$.
\end{solution}

\begin{exercise}[FREES exercise 3.2]\label{ex:f3-2}
With $n=100$, $k=3$, $s=50$ and
\[
(\bX'\bX)^{-1}=\begin{pmatrix}
100 & 20 & 20 & 20\\ 20 & 90 & 30 & 40\\ 20 & 30 & 80 & 50\\ 20 & 40 & 50 & 70
\end{pmatrix},
\]
determine (a) $\SE(b_3)$; (b) the estimated $\cov(b_2,b_3)$; (c) the estimated
$\cor(b_2,b_3)$; (d) the estimated variance of $4b_2+3b_3$.
\end{exercise}

\begin{solution}
By Theorem~\ref{thm:var-beta} the estimated covariance matrix is $s^2(\bX'\bX)^{-1}$,
so $\SE(b_j)=s\sqrt{[(\bX'\bX)^{-1}]_{jj}}$ and
$\widehat\cov(b_i,b_j)=s^2[(\bX'\bX)^{-1}]_{ij}$; the correlation cancels $s^2$ and can
be read off $(\bX'\bX)^{-1}$ alone. For the linear combination, \emph{variance under a
linear map} with $\bc=(0,0,4,3)'$ gives
$\widehat\var(\bc'\hat\bb)=s^2\bc'(\bX'\bX)^{-1}\bc=s^2\{16(80)+9(70)+2(4)(3)(50)\}$.
<<ex-f3-2>>=
XtXi <- rbind(c(100, 20, 20, 20), c(20, 90, 30, 40), c(20, 30, 80, 50), c(20, 40, 50, 70))
sF <- 50; cF <- c(0, 0, 4, 3)
c(se_b3 = sF * sqrt(XtXi[4, 4]), cov_b23 = sF^2 * XtXi[3, 4],
  cor_b23 = XtXi[3, 4] / sqrt(XtXi[3, 3] * XtXi[4, 4]),
  var_lin = sF^2 * drop(t(cF) %*% XtXi %*% cF), se_lin = sF * sqrt(drop(t(cF) %*% XtXi %*% cF)))
@
(a) $\SE(b_3)=50\sqrt{70}=418$; (b) $2500(50)=125{,}000$; (c) $50/\sqrt{80\cdot70}=0.668$;
(d) $2500(1280+630+1200)=7{,}775{,}000$, of which the covariance term contributes
$3{,}000{,}000$: ignoring it would understate the standard error of $4b_2+3b_3$ by the
factor $\sqrt{7775/4775}=1.28$.
\end{solution}

\begin{exercise}[FREES exercise 3.3]\label{ex:f3-3}
For the data
\[
\bx_1=(-1,2,4,6)',\quad \bx_2=(0,0,1,1)',\quad \by=(0,1,5,8)',
\]
the fit of $y=\beta_0+\beta_1x_1+\beta_2x_2+\varepsilon$ has $s=1.373$,
$\mathbf b=(0.15,0.692,2.88)'$ and
\[
(\bX'\bX)^{-1}=\begin{pmatrix}
0.53846 & -0.07692 & -0.15385\\ -0.07692 & 0.15385 & -0.69231\\ -0.15385 & -0.69231 & 4.11538
\end{pmatrix}.
\]
(a) Write $\by$ and $\bX$; (b) determine $\hat y_3$; (c) $\SE(b_2)$; (d) $t(b_1)$.
\end{exercise}

\begin{solution}
(a) $\bX$ has the intercept column first: it is $4\times3$ with rows $(1,-1,0)$,
$(1,2,0)$, $(1,4,1)$, $(1,6,1)$, and $n-k-1=1$.
<<ex-f3-3>>=
Xf <- cbind(1, x1 = c(-1, 2, 4, 6), x2 = c(0, 0, 1, 1)); yf <- c(0, 1, 5, 8)
Af <- solve(crossprod(Xf)); bf <- drop(Af %*% crossprod(Xf, yf))
ef <- yf - Xf %*% bf; sf <- sqrt(sum(ef^2) / (4 - 3))
round(Af, 5)
c(b0 = bf[1], b1 = bf[2], b2 = bf[3], s = sf, yhat3 = drop(Xf[3, ] %*% bf),
  se_b2 = sf * sqrt(Af[3, 3]), t_b1 = bf[2] / (sf * sqrt(Af[2, 2])),
  p_b1 = 2 * pt(-abs(bf[2] / (sf * sqrt(Af[2, 2]))), df = 1))
@
(b) $\hat y_3=0.154+0.692(4)+2.885(1)=5.81$; (c) $\SE(b_2)=1.373\sqrt{4.115}=2.79$;
(d) $t(b_1)=0.692/(1.373\sqrt{0.154})=1.29$ on one degree of freedom, whose two-sided
$p$-value is $0.42$ and $5\%$ critical value $12.7$: four observations and three
parameters leave almost nothing with which to estimate $\sigma^2$.
\end{solution}

\begin{exercise}[FREES exercise 3.4, parts (a)--(f), (i), (j)]\label{ex:f3-4}
The lottery data with the eight explanatory variables of \texttt{WiscLottery}
(\texttt{PERPERHH}, \texttt{MEDSCHYR}, \texttt{MEDHVL}, \texttt{PRCRENT},
\texttt{PRC55P}, \texttt{HHMEDAGE}, \texttt{MEDINC}, \texttt{POP}). (a) Summary
statistics; how many standard deviations above the mean are \texttt{MEDSCHYR} and
\texttt{MEDHVL} for observation 11 (Shorewood)? (b) Which three variables are most
correlated with \texttt{SALES}? (c) A scatterplot matrix; where is observation 11 in the
plot of \texttt{SALES} against \texttt{MEDSCHYR}? (d) Fit \texttt{SALES} on all eight
variables and report $s$, $R^2$, $R_a^2$. (e) Is \texttt{MEDSCHYR} significant? State the
hypotheses, the criterion and the decision. (f) Fit \texttt{SALES} on \texttt{MEDSCHYR},
\texttt{MEDHVL} and \texttt{POP}; compare $s$, $R^2$, $R_a^2$ with (d). (i) Refit (f)
without observation 11: is \texttt{MEDSCHYR} significant? (j) Refit (f) without
observation 9.
\end{exercise}

\begin{solution}
<<ex-f3-4>>=
round(t(sapply(lottery[, -1], descr)), 2)
c(z_MEDSCHYR_11 = (lottery$MEDSCHYR[11] - mean(lottery$MEDSCHYR)) / sd(lottery$MEDSCHYR),
  z_MEDHVL_11 = (lottery$MEDHVL[11] - mean(lottery$MEDHVL)) / sd(lottery$MEDHVL))
round(sort(cor(lottery[, -1])[, "SALES"], decreasing = TRUE), 3)
fit_stats3 <- function(m) c(n = nobs(m), s = summary(m)$sigma, R2 = summary(m)$r.squared,
                            R2_adj = summary(m)$adj.r.squared)
fit_l8 <- lm(SALES ~ . - ZIP, data = lottery)
fit_l3 <- lm(SALES ~ MEDSCHYR + MEDHVL + POP, data = lottery)
fit_l3_no11 <- update(fit_l3, data = lottery[-11, ]); fit_l3_no9 <- update(fit_l3, data = lottery[-9, ])
round(rbind(eight = fit_stats3(fit_l8), three = fit_stats3(fit_l3),
            three_no_11 = fit_stats3(fit_l3_no11), three_no_9 = fit_stats3(fit_l3_no9)), 3)
round(coef(summary(fit_l8))["MEDSCHYR", ], 4); c(crit = qt(0.975, 41))
round(coef(summary(fit_l3)), 4)
round(coef(summary(fit_l3_no11))["MEDSCHYR", ], 4); c(crit = qt(0.975, 45))
@
<<ex-f3-4-fig, fig.height=3.6, fig.width=6.4, out.width="0.72\\linewidth", echo=FALSE>>=
pairs(lottery[, c("SALES", "POP", "MEDHVL", "MEDSCHYR", "PRCRENT", "MEDINC")],
      pch = 16, cex = 0.35, gap = 0.3, cex.labels = 0.9)
@
(a) Observation 11 is $5.8$ standard deviations above the mean in \texttt{MEDSCHYR} and
$3.4$ in \texttt{MEDHVL}. (b) \texttt{POP} ($0.886$), \texttt{MEDHVL} ($0.572$) and
\texttt{PRCRENT} ($0.496$). (c) In the panel of \texttt{SALES} against
\texttt{MEDSCHYR} observation 11 sits alone at the far right with moderate sales.
(d) $s=3580$, $R^2=0.837$, $R_a^2=0.805$ on $41$ residual degrees of freedom.
(e) $H_0\colon\beta_{\texttt{MEDSCHYR}}=0$ against $\neq0$; reject at $5\%$ if
$|t|>t_{41,0.975}=2.02$; $t=-2.26$ with $p=0.029$, so $H_0$ is rejected. (f) The
three-variable model has $s=3445$, $R^2=0.830$ and $R_a^2=0.819$: a lower $R^2$, as
Proposition~\ref{prop:R2-bounds} requires of a submodel, but a smaller $s$ and a larger
$R_a^2$, the five dropped variables all having $|t|<1$. (i) Without Shorewood the
\texttt{MEDSCHYR} $t$ ratio is $-0.81$ with $p=0.42$, so $H_0$ is no longer rejected:
the significance in (e) rested on one high leverage observation. (j) Without Kenosha,
$s$ falls to $2585$ and $R^2$ rises to $0.899$, the outlier of
Example~\ref{ex:kenosha} again.
\end{solution}

\begin{exercise}[FREES exercise 3.5, parts (a)--(f)]\label{ex:f3-5}
Insurer expenses (\texttt{NAICExpense}, Unit 1), with the outputs \texttt{LONGLOSS},
\texttt{SHORTLOSS}, \texttt{GPWPERSONAL}, \texttt{GPWCOMM}, the size measures
\texttt{ASSETS}, \texttt{CASH}, the indicators \texttt{GROUP}, \texttt{STOCK},
\texttt{MUTUAL}, and the wages \texttt{STAFFWAGE}, \texttt{AGENTWAGE}. (a) Summary
statistics of the response and the non-binary explanatory variables, with their
skewness; note the negative values. (b) Transform each non-binary variable by
$\ln(1+x)$, with $\texttt{LNEXPENSES}=\ln(1+\texttt{EXPENSES})$. (c) Which three
variables are most correlated with \texttt{LNEXPENSES}? (d) A box plot of
\texttt{LNEXPENSES} by \texttt{GROUP}: which level has higher expenses? (e) Fit
\texttt{LNEXPENSES} on all eleven explanatory variables and report $s$, $R^2$, $R_a^2$.
(f) Fit the eight-variable model dropping \texttt{CASH}, \texttt{STOCK} and
\texttt{MUTUAL}: (i) $s$, $R^2$, $R_a^2$; (ii) interpret the coefficient of
\texttt{GPWCOMM}; (iii) the expected increase in \texttt{EXPENSES} when
\texttt{GPWCOMM} increases by $\$1$, at the medians.
\end{exercise}

\begin{solution}
<<ex-f3-5>>=
naic <- read.csv("data/frees/csv/NAICExpense.csv")
skew <- function(v) mean((v - mean(v))^3) / mean((v - mean(v))^2)^1.5
vars <- c("EXPENSES", "LONGLOSS", "SHORTLOSS", "GPWPERSONAL", "GPWCOMM", "ASSETS", "CASH",
          "STAFFWAGE", "AGENTWAGE")
round(t(sapply(naic[, vars], function(v) { v <- v[!is.na(v)]
  c(n = length(v), median = median(v), mean = mean(v), sd = sd(v), min = min(v), skew = skew(v),
    negative = sum(v < 0)) })), 3)
L <- as.data.frame(lapply(naic[, vars], function(v) log(1 + v))); names(L) <- paste0("LN", vars)
L$GROUP <- naic$GROUP; L$STOCK <- naic$STOCK; L$MUTUAL <- naic$MUTUAL
round(sort(cor(L[, paste0("LN", vars)], use = "complete.obs")[, "LNEXPENSES"], decreasing = TRUE), 3)
tapply(L$LNEXPENSES, L$GROUP, median)
fit_n11 <- lm(LNEXPENSES ~ ., data = L)
fit_n8 <- lm(LNEXPENSES ~ LNASSETS + GROUP + LNLONGLOSS + LNSHORTLOSS + LNGPWPERSONAL + LNGPWCOMM +
               LNSTAFFWAGE + LNAGENTWAGE, data = L)
round(rbind(eleven = fit_stats3(fit_n11), eight = fit_stats3(fit_n8)), 4)
round(coef(summary(fit_n8)), 4)
mG <- median(naic$GPWCOMM); mE <- median(naic$EXPENSES)
c(median_GPWCOMM = mG, median_EXPENSES = mE,
  dEXPENSES_per_dollar = coef(fit_n8)[["LNGPWCOMM"]] * (1 + mE) / (1 + mG))
@
<<ex-f3-5-fig, fig.height=2.4, fig.width=6.4, out.width="0.45\\linewidth", echo=FALSE>>=
op <- par(mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
boxplot(LNEXPENSES ~ GROUP, data = L, col = "grey85", xlab = "GROUP", ylab = "LNEXPENSES")
par(op)
@
(a) Every dollar variable is heavily skewed to the right, with skewness between $5.6$
and $7.2$ and means several times the medians; expenses, both losses and both premium
variables take negative values for a few companies, so the plain logarithm is
undefined for them, and \texttt{AGENTWAGE} is missing for $19$ companies. (b) The
shifted logarithm $\ln(1+x)$ is defined for every value here, the smallest being
$-0.071$. (c) \texttt{LNSHORTLOSS} ($0.930$), \texttt{LNLONGLOSS} ($0.918$) and
\texttt{LNGPWCOMM} ($0.864$). (d) Affiliated companies, $\texttt{GROUP}=1$, have the
higher expenses, a median of $0.016$ against $0.002$. (e) On the $365$ companies with
complete data, $s=0.0224$, $R^2=0.942$, $R_a^2=0.940$. (f)(i) The eight-variable model
has $s=0.0224$, $R^2=0.941$ and $R_a^2=0.940$: dropping three variables costs a
thousandth of $R^2$ and nothing in $R_a^2$. (ii) The coefficient $0.069$ of
\texttt{LNGPWCOMM} is an elasticity between the shifted variables: a $1\%$ increase in
$1+\texttt{GPWCOMM}$ is associated with a $0.069\%$ increase in
$1+\texttt{EXPENSES}$, other variables fixed. (iii) Differentiating
$\ln(1+E)=\cdots+0.069\ln(1+G)$ gives $\mathrm dE=0.069\,(1+E)/(1+G)\,\mathrm dG$; at
the medians, $E=0.0085$ and $G=0.0238$ million, a dollar more of commercial premium
goes with $0.068$ dollars more expense.
\end{solution}

\begin{exercise}[FREES exercise 3.6, parts (a)--(c)]\label{ex:f3-6}
Regress life expectancy, \texttt{LIFEEXP}, on the three variables \texttt{FERTILITY},
\texttt{PUBLICEDUCATION} and $\texttt{lnHEALTH}=\ln\texttt{PRIVATEHEALTH}$. (a) Interpret the coefficient of public
education. (b) Interpret the coefficient of health expenditure without the logarithmic
scale. (c) Is \texttt{PUBLICEDUCATION} significant? State the hypotheses, the criterion
and the decision.
\end{exercise}

\begin{solution}
<<ex-f3-6>>=
un$lnHEALTH <- log(un$PRIVATEHEALTH)
fit_un3 <- lm(LIFEEXP ~ FERTILITY + PUBLICEDUCATION + lnHEALTH, data = un)
round(coef(summary(fit_un3)), 4)
c(n = nobs(fit_un3), R2 = summary(fit_un3)$r.squared, crit = qt(0.975, nobs(fit_un3) - 4),
  cor_PUBED_LIFEEXP = cor(un$PUBLICEDUCATION, un$LIFEEXP, use = "complete.obs"))
@
The fit uses the $152$ countries with all four variables. (a) Holding fertility and
private health expenditure fixed, a country spending one more percentage point of GDP
on public education has an expected life expectancy $0.18$ years \emph{lower}, although
the simple correlation of the two variables is positive ($0.07$). (b) The coefficient
$-1.03$ of $\ln\texttt{PRIVATEHEALTH}$ means that a $1\%$ increase in private health
expenditure, as a share of GDP, is associated with a change of $-1.03/100=-0.010$ years
in expected life expectancy, the other variables fixed; doubling it, a change of
$\ln2$ in the logarithm, with $-0.71$ years. (c) $H_0\colon\beta_{\texttt{PUBED}}=0$
against $\neq0$; reject at $5\%$ if $|t|>t_{148,0.975}=1.98$; $t=-0.69$ with $p=0.49$,
so $H_0$ is not rejected.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 1]\label{ex:i-1}
Describe the null hypotheses of the $p$-values in ISLR Table 3.4, the regression of
\texttt{sales} on \texttt{TV}, \texttt{radio} and \texttt{newspaper}
(Example~\ref{ex:adv-t}), and the conclusions they support, in terms of the variables
rather than the coefficients.
\end{exercise}

\begin{solution}
Each $p$-value tests, by Definition~\ref{def:ttest}, $H_0\colon\beta_j=0$ against
$\beta_j\neq0$ with the other two media held fixed: for \texttt{TV}, that television
advertising has no association with sales in markets with given radio and newspaper
budgets; likewise for \texttt{radio} and for \texttt{newspaper}; and for the intercept,
that sales are zero when nothing is spent. The $p$-values below $10^{-4}$ for
\texttt{TV} and \texttt{radio} reject their nulls: each medium is associated with sales
after adjusting for the other two. The $p$-value $0.86$ for \texttt{newspaper} does not:
given the television and radio budgets, newspaper spending carries no evidence of an
association, its simple association in Example~\ref{ex:adv-newspaper} being borrowed
from radio.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 4]\label{ex:i-4}
With $n=100$ observations on one predictor, a linear and a cubic regression
$Y=\beta_0+\beta_1X+\beta_2X^2+\beta_3X^3+\varepsilon$ are fitted. (a) If the true
relation is linear, which has the lower training $\RSS$? (b) The lower test $\RSS$?
(c)--(d) The same when the truth is non-linear to an unknown degree.
\end{exercise}

\begin{solution}
(a) The cubic, or a tie: the linear design's column space is contained in the cubic's,
so by Proposition~\ref{prop:R2-bounds} the cubic's training $\RSS$ cannot exceed the
linear one's, whatever the truth. (b) The linear model is expected to have the lower
test $\RSS$: both are unbiased for a linear truth, since the cubic contains it, and the
cubic estimates two more coefficients, which adds variance and no reduction in bias
(the decomposition of Unit 1). (c) The cubic again, by the same containment; the
training $\RSS$ says nothing about the truth. (d) Not enough information: if the truth
is far from linear the cubic's lower bias outweighs its extra variance and it wins on
test data; if the truth is nearly linear the linear model wins as in (b).
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 5]\label{ex:i-5}
For regression without an intercept, $\hat y_i=x_i\hat\beta$ with
$\hat\beta=\sum_ix_iy_i/\sum_jx_j^2$. Write $\hat y_i=\sum_ja_jy_j$ and identify $a_j$.
\end{exercise}

\begin{solution}
Substituting Corollary~\ref{cor:origin},
\[
\hat y_i=x_i\frac{\sum_jx_jy_j}{\sum_lx_l^2}=\sum_ja_jy_j,\qquad a_j=\frac{x_ix_j}{\sum_lx_l^2}:
\]
the fitted values are linear combinations of the responses with weights fixed by the
design. In general $\hat\bY=\bH\bY$, so the weight of $Y_j$ in $\hat Y_i$ is $h_{ij}$;
here $\bH=\bx\bx'/(\bx'\bx)$, whose $(i,j)$ entry is $a_j$. With an intercept,
$\bH\bone=\bone$ makes $\sum_jh_{ij}=1$ for every $i$, and the weight an observation
gives itself is its leverage.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 6]\label{ex:i-6}
Show that the least squares line always passes through $(\bar x,\bar y)$.
\end{exercise}

\begin{solution}
By Corollary~\ref{cor:slr-ls}, $b_0=\bar y-b_1\bar x$, so the line's height at $\bar x$
is $b_0+b_1\bar x=\bar y$. It is the first normal equation, $\sum_ie_i=0$, and needs the
intercept: regression through the origin passes through $(0,0)$ instead.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 7]\label{ex:i-7}
Prove $R^2=r^2$ for simple linear regression, assuming $\bar x=\bar y=0$.
\end{exercise}

\begin{solution}
With zero means, $b_1=\sum_ix_iy_i/\sum_ix_i^2$ and $b_0=0$, so
$\TSS=\sum_iy_i^2$ and
\[
\RSS=\sum_i(y_i-b_1x_i)^2=\sum_iy_i^2-2b_1\sum_ix_iy_i+b_1^2\sum_ix_i^2
=\sum_iy_i^2-\frac{(\sum_ix_iy_i)^2}{\sum_ix_i^2} ,
\]
hence
\[
R^2=\frac{\TSS-\RSS}{\TSS}=\frac{(\sum_ix_iy_i)^2}{\sum_ix_i^2\sum_iy_i^2}=r^2
\]
by~\eqref{eq:corr} with the means zero. Without the assumption, replace $x_i$ and $y_i$
by their deviations, which changes neither $R^2$ (Corollary~\ref{cor:R2-r2}) nor $r$
(Proposition~\ref{prop:corr-bounds}).
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 8]\label{ex:i-8}
Regress \texttt{mpg} on \texttt{horsepower} in \texttt{Auto}. (a) Is there a relation;
how strong; positive or negative; the predicted \texttt{mpg} at $98$ horsepower with
$95\%$ confidence and prediction intervals. (b) Plot the data with the line. (c)
Diagnostic plots.
\end{exercise}

\begin{solution}
<<ex-i-8>>=
fit_hp <- lm(mpg ~ horsepower, data = Auto)
round(coef(summary(fit_hp)), 4)
c(R2 = summary(fit_hp)$r.squared, RSE = summary(fit_hp)$sigma, mean_mpg = mean(Auto$mpg),
  RSE_over_mean = summary(fit_hp)$sigma / mean(Auto$mpg))
rbind(confidence = predict(fit_hp, data.frame(horsepower = 98), interval = "confidence"),
      prediction = predict(fit_hp, data.frame(horsepower = 98), interval = "prediction"))
@
<<ex-i-8-fig, fig.height=2.6, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 3), mar = c(3.2, 3.4, 1.4, 0.6), mgp = c(1.9, 0.6, 0))
plot(Auto$horsepower, Auto$mpg, xlab = "horsepower", ylab = "mpg", pch = 16, cex = 0.4)
abline(fit_hp, col = "#B45309", lwd = 2)
plot(fitted(fit_hp), residuals(fit_hp), xlab = "fitted", ylab = "residual", pch = 16, cex = 0.4)
abline(h = 0, lty = 2)
plot(fitted(fit_hp), rstandard(fit_hp), xlab = "fitted", ylab = "standardised residual", pch = 16, cex = 0.4)
abline(h = c(-2, 0, 2), lty = 2)
par(op)
@
(a) The slope $-0.158$ has $t=-24.5$ and a $p$-value of $10^{-81}$: there is a
relation, and it is negative, each additional unit of horsepower lowering the expected
mileage by $0.16$ miles per gallon. $R^2=0.61$, and the residual standard error $4.9$ is
$21\%$ of the mean mileage $23.4$. At $98$ horsepower the fitted value is $24.5$, the
confidence interval $(24.0,25.0)$ and the prediction interval $(14.8,34.1)$.
(b)--(c) The line overestimates mileage at low and high horsepower and underestimates it
in the middle: the residuals against the fitted values form a U, the mark of a
relation that is not linear; the standardised residuals also spread more at high fitted
values.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 9, parts (a)--(d)]\label{ex:i-9}
For \texttt{Auto}: (a) a scatterplot matrix; (b) the correlation matrix excluding
\texttt{name}; (c) regress \texttt{mpg} on all other variables: is there a relation,
which predictors are significant, what does the \texttt{year} coefficient say;
(d) diagnostic plots: large residuals, high leverage points.
\end{exercise}

\begin{solution}
<<ex-i-9>>=
A <- Auto[, names(Auto) != "name"]
round(cor(A), 2)
fit_auto <- lm(mpg ~ ., data = A)
round(coef(summary(fit_auto)), 4)
c(R2 = summary(fit_auto)$r.squared, F = summary(fit_auto)$fstatistic[["value"]],
  max_std_resid = max(abs(rstandard(fit_auto))), at = which.max(abs(rstandard(fit_auto))),
  max_leverage = max(hatvalues(fit_auto)), at_lev = which.max(hatvalues(fit_auto)), flag = 2 * 8 / 392)
@
<<ex-i-9-fig, fig.height=3.6, fig.width=6.4, out.width="0.72\\linewidth", echo=FALSE>>=
pairs(A, pch = 16, cex = 0.25, gap = 0.2, cex.labels = 0.8)
@
<<ex-i-9-fig2, fig.height=2.4, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 2), mar = c(3.2, 3.4, 1.4, 0.6), mgp = c(1.9, 0.6, 0))
plot(fitted(fit_auto), rstandard(fit_auto), xlab = "fitted", ylab = "standardised residual", pch = 16, cex = 0.4)
abline(h = c(-2, 0, 2), lty = 2)
plot(hatvalues(fit_auto), rstandard(fit_auto), xlab = "leverage", ylab = "standardised residual", pch = 16, cex = 0.4)
abline(v = 2 * 8 / 392, lty = 2)
par(op)
@
(a)--(b) Mileage falls with cylinders, displacement, horsepower and weight, whose
mutual correlations are $0.84$ to $0.95$, and rises with year and origin. (c)
$F=252$ on $(7,384)$ degrees of freedom: a relation exists. At $5\%$ the significant
predictors are \texttt{displacement}, \texttt{weight}, \texttt{year} and
\texttt{origin}; \texttt{cylinders}, \texttt{horsepower} and \texttt{acceleration} are
not, their simple associations being absorbed by the correlated size variables. The
\texttt{year} coefficient $0.75$ says that, with the other variables fixed, a car one
model year newer is expected to travel $0.75$ more miles per gallon. (d) The
standardised residuals curve upward at high fitted values, so the relation is again not
linear; observation $321$ has the largest standardised residual, $4.0$, and observation
$14$ the largest leverage, $0.19$, nearly five times the flag $2(k+1)/n=0.04$.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 11]\label{ex:i-11}
Generate $x_i$ standard normal and $y_i=2x_i+\varepsilon_i$, $n=100$, with
\texttt{set.seed(1)}. (a) Regress $y$ on $x$ without an intercept and report the
coefficient, its standard error, $t$ and $p$-value. (b) The same for $x$ on $y$.
(c) The relation between the two. (d) Show that for regression through the origin
\[
t=\frac{\sqrt{n-1}\,\sum_ix_iy_i}{\sqrt{(\sum_ix_i^2)(\sum_iy_i^2)-(\sum_ix_iy_i)^2}} ,
\]
and confirm it numerically. (e) Deduce that the $t$ statistics in (a) and (b) are
equal. (f) Show numerically that the same holds with an intercept.
\end{exercise}

\begin{solution}
(d) With $\hat\beta=\sum_ix_iy_i/\sum_ix_i^2$ and, for one parameter and no intercept,
$\SE(\hat\beta)=\sqrt{\sum_i(y_i-x_i\hat\beta)^2/\{(n-1)\sum_ix_i^2\}}$,
\[
t=\frac{\hat\beta}{\SE(\hat\beta)}
=\frac{\sum_ix_iy_i}{\sum_ix_i^2}\cdot\frac{\sqrt{n-1}\sqrt{\sum_ix_i^2}}{\sqrt{\sum_i(y_i-x_i\hat\beta)^2}} ,
\qquad
\sum_i(y_i-x_i\hat\beta)^2=\sum_iy_i^2-\frac{(\sum_ix_iy_i)^2}{\sum_ix_i^2} ,
\]
the second by expanding the square and substituting $\hat\beta$; multiplying numerator
and denominator by $\sqrt{\sum_ix_i^2}$ gives the display. (e) The expression is
symmetric in $x$ and $y$, so exchanging their roles cannot change it.
<<ex-i-11>>=
set.seed(1); xa <- rnorm(100); ya <- 2 * xa + rnorm(100)
tf <- sqrt(99) * sum(xa * ya) / sqrt(sum(xa^2) * sum(ya^2) - sum(xa * ya)^2)
round(rbind(y_on_x = coef(summary(lm(ya ~ xa + 0)))[1, ], x_on_y = coef(summary(lm(xa ~ ya + 0)))[1, ]), 5)
c(closed_form = tf, with_intercept_y_on_x = coef(summary(lm(ya ~ xa)))[2, 3],
  with_intercept_x_on_y = coef(summary(lm(xa ~ ya)))[2, 3])
@
(a)--(c) The coefficient of $y$ on $x$ is $1.99$, that of $x$ on $y$ is $0.39$, and the
two $t$ statistics are the same, $18.7$, as (d)--(e) require; the coefficients differ
because $\sum_ix_i^2\neq\sum_iy_i^2$. (f) With an intercept the two $t$ statistics
again coincide, by Exercise~\ref{ex:f2-16}(c): $t=\sqrt{n-2}\,r/\sqrt{1-r^2}$ depends on
the symmetric $r$ alone, so testing $\beta_1=0$ is testing $r=0$, a statement about the
pair and not about a direction.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 12]\label{ex:i-12}
For regression through the origin: (a) when is the coefficient of $X$ on $Y$ equal to
that of $Y$ on $X$? (b) Generate $n=100$ observations for which they differ; (c) for
which they coincide.
\end{exercise}

\begin{solution}
(a) By Corollary~\ref{cor:origin} the two are $\sum_ix_iy_i/\sum_ix_i^2$ and
$\sum_ix_iy_i/\sum_iy_i^2$, equal iff $\sum_ix_i^2=\sum_iy_i^2$ (or the numerator is
zero).
<<ex-i-12>>=
set.seed(4); xb <- rnorm(100); yb <- 3 * xb + rnorm(100)
c(y_on_x = coef(lm(yb ~ xb + 0))[[1]], x_on_y = coef(lm(xb ~ yb + 0))[[1]], sum_x2 = sum(xb^2), sum_y2 = sum(yb^2))
yc <- sample(xb)                                  # a permutation: the same squares
c(y_on_x = coef(lm(yc ~ xb + 0))[[1]], x_on_y = coef(lm(xb ~ yc + 0))[[1]], sum_x2 = sum(xb^2), sum_y2 = sum(yc^2))
@
(b) With $y=3x+\varepsilon$ the sums of squares differ and so do the coefficients.
(c) A permutation of $x$ has the same sum of squares, and the two coefficients agree.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 13]\label{ex:i-13}
With \texttt{set.seed(1)}: (a) $x$, $100$ draws from $N(0,1)$; (b) \texttt{eps}, $100$
draws from $N(0,0.25)$; (c) $y=-1+0.5x+\varepsilon$: the length of $y$, and $\beta_0$,
$\beta_1$; (d) a scatter plot; (e) the least squares fit against the truth; (f) the
fitted and the population lines on the plot, with a legend; (g) a quadratic term: does
it improve the fit? (h)--(i) repeat with less noise (variance $0.01$) and more noise
(variance $1$); (j) the confidence intervals for $\beta_0$, $\beta_1$ in the three cases.
\end{exercise}

\begin{solution}
<<ex-i-13>>=
sim_fit <- function(sd_eps) {
  set.seed(1); x <- rnorm(100); eps <- rnorm(100, sd = sd_eps); y <- -1 + 0.5 * x + eps
  m <- lm(y ~ x)
  list(m = m, x = x, y = y, sd = sd_eps, ci = confint(m),
       quad = coef(summary(lm(y ~ x + I(x^2))))["I(x^2)", ])
}
s_mid <- sim_fit(0.5); s_low <- sim_fit(0.1); s_high <- sim_fit(1)
c(length_y = length(s_mid$y), beta0 = -1, beta1 = 0.5)
round(coef(summary(s_mid$m)), 4)
round(s_mid$quad, 4)
round(rbind(noise_0.25 = c(s_mid$ci[1, ], s_mid$ci[2, ]), noise_0.01 = c(s_low$ci[1, ], s_low$ci[2, ]),
            noise_1 = c(s_high$ci[1, ], s_high$ci[2, ])), 4)
round(rbind(noise_0.25 = coef(s_mid$m), noise_0.01 = coef(s_low$m), noise_1 = coef(s_high$m)), 4)
@
<<ex-i-13-fig, fig.height=2.4, fig.width=6.4, echo=FALSE>>=
op <- par(mfrow = c(1, 3), mar = c(3.2, 3.4, 1.4, 0.6), mgp = c(1.9, 0.6, 0))
for (s in list(s_low, s_mid, s_high)) {
  plot(s$x, s$y, pch = 16, cex = 0.4, xlab = "x", ylab = "y", main = paste("sd(eps) =", s$sd))
  abline(s$m, col = "steelblue", lwd = 2); abline(-1, 0.5, col = "#B45309", lwd = 2, lty = 2)
  legend("topleft", c("least squares", "population"), col = c("steelblue", "#B45309"), lty = 1:2, bty = "n", cex = 0.7)
}
par(op)
@
(c) $y$ has length $100$, $\beta_0=-1$ and $\beta_1=0.5$. (d) A linear relation with
scatter. (e) $\hat\beta_0=-1.02$ and $\hat\beta_1=0.50$, each within one standard error
of the truth. (g) The quadratic term has $t=-1.40$ and $p=0.16$: no evidence of
curvature, as expected of a linear truth. (h)--(j) With error variance $0.01$ the fit is
$(-1.004,0.500)$ and the slope interval $(0.479,0.521)$; with variance $1$ the fit is
$(-1.04,0.50)$ and the slope interval $(0.29,0.71)$: the interval width scales with
$\sigma$ exactly as~\eqref{eq:slr-var} says, the design being the same in all three
cases, and all three intervals cover the truth.
\end{solution}

\begin{exercise}[ISLR §3.7, exercise 15, parts (a)--(c)]\label{ex:i-15}
Predict the per-capita crime rate \texttt{crim} in \texttt{Boston}. (a) Regress it on
each predictor alone: which associations are significant? (b) Regress it on all
predictors: for which can $H_0\colon\beta_j=0$ be rejected? (c) Plot the simple
coefficients against the multiple ones.
\end{exercise}

\begin{solution}
<<ex-i-15>>=
preds <- setdiff(names(Boston), "crim")
uni <- t(sapply(preds, function(v) { m <- lm(as.formula(paste("crim ~", v)), data = Boston)
  c(coef = coef(m)[[2]], p = coef(summary(m))[2, 4]) }))
fit_crim <- lm(crim ~ ., data = Boston)
multi <- coef(summary(fit_crim))[-1, c(1, 4)]
round(cbind(simple = uni[, "coef"], p_simple = uni[, "p"], multiple = multi[, 1], p_multiple = multi[, 2]), 4)
c(R2_multiple = summary(fit_crim)$r.squared)
@
<<ex-i-15-fig, fig.height=2.6, fig.width=6.4, out.width="0.5\\linewidth", echo=FALSE>>=
op <- par(mar = c(3.2, 3.4, 1.2, 0.6), mgp = c(1.9, 0.6, 0))
plot(uni[, "coef"], multi[, 1], xlab = "simple regression coefficient", ylab = "multiple regression coefficient",
     pch = 16)
text(uni[, "coef"], multi[, 1], preds, pos = 4, cex = 0.6)
abline(0, 1, lty = 2)
par(op)
@
(a) Alone, every predictor but \texttt{chas} ($p=0.21$) is significantly associated
with the crime rate. (b) Together, $H_0$ is rejected at $5\%$ for \texttt{zn},
\texttt{dis}, \texttt{rad} and \texttt{medv} only, with \texttt{nox} and
\texttt{lstat} near the boundary; the model explains $45\%$ of the variation.
(c) The two sets of coefficients are unrelated, and \texttt{nox} moves from $31$ alone
to $-10$ in the joint model: its simple association is carried by the predictors it is
correlated with, Example~\ref{ex:adv-newspaper} on a larger scale.
\end{solution}

\begin{exercise}[SOA sample question 11]\label{ex:soa-11}
A regression model gives, for five observations, $y=(2,5,6,8,4)$ and
$\hat f(x)=(4,3,9,3,6)$. Calculate the sum of squared errors: (A) $-35$; (B) $-5$;
(C) $5$; (D) $35$; (E) $46$.
\end{exercise}

\begin{solution}
By Definition~\ref{def:sumsq}, $\SSE=\sum_i(y_i-\hat y_i)^2=(-2)^2+2^2+(-3)^2+5^2+(-2)^2
=4+4+9+25+4=46$, which is (E). (A) and (B) are impossible, a sum of squares being
non-negative; the residuals themselves sum to $-2+2-3+5-2=0$, and neither $5$, the
number of observations, nor $35$ is a sum of squares of these residuals.
\end{solution}

\begin{exercise}[SOA sample question 18]\label{ex:soa-18}
For a simple linear regression on $25$ observations, $\sum_ie_i^2=230$ and $R^2=0.64$.
Calculate the total sum of squares: (A) $605.94$; (B) $638.89$; (C) $690.77$;
(D) $701.59$; (E) $750.87$.
\end{exercise}

\begin{solution}
By~\eqref{eq:R2}, $R^2=1-\SSE/\SST$, so $\SST=\SSE/(1-R^2)=230/0.36=638.89$, which is
(B); $n=25$ is not needed, and $\SSR=\SST-\SSE=408.89$ checks as $0.64\times638.89$.
None of the other options equals $230/(1-R^2)$; they would require $1-R^2$ of
$0.380$, $0.333$, $0.328$ or $0.306$.
\end{solution}

\begin{exercise}[SOA sample question 23]\label{ex:soa-23}
A cafeteria sells coffee at $1.00$ for $12$ ounces, $1.20$ for $16$ and $1.40$ for
$20$, and will price any size at the least squares regression of price on size. Toby
and Karen each buy a $24$-ounce coffee; calculate what they save by sharing one
$48$-ounce coffee instead: (A) it costs $0.40$ more; (B) the same; (C) they save $0.40$;
(D) $0.80$; (E) $1.20$.
\end{exercise}

\begin{solution}
The three points are collinear, so by Proposition~\ref{prop:corr-bounds} $r=1$ and the
least squares line passes through all three with $\SSE=0$: the slope is
$(1.40-1.00)/(20-12)=0.05$ per ounce and the intercept $1.00-0.05(12)=0.40$; the same
comes from~\eqref{eq:slr-ls}, with $\bar x=16$, $\bar y=1.20$,
$b_1=\{(-4)(-0.2)+0+(4)(0.2)\}/\{16+0+16\}=1.6/32=0.05$. Two $24$-ounce cups cost
$2(0.40+1.20)=3.20$; one $48$-ounce cup costs $0.40+2.40=2.80$. They save $0.40$, the
fixed charge of the second cup, which is (C). (A) would follow from adding, not
subtracting, the intercept; (B) from a line through the origin, which the data reject;
(D) and (E) from doubling or tripling the intercept.
\end{solution}

\begin{exercise}[SOA sample question 24]\label{ex:soa-24}
A regression of a mutual fund's return on four predictors plus an intercept over $105$
months reports $F=20.0$; the software failed before computing $R^2$. Which is true:
(A) insufficient information, but $R^2$ could be calculated given $\RSS$;
(B) insufficient information, but it could be calculated given $\TSS$ and $\RSS$;
(C) $R^2=0.44$; (D) $R^2=0.56$; (E) $R^2=0.80$.
\end{exercise}

\begin{solution}
By Corollary~\ref{cor:R2-from-F}, $R^2$ depends on $\SSE$ and $\SST$ only through their
ratio, and $F$ fixes that ratio: with $k=4$ and $n-k-1=100$,
\[
F=\frac{(\SST-\SSE)/4}{\SSE/100}=20\ifff\frac{\SST-\SSE}{\SSE}=0.80
\ifff\frac{\SST}{\SSE}=1.80 ,
\]
so $R^2=1-1/1.80=0.444$, which is (C); the corollary gives it directly as
$kF/(kF+n-k-1)=80/180$. (A) and (B) are false because nothing beyond $F$, $n$ and $k$ is
needed. (D) is $1-R^2=\SSE/\SST=0.556$, the unexplained share, and (E) is
$kF/(n-k-1)=\SSR/\SSE=0.80$, the ratio of explained to unexplained variation.
\end{solution}

\begin{exercise}[SOA sample question 44]\label{ex:soa-44}
Dental claims of $n=100$ participants with the predictor sex, coded $0$ and $1$.
Actuary 1 fits $Y=\beta+\varepsilon$ and Actuary 2 fits
$Y=\beta_0+\beta_1\,\mathrm{Sex}+\varepsilon$, with $\RSS=250{,}000$ and
$\TSS=490{,}000$. Calculate the $F$ statistic testing whether Actuary 2's model is a
significant improvement: (A) $92$; (B) $93$; (C) $94$; (D) $95$; (E) $96$.
\end{exercise}

\begin{solution}
Actuary 1's model is the intercept-only model, whose residual sum of squares is
$\TSS$, so nothing further about it is needed. By~\eqref{eq:F} with $k=1$,
\[
F=\frac{(\TSS-\RSS)/1}{\RSS/(n-2)}=\frac{240{,}000}{250{,}000/98}=94.08 \quad\text{on }F_{1,98},
\]
which is (C). The other options are the same ratio with the wrong residual degrees of
freedom, $96$, $97$, $99$ and $100$ in place of $n-2=98$. Two checks: by
Proposition~\ref{prop:t2F}, $t(b_1)=\sqrt{94.08}=9.70$, and by
Exercise~\ref{ex:f2-9} this is the pooled two-sample $t$ statistic comparing the mean
claims of the two sexes; and $R^2=1-250/490=0.4898$ reproduces $F$
through~\eqref{eq:F}.
\end{solution}

\begin{exercise}[SOA sample question 53]\label{ex:soa-53}
Which statement about $Y=\beta_0+\beta_1X+\varepsilon$ is NOT true: (A) $\beta_0$ is
the expected value of $Y$; (B) $\beta_1$ is the average increase in $Y$ associated with
a one-unit increase in $X$; (C) $\varepsilon$ is typically assumed independent of $X$;
(D) the equation defines the population regression line; (E) least squares is commonly
used to estimate $\beta_0$ and $\beta_1$.
\end{exercise}

\begin{solution}
(A) is false, hence the answer: by \Aref{1}, $\expc[Y\mid X]=\beta_0+\beta_1X$, so
$\beta_0=\expc[Y\mid X=0]$, the expected response when $X=0$, and the unconditional
expectation is $\beta_0+\beta_1\expc[X]$. (B) is the interpretation of a coefficient in
§\ref{sec:2.1.2}, $\beta_1=\partial\expc[Y\mid X]/\partial X$; (C) is \Aref{2} in the
form ISLR states it; (D) is the population regression line of the same remark; (E) is
Definition~\ref{def:ols}.
\end{solution}

\end{document}
