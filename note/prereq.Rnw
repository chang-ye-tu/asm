%==============================================================================
\section{The Real Line}\label{sec:P.0}
%==============================================================================

\begin{remark}[Elementary facts assumed]\label{rem:elementary}
Elementary calculus and linear algebra are taken as known: the product and quotient rules,
integration by parts on $\Real$, the fundamental theorem of calculus for complex-valued
functions of a real variable, $(e^{it})'=ie^{it}$, the extension of a linearly independent
set to a basis and the dimension of a subspace, and the fact that a right inverse of a
square matrix is its inverse.
\end{remark}

\begin{definition}[Supremum]\label{def:sup}
$s$ is the \emph{supremum} of $S\subseteq\Real$ if $s$ is an upper bound and no smaller
number is; $\inf S=-\sup(-S)$. The \emph{completeness axiom} states that every non-empty
$S$ bounded above has a supremum in $\Real$.
\end{definition}

\begin{theorem}[Monotone convergence for sequences]\label{thm:monotone-seq}
A bounded increasing real sequence converges, to the supremum of its values.
\end{theorem}

\begin{proof}
Let $s=\sup_n a_n$, which exists by completeness since the set of values is non-empty and
bounded above. For $\varepsilon>0$, $s-\varepsilon$ is not an upper bound, so
$a_N>s-\varepsilon$ for some $N$. For $n\geqslant N$, monotonicity gives $a_n\geqslant a_N$,
and $a_n\leqslant s$ because $s$ is an upper bound; hence $s-\varepsilon<a_n\leqslant s$,
that is $|a_n-s|<\varepsilon$, for all $n\geqslant N$.
\end{proof}

\begin{theorem}[Bolzano--Weierstrass]\label{thm:BW}
Every bounded sequence in $\Real^d$ has a convergent subsequence.
\end{theorem}

\begin{proof}
Take $d=1$ first. Given a bounded $(a_n)$, say $|a_n|\leqslant B$ for all $n$, put
$b_m=\sup_{n\geqslant m}a_n$, finite by completeness. The sequence $(b_m)$ is decreasing
(a supremum over a smaller set is smaller) and bounded below by $-B$, so it converges to
a limit $b$ by Theorem~\ref{thm:monotone-seq} applied to $(-b_m)$, and
$b\leqslant b_m$ for every $m$. Choose indices $n_1<n_2<\cdots$ with $|a_{n_k}-b|<1/k$
recursively: put $n_0=0$; given $n_{k-1}$, choose $m>n_{k-1}$ with $b_m<b+1/k$ (possible as
$b_m\downarrow b$), then $n_k\geqslant m$ with $a_{n_k}>b_m-1/k$ (possible as $b_m$ is a
supremum, so $b_m-1/k$ is not an upper bound of $\{a_n:n\geqslant m\}$). Then
$n_k\geqslant m>n_{k-1}$, and since $b\leqslant b_m$ and $a_{n_k}\leqslant b_m$,
\[
b-1/k\leqslant b_m-1/k<a_{n_k}\leqslant b_m<b+1/k ,
\]
that is $|a_{n_k}-b|<1/k$. Hence $a_{n_k}\to b$.

For general $d$, write $a_n=(a_n^{(1)},\ldots,a_n^{(d)})$; each coordinate sequence is
bounded since $|a_n^{(j)}|\leqslant|a_n|$. Construct, for $j=1,\ldots,d$, an infinite set of
indices $N_j\subseteq\{1,2,\ldots\}$ with $N_1\supseteq N_2\supseteq\cdots\supseteq N_d$ such
that $(a_n^{(i)})_{n\in N_j}$, listed in increasing order of $n$, converges for every
$i\leqslant j$. For $j=1$, apply the case $d=1$ to $(a_n^{(1)})_{n\geqslant1}$ and let $N_1$
be the set of indices of the convergent subsequence. Given $N_{j-1}$, the sequence
$(a_n^{(j)})_{n\in N_{j-1}}$ is bounded, so by the case $d=1$ it has a convergent
subsequence; let $N_j\subseteq N_{j-1}$ be its set of indices. Coordinates $i<j$ still
converge along $N_j$, because a subsequence of a convergent sequence converges to the same
limit, and coordinate $j$ converges by construction. After step $d$, every coordinate of
$(a_n)_{n\in N_d}$ converges, say $a_n^{(i)}\to c_i$; with $c=(c_1,\ldots,c_d)$,
$|a_n-c|\leqslant\sum_i|a_n^{(i)}-c_i|\to0$ along $N_d$, so this subsequence converges in
$\Real^d$.
\end{proof}

\begin{definition}[Compactness]\label{def:compact}
$K\subseteq\Real^d$ is \emph{compact} if every sequence in $K$ has a subsequence converging
to a point of $K$.
\end{definition}

\begin{theorem}[Heine--Borel]\label{thm:HB}
$K\subseteq\Real^d$ is compact if and only if it is closed and bounded.
\end{theorem}

\begin{proof}
($\Leftarrow$) A sequence in a bounded $K$ is bounded, so it has a convergent subsequence by
Theorem~\ref{thm:BW}, and the limit of that subsequence lies in $K$ because $K$ is closed
(contains the limits of its convergent sequences).

($\Rightarrow$) If $K$ were unbounded, for each $n$ the number $n$ would not bound $K$, so
$K$ would contain some $x_n$ with $|x_n|>n$. No subsequence of such a sequence converges:
if $x_{n_k}\to x$ then $|x_{n_k}-x|<1$ for all large $k$, so $|x_{n_k}|<|x|+1$, whereas
$|x_{n_k}|>n_k\geqslant k\to\infty$. If $K$ were not closed there would be
$x_n\in K$ with $x_n\to x\notin K$; every subsequence also tends to $x$, and a sequence has
at most one limit (if $y_k\to x$ and $y_k\to x'$ then
$|x-x'|\leqslant|x-y_k|+|y_k-x'|\to0$), so no subsequence converges to a point of $K$.
Either way $K$ would not be compact.
\end{proof}

\begin{theorem}[Rolle]\label{thm:rolle}
If $f$ is continuous on $[a,b]$, differentiable on $(a,b)$, and $f(a)=f(b)$, then
$f'(\xi)=0$ for some $\xi\in(a,b)$.
\end{theorem}

\begin{proof}
$[a,b]$ is compact by Theorem~\ref{thm:HB}, so $f$ attains a maximum and a minimum on it:
taking $x_n\in[a,b]$ with $f(x_n)\to M=\sup_{[a,b]}f$, a subsequence converges to some
$x\in[a,b]$ and continuity gives $f(x)=M$ (so $M<\infty$), and the same argument applied to
$-f$ gives the minimum. If both are attained at endpoints then, since $f(a)=f(b)$, the
maximum $M$ and the minimum $m$ are equal, so $m\leqslant f(x)\leqslant M=m$ for every
$x\in[a,b]$: $f$ is constant, $f'\equiv0$ on $(a,b)$, and any interior $\xi$ works.
Otherwise an extremum is attained at an interior $\xi$. Suppose it is a maximum (for a
minimum apply the argument to $-f$, whose derivative is $-f'$). For $0<|h|<\min(\xi-a,b-\xi)$
the point $\xi+h$ lies in $[a,b]$, so $f(\xi+h)-f(\xi)\leqslant0$, and the difference
quotient $\{f(\xi+h)-f(\xi)\}/h$ is $\leqslant0$ for $h>0$ and $\geqslant0$ for $h<0$. The
derivative $f'(\xi)$ is the limit of these quotients as $h\to0$ from either side; a limit
of numbers $\leqslant0$ is $\leqslant0$, and a limit of numbers $\geqslant0$ is
$\geqslant0$, so $f'(\xi)=0$.
\end{proof}

\begin{corollary}[Mean value theorem]\label{cor:MVT}
Under the same hypotheses without $f(a)=f(b)$, there is $\xi\in(a,b)$ with
$f(b)-f(a)=f'(\xi)(b-a)$.
\end{corollary}

\begin{proof}
Apply Theorem~\ref{thm:rolle} to $g(x)=f(x)-f(a)-\frac{f(b)-f(a)}{b-a}(x-a)$, which is
continuous on $[a,b]$, differentiable on $(a,b)$ (a difference of $f$ and a polynomial),
and has $g(a)=0$ and $g(b)=f(b)-f(a)-\{f(b)-f(a)\}=0$. This gives $\xi\in(a,b)$ with
$0=g'(\xi)=f'(\xi)-\{f(b)-f(a)\}/(b-a)$; multiply by $b-a$.
\end{proof}

%==============================================================================
\section{Limits and Semi-continuity}\label{sec:P.1}
%==============================================================================

\begin{definition}[Upper and lower limits]\label{def:limsup}
For a real sequence $(a_n)$, $\limsup_n a_n = \inf_m\sup_{n\geqslant m}a_n$ and
$\liminf_n a_n = \sup_m\inf_{n\geqslant m}a_n$, as elements of $[-\infty,\infty]$.
\end{definition}

\begin{proposition}\label{prop:limsup}
$\liminf_n a_n\leqslant\limsup_n a_n$, and $a_n\to a$ if and only if
$\liminf_n a_n=\limsup_n a_n=a$.
\end{proposition}

\begin{proof}
Write $\ell_m=\inf_{n\geqslant m}a_n$ and $u_m=\sup_{n\geqslant m}a_n$. Then
$\ell_m\leqslant u_m$ for each $m$; $\ell_m$ increases in $m$ and $u_m$ decreases, because
the set $\{a_n:n\geqslant m\}$ shrinks as $m$ grows. For any $m,m'$, with $k=\max(m,m')$,
$\ell_m\leqslant\ell_k\leqslant u_k\leqslant u_{m'}$. Taking the supremum over $m$ gives
$\liminf_na_n\leqslant u_{m'}$ for every $m'$, and then the infimum over $m'$ gives
$\liminf_na_n\leqslant\limsup_na_n$.

If both equal $a$, let $\varepsilon>0$. Since $\sup_m\ell_m=a$, the number $a-\varepsilon$
is not an upper bound of the $\ell_m$, so $\ell_{m_1}>a-\varepsilon$ for some $m_1$; since
$\inf_mu_m=a$, $u_{m_2}<a+\varepsilon$ for some $m_2$. With $m=\max(m_1,m_2)$ and the
monotonicity of $\ell$ and $u$, $a-\varepsilon<\ell_m\leqslant a_n\leqslant u_m<a+\varepsilon$
for $n\geqslant m$, so $|a_n-a|<\varepsilon$ for $n\geqslant m$: $a_n\to a$.

Conversely, let $a_n\to a$ and $\varepsilon>0$, and take $m$ with
$a-\varepsilon<a_n<a+\varepsilon$ for $n\geqslant m$. Then $u_m\leqslant a+\varepsilon$ and
$\ell_m\geqslant a-\varepsilon$, so $\limsup_na_n=\inf_ku_k\leqslant u_m\leqslant
a+\varepsilon$ and $\liminf_na_n=\sup_k\ell_k\geqslant\ell_m\geqslant a-\varepsilon$.
With the first part,
$a-\varepsilon\leqslant\liminf_na_n\leqslant\limsup_na_n\leqslant a+\varepsilon$, and
$\varepsilon>0$ is arbitrary, so both equal $a$.
\end{proof}

\begin{definition}[Semi-continuity]\label{def:semicont}
$f:\Real^d\to\Real$ is \emph{lower semi-continuous} at $x$ if
$\liminf_{y\to x}f(y)\geqslant f(x)$, and \emph{upper semi-continuous} if
$\limsup_{y\to x}f(y)\leqslant f(x)$. Here
$\liminf_{y\to x}f(y)=\sup_{\delta>0}\inf_{|y-x|<\delta}f(y)$ and
$\limsup_{y\to x}f(y)=\inf_{\delta>0}\sup_{|y-x|<\delta}f(y)$, the point $y=x$ included.
\end{definition}

\begin{lemma}[Semi-continuous envelopes]\label{lem:envelopes}
For bounded $f:\Real^d\to\Real$ put $f_*(x)=\liminf_{y\to x}f(y)$ and
$f^*(x)=\limsup_{y\to x}f(y)$. Then $f_*$ is lower semi-continuous, $f^*$ is upper
semi-continuous, $f_*\leqslant f\leqslant f^*$, and the three agree exactly at the
continuity points of $f$.
\end{lemma}

\begin{proof}
Since $f$ is bounded, say $|f|\leqslant B$, every infimum and supremum over a ball lies in
$[-B,B]$, so $f_*$ and $f^*$ are real-valued.

\textbf{Lower semi-continuity of $f_*$.} Fix $x$ and $\delta>0$. Since
$f_*(x)=\sup_{r>0}\inf_{|y-x|<r}f(y)$, the number $f_*(x)-\delta$ is not an upper bound of
these infima, so there is $r>0$ with $\inf_V f>f_*(x)-\delta$ for the open ball
$V=\{y:|y-x|<r\}$. For $z\in V$ put $r'=r-|z-x|>0$; the ball $\{y:|y-z|<r'\}$ lies in $V$
by the triangle inequality, so the infimum of $f$ over it is at least $\inf_Vf$, and
$f_*(z)\geqslant\inf_{|y-z|<r'}f(y)\geqslant\inf_V f> f_*(x)-\delta$. Hence
$\inf_{|z-x|<r}f_*(z)\geqslant f_*(x)-\delta$, so
$\liminf_{z\to x}f_*(z)\geqslant f_*(x)-\delta$ for every $\delta>0$, which is lower
semi-continuity of $f_*$ at $x$.

\textbf{Upper semi-continuity of $f^*$.} Infima and suprema satisfy
$\inf(-g)=-\sup g$, so $(-f)_*=-f^*$. The function $-f$ is bounded, so $(-f)_*$ is lower
semi-continuous by the first step, and therefore $f^*=-(-f)_*$ is upper semi-continuous.

\textbf{The inequalities.} The point $y=x$ belongs to every ball about $x$, so
$\inf_{|y-x|<r}f(y)\leqslant f(x)\leqslant\sup_{|y-x|<r}f(y)$ for every $r>0$; taking the
supremum, respectively infimum, over $r$ gives $f_*(x)\leqslant f(x)\leqslant f^*(x)$.

\textbf{Agreement.} If $f$ is continuous at $x$ and $\varepsilon>0$, there is $r>0$ with
$f(x)-\varepsilon<f(y)<f(x)+\varepsilon$ for $|y-x|<r$, so
$f_*(x)\geqslant f(x)-\varepsilon$ and $f^*(x)\leqslant f(x)+\varepsilon$; as $\varepsilon$
is arbitrary, $f_*(x)\geqslant f(x)\geqslant f^*(x)$, and with the inequalities all three are
equal. Conversely, if $f_*(x)=f(x)=f^*(x)$ and $\varepsilon>0$, the argument of the first
step gives $r_1>0$ with $\inf_{|y-x|<r_1}f>f(x)-\varepsilon$ and, applied to $-f$, $r_2>0$
with $\sup_{|y-x|<r_2}f<f(x)+\varepsilon$; for $|y-x|<\min(r_1,r_2)$,
$|f(y)-f(x)|<\varepsilon$, so $f$ is continuous at $x$.
\end{proof}

\begin{lemma}[Approximation from below]\label{lem:lsc-approx}
A lower semi-continuous $f$ bounded below is the pointwise increasing limit of the bounded
continuous functions $f_k(x)=\inf_y\{f(y)\wedge k + k|x-y|\}$.
\end{lemma}

\begin{proof}
For each $y$ put $g_y(x)=f(y)\wedge k+k|x-y|$, so $f_k=\inf_yg_y$. Every $g_y$ is at least
$f(y)\wedge k\geqslant\inf f\wedge k$, so $f_k\geqslant\inf f\wedge k>-\infty$; and
$f_k(x)\leqslant g_x(x)=f(x)\wedge k\leqslant k$. So $f_k$ is bounded, and
$f_k\leqslant f\wedge k\leqslant f$. By the triangle inequality,
$g_y(x)\leqslant g_y(x')+k|x-x'|$ for all $x,x',y$; taking the infimum over $y$ on both
sides gives $f_k(x)\leqslant f_k(x')+k|x-x'|$, and exchanging $x$ and $x'$ gives
$|f_k(x)-f_k(x')|\leqslant k|x-x'|$. Hence $f_k$ is continuous. Since
$f(y)\wedge k\leqslant f(y)\wedge(k+1)$ and $k|x-y|\leqslant(k+1)|x-y|$, every $g_y$
increases with $k$, and so does the infimum: $f_k\leqslant f_{k+1}$.

For the limit, fix $x$ and $c<f(x)$. Lower semi-continuity gives $\delta>0$ with
$\inf_{|y-x|<\delta}f(y)>c$ (as in the proof of Lemma~\ref{lem:envelopes}), so $f(y)>c$
whenever $|y-x|<\delta$. Take $k$ with $k>c$ and $k\delta>c-\inf f$, and bound $g_y(x)$
below in two cases. If $|y-x|<\delta$ then $f(y)>c$ and $k>c$, so $f(y)\wedge k>c$ and
$g_y(x)\geqslant f(y)\wedge k>c$. If $|y-x|\geqslant\delta$ then
$g_y(x)\geqslant(\inf f\wedge k)+k\delta$; when $k\geqslant\inf f$ this is
$\inf f+k\delta>c$ by the choice of $k$, and when $k<\inf f$ it is $k+k\delta>k>c$.
Hence $g_y(x)>c$ for every $y$, and $f_k(x)\geqslant c$. The sequence $(f_k(x))_k$ is
increasing and bounded above by $f(x)$, so it converges by
Theorem~\ref{thm:monotone-seq}, and its limit lies in $[c,f(x)]$. As $c<f(x)$ was
arbitrary, the limit is $f(x)$.
\end{proof}

%==============================================================================
\section{Continuity, Compactness, Differentiation}\label{sec:P.2}
%==============================================================================

\begin{theorem}[Uniform continuity on compacts]\label{thm:unif-cont}
A continuous $f$ on a compact $K\subseteq\Real^d$ (Definition~\ref{def:compact}) is bounded,
uniformly continuous, and attains its supremum.
\end{theorem}

\begin{proof}
\textbf{Attainment.} Let $M=\sup_K f$, finite or not, and take $x_n\in K$ with
$f(x_n)\to M$: if $M<\infty$, $M-1/n$ is not an upper bound, so some $x_n$ has
$M-1/n<f(x_n)\leqslant M$; if $M=\infty$, $n$ is not an upper bound, so some $x_n$ has
$f(x_n)>n$. By compactness a subsequence $x_{n_k}$ converges to some $x\in K$, and continuity
at $x$ gives $f(x_{n_k})\to f(x)$; also $f(x_{n_k})\to M$, so $M=f(x)$. In particular
$M<\infty$, so $f$ is bounded above and attains its supremum; applying this to the
continuous function $-f$ bounds $f$ below.

\textbf{Uniform continuity.} If it failed there would be $\varepsilon>0$ such that for
every $n$ some points $x_n,y_n\in K$ have $|x_n-y_n|<1/n$ but
$|f(x_n)-f(y_n)|\geqslant\varepsilon$. By compactness a subsequence $x_{n_k}$ converges to
some $x\in K$, and $|y_{n_k}-x|\leqslant|y_{n_k}-x_{n_k}|+|x_{n_k}-x|<1/n_k+|x_{n_k}-x|\to0$,
so $y_{n_k}\to x$ too. Continuity at $x$ makes both $f(x_{n_k})$ and $f(y_{n_k})$ tend to
$f(x)$, so $|f(x_{n_k})-f(y_{n_k})|\to0$, contradicting
$|f(x_{n_k})-f(y_{n_k})|\geqslant\varepsilon$ for every $k$.
\end{proof}

\begin{theorem}[Taylor with Lagrange remainder]\label{thm:taylor}
If $f:\Real\to\Real$ is $m+1$ times differentiable on an interval containing $0$ and $t$,
then for some $\xi$ between $0$ and $t$,
\begin{equation}\label{eq:taylor}
f(t) = \sum_{k=0}^{m}\frac{f^{(k)}(0)}{k!}t^k + \frac{f^{(m+1)}(\xi)}{(m+1)!}t^{m+1} .
\end{equation}
\end{theorem}

\begin{proof}
For $t=0$ both sides of~\eqref{eq:taylor} equal $f(0)$, and $\xi=0$ works. Fix $t\neq0$
and put
\[
R=\frac{1}{t^{m+1}}\Bigl\{f(t)-\sum_{k\leqslant m}\frac{f^{(k)}(0)}{k!}t^k\Bigr\},
\qquad
g(s) = f(t)-\sum_{k\leqslant m}\frac{f^{(k)}(s)}{k!}(t-s)^k - R\,(t-s)^{m+1},
\]
so that $g(0)=0$. At $s=t$ every term with $k\geqslant1$ and the last term vanish, leaving
$g(t)=f(t)-f(t)=0$. Each $f^{(k)}$ with $k\leqslant m$ is differentiable on the interval,
hence continuous, so $g$ is continuous on the closed interval between $0$ and $t$ and
differentiable inside it. By Rolle's theorem (Theorem~\ref{thm:rolle}) $g'(\xi)=0$ for
some $\xi$ strictly between $0$ and $t$. By the product rule, for $k\geqslant1$,
\[
\frac{\dd}{\dd s}\Bigl\{\frac{f^{(k)}(s)}{k!}(t-s)^k\Bigr\}
=\frac{f^{(k+1)}(s)}{k!}(t-s)^k-\frac{f^{(k)}(s)}{(k-1)!}(t-s)^{k-1},
\]
and for $k=0$ the derivative is $f'(s)$. Summing over $k=0,\ldots,m$, the negative term of
index $k$ cancels the positive term of index $k-1$, and only the positive term of index $m$
survives:
\[
\frac{\dd}{\dd s}\sum_{k\leqslant m}\frac{f^{(k)}(s)}{k!}(t-s)^k
= \frac{f^{(m+1)}(s)}{m!}(t-s)^{m} .
\]
So $g'(\xi)=0$ reads $-\frac{f^{(m+1)}(\xi)}{m!}(t-\xi)^m + R(m+1)(t-\xi)^m = 0$. As $\xi$
lies strictly between $0$ and $t$, $t-\xi\neq0$; dividing by $(m+1)(t-\xi)^m$ gives
$R = f^{(m+1)}(\xi)/(m+1)!$. Multiplying the definition of $R$ by $t^{m+1}$ and
substituting this value is~\eqref{eq:taylor}.
\end{proof}

\begin{lemma}[Taylor bound for the complex exponential]\label{lem:taylor-exp}
For every $t\in\Real$ and integer $m\geqslant0$,
\begin{equation}\label{eq:taylor-exp}
\Bigl|e^{it} - \sum_{k=0}^{m}\frac{(it)^k}{k!}\Bigr|
\;\leqslant\; \min\Bigl\{\frac{2|t|^m}{m!},\ \frac{|t|^{m+1}}{(m+1)!}\Bigr\}.
\end{equation}
\end{lemma}

\begin{proof}
For $m\geqslant-1$ let $h_m(t)=e^{it}-\sum_{k=0}^m(it)^k/k!$ (the empty sum for $m=-1$, so
$h_{-1}(t)=e^{it}$ and $|h_{-1}|\equiv1$). For $m\geqslant0$, $h_m(0)=1-1=0$, and
differentiating term by term (a finite sum), using $(e^{it})'=ie^{it}$,
\[
h_m'(t)=ie^{it}-\sum_{k=1}^m\frac{ik(it)^{k-1}}{k!}
=i\Bigl\{e^{it}-\sum_{j=0}^{m-1}\frac{(it)^j}{j!}\Bigr\}=ih_{m-1}(t).
\]
By the fundamental theorem of calculus, $h_m(t)=i\int_0^th_{m-1}(s)\,\dd s$ for
$m\geqslant0$. Consequently, if $|h_{m-1}(s)|\leqslant c\,|s|^{p}$ for all $s$ between $0$
and $t$, then
\[
|h_m(t)|\leqslant\Bigl|\int_0^t|h_{m-1}(s)|\,\dd s\Bigr|\leqslant c\int_0^{|t|}u^p\,\dd u
=\frac{c\,|t|^{p+1}}{p+1}.
\tag{$*$}
\]

\textbf{Second bound.} Claim: $|h_m(t)|\leqslant|t|^{m+1}/(m+1)!$ for all $t$ and all
$m\geqslant-1$. Base case $m=-1$: $|h_{-1}(t)|=1=|t|^0/0!$. Step: if the claim holds for
$m-1$, then $(*)$ with $c=1/m!$ and $p=m$ gives
$|h_m(t)|\leqslant|t|^{m+1}/\{m!(m+1)\}=|t|^{m+1}/(m+1)!$.

\textbf{First bound.} Claim: $|h_m(t)|\leqslant2|t|^m/m!$ for all $t$ and all $m\geqslant0$.
Base case $m=0$: $|h_0(t)|=|e^{it}-1|\leqslant|e^{it}|+1=2$. Step: if the claim holds for
$m-1\geqslant0$, then $(*)$ with $c=2/(m-1)!$ and $p=m-1$ gives
$|h_m(t)|\leqslant2|t|^m/\{(m-1)!\,m\}=2|t|^m/m!$.

Both claims hold for every $m\geqslant0$, so $|h_m(t)|$ is at most their minimum, which
is~\eqref{eq:taylor-exp}.
\end{proof}

\begin{lemma}[Product comparison]\label{lem:prodcomp}
For complex $z_1,\ldots,z_m$ and $z_1',\ldots,z_m'$ of modulus at most $1$,
$\bigl|\prod_k z_k-\prod_k z_k'\bigr|\leqslant\sum_k|z_k-z_k'|$.
\end{lemma}

\begin{proof}
Induction on $m$. For $m=1$ both sides equal $|z_1-z_1'|$. For $m=2$, inserting $z_1'z_2$,
\[
|z_1z_2-z_1'z_2'|=|(z_1-z_1')z_2+z_1'(z_2-z_2')|
\leqslant|z_2||z_1-z_1'|+|z_1'||z_2-z_2'|\leqslant|z_1-z_1'|+|z_2-z_2'| ,
\]
using $|z_2|\leqslant1$ and $|z_1'|\leqslant1$. Suppose the claim holds for $m-1$ factors,
$m\geqslant3$, and put $w=\prod_{k<m}z_k$ and $w'=\prod_{k<m}z_k'$. Then $|w|\leqslant1$
and $|w'|\leqslant1$, as products of numbers of modulus at most $1$, so the case $m=2$
applied to $w,z_m$ and $w',z_m'$, followed by the hypothesis for $m-1$, gives
\[
\Bigl|\prod_{k\leqslant m}z_k-\prod_{k\leqslant m}z_k'\Bigr|=|wz_m-w'z_m'|
\leqslant|w-w'|+|z_m-z_m'|\leqslant\sum_{k<m}|z_k-z_k'|+|z_m-z_m'| .
\]
\end{proof}

\begin{lemma}[Sum of reciprocal squares]\label{lem:basel}
$\sum_{k=1}^\infty k^{-2}=\pi^2/6$ and $\sum_{k=1}^\infty(-1)^{k+1}k^{-2}=\pi^2/12$.
\end{lemma}

\begin{proof}
For $n\geqslant0$ let $I_n=\int_0^{\pi/2}\cos^{2n}x\,\dd x$ and
$J_n=\int_0^{\pi/2}x^2\cos^{2n}x\,\dd x$, both positive. For $n\geqslant1$, integrating by
parts twice, the boundary terms vanishing at $0$ and $\pi/2$,
\begin{align*}
I_n&=2n\int_0^{\pi/2}x\sin x\cos^{2n-1}x\,\dd x\\
&=-n\int_0^{\pi/2}x^2\{\cos^{2n}x-(2n-1)\sin^2x\cos^{2n-2}x\}\,\dd x\\
&=-n\int_0^{\pi/2}x^2\{2n\cos^{2n}x-(2n-1)\cos^{2n-2}x\}\,\dd x\\
&=n(2n-1)J_{n-1}-2n^2J_n .
\end{align*}
The first line takes $u=\cos^{2n}x$, $\dd v=\dd x$, $v=x$, with
$u'=-2n\sin x\cos^{2n-1}x$; the second takes
$u=\sin x\cos^{2n-1}x$, $\dd v=x\,\dd x$, $v=x^2/2$, with
$u'=\cos^{2n}x-(2n-1)\sin^2x\cos^{2n-2}x$; the boundary terms contain the factor $x$ or $x^2$,
which vanishes at $0$, and the factor $\cos^{2n-1}x$ or $\cos^{2n}x$, which vanishes at
$\pi/2$ as $n\geqslant1$. The third line uses $\sin^2x=1-\cos^2x$. Integrating
$I_n=\int_0^{\pi/2}\cos x\cos^{2n-1}x\,\dd x$ by parts with $\dd v=\cos x\,\dd x$, $v=\sin x$,
the boundary term $\sin x\cos^{2n-1}x$ vanishing at both ends, gives
$I_n=(2n-1)\int_0^{\pi/2}\sin^2x\cos^{2n-2}x\,\dd x=(2n-1)(I_{n-1}-I_n)$, so
$2nI_n=(2n-1)I_{n-1}$, that is $I_n=\frac{2n-1}{2n}I_{n-1}$. Dividing the first identity by
$n^2I_n$ gives $1/n^2=(2n-1)J_{n-1}/(nI_n)-2J_n/I_n$, and substituting
$(2n-1)/(nI_n)=2/I_{n-1}$ from the second,
\[
\frac1{n^2}=\frac{2J_{n-1}}{I_{n-1}}-\frac{2J_n}{I_n} ,
\qquad
\sum_{k=1}^n\frac1{k^2}=\frac{2J_0}{I_0}-\frac{2J_n}{I_n}=\frac{\pi^2}6-\frac{2J_n}{I_n} ,
\]
the first sum telescoping, as $J_0=\int_0^{\pi/2}x^2\,\dd x=\pi^3/24$ and $I_0=\pi/2$. The
function $h(x)=\sin x-2x/\pi$ vanishes at $0$ and $\pi/2$, and $h'(x)=\cos x-2/\pi$ is
strictly decreasing on $[0,\pi/2]$ by the mean value theorem (Corollary~\ref{cor:MVT}), as
$\cos'=-\sin<0$ on $(0,\pi/2]$. Since $h'(0)=1-2/\pi>0$, the set $\{x:h'(x)>0\}$ is non-empty;
let $c$ be its supremum. As $h'$ is strictly decreasing, $h'>0$ on $[0,c)$ and
$h'\leqslant0$ on $(c,\pi/2]$, and by the mean value theorem $h$ is nondecreasing on
$[0,c]$ and nonincreasing on $[c,\pi/2]$. Hence $h(x)\geqslant h(0)=0$ for $x\leqslant c$ and
$h(x)\geqslant h(\pi/2)=0$ for $x\geqslant c$, that is $\sin x\geqslant2x/\pi\geqslant0$ on
$[0,\pi/2]$, so $x^2\leqslant(\pi^2/4)\sin^2x$ there. Since
$\cos^{2n}x-\cos^{2n+2}x=\sin^2x\cos^{2n}x$ and $I_{n+1}=\frac{2n+1}{2n+2}I_n$,
\[
0<J_n\leqslant\frac{\pi^2}{4}\int_0^{\pi/2}\sin^2x\cos^{2n}x\,\dd x
=\frac{\pi^2}4(I_n-I_{n+1})=\frac{\pi^2}{4}\cdot\frac{I_n}{2n+2} ,
\]
so $0<2J_n/I_n\leqslant\pi^2/\{4(n+1)\}\to0$, and the partial sums tend to $\pi^2/6$, which
is the first sum. For the second, split the partial sum with $2N$ terms into odd and even
$k$:
\[
\sum_{k=1}^{2N}\frac{(-1)^{k+1}}{k^2}=\sum_{k=1}^{2N}\frac1{k^2}-2\sum_{j=1}^{N}\frac1{(2j)^2}
=\sum_{k=1}^{2N}\frac1{k^2}-\frac12\sum_{j=1}^{N}\frac1{j^2}
\;\longrightarrow\;\frac{\pi^2}6-\frac{\pi^2}{12}=\frac{\pi^2}{12} ,
\]
and the partial sum with $2N+1$ terms differs from this by $(2N+1)^{-2}\to0$.
\end{proof}

%==============================================================================
\section{Convexity and Separation}\label{sec:P.3}
%==============================================================================

\begin{definition}[Convex set, convex function]\label{def:convex}
$C\subseteq\Real^d$ is \emph{convex} if $\lambda x+(1-\lambda)y\in C$ whenever
$x,y\in C$ and $\lambda\in[0,1]$. A function $f:C\to\Real$ on a convex $C$ is
\emph{convex} if $f(\lambda x+(1-\lambda)y)\leqslant\lambda f(x)+(1-\lambda)f(y)$.
\end{definition}

\begin{lemma}[Convexity from the derivative]\label{lem:convex-deriv}
Let $g$ be continuous on an interval $I$ and differentiable at its interior points. If $g'$
is nondecreasing there, $g$ is convex on $I$; if $g'$ is strictly increasing, $g$ is
\emph{strictly convex}: $g(\lambda x+(1-\lambda)y)<\lambda g(x)+(1-\lambda)g(y)$ for $x\neq y$
in $I$ and $0<\lambda<1$. A second derivative $g''\geqslant0$ ($>0$) in the interior suffices.
With the inequalities reversed, $g$ is concave (strictly concave), that is, $-g$ is convex
(strictly convex). A function $f$ on a convex $C\subseteq\Real^d$ is strictly convex if
$f(\lambda x+(1-\lambda)y)<\lambda f(x)+(1-\lambda)f(y)$ for $x\neq y$ in $C$ and $0<\lambda<1$; it is
convex, strictly convex, concave or strictly concave iff every restriction
$t\mapsto f(x+tv)$ to a line is.
\end{lemma}

\begin{proof}
\textbf{Step 1: one variable.} Let $x\neq y$ in $I$ and $0<\lambda<1$; exchanging the roles
of $(x,\lambda)$ and $(y,1-\lambda)$ if necessary, assume $x<y$. Put
$z=\lambda x+(1-\lambda)y$, so $x<z<y$. By the mean value theorem
(Corollary~\ref{cor:MVT}) on $[x,z]$ and on $[z,y]$ there are $\xi_1\in(x,z)$ and
$\xi_2\in(z,y)$ with $g(z)-g(x)=g'(\xi_1)(z-x)$ and $g(y)-g(z)=g'(\xi_2)(y-z)$. Since
$\xi_1<\xi_2$ are interior points and $g'$ is nondecreasing, $g'(\xi_1)\leqslant g'(\xi_2)$,
strictly in the strict case. As $z-x=(1-\lambda)(y-x)$ and $y-z=\lambda(y-x)$,
\[
\lambda\{g(z)-g(x)\}=\lambda(1-\lambda)(y-x)\,g'(\xi_1)
\leqslant\lambda(1-\lambda)(y-x)\,g'(\xi_2)=(1-\lambda)\{g(y)-g(z)\},
\]
strictly in the strict case because $\lambda(1-\lambda)(y-x)>0$. Collecting the terms in
$g(z)$, whose coefficients add to $\lambda+(1-\lambda)=1$, gives
$g(z)\leqslant\lambda g(x)+(1-\lambda)g(y)$, strictly in the strict case. Convexity also
holds trivially when $x=y$ or $\lambda\in\{0,1\}$. If $g''\geqslant0$ ($>0$) in the interior,
then for interior $u<v$ the mean value theorem applied to $g'$ gives
$g'(v)-g'(u)=g''(\eta)(v-u)\geqslant0$ ($>0$) for some $\eta\in(u,v)$, so $g'$ is
nondecreasing (strictly increasing). The concave statements are the convex ones for $-g$,
whose derivatives are $-g'$ and $-g''$.

\textbf{Step 2: restriction to lines.} For $x\in C$ and $v\in\Real^d$ the set
$T=\{t:x+tv\in C\}$ is an interval, as $C$ is convex, and $\varphi(t)=f(x+tv)$ is defined on
$T$. If $f$ is convex and $s,t\in T$, then
$\varphi(\lambda s+(1-\lambda)t)=f\bigl(\lambda(x+sv)+(1-\lambda)(x+tv)\bigr)
\leqslant\lambda\varphi(s)+(1-\lambda)\varphi(t)$, so $\varphi$ is convex; for $v\neq\bzero$
and $s\neq t$ the points $x+sv\neq x+tv$, so strictness passes over too. Conversely, given
$x\neq y$ in $C$, take $v=y-x$: then $0,1\in T$, $\varphi(0)=f(x)$, $\varphi(1)=f(y)$ and
$f(\lambda x+(1-\lambda)y)=\varphi\bigl(\lambda\cdot0+(1-\lambda)\cdot1\bigr)
\leqslant\lambda\varphi(0)+(1-\lambda)\varphi(1)=\lambda f(x)+(1-\lambda)f(y)$, strictly if
$\varphi$ is strictly convex. The concave cases follow by applying this to $-f$.
\end{proof}

\begin{theorem}[Nearest point in a closed convex set]\label{thm:nearest}
Let $C\subseteq\Real^d$ be non-empty, closed and convex, and $z\in\Real^d$. Then there is a
unique $p\in C$ minimising $|z-x|$ over $x\in C$, and it is characterised by
\begin{equation}\label{eq:variational}
\langle z-p,\ x-p\rangle \leqslant 0 \qquad\text{for every } x\in C .
\end{equation}
\end{theorem}

\begin{proof}
\textbf{Existence.} Let $\delta=\inf_{x\in C}|z-x|$, which exists as $C$ is non-empty and
the distances are bounded below by $0$, and take $x_n\in C$ with $|z-x_n|\to\delta$ (for
each $n$, $\delta+1/n$ is not a lower bound). The parallelogram law
$|a-b|^2=2|a|^2+2|b|^2-|a+b|^2$, with $a=z-x_m$ and $b=z-x_n$, gives
\[
|x_n-x_m|^2 = 2|z-x_n|^2+2|z-x_m|^2-4\bigl|z-\tfrac{x_n+x_m}{2}\bigr|^2
\leqslant 2|z-x_n|^2+2|z-x_m|^2-4\delta^2 ,
\]
using $\tfrac12(x_n+x_m)\in C$ by convexity, so that its distance to $z$ is at least
$\delta$. Given $\varepsilon>0$, take $N$ with $|z-x_n|^2<\delta^2+\varepsilon$ for
$n\geqslant N$; then the right side is less than $4\varepsilon$ for $m,n\geqslant N$, so
$(x_n)$ is Cauchy. It converges to some $p$: the sequence is bounded, as
$|x_n|\leqslant|z|+|z-x_n|$ and $|z-x_n|\to\delta$, so by Theorem~\ref{thm:BW} a
subsequence $x_{n_k}$ converges to some $p$, and then
$|x_n-p|\leqslant|x_n-x_{n_k}|+|x_{n_k}-p|$, where the first term is small once $n$ and
$n_k$ exceed the Cauchy index and the second once $k$ is large. The limit $p$ lies in $C$
because $C$ is closed, and $|z-p|\leqslant|z-x_n|+|x_n-p|\to\delta$, so $|z-p|=\delta$.

\textbf{Characterisation.} Let $p\in C$ be any minimiser. For $x\in C$ and
$\lambda\in(0,1]$, the point $p+\lambda(x-p)=(1-\lambda)p+\lambda x$ lies in $C$ by
convexity, so
\[
\delta^2 \leqslant |z-p-\lambda(x-p)|^2
= \delta^2 - 2\lambda\langle z-p,x-p\rangle + \lambda^2|x-p|^2 .
\]
Subtracting $\delta^2$ and dividing by $2\lambda>0$ gives
$\langle z-p,x-p\rangle\leqslant\lambda|x-p|^2/2$, and letting $\lambda\to0^+$
gives~\eqref{eq:variational}. Conversely if $p\in C$ satisfies~\eqref{eq:variational} then for
any $x\in C$, expanding $|(z-p)-(x-p)|^2$,
$|z-x|^2 = |z-p|^2 - 2\langle z-p,x-p\rangle + |x-p|^2 \geqslant |z-p|^2$, so $p$ is
minimising.

\textbf{Uniqueness.} If $p$ and $p'$ both minimise, both satisfy~\eqref{eq:variational} by
the characterisation. Taking $x=p'$ in the inequality for $p$ and $x=p$ in the inequality
for $p'$ gives $\langle z-p,p'-p\rangle\leqslant0$ and $\langle z-p',p-p'\rangle\leqslant0$.
Adding, $\langle(z-p)-(z-p'),p'-p\rangle=|p'-p|^2\leqslant0$, so $p=p'$.
\end{proof}

\begin{theorem}[Separating hyperplane]\label{thm:separating}
Let $C\subseteq\Real^d$ be non-empty, closed and convex, and $z\notin C$. Then there exist
$\bw\neq\bzero$ and $\alpha\in\Real$ with
$\langle\bw,z\rangle > \alpha \geqslant \langle\bw,x\rangle$ for every $x\in C$.
\end{theorem}

\begin{proof}
Let $p$ be the nearest point of Theorem~\ref{thm:nearest} and put $\bw=z-p\neq\bzero$. By
\eqref{eq:variational}, $\langle\bw,x\rangle\leqslant\langle\bw,p\rangle$ for every
$x\in C$; take $\alpha=\langle\bw,p\rangle$. Then
$\langle\bw,z\rangle-\alpha = \langle\bw,z-p\rangle = |\bw|^2>0$.
\end{proof}

\begin{proposition}[First-order condition]\label{prop:convex-fo}
A differentiable $f$ on an open convex $C$ is convex if and only if
$f(y)\geqslant f(x)+\langle\nabla f(x),y-x\rangle$ for all $x,y\in C$. A convex
differentiable $f$ attains a global minimum at $x$ if and only if $\nabla f(x)=\bzero$.
\end{proposition}

\begin{proof}
If $f$ is convex then for $\lambda\in(0,1]$,
$f(x+\lambda(y-x))\leqslant f(x)+\lambda\{f(y)-f(x)\}$, so
\[
\frac{f(x+\lambda(y-x))-f(x)}{\lambda}\leqslant f(y)-f(x) ;
\]
letting $\lambda\to0^+$, the left side tends to $\langle\nabla f(x),y-x\rangle$, because
differentiability at $x$ means $f(x+h)=f(x)+\langle\nabla f(x),h\rangle+r(h)$ with
$r(h)/|h|\to0$, and with $h=\lambda(y-x)$, $y\neq x$, the remainder divided by $\lambda$ is
$|y-x|\,r(h)/|h|\to0$ (for $y=x$ there is nothing to prove). A non-strict inequality
survives the limit, which gives the gradient inequality. Conversely, given the gradient
inequality, let $x,y\in C$, $\lambda\in[0,1]$ and $u=\lambda x+(1-\lambda)y\in C$. The
gradient inequality at $u$ gives
\[
f(x)\geqslant f(u)+\langle\nabla f(u),x-u\rangle,\qquad
f(y)\geqslant f(u)+\langle\nabla f(u),y-u\rangle .
\]
Multiplying the first by $\lambda$, the second by $1-\lambda$ and adding,
$\lambda f(x)+(1-\lambda)f(y)\geqslant f(u)+\langle\nabla f(u),\lambda x+(1-\lambda)y-u\rangle
=f(u)$, since $\lambda x+(1-\lambda)y-u=\bzero$.

The minimum statement follows: $\nabla f(x)=\bzero$ makes the gradient inequality read
$f(y)\geqslant f(x)$ for all $y\in C$. Conversely, let $x$ be a minimiser. Since $C$ is
open there is $r>0$ with $x+t\mathbf{e}_j\in C$ for $|t|<r$, where $\mathbf{e}_j$ is the
$j$th standard basis vector, and $\varphi_j(t)=f(x+t\mathbf{e}_j)$ has a minimum at the
interior point $t=0$ of $(-r,r)$, with $\varphi_j'(0)=\partial_jf(x)$. The difference
quotients $\{\varphi_j(t)-\varphi_j(0)\}/t$ are $\geqslant0$ for $0<t<r$ and $\leqslant0$
for $-r<t<0$, so their limit $\partial_jf(x)$ is both $\geqslant0$ and $\leqslant0$, as in
the proof of Theorem~\ref{thm:rolle}. Hence every partial derivative vanishes:
$\nabla f(x)=\bzero$.
\end{proof}

\begin{lemma}[Coercive minimisation]\label{lem:coercive}
Let $f:\Real^d\to\Real$ be continuous and \emph{coercive}, meaning $f(x)\to\infty$ as
$|x|\to\infty$. Then $f$ attains its infimum. If $f$ is in addition strictly convex
(Lemma~\ref{lem:convex-deriv}), the minimiser is unique.
\end{lemma}

\begin{proof}
Fix $x_0$ and put $S=\{x: f(x)\leqslant f(x_0)\}$, which contains $x_0$. It is closed: if
$x_n\in S$ and $x_n\to x$, continuity gives $f(x)=\lim_nf(x_n)\leqslant f(x_0)$, so $x\in S$.
Coercivity gives $R$ with $f(x)>f(x_0)$ whenever $|x|>R$, so $S\subseteq\{|x|\leqslant R\}$
is bounded, hence compact by Theorem~\ref{thm:HB}. By Theorem~\ref{thm:unif-cont} applied to
$-f$, $f$ attains a minimum on $S$ at some $x^\star$, and for $x\notin S$ one has
$f(x)>f(x_0)\geqslant f(x^\star)$, so $x^\star$ minimises $f$ on $\Real^d$.

If $x^\star\neq y^\star$ both minimise, with common value $m$, strict convexity with
$\lambda=\tfrac12$ gives
$f\bigl(\tfrac12(x^\star+y^\star)\bigr)<\tfrac12f(x^\star)+\tfrac12f(y^\star)=m$,
contradicting minimality.
\end{proof}

\begin{lemma}[Directional characterisation of a convex minimum]\label{lem:dirderiv}
Let $f:\Real^d\to\Real$ be convex. For each $x$ and $v$ the difference quotient
$t\mapsto\{f(x+tv)-f(x)\}/t$ is non-decreasing on $t>0$, so
\begin{equation}\label{eq:dirderiv}
f'(x;v) = \lim_{t\downarrow0}\frac{f(x+tv)-f(x)}{t}
\end{equation}
exists in $[-\infty,\infty)$. Moreover $x$ minimises $f$ over $\Real^d$ if and only if
$f'(x;v)\geqslant0$ for every $v$.
\end{lemma}

\begin{proof}
Write $q(t)=\{f(x+tv)-f(x)\}/t$ for $t>0$. For $0<s<t$ write
$x+sv = (1-s/t)x+(s/t)(x+tv)$, a convex combination since $0<s/t<1$; convexity gives
$f(x+sv)\leqslant(1-s/t)f(x)+(s/t)f(x+tv)$, that is
$f(x+sv)-f(x)\leqslant(s/t)\{f(x+tv)-f(x)\}$, and dividing by $s>0$ gives
$q(s)\leqslant q(t)$. Put $\ell=\inf_{t>0}q(t)\in[-\infty,\infty)$. For any $c>\ell$ there
is $t_0>0$ with $q(t_0)<c$, and then $\ell\leqslant q(t)\leqslant q(t_0)<c$ for
$0<t<t_0$ by monotonicity; so $q(t)\to\ell$ as $t\downarrow0$ (when $\ell=-\infty$ this
says $q(t)\to-\infty$). Thus the limit~\eqref{eq:dirderiv} exists and equals $\ell$, and
$f'(x;v)=\ell\leqslant q(t)$ for every $t>0$; multiplying by $t$,
\begin{equation}\label{eq:dd-lower}
f(x+tv)\geqslant f(x)+t\,f'(x;v) \qquad (t>0) .
\end{equation}

If $f'(x;v)\geqslant0$ for every $v$, then~\eqref{eq:dd-lower} with $t=1$ and $v=y-x$ gives
$f(y)\geqslant f(x)+f'(x;y-x)\geqslant f(x)$ for every $y$. Conversely, if $x$ is a
minimiser, then $f(x+tv)-f(x)\geqslant0$, so every difference quotient
in~\eqref{eq:dirderiv} is non-negative, hence so is their infimum $f'(x;v)$.
\end{proof}

\begin{lemma}[Interior of the closure of a convex set]\label{lem:closure-interior}
If $E\subseteq\Real^d$ is convex and $\overline E$ contains an open ball about $x$, then
$x\in E$. Here $\overline E$, the closure of $E$, is the set of limits of convergent sequences
of points of $E$.
\end{lemma}

\begin{proof}
Translating, take $x=\bzero$ and an open ball $B$ of radius $r>0$ about $\bzero$ with
$B\subseteq\overline E$. First, $E$ has an interior point. $E$ lies in no hyperplane
$H=\{y:\langle\ba,y\rangle=c\}$ with $\ba\neq\bzero$: $H$ is closed, so $E\subseteq H$
would give $B\subseteq\overline E\subseteq H$, yet $\pm\tfrac r2\ba/|\ba|\in B$ give
different values of $\langle\ba,\cdot\rangle$ (namely $\pm\tfrac r2|\ba|$). ($E$ is
non-empty, since $\overline E\supseteq B$ is.)

Pick $w_0\in E$ and then, for $j=1,\ldots,d$ in turn, $w_j\in E$ with
$w_j-w_0\notin U_{j-1}=\operatorname{span}\{w_1-w_0,\ldots,w_{j-1}-w_0\}$ ($U_0=\{\bzero\}$).
Such a $w_j$ exists: otherwise $E\subseteq w_0+U_{j-1}$, where $U_{j-1}$ has dimension at
most $j-1<d$. Take a basis $u_1,\ldots,u_k$ of $U_{j-1}$, $k<d$; the linear map
$T\ba=(\langle\ba,u_1\rangle,\ldots,\langle\ba,u_k\rangle)$ from $\Real^d$ to $\Real^k$ is not
injective, since an injective linear map would carry the $d$ standard basis vectors to $d$
linearly independent vectors of $\Real^k$, impossible as $k<d$. So some $\ba\neq\bzero$ has
$\langle\ba,u_i\rangle=0$ for all $i$, hence $\langle\ba,u\rangle=0$ for $u\in U_{j-1}$, and
$E\subseteq w_0+U_{j-1}\subseteq\{y:\langle\ba,y\rangle=\langle\ba,w_0\rangle\}$, a hyperplane,
contradicting the previous paragraph. The vectors $w_1-w_0,\ldots,w_d-w_0$ are linearly
independent: in a vanishing combination $\sum_ic_i(w_i-w_0)=\bzero$ with some $c_i\neq0$, the
largest such index $j$ would give $w_j-w_0=-\sum_{i<j}(c_i/c_j)(w_i-w_0)\in U_{j-1}$. Being
$d$ independent vectors in $\Real^d$ they form a basis, so the matrix $V$ with columns
$w_j-w_0$ satisfies $V\bc_i=\mathbf{e}_i$ for some $\bc_i$, $i=1,\ldots,d$; the matrix with
columns $\bc_i$ is a right inverse of $V$, hence its inverse $V^{-1}$. The map
$\mu(y)=V^{-1}(y-w_0)$ is continuous in $y$, each coordinate being linear. Every $y$ with
$\mu(y)\geqslant\bzero$ and $\sum_j\mu_j(y)\leqslant1$ satisfies
$y=w_0+V\mu(y)=(1-\sum_j\mu_j)w_0+\sum_j\mu_jw_j$, a convex combination of points of $E$, so
$y\in E$ (a convex set contains the convex combinations of finitely many of its points, by
induction on their number: $\sum_{j=0}^k\theta_jw_j=(1-\theta_k)\sum_{j<k}\frac{\theta_j}{1-\theta_k}w_j+\theta_kw_k$
for $\theta_k<1$). At $z=w_0+V\bone/(d+1)$ the coordinates of $\mu(z)$ equal $1/(d+1)>0$ and
sum to $d/(d+1)<1$. Each of the $d+1$ functions $\mu_1,\ldots,\mu_d$ and $\sum_j\mu_j$ is
continuous, so each strict inequality holds on some open ball about $z$; on the smallest of
these balls, of radius $\rho>0$ say, all hold, and that ball therefore lies in $E$.

Now take $t>0$ with $t|z|<r$, so $y=-tz\in B\subseteq\overline E$, and, $y$ being a limit of
points of $E$, pick $y'\in E$ with $|y'-y|<t\rho$. Then $z'=z-(y'-y)/t$ satisfies
$|z'-z|<\rho$, so $z'\in E$, and
\[
\tfrac{1}{1+t}\,y'+\tfrac{t}{1+t}\,z'=\tfrac{y'+tz-(y'-y)}{1+t}=\tfrac{y+tz}{1+t}=\bzero ,
\]
a convex combination of the points $y',z'\in E$; by convexity $\bzero\in E$.
\end{proof}

\begin{theorem}[Separation of two convex sets]\label{thm:sep2}
Let $C,D\subseteq\Real^d$ be non-empty disjoint convex sets. Then there are $\bw\neq\bzero$
and $\alpha$ with $\langle\bw,x\rangle\leqslant\alpha\leqslant\langle\bw,y\rangle$ for all
$x\in C$, $y\in D$.
\end{theorem}

\begin{proof}
$E=C-D=\{x-y: x\in C,\ y\in D\}$ is non-empty and convex: for $x,x'\in C$, $y,y'\in D$ and
$\theta\in[0,1]$, $\theta(x-y)+(1-\theta)(x'-y')=\{\theta x+(1-\theta)x'\}-\{\theta
y+(1-\theta)y'\}\in C-D$. Also $\bzero\notin E$ because $C$ and $D$ are disjoint. Let
$\overline E$ be the set of limits of convergent sequences in $E$. It contains $E$
(constant sequences), and it is convex: if $a_n\to a$ and $b_n\to b$ with $a_n,b_n\in E$, then
$\theta a_n+(1-\theta)b_n\in E$ tends to $\theta a+(1-\theta)b$. It is closed: if
$c_k\in\overline E$ and $c_k\to c$, pick $e_k\in E$ with $|e_k-c_k|<1/k$; then $e_k\to c$, so
$c\in\overline E$.

\textbf{Case $\bzero\notin\overline{E}$.} Theorem~\ref{thm:separating} applied to the
non-empty closed convex $\overline{E}$ and the point $\bzero$ gives $\bw\neq\bzero$ and
$\alpha'$ with $\langle\bw,z\rangle\leqslant\alpha'<\langle\bw,\bzero\rangle=0$ for all
$z\in\overline E$.

\textbf{Case $\bzero\in\overline E\setminus E$.} No open ball about $\bzero$ lies inside
$\overline E$: otherwise Lemma~\ref{lem:closure-interior} would place $\bzero$ in $E$. So
for each $k$ the ball of radius $1/k$ about $\bzero$ contains some $z_k\notin\overline E$,
and $z_k\to\bzero$. For each $k$, Theorem~\ref{thm:separating} applied to $\overline E$ and
$z_k$ gives $\bw_k\neq\bzero$ with $\langle\bw_k,z\rangle<\langle\bw_k,z_k\rangle$ for all
$z\in\overline E$; dividing by $|\bw_k|$, take $|\bw_k|=1$. The $\bw_k$ are bounded, so by
Theorem~\ref{thm:BW} a subsequence $\bw_{k_j}$ converges to some $\bw$, and
$|\bw|=\lim_j|\bw_{k_j}|=1$. For fixed $z\in\overline E$,
$\langle\bw_{k_j},z\rangle<\langle\bw_{k_j},z_{k_j}\rangle\leqslant d\,|z_{k_j}|\to0$, since
each coordinate of the unit vector $\bw_{k_j}$ has modulus at most $1$ and each coordinate of
$z_{k_j}$ has modulus at most $|z_{k_j}|$; meanwhile
$\langle\bw_{k_j},z\rangle\to\langle\bw,z\rangle$; so $\langle\bw,z\rangle\leqslant0$ for
all $z\in\overline E$, in particular for all $z\in E$.

Either way $\bw\neq\bzero$ and $\langle\bw,x-y\rangle\leqslant0$ for $x\in C$, $y\in D$, that
is $\langle\bw,x\rangle\leqslant\langle\bw,y\rangle$. Fixing $y$, the set
$\{\langle\bw,x\rangle:x\in C\}$ is bounded above, so its supremum $s$ exists and
$s\leqslant\langle\bw,y\rangle$ for every $y\in D$; hence
$s\leqslant\inf_{y\in D}\langle\bw,y\rangle$, and $\alpha=s$ works.
\end{proof}

%==============================================================================
\section{Convex Programming and Duality}\label{sec:P.3b}
%==============================================================================

Consider
\begin{equation}\label{eq:primal}
p^\star = \inf\ f_0(x) \quad\text{subject to}\quad f_i(x)\leqslant0,\ i=1,\ldots,m,
\qquad x\in\calD\subseteq\Real^d ,
\end{equation}
with $\calD$ convex and $f_0,\ldots,f_m$ convex on $\calD$.

\begin{definition}[Lagrangian and dual function]\label{def:lagrangian}
For $\blam\in\Real^m$,
\begin{equation}\label{eq:lagrangian}
L(x,\blam) = f_0(x)+\sum_{i=1}^m\lambda_i f_i(x),
\qquad
g(\blam) = \inf_{x\in\calD} L(x,\blam) ,
\end{equation}
and the \emph{dual problem} is $d^\star=\sup_{\blam\geqslant\bzero} g(\blam)$.
\end{definition}

\begin{proposition}[Concavity of the dual]\label{prop:dual-concave}
$g$ is concave on $\Real^m$, whatever the $f_i$.
\end{proposition}

\begin{proof}
For each fixed $x$, $\blam\mapsto L(x,\blam)$ is affine. An infimum of affine functions is
concave: if $g(\blam)=\inf_x L(x,\blam)$ then for $\theta\in[0,1]$,
\[
L(x,\theta\blam+(1-\theta)\bmu) = \theta L(x,\blam)+(1-\theta)L(x,\bmu)
\geqslant \theta g(\blam)+(1-\theta)g(\bmu) ,
\]
and taking the infimum over $x$ on the left preserves the bound.
\end{proof}

\begin{theorem}[Weak duality]\label{thm:weak-duality}
$d^\star\leqslant p^\star$.
\end{theorem}

\begin{proof}
Let $x$ be feasible and $\blam\geqslant\bzero$. Then $\lambda_if_i(x)\leqslant0$ for every
$i$, so $L(x,\blam)\leqslant f_0(x)$ and hence
$g(\blam)\leqslant L(x,\blam)\leqslant f_0(x)$. Taking the infimum over feasible $x$ gives
$g(\blam)\leqslant p^\star$, and then the supremum over $\blam\geqslant\bzero$.
\end{proof}

\begin{theorem}[Slater implies strong duality]\label{thm:slater}
Suppose $p^\star$ is finite and \emph{Slater's condition} holds: there is
$\tilde x\in\calD$ with $f_i(\tilde x)<0$ for every $i$. Then $d^\star=p^\star$, and the
dual optimum is attained.
\end{theorem}

\begin{proof}
Put
\[
\calA = \bigl\{(\bu,t)\in\Real^m\times\Real:\ \exists x\in\calD \text{ with }
f_i(x)\leqslant u_i\ \forall i,\ f_0(x)\leqslant t\bigr\} .
\]
$\calA$ is convex: given $(\bu,t)$ witnessed by $x$ and $(\bu',t')$ by $x'$, and
$\theta\in[0,1]$, the point $x_\theta=\theta x+(1-\theta)x'$ lies in $\calD$ by convexity of
$\calD$, and convexity of each $f_i$ gives
$f_i(x_\theta)\leqslant\theta f_i(x)+(1-\theta)f_i(x')\leqslant\theta u_i+(1-\theta)u_i'$,
and likewise $f_0(x_\theta)\leqslant\theta t+(1-\theta)t'$; so $x_\theta$ witnesses
$\theta(\bu,t)+(1-\theta)(\bu',t')\in\calA$. Also
$\calB=\{(\bzero,s): s<p^\star\}$ is convex (a segment of a line), both sets are non-empty
($\calA$ contains $(f_1(\tilde x),\ldots,f_m(\tilde x),f_0(\tilde x))$, and $\calB$ is
non-empty as $p^\star$ is finite), and $\calA\cap\calB=\emptyset$, since a point
$(\bzero,s)$ of the intersection would be witnessed by an $x\in\calD$ with
$f_i(x)\leqslant0$ for all $i$, a feasible point, with $f_0(x)\leqslant s<p^\star$,
contradicting the definition of $p^\star$.

By Theorem~\ref{thm:sep2} applied with $C=\calB$ and $D=\calA$ there are
$(\blam,\mu)\neq\bzero$ and $\alpha$ with
\begin{equation}\label{eq:sep-A-B}
\langle\blam,\bu\rangle+\mu t\geqslant\alpha \ \ \text{on }\calA,
\qquad
\mu s\leqslant\alpha \ \ \text{for all } s<p^\star .
\end{equation}
Increasing any $u_i$ or $t$ keeps a point in $\calA$ (the same witness $x$ serves). If some
$\lambda_i<0$, then starting from a point $(\bu,t)\in\calA$ and replacing $u_i$ by
$u_i+r$, the left side of~\eqref{eq:sep-A-B} becomes
$\langle\blam,\bu\rangle+\mu t+\lambda_ir\to-\infty$ as $r\to\infty$, contradicting the
bound $\geqslant\alpha$; so $\blam\geqslant\bzero$, and in the same way, increasing $t$,
$\mu\geqslant0$. Letting $s\uparrow p^\star$ in $\mu s\leqslant\alpha$ gives
$\mu p^\star\leqslant\alpha$.

\textbf{Case $\mu>0$.} For arbitrary $x\in\calD$ the point
$(\bu,t)=(f_1(x),\ldots,f_m(x),f_0(x))$ lies in $\calA$, witnessed by $x$ itself. Dividing
the first inequality of~\eqref{eq:sep-A-B} at this point by $\mu$, and using
$\alpha/\mu\geqslant p^\star$,
\[
f_0(x)+\sum_i\frac{\lambda_i}{\mu}f_i(x) \geqslant \frac{\alpha}{\mu}\geqslant p^\star .
\]
The left side is $L(x,\blam/\mu)$, so taking the infimum over $x\in\calD$ gives
$g(\blam/\mu)\geqslant p^\star$. As $\blam/\mu\geqslant\bzero$,
$d^\star\geqslant g(\blam/\mu)\geqslant p^\star$, and Theorem~\ref{thm:weak-duality} gives
$d^\star\leqslant p^\star$; so $d^\star=p^\star=g(\blam/\mu)$, and the dual optimum is
attained at $\blam/\mu$.

\textbf{Case $\mu=0$.} Then $\langle\blam,\bu\rangle\geqslant\alpha\geqslant\mu p^\star=0$
on $\calA$, so $\sum_i\lambda_if_i(x)\geqslant0$ for every $x\in\calD$. Taking
$x=\tilde x$: every term $\lambda_if_i(\tilde x)$ is $\leqslant0$, as $\lambda_i\geqslant0$
and $f_i(\tilde x)<0$, and the terms add to a number $\geqslant0$, so every term is $0$;
since $f_i(\tilde x)\neq0$, every $\lambda_i=0$. Then $(\blam,\mu)=\bzero$, a contradiction.
So this case cannot occur.
\end{proof}

\begin{theorem}[Karush--Kuhn--Tucker]\label{thm:kkt}
Assume $\calD$ open, $f_0,\ldots,f_m$ differentiable and strong duality, with $x^\star$ primal and
$\blam^\star$ dual optimal. Then
\begin{align}
f_i(x^\star)&\leqslant0, & \lambda_i^\star&\geqslant0, \label{eq:kkt-feas}\\
\lambda_i^\star f_i(x^\star)&=0 \ \ (i=1,\ldots,m), &
\nabla f_0(x^\star)+\sum_i\lambda_i^\star\nabla f_i(x^\star)&=\bzero .\label{eq:kkt-stat}
\end{align}
Conversely, if the problem is convex and $(x^\star,\blam^\star)$
satisfies~\eqref{eq:kkt-feas}--\eqref{eq:kkt-stat}, then they are primal and dual optimal
with zero gap.
\end{theorem}

\begin{proof}
\textbf{Necessity.} Primal optimality includes feasibility, $f_i(x^\star)\leqslant0$, and
dual optimality includes $\blam^\star\geqslant\bzero$: that is~\eqref{eq:kkt-feas}. Strong
duality, $f_0(x^\star)=p^\star=d^\star=g(\blam^\star)$, gives
\[
f_0(x^\star) = g(\blam^\star) = \inf_{x\in\calD}\Bigl\{f_0(x)+\sum_i\lambda_i^\star f_i(x)\Bigr\}
\leqslant f_0(x^\star)+\sum_i\lambda_i^\star f_i(x^\star) \leqslant f_0(x^\star) ,
\]
the last step because each $\lambda_i^\star f_i(x^\star)\leqslant0$. So both inequalities
are equalities. Equality on the right forces
$\sum_i\lambda_i^\star f_i(x^\star)=0$, a sum of non-positive terms, hence each term is
zero: that is \emph{complementary slackness}. Equality on the left says $x^\star$
minimises the differentiable function $x\mapsto L(x,\blam^\star)$ over $\calD$, whose
gradient is $\nabla f_0+\sum_i\lambda_i^\star\nabla f_i$. Since $\calD$ is open, the
argument at the end of the proof of Proposition~\ref{prop:convex-fo} (a minimum at an
interior point of each coordinate line forces the partial derivative to vanish, which uses
no convexity) shows this gradient vanishes at $x^\star$: that is the stationarity condition
in~\eqref{eq:kkt-stat}.

\textbf{Sufficiency.} Complementary slackness gives
$L(x^\star,\blam^\star)=f_0(x^\star)+\sum_i\lambda_i^\star f_i(x^\star)=f_0(x^\star)$.
Under convexity, $L(\cdot,\blam^\star)=f_0+\sum_i\lambda_i^\star f_i$ is convex, as a sum of
convex functions with non-negative weights $\lambda_i^\star$, and differentiable on the open
convex $\calD$ with vanishing gradient at $x^\star$ by~\eqref{eq:kkt-stat}; so by
Proposition~\ref{prop:convex-fo} $x^\star$ minimises it, i.e.\
$g(\blam^\star)=L(x^\star,\blam^\star)=f_0(x^\star)$. Since $x^\star$ is feasible and
$\blam^\star\geqslant\bzero$, the definitions and Theorem~\ref{thm:weak-duality} give
\[
f_0(x^\star)\geqslant p^\star\geqslant d^\star\geqslant g(\blam^\star)=f_0(x^\star),
\]
so all four are equal: $x^\star$ attains $p^\star$, $\blam^\star$ attains $d^\star$, and the
gap $p^\star-d^\star$ is zero.
\end{proof}

\begin{remark}
In the support vector classifier of Unit~14, $x=(\bw,b)$, $f_0(x)=\tfrac12|\bw|^2$, and each
observation $(\bx_i,y_i)$, $y_i\in\{-1,1\}$, contributes the margin constraint
$f_i(x)=1-y_i(\bw'\bx_i+b)\leqslant0$; the stationarity condition in~\eqref{eq:kkt-stat},
read in the $\bw$ coordinates, gives $\bw^\star=\sum_i\lambda_i^\star y_i\bx_i$.
Here Theorem~\ref{thm:kkt} applies when the two classes are linearly separable: the
problem is convex with $0\leqslant p^\star<\infty$ (separability makes it feasible), and rescaling a separating $(\bw,b)$ makes every $f_i<0$, which is
Slater's condition, so Theorem~\ref{thm:slater} supplies the strong duality and the dual
optimum that Theorem~\ref{thm:kkt} assumes at a primal optimum $x^\star$.
Complementary slackness produces the support vectors: $\lambda_i^\star>0$ forces
$f_i(x^\star)=0$, so only the observations whose margin constraint is active carry a
nonzero multiplier, and $\bw^\star$ depends on those alone.
\end{remark}

%##############################################################################
\coursepart{II}{Linear Algebra}
%##############################################################################

%==============================================================================
\section{Rank, Column Space, Rank--Nullity}\label{sec:P.4}
%==============================================================================

For $\bA\in\Real^{n\times p}$ write $\calC(\bA)=\{\bA\bv:\bv\in\Real^p\}$ for the column
space and $\calN(\bA)=\{\bv:\bA\bv=\bzero\}$ for the null space, and
$\rank(\bA)=\dim\calC(\bA)$.

\begin{theorem}[Rank--nullity]\label{thm:rank-nullity}
$\rank(\bA)+\dim\calN(\bA)=p$.
\end{theorem}

\begin{proof}
Take a basis $\bv_1,\ldots,\bv_q$ of $\calN(\bA)$ and extend it to a basis
$\bv_1,\ldots,\bv_p$ of $\Real^p$. The vectors $\bA\bv_{q+1},\ldots,\bA\bv_p$ span
$\calC(\bA)$: any $\bv\in\Real^p$ is $\sum_{j\leqslant p}c_j\bv_j$, and since
$\bA\bv_j=\bzero$ for $j\leqslant q$, $\bA\bv=\sum_{j>q}c_j\bA\bv_j$. They are independent: if
$\sum_{j>q}c_j\bA\bv_j=\bzero$ then $\bA\bigl(\sum_{j>q}c_j\bv_j\bigr)=\bzero$, so
$\sum_{j>q}c_j\bv_j\in\calN(\bA)$ is a combination $\sum_{j\leqslant q}d_j\bv_j$; then
$\sum_{j\leqslant q}d_j\bv_j-\sum_{j>q}c_j\bv_j=\bzero$, and independence of the full basis
forces every $c_j=0$. So $\bA\bv_{q+1},\ldots,\bA\bv_p$ is a basis of $\calC(\bA)$, and
$\rank(\bA)=p-q$.
\end{proof}

\begin{proposition}[Gram matrices]\label{prop:gram}
$\calN(\bA'\bA)=\calN(\bA)$ and $\rank(\bA'\bA)=\rank(\bA)$. In particular $\bA'\bA$ is
invertible if and only if $\bA$ has full column rank.
\end{proposition}

\begin{proof}
If $\bA\bv=\bzero$ then $\bA'\bA\bv=\bzero$. Conversely $\bA'\bA\bv=\bzero$ gives
$\bv'\bA'\bA\bv=|\bA\bv|^2=0$, so $\bA\bv=\bzero$. The null spaces coincide, and both
matrices have $p$ columns, so Theorem~\ref{thm:rank-nullity} gives
$\rank(\bA'\bA)=p-\dim\calN(\bA'\bA)=p-\dim\calN(\bA)=\rank(\bA)$. $\bA'\bA$ is $p\times p$.
If its rank is $p$, its column space is a $p$-dimensional subspace of $\Real^p$, hence all of
$\Real^p$; so for each standard basis vector $\mathbf{e}_i$ there is $\bc_i$ with
$\bA'\bA\bc_i=\mathbf{e}_i$, and the matrix with columns $\bc_i$ is a right inverse, hence
the inverse. Conversely, if $\bA'\bA$ is invertible then $\bA'\bA\bv=\bzero$ forces
$\bv=\bzero$, so $\dim\calN(\bA'\bA)=0$ and the rank is $p$. Full column rank of $\bA$ means
$\rank(\bA)=p$, which by the first part is $\rank(\bA'\bA)=p$.
\end{proof}


%==============================================================================
\section{The Trace}\label{sec:P.trace}
%==============================================================================

\begin{definition}[Trace]\label{def:trace}
$\tr(\bA)=\sum_{i}a_{ii}$ for square $\bA$.
\end{definition}

\begin{proposition}[Properties of the trace]\label{prop:trace}
\leavevmode
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{tr:i}   $\tr$ is linear: $\tr(\alpha\bA+\beta\bB)=\alpha\tr(\bA)+\beta\tr(\bB)$.
\item\label{tr:ii}  $\tr(\bA\bB)=\tr(\bB\bA)$ whenever both products are defined, even when
      $\bA\bB$ and $\bB\bA$ have different sizes.
\item\label{tr:iii} $\tr(\bP\bA\bP^{-1})=\tr(\bA)$ for invertible $\bP$: the trace is a
      similarity invariant.
\item\label{tr:iv}  $\tr(\bA'\bA)=\sum_{i,j}a_{ij}^2$, so $\tr(\bA'\bA)=0$ forces
      $\bA=\bzero$.
\end{enumerate}
\end{proposition}

\begin{proof}
\ref{tr:i} is immediate. For~\ref{tr:ii}, with $\bA$ of size $m\times n$ and $\bB$ of size
$n\times m$,
\[
\tr(\bA\bB)=\sum_{i=1}^m\sum_{j=1}^n a_{ij}b_{ji}
          =\sum_{j=1}^n\sum_{i=1}^m b_{ji}a_{ij}=\tr(\bB\bA) ,
\]
the two double sums differing only in the order of summation, which is finite.
\ref{tr:iii} follows by applying~\ref{tr:ii} with the pair $\bP\bA$ and $\bP^{-1}$:
$\tr\bigl((\bP\bA)\bP^{-1}\bigr)=\tr\bigl(\bP^{-1}(\bP\bA)\bigr)=\tr(\bA)$.
For~\ref{tr:iv}, the $(i,i)$ entry of $\bA'\bA$ is $\sum_j a_{ji}^2$.
\end{proof}

\begin{remark}
Property~\ref{tr:iii} makes $\tr(\bA)$ well defined on a linear map rather than on a
matrix.
\end{remark}

%==============================================================================
\section{Inner Products, Orthogonality, Projection}\label{sec:P.5}
%==============================================================================

\begin{theorem}[Cauchy--Schwarz]\label{thm:CS}
$|\langle\bu,\bv\rangle|\leqslant|\bu|\,|\bv|$, with equality iff $\bu$ and $\bv$ are
proportional.
\end{theorem}

\begin{proof}
If $\bv=\bzero$ both sides are $0$ and $\bv=0\cdot\bu$, so $\bu$ and $\bv$ are
proportional. For $\bv\neq\bzero$ and $t\in\Real$,
$0\leqslant|\bu-t\bv|^2 = |\bu|^2-2t\langle\bu,\bv\rangle+t^2|\bv|^2$. The right side is a
quadratic in $t$ with non-negative values; at its minimising point
$t_0=\langle\bu,\bv\rangle/|\bv|^2$ it equals $|\bu|^2-\langle\bu,\bv\rangle^2/|\bv|^2$, so
\[
0\leqslant|\bu-t_0\bv|^2=|\bu|^2-\frac{\langle\bu,\bv\rangle^2}{|\bv|^2},
\]
that is $\langle\bu,\bv\rangle^2\leqslant|\bu|^2|\bv|^2$, which is the inequality after
taking square roots. Equality holds exactly when $|\bu-t_0\bv|=0$, that is $\bu=t_0\bv$, so
equality forces proportionality. Conversely, if $\bu=c\bv$ both sides equal $|c|\,|\bv|^2$,
and if $\bv=c\bu$ both sides equal $|c|\,|\bu|^2$.
\end{proof}

\begin{theorem}[Orthogonal projection]\label{thm:projection}
Let $S\subseteq\Real^n$ be a subspace and $\by\in\Real^n$. There is a unique
$\hat\by\in S$ minimising $|\by-\bu|$ over $\bu\in S$, characterised by
$\by-\hat\by\perp S$. If $S=\calC(\bX)$ with $\bX$ of full column rank, then
$\hat\by=\bH\by$ with $\bH=\bX(\bX'\bX)^{-1}\bX'$.
\end{theorem}

\begin{proof}
A subspace is convex, and it is closed: this is trivial for $S=\{\bzero\}$; otherwise let
the columns of $\bB$ form a basis of $S$, so that $\bB'\bB$ is invertible by
Proposition~\ref{prop:gram}, and if $\bB\bc_m\to\by$ then
$\bc_m=(\bB'\bB)^{-1}\bB'\bB\bc_m\to\bc:=(\bB'\bB)^{-1}\bB'\by$ (each entry of
$(\bB'\bB)^{-1}\bB'\bz$ is a fixed linear combination of the entries of $\bz$, hence
continuous in $\bz$). Then $\bB\bc_m\to\bB\bc$ in the same way, and since a sequence has
one limit, $\by=\bB\bc\in S$. A subspace is non-empty, so Theorem~\ref{thm:nearest} gives
a unique minimiser $\hat\by$, characterised by $\langle\by-\hat\by,\bu-\hat\by\rangle\leqslant0$
for all $\bu\in S$. For a subspace this is equivalent to $\by-\hat\by\perp S$. Indeed, for
$\bs\in S$ both $\bu=\hat\by+\bs$ and $\bu=\hat\by-\bs$ lie in $S$, and the variational
inequality~\eqref{eq:variational} at these two points reads
$\langle\by-\hat\by,\bs\rangle\leqslant0$ and $-\langle\by-\hat\by,\bs\rangle\leqslant0$,
forcing $\langle\by-\hat\by,\bs\rangle=0$. Conversely, if $\by-\hat\by\perp S$ with
$\hat\by\in S$, then $\bu-\hat\by\in S$ for $\bu\in S$, so
$\langle\by-\hat\by,\bu-\hat\by\rangle=0\leqslant0$, and Theorem~\ref{thm:nearest} identifies
$\hat\by$ as the minimiser.

For the formula, $\by-\hat\by\perp\calC(\bX)$ means $\langle\by-\hat\by,\bX\mathbf{e}_j\rangle=0$
for every column, that is $\bX'(\by-\hat\by)=\bzero$. As $\hat\by\in\calC(\bX)$, write
$\hat\by=\bX\bc$; then $\bX'\bX\bc=\bX'\by$. Since $\bX'\bX$ is invertible by
Proposition~\ref{prop:gram}, $\bc=(\bX'\bX)^{-1}\bX'\by$ and
$\hat\by=\bX(\bX'\bX)^{-1}\bX'\by=\bH\by$.
\end{proof}

\begin{theorem}[Pythagoras]\label{thm:pythagoras}
If $\bu\perp\bv$ then $|\bu+\bv|^2=|\bu|^2+|\bv|^2$.
\end{theorem}

\begin{proof}
$|\bu+\bv|^2 = \langle\bu+\bv,\bu+\bv\rangle=|\bu|^2+2\langle\bu,\bv\rangle+|\bv|^2$, and
$\langle\bu,\bv\rangle=0$.
\end{proof}

%==============================================================================
\section{The Spectral Theorem}\label{sec:P.6}
%==============================================================================

\begin{theorem}[Spectral theorem]\label{thm:spectral}
A symmetric $\bA\in\Real^{n\times n}$ has an orthonormal basis of eigenvectors: there are
an orthogonal $\bP$ and a diagonal $\bLam$ with $\bA=\bP\bLam\bP'$, the diagonal entries of
$\bLam$ being the eigenvalues of $\bA$, all real.
\end{theorem}

\begin{proof}
Write $q(\bv)=\bv'\bA\bv$, a polynomial in the coordinates of $\bv$, hence continuous. For a
subspace $W\neq\{\bzero\}$ of $\Real^n$ let $\Sigma_W=\{\bv\in W:|\bv|=1\}$ be its unit
sphere, which is non-empty ($\bw/|\bw|$ for any $\bw\in W\setminus\{\bzero\}$).

\textbf{Step 1: the maximum of $q$ on $\Sigma_W$ is attained.} $\Sigma_W$ is bounded, and it
is closed: if $\bv_m\in\Sigma_W$ and $\bv_m\to\bv$, then $\bv\in W$ because $W$ is closed (as
shown in the proof of Theorem~\ref{thm:projection}), and $|\bv|=\lim_m|\bv_m|=1$. So
$\Sigma_W$ is compact by Theorem~\ref{thm:HB}, and by Theorem~\ref{thm:unif-cont} the
continuous $q$ attains its maximum on $\Sigma_W$.

\textbf{Step 2: a maximiser on an invariant subspace is an eigenvector.} Let $W\neq\{\bzero\}$
be $\bA$-invariant ($\bA W\subseteq W$), let $\bv_1\in\Sigma_W$ maximise $q$ on $\Sigma_W$, and
put $\lambda_1=q(\bv_1)=\bv_1'\bA\bv_1$, a real number. Fix $\bu\in W$ with $\bu\perp\bv_1$.
By Theorem~\ref{thm:pythagoras}, $|\bv_1+t\bu|^2=1+t^2|\bu|^2>0$ for every $t\in\Real$, so
$\bw(t)=(\bv_1+t\bu)/|\bv_1+t\bu|$ lies in $\Sigma_W$ and $q(\bw(t))\leqslant\lambda_1=q(\bw(0))$.
Expanding with $\bu'\bA\bv_1=\bv_1'\bA\bu$ (symmetry of $\bA$),
\[
\varphi(t):=q(\bw(t))=\frac{N(t)}{D(t)},\qquad
N(t)=\lambda_1+2t\,\bu'\bA\bv_1+t^2\,\bu'\bA\bu,\qquad D(t)=1+t^2|\bu|^2 ,
\]
a quotient of polynomials with $D>0$, hence differentiable, with a maximum at the interior
point $t=0$. As in the proof of Theorem~\ref{thm:rolle}, $\varphi'(0)=0$. By the quotient
rule, with $N(0)=\lambda_1$, $N'(0)=2\bu'\bA\bv_1$, $D(0)=1$, $D'(0)=0$,
\[
0=\varphi'(0)=\frac{N'(0)D(0)-N(0)D'(0)}{D(0)^2}= 2\bu'\bA\bv_1 .
\]
So $\bu'\bA\bv_1=0$ for every $\bu\in W$ with $\bu\perp\bv_1$. Apply this to
$\bu=\bA\bv_1-\lambda_1\bv_1$: it lies in $W$, since $\bA\bv_1\in W$ by invariance and
$\bv_1\in W$, and $\bv_1'\bu=\bv_1'\bA\bv_1-\lambda_1|\bv_1|^2=\lambda_1-\lambda_1=0$. Hence
\[
0=\bu'\bA\bv_1=\bu'(\bu+\lambda_1\bv_1)=|\bu|^2+\lambda_1\bu'\bv_1=|\bu|^2 ,
\]
so $\bu=\bzero$, that is $\bA\bv_1=\lambda_1\bv_1$.

\textbf{Step 3: the orthogonal complement of an eigenvector stays invariant.} With $W$,
$\bv_1$, $\lambda_1$ as in Step 2, the subspace $W\cap\bv_1^\perp=\{\bu\in W:\bu\perp\bv_1\}$
is $\bA$-invariant: for $\bu$ in it, $\bA\bu\in W$ by invariance of $W$, and by symmetry
$\langle\bA\bu,\bv_1\rangle=\bu'\bA'\bv_1=\bu'\bA\bv_1=\lambda_1\langle\bu,\bv_1\rangle=0$.

\textbf{Step 4: the recursion.} Put $W_0=\Real^n$, which is $\bA$-invariant. For
$k=1,2,\ldots,n$ in turn, suppose orthonormal $\bv_1,\ldots,\bv_{k-1}$ have been chosen (none
when $k=1$) with $\bA\bv_j=\lambda_j\bv_j$, and that
\[
W_{k-1}=\{\bu\in\Real^n:\bu\perp\bv_1,\ldots,\bu\perp\bv_{k-1}\}
\]
is $\bA$-invariant (for $k=1$ this is $W_0=\Real^n$). For $k\geqslant2$ let $\bV_{k-1}$
be the $n\times(k-1)$ matrix with columns $\bv_1,\ldots,\bv_{k-1}$; then $W_{k-1}=\calN(\bV_{k-1}')$, a subspace. Orthonormality means
$\bV_{k-1}'\bV_{k-1}=\bI_{k-1}$, so every $\bc\in\Real^{k-1}$ equals
$\bV_{k-1}'(\bV_{k-1}\bc)$ and $\calC(\bV_{k-1}')=\Real^{k-1}$; by
Theorem~\ref{thm:rank-nullity}, $\dim W_{k-1}=n-(k-1)\geqslant1$. So $W_{k-1}\neq\{\bzero\}$
for every $k\leqslant n$.
By Step 1 choose $\bv_k\in\Sigma_{W_{k-1}}$ maximising $q$ there, and put
$\lambda_k=q(\bv_k)$. By Step 2, $\bA\bv_k=\lambda_k\bv_k$ with $\lambda_k$ real. Since
$\bv_k\in W_{k-1}$, it is orthogonal to $\bv_1,\ldots,\bv_{k-1}$, and $|\bv_k|=1$, so
$\bv_1,\ldots,\bv_k$ are orthonormal. Finally
$W_k=W_{k-1}\cap\bv_k^\perp$ is $\bA$-invariant by Step 3. This is the hypothesis for
$k+1$, and the recursion continues until $k=n$. Since $W_k\subseteq W_{k-1}$, the maximum
over the smaller sphere is no larger, so $\lambda_1\geqslant\lambda_2\geqslant\cdots\geqslant\lambda_n$.

\textbf{Step 5: the diagonalisation.} Let $\bP$ have columns $\bv_1,\ldots,\bv_n$ and
$\bLam=\diag(\lambda_1,\ldots,\lambda_n)$. Orthonormality gives $\bP'\bP=\bI$, so $\bP$ is a
right inverse of the square matrix $\bP'$, hence its inverse, and $\bP\bP'=\bI$ as well:
$\bP$ is orthogonal. Column by column, $\bA\bP=(\bA\bv_1,\ldots,\bA\bv_n)
=(\lambda_1\bv_1,\ldots,\lambda_n\bv_n)=\bP\bLam$, and multiplying on the right by $\bP'$
gives $\bA=\bP\bLam\bP'$. Each $\lambda_k$ is an eigenvalue, with eigenvector $\bv_k$.
Conversely, if $\bA\bx=\mu\bx$ for some $\bx\neq\bzero$ (real or complex, with $\mu$ real or
complex), then $\bw=\bP'\bx\neq\bzero$ (as $\bx=\bP\bw$) and $\bP\bLam\bw=\bA\bx=\mu\bx=\mu\bP\bw$;
multiplying by $\bP'$ gives $\lambda_jw_j=\mu w_j$ for every $j$, and a $j$ with $w_j\neq0$
gives $\mu=\lambda_j$. So the eigenvalues of $\bA$ are exactly $\lambda_1,\ldots,\lambda_n$,
all real.
\end{proof}

\begin{corollary}[Rayleigh]\label{cor:rayleigh}
For symmetric $\bA$ with eigenvalues $\lambda_1\geqslant\cdots\geqslant\lambda_n$,
$\max_{|\bv|=1}\bv'\bA\bv=\lambda_1$ and $\min_{|\bv|=1}\bv'\bA\bv=\lambda_n$.
\end{corollary}

\begin{proof}
By Theorem~\ref{thm:spectral}, $\bA=\bP\bLam\bP'$ with $\bP$ orthogonal; permuting the
columns of $\bP$ and the diagonal entries of $\bLam$ in the same way (which preserves
$\bP\bLam\bP'=\sum_j\lambda_j\bp_j\bp_j'$, $\bp_j$ the $j$th column), take the diagonal of
$\bLam$ in the order $\lambda_1\geqslant\cdots\geqslant\lambda_n$. For $|\bv|=1$ put
$\bw=\bP'\bv$; then $\bv=\bP\bw$ and $|\bw|^2=\bv'\bP\bP'\bv=|\bv|^2=1$, and
\[
\bv'\bA\bv=\bw'\bP'\bP\bLam\bP'\bP\bw=\bw'\bLam\bw=\sum_j\lambda_jw_j^2 ,
\]
a convex combination of the eigenvalues, the weights $w_j^2\geqslant0$ adding to $1$. Hence
$\lambda_n=\sum_j\lambda_nw_j^2\leqslant\bv'\bA\bv\leqslant\sum_j\lambda_1w_j^2=\lambda_1$. The
bounds are attained at the first and last columns of $\bP$, unit eigenvectors with
$\bp_1'\bA\bp_1=\lambda_1|\bp_1|^2=\lambda_1$ and likewise $\bp_n'\bA\bp_n=\lambda_n$.
\end{proof}

%==============================================================================
\section{Positive Definiteness and Square Roots}\label{sec:P.7}
%==============================================================================

\begin{definition}\label{def:pd}
Symmetric $\bA$ is \emph{positive semi-definite} if $\bv'\bA\bv\geqslant0$ for all $\bv$,
and \emph{positive definite} if $\bv'\bA\bv>0$ for $\bv\neq\bzero$.
\end{definition}

\begin{proposition}\label{prop:pd-eigen}
A symmetric $\bA$ is positive semi-definite iff all its eigenvalues are non-negative, and
positive definite iff all are strictly positive; in the latter case $\bA$ is invertible.
\end{proposition}

\begin{proof}
By Corollary~\ref{cor:rayleigh} the extreme values of $\bv'\bA\bv$ on the unit sphere are
$\lambda_n$ and $\lambda_1$. For $\bv\neq\bzero$,
$\bv'\bA\bv=|\bv|^2\,(\bv/|\bv|)'\bA(\bv/|\bv|)\geqslant|\bv|^2\lambda_n$; so
$\lambda_n\geqslant0$ makes the form non-negative and $\lambda_n>0$ makes it positive.
Conversely, a unit eigenvector $\bu$ for $\lambda_n$ has $\bu'\bA\bu=\lambda_n$, so a
non-negative (positive) form forces $\lambda_n\geqslant0$ ($\lambda_n>0$). As $\lambda_n$ is
the smallest eigenvalue, this is the condition on all eigenvalues. If every eigenvalue is
nonzero, $\bLam^{-1}=\diag(1/\lambda_j)$ exists, and with $\bA=\bP\bLam\bP'$ and
$\bP'\bP=\bI$, $\bA\,\bP\bLam^{-1}\bP'=\bP\bLam\bLam^{-1}\bP'=\bP\bP'=\bI$; so
$\bA^{-1}=\bP\bLam^{-1}\bP'$.
\end{proof}

\begin{lemma}[Inverses of convergent positive definite matrices]\label{lem:inv-limit}
Let $\bA_n$ be symmetric matrices whose entries converge to those of a positive definite
$\bQ$, and let $\lambda>0$ be the smallest eigenvalue of $\bQ$. For all large $n$,
$\bA_n$ is positive definite with every eigenvalue at least $\lambda/2$, every entry of
$\bA_n^{-1}$ is at most $2/\lambda$ in absolute value, and $\bA_n^{-1}\to\bQ^{-1}$
entrywise.
\end{lemma}

\begin{proof}
For $|\bv|=1$ every coordinate has $|v_r|\leqslant1$, so $|v_rv_s|\leqslant1$ and
$|\bv'(\bA_n-\bQ)\bv|=\bigl|\sum_{r,s}v_r(\bA_n-\bQ)_{rs}v_s\bigr|
\leqslant\sum_{r,s}|(\bA_n-\bQ)_{rs}|=:\delta_n$, and $\delta_n\to0$ as a finite sum of terms
tending to $0$. By Corollary~\ref{cor:rayleigh}, $\bv'\bQ\bv\geqslant\lambda$, hence
$\bv'\bA_n\bv=\bv'\bQ\bv+\bv'(\bA_n-\bQ)\bv\geqslant\lambda-\delta_n\geqslant\lambda/2$ for
every unit $\bv$ once $\delta_n\leqslant\lambda/2$, that is for all large $n$. By the same
corollary applied to $\bA_n$, its smallest eigenvalue is the minimum of $\bv'\bA_n\bv$ over
unit $\bv$, so every eigenvalue of $\bA_n$ is at least $\lambda/2$, and
Proposition~\ref{prop:pd-eigen} makes $\bA_n$ positive definite and invertible. With
$\bA_n=\bP\bLam\bP'$ (Theorem~\ref{thm:spectral}; $\bP$, $\bLam$ depend on $n$),
$\bA_n^{-1}=\bP\bLam^{-1}\bP'$ by the proof of Proposition~\ref{prop:pd-eigen}. For unit
vectors $\bu,\bv$ put $\bw=\bP'\bv$, so $|\bw|=1$; then
$|\bA_n^{-1}\bv|^2=\bw'\bLam^{-1}\bP'\bP\bLam^{-1}\bw=\sum_j\lambda_j^{-2}w_j^2
\leqslant(2/\lambda)^2\sum_jw_j^2=(2/\lambda)^2$, the $\lambda_j\geqslant\lambda/2$ being the
eigenvalues of $\bA_n$, and $|\bu'\bA_n^{-1}\bv|\leqslant|\bu|\,|\bA_n^{-1}\bv|\leqslant2/\lambda$
by Theorem~\ref{thm:CS}. Taking $\bu=\mathbf{e}_r$ and $\bv=\mathbf{e}_s$ gives
$|(\bA_n^{-1})_{rs}|\leqslant2/\lambda$. Finally
$\bA_n^{-1}-\bQ^{-1}=\bA_n^{-1}(\bQ-\bA_n)\bQ^{-1}$ (multiply out the right side), whose
$(r,s)$ entry $\sum_{a,b}(\bA_n^{-1})_{ra}(\bQ-\bA_n)_{ab}(\bQ^{-1})_{bs}$ is a finite sum of
products of an entry bounded by $2/\lambda$, an entry tending to $0$, and a fixed entry;
each product tends to $0$, hence so does the sum.
\end{proof}

\begin{theorem}[Symmetric square root]\label{thm:sqrt}
A positive semi-definite $\bA$ has a unique positive semi-definite $\bA^{1/2}$ with
$(\bA^{1/2})^2=\bA$. If $\bA$ is positive definite so is $\bA^{1/2}$, and
$\bA^{-1/2}:=(\bA^{1/2})^{-1}$ satisfies $\bA^{-1/2}\bA\bA^{-1/2}=\bI$.
\end{theorem}

\begin{proof}
Write $\bA=\bP\bLam\bP'$ and set $\bA^{1/2}=\bP\bLam^{1/2}\bP'$ with $\bLam^{1/2}$ the
diagonal matrix of non-negative square roots, legitimate by
Proposition~\ref{prop:pd-eigen}. It is symmetric, since
$(\bP\bLam^{1/2}\bP')'=\bP\bLam^{1/2}\bP'$; it squares to $\bA$, since
$\bP\bLam^{1/2}\bP'\bP\bLam^{1/2}\bP'=\bP\bLam\bP'$ by $\bP'\bP=\bI$; and it is positive
semi-definite, since with $\bw=\bP'\bv$, $\bv'\bA^{1/2}\bv=\sum_j\lambda_j^{1/2}w_j^2\geqslant0$.

\textbf{Uniqueness.} Let $\bB$ be positive semi-definite with $\bB^2=\bA$. By
Theorem~\ref{thm:spectral}, $\bB=\bQ\bM\bQ'$ with $\bQ$ orthogonal, columns $\bq_i$, and
$\bM=\diag(\mu_1,\ldots,\mu_n)$, where $\mu_i\geqslant0$ by Proposition~\ref{prop:pd-eigen};
then $\bA=\bB^2=\bQ\bM^2\bQ'$, so $\bA\bq_i=\mu_i^2\bq_i$. Let $\alpha\geqslant0$ and
$\bx\in\Real^n$ with $\bA\bx=\alpha\bx$. Writing $\bx=\sum_id_i\bq_i$ (the $\bq_i$ form a
basis), $\bzero=\bA\bx-\alpha\bx=\sum_id_i(\mu_i^2-\alpha)\bq_i$, so by independence
$d_i=0$ unless $\mu_i^2=\alpha$, that is unless $\mu_i=\sqrt\alpha$ (both being
non-negative). Hence $\bB\bx=\sum_id_i\mu_i\bq_i=\sqrt\alpha\sum_id_i\bq_i=\sqrt\alpha\,\bx$.
The same argument with $\bA=\bP\bLam\bP'$ and $\bA^{1/2}=\bP\bLam^{1/2}\bP'$ in place of
$\bQ\bM^2\bQ'$ and $\bQ\bM\bQ'$ gives $\bA^{1/2}\bx=\sqrt\alpha\,\bx$. Apply both to the
$j$th column $\bp_j$ of $\bP$, an eigenvector of $\bA$ with eigenvalue
$\alpha=\lambda_j\geqslant0$: $\bB\bp_j=\sqrt{\lambda_j}\,\bp_j=\bA^{1/2}\bp_j$. So
$\bB\bP=\bA^{1/2}\bP$, and multiplying on the right by $\bP'$ gives $\bB=\bA^{1/2}$.

\textbf{The positive definite case.} If $\bA$ is positive definite, every $\lambda_j>0$ by
Proposition~\ref{prop:pd-eigen}, so the eigenvalues $\lambda_j^{1/2}$ of $\bA^{1/2}$ are
positive and $\bA^{1/2}$ is positive definite by the same proposition, hence invertible, with
$\bA^{-1/2}=\bP\bLam^{-1/2}\bP'$ (as in the proof of Proposition~\ref{prop:pd-eigen}). Then
$\bA^{-1/2}\bA\bA^{-1/2}=\bP\bLam^{-1/2}\bP'\bP\bLam\bP'\bP\bLam^{-1/2}\bP'
=\bP\bLam^{-1/2}\bLam\bLam^{-1/2}\bP'=\bP\bP'=\bI$.
\end{proof}

%==============================================================================
\section{Idempotent Matrices}\label{sec:P.8}
%==============================================================================

\begin{definition}\label{def:idempotent}
$\bA$ is \emph{idempotent} if $\bA^2=\bA$.
\end{definition}

\begin{lemma}[Trace equals rank]\label{lem:idempotent}
An idempotent $\bA\in\Real^{n\times n}$ has $\tr(\bA)=\rank(\bA)$, and its eigenvalues lie
in $\{0,1\}$.
\end{lemma}

\begin{proof}
If $\bA\bv=\lambda\bv$ with $\bv\neq\bzero$ then
$\lambda\bv=\bA^2\bv=\lambda^2\bv$, so $\lambda\in\{0,1\}$. Next,
$\Real^n=\calN(\bA)\oplus\calC(\bA)$: any $\bv$ splits as $(\bv-\bA\bv)+\bA\bv$ with
$\bA(\bv-\bA\bv)=\bzero$, and if $\bv=\bA\bw$ lies in both then
$\bv=\bA\bw=\bA^2\bw=\bA\bv=\bzero$. Every $\bu=\bA\bw\in\calC(\bA)$ has
$\bA\bu=\bA^2\bw=\bA\bw=\bu$. Let $\mathbf{n}_1,\ldots,\mathbf{n}_{n-r}$ be a basis of $\calN(\bA)$ and
$\bc_1,\ldots,\bc_r$ one of $\calC(\bA)$, where $r=\rank(\bA)$ and
$\dim\calN(\bA)=n-r$ by Theorem~\ref{thm:rank-nullity}. Together they are linearly
independent: if $\sum_ia_i\mathbf{n}_i+\sum_jb_j\bc_j=\bzero$, the vector
$\sum_ia_i\mathbf{n}_i=-\sum_jb_j\bc_j$ lies in both subspaces, hence is $\bzero$, and independence
within each basis forces all $a_i$ and $b_j$ to vanish. Being $n$ independent vectors in
$\Real^n$ they form a basis, so the matrix $\bP$ with these columns is invertible (as in the
proof of Proposition~\ref{prop:gram}). As $\bA\mathbf{n}_i=\bzero$ and $\bA\bc_j=\bc_j$,
$\bA\bP=\bP\bLam$ with $\bLam$ diagonal carrying $n-r$ zeros and $r$ ones, so
$\bA=\bP\bLam\bP^{-1}$. The trace is invariant under similarity
(Proposition~\ref{prop:trace}\ref{tr:iii}), so $\tr(\bA)=\tr(\bLam)=r$.
\end{proof}

\begin{proposition}[Projections are the symmetric idempotents]\label{prop:proj-char}
$\bH$ is the matrix of the orthogonal projection onto a subspace $S$ if and only if $\bH$
is symmetric, idempotent, and $\calC(\bH)=S$.
\end{proposition}

\begin{proof}
If $S=\{\bzero\}$ the projection is $\bH=\bzero$ and both sides hold trivially. Otherwise
the projection is $\bH=\bX(\bX'\bX)^{-1}\bX'$ by Theorem~\ref{thm:projection}, with $\bX$ a
matrix whose columns form a basis of $S$ (so $\bX$ has full column rank). The matrix
$(\bX'\bX)^{-1}$ is symmetric, being the inverse of a symmetric matrix:
$\{(\bX'\bX)^{-1}\}'\bX'\bX=\{\bX'\bX(\bX'\bX)^{-1}\}'=\bI$. Hence
$\bH'=\bX\{(\bX'\bX)^{-1}\}'\bX'=\bH$, and
$\bH^2=\bX(\bX'\bX)^{-1}(\bX'\bX)(\bX'\bX)^{-1}\bX'=\bX(\bX'\bX)^{-1}\bX'=\bH$. Every
$\bH\by=\bX\{(\bX'\bX)^{-1}\bX'\by\}$ lies in $\calC(\bX)$, and $\bH\bX=\bX$ shows each
column of $\bX$ lies in $\calC(\bH)$; so $\calC(\bH)=\calC(\bX)=S$. Conversely let $\bH$ be symmetric idempotent
with column space $S$. For $\by\in\Real^n$, $\bH\by\in S$ and
$\by-\bH\by\perp S$, because for $\bu=\bH\bw\in S$,
$\langle\by-\bH\by,\bH\bw\rangle = \bw'\bH'(\bI-\bH)\by = \bw'(\bH-\bH^2)\by = 0$. By the
characterisation in Theorem~\ref{thm:projection}, $\bH\by$ is the projection.
\end{proof}

%==============================================================================
\section{Block Matrices}\label{sec:P.9}
%==============================================================================

\begin{theorem}[Schur complement]\label{thm:schur}
Let $\bM=\bigl(\begin{smallmatrix}\bA&\bB\\\bC&\bD\end{smallmatrix}\bigr)$ with $\bA$
invertible, and put $\bS=\bD-\bC\bA^{-1}\bB$. If $\bS$ is invertible then $\bM$ is, with
\begin{equation}\label{eq:schur}
\bM^{-1} = \begin{pmatrix}
\bA^{-1}+\bA^{-1}\bB\bS^{-1}\bC\bA^{-1} & -\bA^{-1}\bB\bS^{-1}\\
-\bS^{-1}\bC\bA^{-1} & \bS^{-1}\end{pmatrix} ,
\end{equation}
so the lower-right block of $\bM^{-1}$ is $\bS^{-1}$.
\end{theorem}

\begin{proof}
Verify $\bM\bM^{-1}=\bI$ blockwise. The $(1,1)$ block is
$\bA(\bA^{-1}+\bA^{-1}\bB\bS^{-1}\bC\bA^{-1})-\bB\bS^{-1}\bC\bA^{-1}
= \bI+\bB\bS^{-1}\bC\bA^{-1}-\bB\bS^{-1}\bC\bA^{-1}=\bI$; the $(1,2)$ block is
$-\bA\bA^{-1}\bB\bS^{-1}+\bB\bS^{-1}=\bzero$; the $(2,1)$ block is
$\bC\bA^{-1}+\bC\bA^{-1}\bB\bS^{-1}\bC\bA^{-1}-\bD\bS^{-1}\bC\bA^{-1}
= \bC\bA^{-1}-\bS\bS^{-1}\bC\bA^{-1}=\bzero$; and the $(2,2)$ block is
$-\bC\bA^{-1}\bB\bS^{-1}+\bD\bS^{-1}=(\bD-\bC\bA^{-1}\bB)\bS^{-1}=\bS\bS^{-1}=\bI$. So the
matrix in~\eqref{eq:schur} is a right inverse of the square matrix $\bM$, hence its
inverse.
\end{proof}

\begin{corollary}\label{cor:schur-gram}
For $\bW=[\bone\ \bZ]$ with $n$ rows and of full column rank, the lower-right $p\times p$ block of
$(\bW'\bW)^{-1}$ is $(\bZ'\bM_0\bZ)^{-1}$, where $\bM_0=\bI_n-n^{-1}\bone\bone'$.
\end{corollary}

\begin{proof}
$\bW'\bW=\bigl(\begin{smallmatrix}n&\bone'\bZ\\\bZ'\bone&\bZ'\bZ\end{smallmatrix}\bigr)$,
whose $(1,1)$ entry $n$ is invertible and whose Schur complement of that entry is
$\bZ'\bZ-\bZ'\bone\,n^{-1}\bone'\bZ=\bZ'(\bI_n-n^{-1}\bone\bone')\bZ=\bZ'\bM_0\bZ$. This
square matrix is invertible. Indeed, $\bM_0$ is symmetric, and as $\bone'\bone=n$,
$\bM_0^2=\bI_n-2n^{-1}\bone\bone'+n^{-2}\bone(\bone'\bone)\bone'=\bM_0$. If
$\bZ'\bM_0\bZ\bc=\bzero$ then
$|\bM_0\bZ\bc|^2=\bc'\bZ'\bM_0'\bM_0\bZ\bc=\bc'\bZ'\bM_0\bZ\bc=0$, so
$\bzero=\bM_0\bZ\bc=\bZ\bc-n^{-1}\bone(\bone'\bZ\bc)$, that is $\bZ\bc=a\bone$ with
$a=n^{-1}\bone'\bZ\bc$. Then $\bW(-a,\bc')'=-a\bone+\bZ\bc=\bzero$, and full column rank of
$\bW$ ($\calN(\bW)=\{\bzero\}$ by Theorem~\ref{thm:rank-nullity}) forces $(-a,\bc')'=\bzero$,
in particular $\bc=\bzero$. So $\calN(\bZ'\bM_0\bZ)=\{\bzero\}$, the $p\times p$ matrix
$\bZ'\bM_0\bZ$ has rank $p$, and it is invertible as in the proof of
Proposition~\ref{prop:gram}. Theorem~\ref{thm:schur}, with $\bA=n$, $\bB=\bone'\bZ$,
$\bC=\bZ'\bone$, $\bD=\bZ'\bZ$, gives the lower-right block $(\bZ'\bM_0\bZ)^{-1}$.
\end{proof}

\begin{lemma}[Sherman--Morrison]\label{lem:sherman}
Let $\bA$ be invertible and $\bu,\bv$ vectors with $1-\bv'\bA^{-1}\bu\neq0$. Then
\begin{equation}\label{eq:sherman}
(\bA-\bu\bv')^{-1} = \bA^{-1}+\frac{\bA^{-1}\bu\,\bv'\bA^{-1}}{1-\bv'\bA^{-1}\bu} .
\end{equation}
\end{lemma}

\begin{proof}
Write $c=1-\bv'\bA^{-1}\bu\neq0$, let $\bB$ denote the right side of~\eqref{eq:sherman},
and multiply $\bB$ on the right by $\bA-\bu\bv'$:
\[
\bB(\bA-\bu\bv')=\bI-\bA^{-1}\bu\bv'+\frac{\bA^{-1}\bu\bv'-\bA^{-1}\bu(\bv'\bA^{-1}\bu)\bv'}{c}
= \bI-\bA^{-1}\bu\bv'+\frac{\bA^{-1}\bu\bv'\,c}{c} = \bI ,
\]
using that $\bv'\bA^{-1}\bu$ is a scalar, so that
$\bA^{-1}\bu(\bv'\bA^{-1}\bu)\bv'=(\bv'\bA^{-1}\bu)\bA^{-1}\bu\bv'$ and the numerator is
$(1-\bv'\bA^{-1}\bu)\bA^{-1}\bu\bv'$. So $\bA-\bu\bv'$ is a right inverse of the square
matrix $\bB$, hence $\bB$ is invertible with $\bB^{-1}=\bA-\bu\bv'$, and therefore
$\bA-\bu\bv'$ is invertible with inverse $\bB$.
\end{proof}

%==============================================================================
\section{The Singular Value Decomposition}\label{sec:P.10}
%==============================================================================

\begin{theorem}[SVD]\label{thm:svd}
Every $\bA\in\Real^{n\times p}$ factors as $\bA=\bU\bD\bV'$ with $\bU\in\Real^{n\times r}$
and $\bV\in\Real^{p\times r}$ having orthonormal columns, $r=\rank(\bA)$, and
$\bD=\diag(d_1,\ldots,d_r)$ with $d_1\geqslant\cdots\geqslant d_r>0$. The $d_j^2$ are the
nonzero eigenvalues of $\bA'\bA$.
\end{theorem}

\begin{proof}
$\bA'\bA$ is symmetric, and positive semi-definite since $\bx'\bA'\bA\bx=|\bA\bx|^2\geqslant0$,
so by Theorem~\ref{thm:spectral} and Proposition~\ref{prop:pd-eigen} it has an orthonormal
eigenbasis $\bv_1,\ldots,\bv_p$ with eigenvalues $\lambda_1\geqslant\cdots\geqslant\lambda_p\geqslant0$
(ordered as in the proof of Corollary~\ref{cor:rayleigh}). Write $\bA'\bA=\bP\bLam\bP'$ with
$\bP$ the orthogonal matrix of columns $\bv_j$. Since $\bP$ and $\bP'$ are invertible,
$\calC(\bA'\bA)=\calC(\bP\bLam\bP')=\bP\calC(\bLam)$ has the same dimension as
$\calC(\bLam)$, which is spanned by the $\mathbf{e}_j$ with $\lambda_j\neq0$; so the number of
positive $\lambda_j$ is $\rank(\bA'\bA)$, which equals $r=\rank(\bA)$ by
Proposition~\ref{prop:gram}. By the ordering, $\lambda_1,\ldots,\lambda_r>0$ and
$\lambda_{r+1}=\cdots=\lambda_p=0$. Also
$|\bA\bv_j|^2=\bv_j'\bA'\bA\bv_j=\lambda_j|\bv_j|^2=\lambda_j$, so $\bA\bv_j=\bzero$ for
$j>r$. Put $d_j=\sqrt{\lambda_j}$, so $d_1\geqslant\cdots\geqslant d_r>0$, and
$\bu_j=\bA\bv_j/d_j$ for $j\leqslant r$; these are orthonormal, since
$\bu_j'\bu_k = \bv_j'\bA'\bA\bv_k/(d_jd_k)=\lambda_k\bv_j'\bv_k/(d_jd_k)=\lambda_k\delta_{jk}/(d_jd_k)$,
which is $1$ for $j=k$ and $0$ otherwise. Let $\bU$ and $\bV$ have columns
$\bu_1,\ldots,\bu_r$ and $\bv_1,\ldots,\bv_r$, and $\bD=\diag(d_1,\ldots,d_r)$.

For any $\bx$, $\bx=\bP\bP'\bx=\sum_{j\leqslant p}\langle\bv_j,\bx\rangle\bv_j$. The terms with
$j>r$ have $\bA\bv_j=\bzero$, and $\bA\bv_j=d_j\bu_j$ for $j\leqslant r$, so
\[
\bA\bx=\sum_{j\leqslant r}\langle\bv_j,\bx\rangle d_j\bu_j = \bU\bD\bV'\bx ,
\]
because $\bV'\bx$ has entries $\langle\bv_j,\bx\rangle$, $\bD$ multiplies the $j$th by
$d_j$, and $\bU$ forms the combination of the $\bu_j$ with these coefficients. As this holds
for every $\bx$, $\bA=\bU\bD\bV'$. The nonzero eigenvalues of $\bA'\bA$ are
$\lambda_1,\ldots,\lambda_r$ (Theorem~\ref{thm:spectral}), that is $d_1^2,\ldots,d_r^2$.
\end{proof}


%==============================================================================
\section{Norms and Conditioning}\label{sec:P.cond}
%==============================================================================

\begin{definition}[Operator norm, condition number]\label{def:opnorm}
$\|\bA\|=\sup_{|\bx|=1}|\bA\bx|$. For invertible $\bA$ the \emph{condition number} is
$\kappa(\bA)=\|\bA\|\,\|\bA^{-1}\|$.
\end{definition}

\begin{proposition}\label{prop:opnorm}
For $\bA\neq\bzero$, $\|\bA\|=d_1$, the largest singular value of $\bA$ (and
$\|\bzero\|=0$). For symmetric positive definite $\bA$
with eigenvalues $\lambda_1\geqslant\cdots\geqslant\lambda_n>0$,
$\|\bA\|=\lambda_1$, $\|\bA^{-1}\|=\lambda_n^{-1}$ and
$\kappa(\bA)=\lambda_1/\lambda_n$.
\end{proposition}

\begin{proof}
For $\bA=\bzero$, $|\bA\bx|=0$ for every $\bx$. For $\bA\neq\bzero$, $r=\rank(\bA)\geqslant1$.
$|\bA\bx|^2=\bx'\bA'\bA\bx$, and by Corollary~\ref{cor:rayleigh} applied to the symmetric
$\bA'\bA$ its maximum over $|\bx|=1$ is the largest eigenvalue of $\bA'\bA$, which is $d_1^2$
by Theorem~\ref{thm:svd} (the largest eigenvalue is positive, since $\bA'\bA\neq\bzero$ by
Proposition~\ref{prop:gram}, so it is the largest nonzero one). As $s\mapsto\sqrt s$ is
increasing, $\sup_{|\bx|=1}|\bA\bx|=\sqrt{d_1^2}=d_1$. For symmetric positive definite
$\bA=\bP\bLam\bP'$, $\bA'\bA=\bA^2=\bP\bLam^2\bP'$ has eigenvalues $\lambda_i^2$, the largest
being $\lambda_1^2$, so $\|\bA\|=\lambda_1$; and $\bA^{-1}=\bP\bLam^{-1}\bP'$
(Proposition~\ref{prop:pd-eigen}) is symmetric positive definite with eigenvalues
$\lambda_i^{-1}$, the largest being $\lambda_n^{-1}$, so by the same argument
$\|\bA^{-1}\|=\lambda_n^{-1}$. Multiplying, $\kappa(\bA)=\lambda_1/\lambda_n$.
\end{proof}

\begin{theorem}[Conditioning of a linear system]\label{thm:conditioning}
Let $\bA$ be invertible, $\bA\bx=\mathbf{b}\neq\bzero$, and
$\bA(\bx+\delta\bx)=\mathbf{b}+\delta\mathbf{b}$. Then
\begin{equation}\label{eq:conditioning}
\frac{|\delta\bx|}{|\bx|} \;\leqslant\; \kappa(\bA)\,\frac{|\delta\mathbf{b}|}{|\mathbf{b}|} .
\end{equation}
\end{theorem}

\begin{proof}
For any matrix $\bB$ and vector $\by\neq\bzero$, $\by/|\by|$ is a unit vector, so
$|\bB\by|=|\by|\,|\bB(\by/|\by|)|\leqslant\|\bB\|\,|\by|$; this also holds for $\by=\bzero$.
Subtracting the two systems gives $\bA\,\delta\bx=\delta\mathbf{b}$, so
$|\delta\bx|=|\bA^{-1}\delta\mathbf{b}|\leqslant\|\bA^{-1}\|\,|\delta\mathbf{b}|$. Also
$|\mathbf{b}|=|\bA\bx|\leqslant\|\bA\|\,|\bx|$, where $\bx\neq\bzero$ because
$\mathbf{b}\neq\bzero$; dividing by $|\bx|\,|\mathbf{b}|>0$,
$1/|\bx|\leqslant\|\bA\|/|\mathbf{b}|$. Multiplying the two bounds, both sides of each being
non-negative, gives
$|\delta\bx|/|\bx|\leqslant\|\bA^{-1}\|\,\|\bA\|\,|\delta\mathbf{b}|/|\mathbf{b}|$,
which is~\eqref{eq:conditioning}.
\end{proof}

\begin{corollary}[Why the normal equations square the difficulty]\label{cor:kappa-square}
For $\bX$ of full column rank, $\kappa(\bX'\bX)=\kappa(\bX)^2$, where $\kappa(\bX)$ is the
ratio of the largest to the smallest singular value of $\bX$.
\end{corollary}

\begin{proof}
Let $\bX$ have $p$ columns. By Theorem~\ref{thm:svd}, $\bX=\bU\bD\bV'$ with $r=p$ by full
column rank, so $\bV$ is $p\times p$ with orthonormal columns, that is orthogonal, and
$\bX'\bX=\bV\bD\bU'\bU\bD\bV'=\bV\bD^2\bV'$ as $\bU'\bU=\bI$. So $\bX'\bX$ is symmetric
positive definite (invertible by Proposition~\ref{prop:gram}) with eigenvalues
$d_1^2\geqslant\cdots\geqslant d_p^2>0$, and by Proposition~\ref{prop:opnorm} its condition
number is $d_1^2/d_p^2=(d_1/d_p)^2=\kappa(\bX)^2$.
\end{proof}

\begin{remark}
Corollary~\ref{cor:kappa-square} is why least squares is computed from a QR
factorisation of $\bX$ rather than by forming $\bX'\bX$: the latter squares the condition
number, so a design that is merely ill-conditioned becomes numerically singular. After
centring and scaling the predictors, so that $\bX'\bX$ becomes a multiple of their
correlation matrix $\bR$, a large $\kappa(\bR)$ and a large variance inflation factor
$\VIF_j=[\bR^{-1}]_{jj}$ (Unit~4) detect the same near-degeneracy, the first through the
spectrum and the second one predictor at a time: by Corollary~\ref{cor:rayleigh},
$\max_j\VIF_j\leqslant1/\lambda_{\min}(\bR)\leqslant\sum_j\VIF_j$, and the eigenvalues of
$\bR=\bP\bLam\bP'$ are positive with sum $\tr\bLam=\tr\bR=p$
(Theorem~\ref{thm:spectral}, Proposition~\ref{prop:trace}\textup{(ii)}), so
$1\leqslant\lambda_{\max}(\bR)\leqslant p$ and, by Proposition~\ref{prop:opnorm},
$1/\lambda_{\min}(\bR)\leqslant\kappa(\bR)\leqslant p/\lambda_{\min}(\bR)$. Without the scaling they
can disagree: two orthogonal predictors on scales $1$ and $10^4$ give
$\kappa(\bX'\bX)=10^8$, yet both variance inflation factors equal $1$.
\end{remark}

%==============================================================================
\section{Matrix Differentiation}\label{sec:P.11}
%==============================================================================

\begin{definition}[Differential and derivative]\label{def:differential}
For $f:\Real^p\to\Real$, $Df(\bb):=\partial f/\partial\bb'$ is the row vector of partial
derivatives, and $f$ is \emph{differentiable} at $\bb$ if
$f(\bb+\bh)-f(\bb)=Df(\bb)\bh+o(|\bh|)$, meaning that the remainder divided by $|\bh|$ tends
to $0$ as $\bh\to\bzero$; for vector-valued $f$ the same is required of each coordinate, and
$Df(\bb)$ is the matrix whose rows are the coordinates' derivatives. The \emph{differential}
is the linear form $\dd f = \sum_j(\partial f/\partial b_j)\,\dd b_j$.
\end{definition}

\begin{proposition}[First identification theorem]\label{prop:identification}
If $\dd f(\bb)=\bc(\bb)'\dd\bb$ for a vector $\bc(\bb)$, then $Df(\bb)=\bc(\bb)'$.
\end{proposition}

\begin{proof}
Both sides are the coefficient vector of the same linear form in $\dd\bb$:
$\sum_j(\partial f/\partial b_j)\,\dd b_j=\sum_jc_j(\bb)\,\dd b_j$ for every $\dd\bb$. A
linear form determines its coefficients: applying both sides to the $j$th standard basis
vector $\dd\bb=\mathbf{e}_j$ gives $\partial f/\partial b_j=c_j(\bb)$ for each $j$, that is
$Df(\bb)=\bc(\bb)'$.
\end{proof}

\begin{lemma}[The two rules used in the course]\label{lem:matrix-diff}
For constant $\ba\in\Real^p$ and constant $\bA\in\Real^{p\times p}$,
\begin{enumerate}[label=\textup{(\roman*)}]
\item $D(\ba'\bb)=D(\bb'\ba)=\ba'$;
\item $D(\bb'\bA\bb)=\bb'(\bA+\bA')$, which is $2\bb'\bA$ when $\bA$ is symmetric.
\end{enumerate}
\end{lemma}

\begin{proof}
\textbf{(i)} $\ba'\bb=\sum_ja_jb_j$, so $\partial(\ba'\bb)/\partial b_j=a_j$ and
$\dd(\ba'\bb)=\sum_ja_j\,\dd b_j=\ba'\dd\bb$ (the coefficients $\ba$ being constant);
Proposition~\ref{prop:identification} gives $D(\ba'\bb)=\ba'$, and $\bb'\ba=\ba'\bb$. The
function is differentiable in the sense of Definition~\ref{def:differential}, as
$\ba'(\bb+\bh)-\ba'\bb=\ba'\bh$ exactly, with zero remainder.

\textbf{(ii)} Expanding, $(\bb+\bh)'\bA(\bb+\bh)-\bb'\bA\bb=\bb'\bA\bh+\bh'\bA\bb+\bh'\bA\bh$,
and the scalar $\bh'\bA\bb$ equals its transpose $\bb'\bA'\bh$, so the difference is
$\bb'(\bA+\bA')\bh+\bh'\bA\bh$. By Theorem~\ref{thm:CS} and the bound
$|\bA\bh|\leqslant\|\bA\|\,|\bh|$ (Definition~\ref{def:opnorm}, as in the proof of
Theorem~\ref{thm:conditioning}), $|\bh'\bA\bh|\leqslant|\bh|\,|\bA\bh|\leqslant\|\bA\|\,|\bh|^2$,
so the remainder divided by $|\bh|$ is at most $\|\bA\|\,|\bh|\to0$: it is $o(|\bh|)$.
Taking $\bh=t\mathbf{e}_j$, with $\mathbf{e}_j$ the $j$th standard basis vector, and dividing
by $t\neq0$, the difference quotient is $\bb'(\bA+\bA')\mathbf{e}_j+t\,\mathbf{e}_j'\bA\mathbf{e}_j$,
which tends to $\bb'(\bA+\bA')\mathbf{e}_j$ as $t\to0$; so
$\partial(\bb'\bA\bb)/\partial b_j$ is the $j$th entry of $\bb'(\bA+\bA')$. When $\bA'=\bA$
this row vector is $2\bb'\bA$.
\end{proof}


\begin{proposition}[Chain rule for differentials]\label{prop:chain}
Let $\bu=g(\bx)$ be differentiable at $\bx$ and $f$ differentiable at $\bu$. Then the
differential of the composition is obtained by substitution:
$\dd f = (Df)(\bu)\,\dd\bu$ with $\dd\bu=(Dg)(\bx)\,\dd\bx$, hence
$D(f\circ g)(\bx)=(Df)(g(\bx))\,(Dg)(\bx)$.
\end{proposition}

\begin{proof}
It suffices to treat scalar $f$, a vector-valued $f$ being handled one coordinate at a
time. Write $\bF=(Df)(\bu)$ (a row vector) and $\bG=(Dg)(\bx)$ (a matrix).
Differentiability of $f$ at $\bu$ gives $f(\bu+\bh)-f(\bu)=\bF\bh+r_f(\bh)$ with
$r_f(\bh)/|\bh|\to0$ as $\bh\to\bzero$, and of $g$ at $\bx$ gives
$g(\bx+\bk)-g(\bx)=\bG\bk+\br_g(\bk)$ with each coordinate of $\br_g(\bk)/|\bk|$ tending to
$0$, hence $|\br_g(\bk)|/|\bk|\to0$. Put $\rho(\bh)=|r_f(\bh)|/|\bh|$ for $\bh\neq\bzero$ and
$\rho(\bzero)=0$ (note $r_f(\bzero)=0$), so $\rho(\bh)\to0$ as $\bh\to\bzero$ and
$|r_f(\bh)|=\rho(\bh)|\bh|$ for every $\bh$. Substitute
$\bh=\bh(\bk)=g(\bx+\bk)-g(\bx)=\bG\bk+\br_g(\bk)$:
\[
f(g(\bx+\bk))-f(g(\bx)) = \bF\bG\bk + \bF\br_g(\bk)+r_f(\bh(\bk)) .
\]
The second term is at most $|\bF|\,|\br_g(\bk)|$ by Theorem~\ref{thm:CS}, which divided by
$|\bk|$ tends to $0$. For the third, take $\bk$ so small that $|\br_g(\bk)|\leqslant|\bk|$;
then $|\bh(\bk)|\leqslant\|\bG\|\,|\bk|+|\bk|=(\|\bG\|+1)|\bk|$ (Definition~\ref{def:opnorm}),
so $\bh(\bk)\to\bzero$ as $\bk\to\bzero$ and
\[
\frac{|r_f(\bh(\bk))|}{|\bk|}=\rho(\bh(\bk))\frac{|\bh(\bk)|}{|\bk|}\leqslant(\|\bG\|+1)\,\rho(\bh(\bk))\to0 .
\]
Hence $f(g(\bx+\bk))-f(g(\bx)) = \bF\bG\bk + o(|\bk|)$, so $f\circ g$ is differentiable at
$\bx$. Taking $\bk=t\mathbf{e}_j$, with $\mathbf{e}_j$ the $j$th standard basis vector,
dividing by $t\neq0$ and letting $t\to0$ shows that $\partial(f\circ g)/\partial x_j$ at
$\bx$ is the $j$th entry of $\bF\bG=(Df)(\bu)(Dg)(\bx)$, and the substitution rule for the
differentials restates this identity.
\end{proof}

\begin{example}[The form used for likelihoods]\label{ex:chain-glm}
For a scalar $h$ and the linear index $\eta=\bx'\bb$,
\[
\frac{\partial}{\partial\bb'}\,h(\bx'\bb) = h'(\bx'\bb)\,\bx' ,
\]
since $\dd\eta=\bx'\dd\bb$ by Lemma~\ref{lem:matrix-diff}\textup{(i)} and
$\dd h = h'(\eta)\,\dd\eta$. Summing over observations gives the score vector of a
generalised linear model, and differentiating once more with
Proposition~\ref{prop:chain} gives the information matrix.
\end{example}

%##############################################################################
\coursepart{III}{Measure-Theoretic Probability}
%##############################################################################

%==============================================================================
\section{Measure and Measurable Functions}\label{sec:P.measure}
%==============================================================================

\begin{definition}[Extended real line]\label{def:extended}
$[-\infty,\infty]=\Real\cup\{-\infty,\infty\}$ is ordered by $-\infty<x<\infty$ for
$x\in\Real$. Every $S\subseteq[-\infty,\infty]$ has a supremum: $\sup S=\infty$ if
$\infty\in S$ or $S\cap\Real$ is unbounded above, $\sup S=-\infty$ if
$S\subseteq\{-\infty\}$, and otherwise $\sup S=\sup(S\cap\Real)$, which exists by the
completeness axiom (Definition~\ref{def:sup}); $\inf S=-\sup(-S)$. On $[0,\infty]$,
$a+\infty=\infty+a=\infty$, $a\cdot\infty=\infty\cdot a=\infty$ for $a>0$, and
$0\cdot\infty=\infty\cdot0=0$. A sequence $a_n\in[-\infty,\infty]$ \emph{tends to}
$\infty$ if for each $M\in\Real$ eventually $a_n>M$; $\limsup_n a_n$ and $\liminf_n a_n$
are defined by the formulas of Definition~\ref{def:limsup}. For $a_n\in[0,\infty]$,
$\sum_n a_n=\sup_N\sum_{n\leqslant N}a_n$.
\end{definition}

\begin{remark}
An increasing sequence in $[-\infty,\infty]$ converges to its supremum: by
Theorem~\ref{thm:monotone-seq} when the supremum is finite and the terms are eventually
finite, and directly from the definition otherwise. In particular a series of terms in
$[0,\infty]$ is the limit of its partial sums, so $\sum_n(a_n+b_n)=\sum_na_n+\sum_nb_n$ and
$\sum_nca_n=c\sum_na_n$ for $a_n,b_n,c\in[0,\infty]$, and a finite sum of such series may
be summed term by term in either order.
\end{remark}

\begin{definition}[$\sigma$-field]\label{def:sigma-field}
A collection $\calF$ of subsets of a set $\Omega$ is a \emph{$\sigma$-field} if
$\Omega\in\calF$; $A\in\calF$ implies $A^c=\Omega\setminus A\in\calF$; and
$A_1,A_2,\ldots\in\calF$ implies $\bigcup_nA_n\in\calF$. The pair $(\Omega,\calF)$ is a
\emph{measurable space} and the members of $\calF$ are \emph{measurable sets}.
\end{definition}

\begin{remark}
A $\sigma$-field contains $\emptyset=\Omega^c$; it is closed under countable intersections,
since $\bigcap_nA_n=(\bigcup_nA_n^c)^c$; under finite unions and intersections, by
padding a finite list with copies of $\emptyset$ or of $\Omega$; and under differences,
$A\setminus B=A\cap B^c$.
\end{remark}

\begin{definition}[Generated and Borel $\sigma$-fields]\label{def:borel}
For a collection $\calC$ of subsets of $\Omega$, $\sigma(\calC)$ is the intersection of all
$\sigma$-fields on $\Omega$ containing $\calC$. The \emph{Borel $\sigma$-field}
$\calB(\Real^d)$ is $\sigma(\calO_d)$ with $\calO_d$ the open subsets of $\Real^d$; its
members are \emph{Borel sets}. A set $B\subseteq[-\infty,\infty]$ is Borel if
$B\cap\Real\in\calB(\Real)$.
\end{definition}

\begin{remark}
The collection of all subsets of $\Omega$ is a $\sigma$-field containing $\calC$, so the
intersection is over a non-empty family. Each of the three defining properties holds in
every member of the family, hence in the intersection: $\sigma(\calC)$ is a $\sigma$-field,
and it is contained in every $\sigma$-field containing $\calC$. If $\calC\subseteq\calD$
then $\sigma(\calC)\subseteq\sigma(\calD)$, and if $\calC\subseteq\sigma(\calD)$ then
$\sigma(\calC)\subseteq\sigma(\calD)$. Closed sets are Borel, being complements of open
sets. The Borel sets of $[-\infty,\infty]$ form a $\sigma$-field, since
$B^c\cap\Real=\Real\setminus(B\cap\Real)$ and
$(\bigcup_nB_n)\cap\Real=\bigcup_n(B_n\cap\Real)$.
\end{remark}

\begin{lemma}[Generators of the Borel $\sigma$-field]\label{lem:borel-gen}
\begin{enumerate}[label=\textup{(\roman*)}]
\item Every open $U\subseteq\Real^d$ is the union of the countably many open boxes
      $\prod_{i\leqslant d}(a_i,b_i)$ with rational $a_i<b_i$ that are contained in $U$.
\item $\calB(\Real^d)=\sigma(\mathcal{R}_d)$, where $\mathcal{R}_d$ is the class of half-open boxes
      $\prod_{i\leqslant d}(a_i,b_i]$ with $a_i<b_i$ real.
\item $\calB(\Real)=\sigma\bigl(\{(-\infty,a]:a\in\Real\}\bigr)$.
\end{enumerate}
\end{lemma}

\begin{proof}
(i) The boxes with rational corners form a countable family, as $\mathbb{Q}^{2d}$ is
countable. Each box in the union lies in $U$, so the union is contained in $U$. Conversely
let $x\in U$. As $U$ is open there is $\delta>0$ with $|y-x|<\delta$ implying $y\in U$.
Choose rationals $a_i<x_i<b_i$ with $b_i-a_i<\delta/\sqrt d$. If $y$ lies in the box
$\prod_i(a_i,b_i)$, then $x_i$ and $y_i$ both lie in $(a_i,b_i)$, so
$|y_i-x_i|<\delta/\sqrt d$ for each $i$ and $|y-x|<\delta$; thus the box lies in $U$, and it
contains $x$.

(ii) An open box is a countable union of half-open boxes,
$\prod_i(a_i,b_i)=\bigcup_{n>n_0}\prod_i(a_i,b_i-1/n]$ with $n_0$ so large that
$a_i<b_i-1/n_0$ for every $i$. By (i) every open set is therefore a countable union of
members of $\mathcal{R}_d$, so $\calO_d\subseteq\sigma(\mathcal{R}_d)$ and
$\calB(\Real^d)\subseteq\sigma(\mathcal{R}_d)$. Conversely a half-open box is the countable
intersection of the open boxes $\prod_i(a_i,b_i+1/n)$, hence Borel, so
$\sigma(\mathcal{R}_d)\subseteq\calB(\Real^d)$.

(iii) Let $\calG=\sigma(\{(-\infty,a]\})$. The sets $(-\infty,a]$ are closed, hence Borel,
so $\calG\subseteq\calB(\Real)$. Conversely $(a,b]=(-\infty,b]\setminus(-\infty,a]$ lies in
$\calG$, so $\mathcal{R}_1\subseteq\calG$ and $\calB(\Real)=\sigma(\mathcal{R}_1)\subseteq\calG$ by (ii).
\end{proof}

\begin{definition}[Measure]\label{def:measure}
A \emph{measure} on a measurable space $(\Omega,\calF)$ is a function
$\mu:\calF\to[0,\infty]$ with $\mu(\emptyset)=0$ that is \emph{countably additive}:
$\mu(\bigcup_nA_n)=\sum_n\mu(A_n)$ for pairwise disjoint $A_1,A_2,\ldots\in\calF$. The
triple $(\Omega,\calF,\mu)$ is a \emph{measure space}. It is a \emph{probability space},
written $(\Omega,\calF,\prb)$, if $\prb(\Omega)=1$; $\mu$ is \emph{finite} if
$\mu(\Omega)<\infty$, and \emph{$\sigma$-finite} if $\Omega=\bigcup_n\Omega_n$ for some
$\Omega_n\in\calF$ with $\mu(\Omega_n)<\infty$. A set $N\in\calF$ with $\mu(N)=0$ is a
\emph{null set}.
\end{definition}

\begin{proposition}[Properties of measures]\label{prop:measure}
In a measure space $(\Omega,\calF,\mu)$ let $A,B,A_1,A_2,\ldots\in\calF$.
\begin{enumerate}[label=\textup{(\roman*)}]
\item \emph{Finite additivity.} If $A_1,\ldots,A_k$ are pairwise disjoint then
      $\mu(\bigcup_{i\leqslant k}A_i)=\sum_{i\leqslant k}\mu(A_i)$.
\item \emph{Monotonicity.} If $A\subseteq B$ then $\mu(A)\leqslant\mu(B)$, and
      $\mu(B\setminus A)=\mu(B)-\mu(A)$ when $\mu(A)<\infty$.
\item \emph{Countable subadditivity.} $\mu(\bigcup_nA_n)\leqslant\sum_n\mu(A_n)$.
\item \emph{Continuity from below.} If $A_1\subseteq A_2\subseteq\cdots$ and
      $A=\bigcup_nA_n$, then $\mu(A_n)\uparrow\mu(A)$.
\item \emph{Continuity from above.} If $A_1\supseteq A_2\supseteq\cdots$,
      $A=\bigcap_nA_n$ and $\mu(A_1)<\infty$, then $\mu(A_n)\downarrow\mu(A)$.
\end{enumerate}
\end{proposition}

\begin{proof}
(i) Put $A_i=\emptyset$ for $i>k$. The sequence $A_1,A_2,\ldots$ is pairwise disjoint with
union $\bigcup_{i\leqslant k}A_i$, and countable additivity gives
$\mu(\bigcup_{i\leqslant k}A_i)=\sum_{i\leqslant k}\mu(A_i)+\sum_{i>k}0$.

(ii) $B$ is the disjoint union of $A$ and $B\setminus A$, so by (i)
$\mu(B)=\mu(A)+\mu(B\setminus A)\geqslant\mu(A)$. If $\mu(A)<\infty$, subtracting $\mu(A)$
from both sides gives the second statement.

(iii) Put $C_1=A_1$ and $C_n=A_n\setminus\bigcup_{i<n}A_i$ for $n\geqslant2$. The $C_n$ lie in
$\calF$, are pairwise disjoint, satisfy $C_n\subseteq A_n$, and have the same union as the
$A_n$: a point of $\bigcup_nA_n$ lies in $C_n$ for the least $n$ with that point in $A_n$.
By countable additivity and (ii),
$\mu(\bigcup_nA_n)=\sum_n\mu(C_n)\leqslant\sum_n\mu(A_n)$.

(iv) Put $B_1=A_1$ and $B_n=A_n\setminus A_{n-1}$ for $n\geqslant2$. These are pairwise
disjoint, $\bigcup_{i\leqslant n}B_i=A_n$, and $\bigcup_iB_i=A$. By countable additivity
and (i),
\[
\mu(A)=\sum_i\mu(B_i)=\lim_n\sum_{i\leqslant n}\mu(B_i)=\lim_n\mu(A_n) ,
\]
and the $\mu(A_n)$ increase by (ii).

(v) The sets $A_1\setminus A_n$ increase with union $A_1\setminus A$, so by (iv)
$\mu(A_1\setminus A_n)\uparrow\mu(A_1\setminus A)$. Every subset of $A_1$ in $\calF$ has
finite measure, so by (ii) this reads $\mu(A_1)-\mu(A_n)\to\mu(A_1)-\mu(A)$; subtracting
from the finite number $\mu(A_1)$ gives $\mu(A_n)\to\mu(A)$, and the $\mu(A_n)$ decrease
by (ii).
\end{proof}

\begin{remark}
The finiteness in (v) cannot be dropped: for the counting measure on the positive
integers, $\mu(A)=$ the number of elements of $A$, the sets $A_n=\{n,n+1,\ldots\}$ decrease
to $\emptyset$ while $\mu(A_n)=\infty$ for every $n$.
\end{remark}

\begin{definition}[Measurable function]\label{def:measurable}
Let $(\Omega,\calF)$ and $(E,\calE)$ be measurable spaces. A map $f:\Omega\to E$ is
\emph{$\calF/\calE$-measurable} if $f^{-1}(B)\in\calF$ for every $B\in\calE$. When $E$ is
$\Real^d$ or $[-\infty,\infty]$ with its Borel sets, $f$ is simply called
\emph{measurable}, and \emph{Borel} when moreover $\Omega=\Real^k$ and $\calF=\calB(\Real^k)$.
A \emph{non-negative measurable function} is a measurable $f:\Omega\to[-\infty,\infty]$
with values in $[0,\infty]$. A complex $f=u+iv$ is measurable if $u$ and $v$ are.
\end{definition}

\begin{lemma}[Criteria for measurability]\label{lem:meas-criteria}
Let $(\Omega,\calF)$ be a measurable space.
\begin{enumerate}[label=\textup{(\roman*)}]
\item If $\calE=\sigma(\calC)$, then $f:\Omega\to E$ is $\calF/\calE$-measurable if and only
      if $f^{-1}(C)\in\calF$ for every $C\in\calC$.
\item $f:\Omega\to[-\infty,\infty]$ is measurable if and only if $\{f\leqslant a\}\in\calF$
      for every $a\in\Real$, and then $\{f<a\}$, $\{f\geqslant a\}$, $\{f>a\}$ and $\{f=a\}$
      lie in $\calF$ for every $a\in[-\infty,\infty]$. A real-valued $f$ is measurable as a
      map to $\Real$ if and only if it is measurable as a map to $[-\infty,\infty]$.
\item A continuous $g:\Real^k\to\Real^m$ is Borel, and if $f$ is $\calF/\calE$-measurable
      and $g$ is $\calE/\calE'$-measurable then $g\circ f$ is $\calF/\calE'$-measurable.
\item $f=(f_1,\ldots,f_d):\Omega\to\Real^d$ is measurable if and only if every $f_i$ is.
\end{enumerate}
\end{lemma}

\begin{proof}
(i) Necessity is clear as $\calC\subseteq\calE$. For sufficiency let
$\calD=\{B\subseteq E: f^{-1}(B)\in\calF\}$. Since $f^{-1}(E)=\Omega$,
$f^{-1}(E\setminus B)=\Omega\setminus f^{-1}(B)$ and
$f^{-1}(\bigcup_nB_n)=\bigcup_nf^{-1}(B_n)$, $\calD$ is a $\sigma$-field. It contains $\calC$
by hypothesis, hence contains $\sigma(\calC)=\calE$.

(ii) Let $\calG=\sigma(\{[-\infty,a]:a\in\Real\})$, a $\sigma$-field on $[-\infty,\infty]$;
by (i) it suffices to show that $\calG$ is the Borel $\sigma$-field of $[-\infty,\infty]$.
Each $[-\infty,a]$ is Borel, its trace on $\Real$ being the closed set $(-\infty,a]$, so
$\calG$ is contained in the Borel sets. Conversely $\{-\infty\}=\bigcap_n[-\infty,-n]$ and
$\{\infty\}=[-\infty,\infty]\setminus\bigcup_n[-\infty,n]$ lie in $\calG$, so
$\Real\in\calG$ and the subsets of $\Real$ belonging to $\calG$ form a $\sigma$-field on
$\Real$ (the complement in $\Real$ of such a set $B$ is $\Real\setminus B\in\calG$). This
$\sigma$-field contains $(-\infty,a]=[-\infty,a]\setminus\{-\infty\}$, hence contains
$\calB(\Real)$ by Lemma~\ref{lem:borel-gen}(iii). A Borel $B\subseteq[-\infty,\infty]$ is
the union of $B\cap\Real$ and a subset of $\{-\infty,\infty\}$, so $B\in\calG$. For the
other sets: $\{f>a\}=\Omega\setminus\{f\leqslant a\}$,
$\{f<a\}=\bigcup_n\{f\leqslant a-1/n\}$, $\{f\geqslant a\}=\Omega\setminus\{f<a\}$ and
$\{f=a\}=\{f\leqslant a\}\cap\{f\geqslant a\}$ for real $a$, and
$\{f=\pm\infty\}=f^{-1}(\{\pm\infty\})$; the cases $a=\pm\infty$ follow, as
$\{f<\infty\}=\Omega\setminus\{f=\infty\}$, $\{f\geqslant\infty\}=\{f=\infty\}$,
$\{f>\infty\}=\emptyset$, and symmetrically at $-\infty$. Finally, for real-valued $f$ and Borel
$B\subseteq[-\infty,\infty]$, $f^{-1}(B)=f^{-1}(B\cap\Real)$, and every Borel subset of
$\Real$ is a Borel subset of $[-\infty,\infty]$.

(iii) Let $V\subseteq\Real^m$ be open and $x\in g^{-1}(V)$. There is $\varepsilon>0$ with
the ball of radius $\varepsilon$ about $g(x)$ inside $V$, and by continuity $\delta>0$ with
$|g(y)-g(x)|<\varepsilon$ whenever $|y-x|<\delta$; so the ball of radius $\delta$ about $x$
lies in $g^{-1}(V)$, and $g^{-1}(V)$ is open, hence Borel. By (i) with $\calC=\calO_m$, $g$
is Borel. For the composition, $(g\circ f)^{-1}(B)=f^{-1}(g^{-1}(B))$ and
$g^{-1}(B)\in\calE$.

(iv) If $f$ is measurable then $f_i=p_i\circ f$ with $p_i(x)=x_i$ continuous, so $f_i$ is
measurable by (iii). Conversely,
$f^{-1}(\prod_i(a_i,b_i])=\bigcap_if_i^{-1}((a_i,b_i])\in\calF$, and the half-open boxes
generate $\calB(\Real^d)$ by Lemma~\ref{lem:borel-gen}(ii); apply (i).
\end{proof}

\begin{proposition}[Operations preserving measurability]\label{prop:meas-closure}
Let $(\Omega,\calF)$ be a measurable space.
\begin{enumerate}[label=\textup{(\roman*)}]
\item If $f,g:\Omega\to\Real$ are measurable and $c\in\Real$, then $f+g$, $cf$, $fg$,
      $f\vee g$, $f\wedge g$, $f^+=f\vee0$, $f^-=(-f)\vee0$ and $|f|$ are measurable.
\item If $f_1,f_2,\ldots:\Omega\to[-\infty,\infty]$ are measurable, so are $\sup_nf_n$,
      $\inf_nf_n$, $\limsup_nf_n$ and $\liminf_nf_n$. In particular, if $f_n\to f$
      pointwise with $f$ real-valued, then $f$ is measurable.
\item If $f,g$ are non-negative measurable functions, so are $f+g$ and $fg$.
\item The indicator $\indc_A$ is measurable if and only if $A\in\calF$.
\end{enumerate}
\end{proposition}

\begin{proof}
(i) The map $\omega\mapsto(f(\omega),g(\omega))$ is measurable into $\Real^2$ by
Lemma~\ref{lem:meas-criteria}(iv). The functions $(x,y)\mapsto x+y$, $cx$, $xy$,
$\max(x,y)$, $\min(x,y)$ are continuous on $\Real^2$, so the compositions are measurable by
Lemma~\ref{lem:meas-criteria}(iii). Then $f^+=f\vee0$ and $f^-=(-f)\vee0$ are measurable,
and $|f|=f^++f^-$.

(ii) For real $a$,
\[
\{\sup_nf_n\leqslant a\}=\bigcap_n\{f_n\leqslant a\},
\qquad
\{\inf_nf_n\leqslant a\}=\bigcap_k\bigcup_n\{f_n<a+1/k\},
\]
so both are measurable by Lemma~\ref{lem:meas-criteria}(ii).
Then $\limsup_nf_n=\inf_m\sup_{n\geqslant m}f_n$ and $\liminf_nf_n=\sup_m\inf_{n\geqslant m}f_n$
are measurable. If $f_n\to f$ pointwise with $f$ real, then $f=\limsup_nf_n$ by
Proposition~\ref{prop:limsup}.

(iii) Let $a\in\Real$. If $a<0$ then $\{f+g>a\}=\Omega$. For $a\geqslant0$ the claim is
\[
\{f+g>a\}=\bigcup_{r\in\mathbb{Q}}\bigl(\{f>r\}\cap\{g>a-r\}\bigr) ,
\]
a countable union of measurable sets. If $f(\omega)>r$ and $g(\omega)>a-r$ then
$f(\omega)+g(\omega)>a$, also when a value is infinite. Conversely suppose
$f(\omega)+g(\omega)>a$. If $f(\omega)=\infty$, take rational $r>a$, so that
$a-r<0\leqslant g(\omega)$. If $f(\omega)<\infty=g(\omega)$, take rational $r<f(\omega)$. If
both are finite, then $a-g(\omega)<f(\omega)$ and any rational $r$ strictly between them
works. For the product, $f\wedge n$ and $g\wedge n$ are real and measurable, as
$\{f\wedge n\leqslant a\}$ is $\{f\leqslant a\}$ for $a<n$ and $\Omega$ for
$a\geqslant n$; so $(f\wedge n)(g\wedge n)$ is measurable by (i). It increases in $n$ to
$fg$: if $f(\omega)=0$ or $g(\omega)=0$ every term and $fg(\omega)$ vanish; if both are
finite and positive, the terms equal $fg(\omega)$ once $n$ exceeds both; if
$f(\omega)=\infty$ and $g(\omega)>0$, the terms are at least $n\,(g(\omega)\wedge1)\to\infty$,
and symmetrically. By (ii), $fg=\sup_n(f\wedge n)(g\wedge n)$ is measurable.

(iv) $\indc_A^{-1}(B)$ is one of $\emptyset$, $A$, $A^c$, $\Omega$, and equals $A$ for
$B=\{1\}$.
\end{proof}

\begin{definition}[Simple function]\label{def:simple}
A \emph{simple function} is a measurable $s:\Omega\to[0,\infty)$ taking finitely many
values. Its \emph{canonical form} is $s=\sum_{a\in s(\Omega)}a\,\indc_{\{s=a\}}$, the sets
$\{s=a\}\in\calF$ partitioning $\Omega$.
\end{definition}

\begin{remark}
If $A_1,\ldots,A_k\in\calF$ and $a_1,\ldots,a_k\in[0,\infty)$, then
$\sum_ia_i\indc_{A_i}$ is simple: it is measurable by
Proposition~\ref{prop:meas-closure}(i),(iv), and takes at most $2^k$ values.
\end{remark}

\begin{theorem}[Approximation by simple functions]\label{thm:simple-approx}
Let $f$ be a non-negative measurable function. Put $\varphi_n(t)=n$ for $t\geqslant n$ and,
for $0\leqslant t<n$, $\varphi_n(t)=(k-1)2^{-n}$ where $k$ is the integer with
$(k-1)2^{-n}\leqslant t<k2^{-n}$; and put $s_n=\varphi_n\circ f$. Then each $s_n$ is simple,
$0\leqslant s_1\leqslant s_2\leqslant\cdots\leqslant f$, and $s_n\to f$ pointwise.
\end{theorem}

\begin{proof}
\textbf{Simple.} Explicitly
\[
s_n=\sum_{k=1}^{n2^n}(k-1)2^{-n}\,\indc\{(k-1)2^{-n}\leqslant f<k2^{-n}\}
+n\,\indc\{f\geqslant n\} ,
\]
and the sets on the right lie in $\calF$ by Lemma~\ref{lem:meas-criteria}(ii), being
intersections of sets of the form $\{f\geqslant c\}$ and $\{f<c\}$. So $s_n$ is simple.

\textbf{Below $f$.} For $t\in[0,\infty]$, $\varphi_n(t)\leqslant t$: if $t\geqslant n$ then
$\varphi_n(t)=n\leqslant t$, and otherwise $\varphi_n(t)$ is the largest multiple of $2^{-n}$ not
exceeding $t$.

\textbf{Increasing.} Fix $t\in[0,\infty]$. If $t\geqslant n+1$ then
$\varphi_n(t)=n<n+1=\varphi_{n+1}(t)$. If $n\leqslant t<n+1$ then $\varphi_n(t)=n$, and $n$ is a
multiple of $2^{-(n+1)}$ not exceeding $t$, so $\varphi_{n+1}(t)\geqslant n$. If $t<n$ then
$\varphi_n(t)$ is a multiple of $2^{-n}$, hence of $2^{-(n+1)}$, not exceeding $t$, and
$\varphi_{n+1}(t)$ is the largest such multiple, so $\varphi_{n+1}(t)\geqslant\varphi_n(t)$.

\textbf{Convergence.} If $t=\infty$ then $\varphi_n(t)=n\to\infty$. If $t<\infty$ then for
$n>t$, $0\leqslant t-\varphi_n(t)<2^{-n}$, so $\varphi_n(t)\to t$. Applying this to $t=f(\omega)$
gives $s_n(\omega)\to f(\omega)$.
\end{proof}

\begin{definition}[$\pi$-system, $\lambda$-system]\label{def:pi-lambda}
A collection $\mathcal{P}$ of subsets of $\Omega$ is a \emph{$\pi$-system} if $A,B\in\mathcal{P}$
implies $A\cap B\in\mathcal{P}$. A collection $\calL$ is a \emph{$\lambda$-system} if
$\Omega\in\calL$; $A,B\in\calL$ and $A\subseteq B$ imply $B\setminus A\in\calL$; and
$A_1\subseteq A_2\subseteq\cdots$ in $\calL$ imply $\bigcup_nA_n\in\calL$.
\end{definition}

\begin{theorem}[Dynkin's $\pi$--$\lambda$ theorem]\label{thm:pi-lambda}
If $\mathcal{P}$ is a $\pi$-system, $\calL$ is a $\lambda$-system and $\mathcal{P}\subseteq\calL$, then
$\sigma(\mathcal{P})\subseteq\calL$.
\end{theorem}

\begin{proof}
\textbf{Step 1: a $\pi$-system that is a $\lambda$-system is a $\sigma$-field.} Let $\calD$
be both. Then $\Omega\in\calD$, and $A^c=\Omega\setminus A\in\calD$ for $A\in\calD$. For
$A,B\in\calD$, $A\cup B=(A^c\cap B^c)^c\in\calD$, so $\calD$ is closed under finite unions.
For $A_1,A_2,\ldots\in\calD$ the sets $B_n=\bigcup_{i\leqslant n}A_i$ lie in $\calD$ and
increase to $\bigcup_iA_i$, which therefore lies in $\calD$.

\textbf{Step 2: the smallest $\lambda$-system.} Let $\lambda(\mathcal{P})$ be the intersection
of all $\lambda$-systems containing $\mathcal{P}$ (the collection of all subsets of $\Omega$ is
one). Each defining property of a $\lambda$-system holds in every member of the family,
hence in the intersection, so $\lambda(\mathcal{P})$ is a $\lambda$-system, and
$\lambda(\mathcal{P})\subseteq\calL$. By Step 1 it suffices to show that $\lambda(\mathcal{P})$ is a
$\pi$-system: it is then a $\sigma$-field containing $\mathcal{P}$, so
$\sigma(\mathcal{P})\subseteq\lambda(\mathcal{P})\subseteq\calL$.

\textbf{Step 3: an auxiliary $\lambda$-system.} For $A\in\lambda(\mathcal{P})$ let
$\calL_A=\{B\subseteq\Omega:A\cap B\in\lambda(\mathcal{P})\}$. This is a $\lambda$-system:
$A\cap\Omega=A\in\lambda(\mathcal{P})$; if $B\subseteq C$ lie in $\calL_A$ then
$A\cap(C\setminus B)=(A\cap C)\setminus(A\cap B)$, a difference of two members of
$\lambda(\mathcal{P})$ with the first containing the second, hence in $\lambda(\mathcal{P})$; and if
$B_n\uparrow B$ with $B_n\in\calL_A$ then $A\cap B_n\uparrow A\cap B$, so
$A\cap B\in\lambda(\mathcal{P})$.

\textbf{Step 4: closure under intersection.} If $A\in\mathcal{P}$ then $\mathcal{P}\subseteq\calL_A$,
as $\mathcal{P}$ is a $\pi$-system; $\calL_A$ being a $\lambda$-system,
$\lambda(\mathcal{P})\subseteq\calL_A$. Thus $A\cap B\in\lambda(\mathcal{P})$ whenever $A\in\mathcal{P}$ and
$B\in\lambda(\mathcal{P})$. Now fix $B\in\lambda(\mathcal{P})$. What was just shown says
$\mathcal{P}\subseteq\calL_B$, so $\lambda(\mathcal{P})\subseteq\calL_B$, that is,
$B\cap C\in\lambda(\mathcal{P})$ for every $C\in\lambda(\mathcal{P})$.
\end{proof}

\begin{corollary}[Uniqueness of measures]\label{cor:measure-unique}
Let $\mathcal{P}$ be a $\pi$-system on $\Omega$ and $\mu,\nu$ measures on $\sigma(\mathcal{P})$ with
$\mu(A)=\nu(A)$ for $A\in\mathcal{P}$. If there are $\Omega_1\subseteq\Omega_2\subseteq\cdots$ in
$\mathcal{P}$ with $\bigcup_n\Omega_n=\Omega$ and $\mu(\Omega_n)<\infty$, then $\mu=\nu$ on
$\sigma(\mathcal{P})$. In particular two finite measures with $\mu(\Omega)=\nu(\Omega)$, such as
two probability measures, that agree on $\mathcal{P}$ agree on $\sigma(\mathcal{P})$.
\end{corollary}

\begin{proof}
Fix $n$ and let $\calL_n=\{A\in\sigma(\mathcal{P}):\mu(A\cap\Omega_n)=\nu(A\cap\Omega_n)\}$. It is
a $\lambda$-system. First, $\Omega\in\calL_n$ as $\Omega_n\in\mathcal{P}$. Next, if
$A\subseteq B$ lie in $\calL_n$, then
$(B\setminus A)\cap\Omega_n=(B\cap\Omega_n)\setminus(A\cap\Omega_n)$, and all these sets have
finite measure, at most $\mu(\Omega_n)=\nu(\Omega_n)$; by
Proposition~\ref{prop:measure}(ii) both $\mu$ and $\nu$ give it the measure
$\mu(B\cap\Omega_n)-\mu(A\cap\Omega_n)=\nu(B\cap\Omega_n)-\nu(A\cap\Omega_n)$. Finally if
$A_k\uparrow A$ with $A_k\in\calL_n$ then $A_k\cap\Omega_n\uparrow A\cap\Omega_n$, and
continuity from below (Proposition~\ref{prop:measure}(iv)) passes the equality to the
limit. Also $\mathcal{P}\subseteq\calL_n$, since $A\cap\Omega_n\in\mathcal{P}$ for $A\in\mathcal{P}$.
Theorem~\ref{thm:pi-lambda} gives $\sigma(\mathcal{P})\subseteq\calL_n$. For $A\in\sigma(\mathcal{P})$,
$A\cap\Omega_n\uparrow A$, so by continuity from below
$\mu(A)=\lim_n\mu(A\cap\Omega_n)=\lim_n\nu(A\cap\Omega_n)=\nu(A)$.

For the last statement, $\mathcal{P}\cup\{\Omega\}$ is a $\pi$-system generating the same
$\sigma$-field, on which $\mu$ and $\nu$ agree; take $\Omega_n=\Omega$.
\end{proof}

%==============================================================================
\section{The Integral and Its Convergence Theorems}\label{sec:P.13}
%==============================================================================

Throughout, $(\Omega,\calF,\mu)$ is a measure space.

\begin{definition}[Integral of a simple function]\label{def:int-simple}
For a simple $s$ with canonical form $\sum_aa\,\indc_{\{s=a\}}$,
$\int s\,\dd\mu=\sum_aa\,\mu\{s=a\}$, a finite sum in $[0,\infty]$.
\end{definition}

\begin{lemma}[Integral of simple functions]\label{lem:int-simple}
Let $s,t$ be simple.
\begin{enumerate}[label=\textup{(\roman*)}]
\item If $s=\sum_{i\leqslant k}a_i\indc_{A_i}$ with $a_i\in[0,\infty)$ and $A_i\in\calF$,
      not necessarily disjoint, then $\int s\,\dd\mu=\sum_{i\leqslant k}a_i\mu(A_i)$.
\item $\int(as+bt)\,\dd\mu=a\int s\,\dd\mu+b\int t\,\dd\mu$ for $a,b\in[0,\infty)$.
\item If $s\leqslant t$ then $\int s\,\dd\mu\leqslant\int t\,\dd\mu$.
\item $\nu(A)=\int s\indc_A\,\dd\mu$ defines a measure $\nu$ on $\calF$.
\end{enumerate}
\end{lemma}

\begin{proof}
(i) \emph{Disjoint case.} Suppose first that $A_1,\ldots,A_k$ partition $\Omega$. A point
of $A_i$ then has $s=a_i$, so for each value $a$ of $s$ the set $\{s=a\}$ is the disjoint
union of the $A_i$ with $a_i=a$, and $\mu\{s=a\}=\sum_{i:a_i=a}\mu(A_i)$ by finite
additivity; an $A_i$ whose $a_i$ is not a value of $s$ is empty and contributes
$a_i\mu(\emptyset)=0$. Hence
\[
\sum_aa\,\mu\{s=a\}=\sum_a\sum_{i:\,a_i=a}a_i\mu(A_i)=\sum_ia_i\mu(A_i) .
\]
If the $A_i$ are disjoint but do not cover $\Omega$, adjoin
$A_0=\Omega\setminus\bigcup_iA_i$ with $a_0=0$, which adds $0\cdot\mu(A_0)=0$.

\emph{General case.} For $\epsilon=(\epsilon_1,\ldots,\epsilon_k)\in\{0,1\}^k$ let
$B_\epsilon=\bigcap_iA_i^{(\epsilon_i)}$, where $A^{(1)}=A$ and $A^{(0)}=A^c$. The $2^k$
sets $B_\epsilon$ lie in $\calF$ and partition $\Omega$, each point lying in exactly the
$B_\epsilon$ with $\epsilon_i=\indc_{A_i}(\omega)$; and $A_i$ is the disjoint union of the
$B_\epsilon$ with $\epsilon_i=1$. On $B_\epsilon$, $s=c_\epsilon:=\sum_ia_i\epsilon_i$. By
the disjoint case and finite additivity,
\[
\int s\,\dd\mu=\sum_\epsilon c_\epsilon\mu(B_\epsilon)
=\sum_i a_i\sum_{\epsilon:\,\epsilon_i=1}\mu(B_\epsilon)=\sum_ia_i\mu(A_i) ,
\]
the rearrangement of a finite sum of terms in $[0,\infty]$ being permitted.

(ii) Let $s=\sum_ia_i\indc_{A_i}$ and $t=\sum_jb_j\indc_{B_j}$ be the canonical forms. Then
$as+bt=\sum_i(aa_i)\indc_{A_i}+\sum_j(bb_j)\indc_{B_j}$, and (i) gives
$\int(as+bt)\,\dd\mu=a\sum_ia_i\mu(A_i)+b\sum_jb_j\mu(B_j)$.

(iii) $t-s$ is measurable with finitely many values in $[0,\infty)$, so it is simple, and by
(ii) $\int t\,\dd\mu=\int s\,\dd\mu+\int(t-s)\,\dd\mu\geqslant\int s\,\dd\mu$.

(iv) With $s=\sum_ia_i\indc_{A_i}$, $s\indc_A=\sum_ia_i\indc_{A_i\cap A}$, so by (i)
$\nu(A)=\sum_ia_i\mu(A_i\cap A)$. Then $\nu(\emptyset)=\sum_ia_i\mu(\emptyset)=0$. If $C_1,C_2,\ldots$ are
pairwise disjoint with union $C$, so are the $A_i\cap C_n$, with union $A_i\cap C$, and
\[
\nu(C)=\sum_ia_i\sum_n\mu(A_i\cap C_n)=\sum_n\sum_ia_i\mu(A_i\cap C_n)=\sum_n\nu(C_n) ,
\]
a finite sum of series with terms in $[0,\infty]$ being summed term by term.
\end{proof}

\begin{definition}[Integral of a non-negative function]\label{def:int-nonneg}
For a non-negative measurable $f$,
\[
\int f\,\dd\mu=\sup\Bigl\{\int s\,\dd\mu:\ s\text{ simple},\ s\leqslant f\Bigr\}\in[0,\infty] ,
\]
also written $\int f(\omega)\,\mu(\dd\omega)$; and $\int_Af\,\dd\mu=\int f\indc_A\,\dd\mu$
for $A\in\calF$.
\end{definition}

\begin{lemma}[Monotonicity and scaling]\label{lem:int-mono}
Let $f,g$ be non-negative measurable functions.
\begin{enumerate}[label=\textup{(\roman*)}]
\item For simple $f$, Definitions~\ref{def:int-simple} and~\ref{def:int-nonneg} agree.
\item If $f\leqslant g$ then $\int f\,\dd\mu\leqslant\int g\,\dd\mu$.
\item $\int cf\,\dd\mu=c\int f\,\dd\mu$ for $c\in[0,\infty)$.
\item $\int c\indc_A\,\dd\mu=c\,\mu(A)$ for $c\in[0,\infty)$ and $A\in\calF$.
\end{enumerate}
\end{lemma}

\begin{proof}
(i) If $f$ is simple, every simple $s\leqslant f$ has $\int s\leqslant\int f$ by
Lemma~\ref{lem:int-simple}(iii), and $s=f$ is admissible, so the supremum is the integral
of Definition~\ref{def:int-simple}. (ii) Every simple $s\leqslant f$ is also
$\leqslant g$, so the supremum defining $\int g$ is over a larger set. (iii) For $c=0$ both
sides vanish. For $c>0$, $s\leqslant f$ if and only if $cs\leqslant cf$, and
$\int cs=c\int s$ by Lemma~\ref{lem:int-simple}(ii), so the two suprema differ by the factor
$c$. (iv) is (i) with Lemma~\ref{lem:int-simple}(i).
\end{proof}

\begin{theorem}[Monotone convergence theorem]\label{thm:mct}
Let $f_1\leqslant f_2\leqslant\cdots$ be non-negative measurable functions and
$f=\lim_nf_n=\sup_nf_n$. Then $f$ is measurable and
$\int f_n\,\dd\mu\uparrow\int f\,\dd\mu$.
\end{theorem}

\begin{proof}
\textbf{Step 1: the easy inequality.} $f$ is measurable by
Proposition~\ref{prop:meas-closure}(ii). Since $f_n\leqslant f_{n+1}\leqslant f$,
Lemma~\ref{lem:int-mono}(ii) shows that $\int f_n$ increases and is at most $\int f$; so
$L=\lim_n\int f_n$ exists in $[0,\infty]$ and $L\leqslant\int f$.

\textbf{Step 2: a set on which $f_n$ is nearly as large as $s$.} By
Definition~\ref{def:int-nonneg} it remains to show $\int s\leqslant L$ for every simple
$s\leqslant f$. Fix such $s$ and $c\in(0,1)$, and let $E_n=\{f_n\geqslant cs\}$, which lies
in $\calF$ as the finite union over the values $a$ of $s$ of
$\{s=a\}\cap\{f_n\geqslant ca\}$. The $E_n$ increase, since the $f_n$ do. Their union is
$\Omega$: if $s(\omega)=0$ then $\omega\in E_1$, and if $s(\omega)>0$ then
$cs(\omega)<s(\omega)\leqslant f(\omega)=\lim_nf_n(\omega)$, so $f_n(\omega)>cs(\omega)$ for
all large $n$.

\textbf{Step 3: the reverse inequality.} The simple function $cs\indc_{E_n}$ satisfies
$cs\indc_{E_n}\leqslant f_n$, so by Definition~\ref{def:int-nonneg} and
Lemma~\ref{lem:int-simple}(ii)
\[
\int f_n\,\dd\mu\geqslant\int cs\indc_{E_n}\,\dd\mu=c\,\nu(E_n),
\qquad \nu(A)=\int s\indc_A\,\dd\mu .
\]
By Lemma~\ref{lem:int-simple}(iv) $\nu$ is a measure, so continuity from below
(Proposition~\ref{prop:measure}(iv)) gives $\nu(E_n)\uparrow\nu(\Omega)=\int s$. Letting
$n\to\infty$, $L\geqslant c\int s$; letting $c\uparrow1$, $L\geqslant\int s$.
\end{proof}

\begin{theorem}[Additivity of the integral]\label{thm:int-additive}
For non-negative measurable $f,g$ and $a,b\in[0,\infty)$,
$\int(af+bg)\,\dd\mu=a\int f\,\dd\mu+b\int g\,\dd\mu$.
\end{theorem}

\begin{proof}
By Theorem~\ref{thm:simple-approx} there are simple $s_n\uparrow f$ and $t_n\uparrow g$.
Then $as_n+bt_n$ is simple and increases. At every point $as_n\to af$ (both sides vanish if
$a=0$, and $as_n\to\infty$ if $a>0$ and $f=\infty$), and likewise $bt_n\to bg$, so
$as_n+bt_n\uparrow af+bg$. By Theorem~\ref{thm:mct} applied three times
and Lemma~\ref{lem:int-simple}(ii),
\[
\int(af+bg)\,\dd\mu=\lim_n\int(as_n+bt_n)\,\dd\mu
=\lim_n\Bigl(a\int s_n\,\dd\mu+b\int t_n\,\dd\mu\Bigr)
=a\int f\,\dd\mu+b\int g\,\dd\mu ,
\]
the limit of a sum of increasing sequences in $[0,\infty]$ being the sum of the limits.
\end{proof}

\begin{corollary}[Integral of a series]\label{cor:int-series}
\begin{enumerate}[label=\textup{(\roman*)}]
\item If $f_1,f_2,\ldots$ are non-negative and measurable, then
      $\int\sum_nf_n\,\dd\mu=\sum_n\int f_n\,\dd\mu$.
\item For non-negative measurable $f$, $\nu(A)=\int_Af\,\dd\mu$ defines a measure on $\calF$.
\end{enumerate}
\end{corollary}

\begin{proof}
(i) The partial sums $g_N=\sum_{n\leqslant N}f_n$ are measurable by
Proposition~\ref{prop:meas-closure}(iii), increase in $N$, and converge to $\sum_nf_n$
(Definition~\ref{def:extended}). By induction on $N$,
$\int g_N=\sum_{n\leqslant N}\int f_n$: for $N=1$ both sides are $\int f_1$, and if it
holds for $N-1$ then $g_N=g_{N-1}+f_N$ and Theorem~\ref{thm:int-additive} gives
$\int g_N=\int g_{N-1}+\int f_N=\sum_{n\leqslant N}\int f_n$. Theorem~\ref{thm:mct} lets $N\to\infty$ on the left,
and the right side tends to $\sum_n\int f_n$ by Definition~\ref{def:extended}.

(ii) $\nu(\emptyset)=\int0=0$. If $A_1,A_2,\ldots$ are pairwise disjoint with union $A$,
then $f\indc_A=\sum_nf\indc_{A_n}$ pointwise, as each point of $A$ lies in exactly one
$A_n$; apply (i).
\end{proof}

\begin{definition}[Almost everywhere]\label{def:ae}
A property of points of $\Omega$ holds \emph{$\mu$-almost everywhere} (a.e.), or
\emph{almost surely} (a.s.) when $\mu$ is a probability, if the set where it fails is
contained in a null set.
\end{definition}

\begin{proposition}[Null sets and the integral]\label{prop:null}
Let $f,g$ be non-negative measurable functions.
\begin{enumerate}[label=\textup{(\roman*)}]
\item $a\,\mu\{f\geqslant a\}\leqslant\int f\,\dd\mu$ for $a\in(0,\infty)$.
\item If $N$ is a null set then $\int_Nf\,\dd\mu=0$.
\item If $f=g$ a.e. then $\int f\,\dd\mu=\int g\,\dd\mu$.
\item $\int f\,\dd\mu=0$ if and only if $f=0$ a.e.
\item If $\int f\,\dd\mu<\infty$ then $f<\infty$ a.e.
\item Countable unions of null sets are null; so if each of countably many properties holds
      a.e., they hold simultaneously a.e.
\end{enumerate}
\end{proposition}

\begin{proof}
(i) $a\indc_{\{f\geqslant a\}}\leqslant f$ pointwise; apply Lemma~\ref{lem:int-mono}(ii),(iv).

(ii) A simple $s\leqslant f\indc_N$ vanishes off $N$, so for each value $a>0$ of $s$,
$\{s=a\}\subseteq N$ and $\mu\{s=a\}=0$ by Proposition~\ref{prop:measure}(ii); hence
$\int s=0$, and the supremum is $0$.

(iii) Let $N$ be a null set with $f=g$ off $N$. By Theorem~\ref{thm:int-additive} and (ii),
$\int f=\int f\indc_{N^c}+\int f\indc_N=\int f\indc_{N^c}$, and likewise
$\int g=\int g\indc_{N^c}$; and $f\indc_{N^c}=g\indc_{N^c}$.

(iv) If $f=0$ a.e., (iii) with $g=0$ gives $\int f=0$. Conversely, if $\int f=0$, (i)
gives $\mu\{f\geqslant1/k\}\leqslant k\int f=0$ for each $k$, and
$\{f>0\}=\bigcup_k\{f\geqslant1/k\}$ is null by countable subadditivity
(Proposition~\ref{prop:measure}(iii)).

(v) $n\indc_{\{f=\infty\}}\leqslant f$, so $n\,\mu\{f=\infty\}\leqslant\int f<\infty$ for
every $n$, which forces $\mu\{f=\infty\}=0$.

(vi) If $N_1,N_2,\ldots$ are null, countable subadditivity
(Proposition~\ref{prop:measure}(iii)) gives $\mu(\bigcup_kN_k)\leqslant\sum_k0=0$. If the
$k$th property fails only inside a null set $N_k$, then the set where some property fails
lies in $\bigcup_kN_k$, which is null.
\end{proof}

\begin{theorem}[Fatou's lemma]\label{thm:fatou}
For non-negative measurable $f_1,f_2,\ldots$,
$\int\liminf_nf_n\,\dd\mu\leqslant\liminf_n\int f_n\,\dd\mu$.
\end{theorem}

\begin{proof}
Let $g_m=\inf_{n\geqslant m}f_n$, measurable by Proposition~\ref{prop:meas-closure}(ii).
The $g_m$ are non-negative and increase in $m$ (an infimum over fewer terms), with
$\sup_mg_m=\liminf_nf_n$ by Definition~\ref{def:limsup}. Since $g_m\leqslant f_n$ for
every $n\geqslant m$, Lemma~\ref{lem:int-mono}(ii) gives
$\int g_m\leqslant\inf_{n\geqslant m}\int f_n$. By Theorem~\ref{thm:mct},
\[
\int\liminf_nf_n\,\dd\mu=\lim_m\int g_m\,\dd\mu
\leqslant\lim_m\inf_{n\geqslant m}\int f_n\,\dd\mu=\liminf_n\int f_n\,\dd\mu . \qedhere
\]
\end{proof}

\begin{definition}[Integrable function]\label{def:integrable}
A measurable $f:\Omega\to\Real$ is \emph{integrable} if $\int|f|\,\dd\mu<\infty$, and then
$\int f\,\dd\mu=\int f^+\,\dd\mu-\int f^-\,\dd\mu$, both terms being finite as
$f^\pm\leqslant|f|$. More generally the integral of a measurable real $f$ \emph{exists},
with this value in $[-\infty,\infty]$, when at least one of $\int f^\pm$ is finite. A
measurable complex $f=u+iv$ is integrable if $\int|f|\,\dd\mu<\infty$, and then
$\int f\,\dd\mu=\int u\,\dd\mu+i\int v\,\dd\mu$, the real functions $u,v$ being integrable
as $|u|,|v|\leqslant|f|$.
\end{definition}

\begin{theorem}[Properties of the integral]\label{thm:int-linear}
Let $f,g$ be integrable, real or complex.
\begin{enumerate}[label=\textup{(\roman*)}]
\item For constants $a,b$ (real, or complex in the complex case), $af+bg$ is integrable and
      $\int(af+bg)\,\dd\mu=a\int f\,\dd\mu+b\int g\,\dd\mu$.
\item If $f,g$ are real and $f\leqslant g$ then $\int f\,\dd\mu\leqslant\int g\,\dd\mu$.
\item $\bigl|\int f\,\dd\mu\bigr|\leqslant\int|f|\,\dd\mu$.
\item If $h$ is measurable and $h=f$ a.e., then $h$ is integrable and
      $\int h\,\dd\mu=\int f\,\dd\mu$.
\end{enumerate}
\end{theorem}

\begin{proof}
(i) \emph{Real case.} $|af+bg|\leqslant|a||f|+|b||g|$, so $af+bg$ is integrable by
Lemma~\ref{lem:int-mono} and Theorem~\ref{thm:int-additive}. For $a\geqslant0$,
$(af)^\pm=af^\pm$, so $\int af=a\int f^+-a\int f^-=a\int f$ by
Lemma~\ref{lem:int-mono}(iii); for $a<0$, $(af)^+=|a|f^-$ and $(af)^-=|a|f^+$, so
$\int af=|a|\int f^--|a|\int f^+=a\int f$. For the sum, let $h=f+g$. From
$h^+-h^-=f^+-f^-+g^+-g^-$,
\[
h^++f^-+g^-=h^-+f^++g^+ ,
\]
an identity between non-negative functions. Theorem~\ref{thm:int-additive} gives
$\int h^++\int f^-+\int g^-=\int h^-+\int f^++\int g^+$, all six terms finite; rearranging,
$\int h=\int f+\int g$.

\emph{Complex case.} With $f=u+iv$, $g=w+iz$, $f+g=(u+w)+i(v+z)$, and the real case gives
additivity. For $a=\alpha+i\beta$, $af=(\alpha u-\beta v)+i(\beta u+\alpha v)$, and by the
real case $\int af=\alpha\int u-\beta\int v+i(\beta\int u+\alpha\int v)
=(\alpha+i\beta)(\int u+i\int v)$.

(ii) $g-f\geqslant0$ is integrable with $(g-f)^-=0$, so by (i)
$\int g-\int f=\int(g-f)=\int(g-f)^+\geqslant0$.

(iii) Real case: $\int f=\int f^+-\int f^-$ and $-\int f$ are both at most
$\int f^++\int f^-=\int|f|$, by Theorem~\ref{thm:int-additive}. Complex case: let
$z=\int f$; if $z=0$ there is nothing to prove. Otherwise put $\theta=\bar z/|z|$, so
$|\theta|=1$ and $\theta z=|z|$. By (i), $|z|=\int\theta f$, a real number, so it equals the
real part $\int\mathrm{Re}(\theta f)$, and by (ii) and the real case
$\int\mathrm{Re}(\theta f)\leqslant\int|\theta f|=\int|f|$.

(iv) $|h|=|f|$ a.e., so $\int|h|=\int|f|<\infty$ by Proposition~\ref{prop:null}(iii). For
real $f$, $h^\pm=f^\pm$ a.e., and Proposition~\ref{prop:null}(iii) gives $\int h^\pm=\int
f^\pm$; the complex case follows from the real and imaginary parts.
\end{proof}

\begin{theorem}[Dominated convergence theorem]\label{thm:dct}
Let $f,f_1,f_2,\ldots$ be measurable, real or complex, with $f_n\to f$ a.e., and let $g$ be
a non-negative integrable function with $|f_n|\leqslant g$ a.e.\ for every $n$. Then $f$
and the $f_n$ are integrable, $\int|f_n-f|\,\dd\mu\to0$, and
$\int f_n\,\dd\mu\to\int f\,\dd\mu$.
\end{theorem}

\begin{proof}
\textbf{Step 1: reduction to everywhere.} By Proposition~\ref{prop:null}(vi) there is a
null set $N$ off which $f_n\to f$ and $|f_n|\leqslant g$ for every $n$. Replacing $f$,
$f_n$, $g$ by $f\indc_{N^c}$, $f_n\indc_{N^c}$, $g\indc_{N^c}$ changes none of the
integrals in the statement, by Theorem~\ref{thm:int-linear}(iv) and
Proposition~\ref{prop:null}(iii), and the new functions satisfy the hypotheses at every
point.

\textbf{Step 2: integrability.} $|f_n|\leqslant g$ gives $\int|f_n|\leqslant\int g<\infty$.
Letting $n\to\infty$ in $|f_n|\leqslant g$ gives $|f|\leqslant g$, so $f$ is integrable.

\textbf{Step 3: Fatou applied to $2g-|f_n-f|$.} Since
$|f_n-f|\leqslant|f_n|+|f|\leqslant2g$, the functions $h_n=2g-|f_n-f|$ are non-negative and
measurable, and $h_n\to2g$ pointwise. Theorem~\ref{thm:fatou} and
Theorem~\ref{thm:int-linear}(i) give
\[
\int2g\,\dd\mu\leqslant\liminf_n\int h_n\,\dd\mu
=\int2g\,\dd\mu-\limsup_n\int|f_n-f|\,\dd\mu ,
\]
using $\liminf_n(c-x_n)=c-\limsup_nx_n$, which holds because
$\inf_{n\geqslant m}(c-x_n)=c-\sup_{n\geqslant m}x_n$. As $\int2g$ is finite it may be
cancelled, leaving $\limsup_n\int|f_n-f|\leqslant0$. The terms are non-negative, so
$\int|f_n-f|\to0$.

\textbf{Step 4.} By Theorem~\ref{thm:int-linear}(i),(iii),
$|\int f_n-\int f|=|\int(f_n-f)|\leqslant\int|f_n-f|\to0$.
\end{proof}

\begin{theorem}[Differentiation under the integral sign]\label{thm:diff-int}
Let $(\calX,\mu)$ be a measure space, $I\subseteq\Real$ an open interval, and
$f:I\times\calX\to\Real$ such that
\begin{enumerate}[label=\textup{(\roman*)}]
\item $x\mapsto f(t,x)$ is $\mu$-integrable for each $t\in I$;
\item $\partial f/\partial t$ exists for every $(t,x)$;
\item $|\partial f/\partial t(t,x)|\leqslant g(x)$ for all $t\in I$, with
      $\int g\,\dd\mu<\infty$.
\end{enumerate}
Then $F(t)=\int f(t,x)\,\dd\mu(x)$ is differentiable on $I$ with
$F'(t)=\int\frac{\partial f}{\partial t}(t,x)\,\dd\mu(x)$.
\end{theorem}

\begin{proof}
Fix $t\in I$ and any sequence $h_n\to0$ with $t+h_n\in I$, $h_n\neq0$. Put
$q_n(x)=\{f(t+h_n,x)-f(t,x)\}/h_n$, measurable by (i) and
Proposition~\ref{prop:meas-closure}(i). By (ii) and the mean value theorem
(Corollary~\ref{cor:MVT}) applied in $t$, for each $x$ there is $\xi$ between $t$ and
$t+h_n$ with $q_n(x)=\partial f/\partial t(\xi,x)$, so $|q_n(x)|\leqslant g(x)$ by (iii).
Also $q_n(x)\to\partial f/\partial t(t,x)$ pointwise by (ii), so
$x\mapsto\partial f/\partial t(t,x)$ is measurable by
Proposition~\ref{prop:meas-closure}(ii). The dominated convergence theorem
(Theorem~\ref{thm:dct}) gives $\int q_n\,\dd\mu\to\int\partial f/\partial t\,\dd\mu$, and by
Theorem~\ref{thm:int-linear}(i) the left side is $\{F(t+h_n)-F(t)\}/h_n$, $F$ being
defined by (i). As the sequence $(h_n)$ was arbitrary, the difference quotient of $F$ tends
to $L=\int\partial f/\partial t(t,x)\,\dd\mu(x)$ as $h\to0$: otherwise there would be
$\varepsilon>0$ and, for each $n$, some $h_n$ with $0<|h_n|<1/n$, $t+h_n\in I$ and
$|\{F(t+h_n)-F(t)\}/h_n-L|\geqslant\varepsilon$, a sequence along which the quotients
do not tend to $L$. So $F'(t)=L$.
\end{proof}

\begin{definition}[Random vectors, laws and expectation]\label{def:expectation}
On a probability space $(\Omega,\calF,\prb)$ a \emph{random vector} is a measurable
$X:\Omega\to\Real^d$, a \emph{random variable} when $d=1$. Its \emph{law} is
$\mu_X(B)=\prb\{X\in B\}$ for $B\in\calB(\Real^d)$. The \emph{expectation} of a random
variable $Y$ is $\expc[Y]=\int Y\,\dd\prb$ whenever the integral exists, and likewise
$\expc[Y]=\int Y\,\dd\prb$ for measurable $Y:\Omega\to[0,\infty]$ and for integrable complex
$Y$ (Definition~\ref{def:integrable}). For an integrable random variable $Y$,
$\var(Y)=\expc[(Y-\expc Y)^2]\in[0,\infty]$ and $\sd(Y)=\var(Y)^{1/2}$; for a random vector
$\bz=(z_1,\ldots,z_d)'$ with integrable coordinates, $\expc\bz=(\expc z_1,\ldots,\expc z_d)'$,
$\cov(z_i,z_j)=\expc[(z_i-\expc z_i)(z_j-\expc z_j)]$ whenever this expectation exists, and
$\var(\bz)$ is the $d\times d$ matrix with entries $\cov(z_i,z_j)$.
\end{definition}

\begin{remark}
$\mu_X$ is a probability measure on $\calB(\Real^d)$: $\mu_X(\Real^d)=\prb(\Omega)=1$, and
preimages of pairwise disjoint sets are pairwise disjoint with
$X^{-1}(\bigcup_nB_n)=\bigcup_nX^{-1}(B_n)$.
\end{remark}

\begin{theorem}[Change of variables]\label{thm:change-var}
Let $T:\Omega\to E$ be $\calF/\calE$-measurable and $\mu T^{-1}(B)=\mu(T^{-1}(B))$ for
$B\in\calE$. For $\calE$-measurable $g:E\to[0,\infty]$,
\[
\int g\circ T\,\dd\mu=\int g\,\dd(\mu T^{-1}) ,
\]
and the same holds for real or complex $g$ whenever either side is finite with $|g|$ in
place of $g$. In particular $\expc[g(X)]=\int g\,\dd\mu_X$ for a random vector $X$ and a
Borel $g\geqslant0$, or a Borel $g$ with $\expc|g(X)|<\infty$.
\end{theorem}

\begin{proof}
$\mu T^{-1}$ is a measure on $\calE$, by the argument of the preceding remark. For
$g=\indc_B$, $g\circ T=\indc_{T^{-1}(B)}$, and both sides equal $\mu(T^{-1}(B))$ by
Lemma~\ref{lem:int-mono}(iv). For simple $g=\sum_ia_i\indc_{B_i}$,
$g\circ T=\sum_ia_i\indc_{T^{-1}(B_i)}$ is simple on $\Omega$, and both sides equal
$\sum_ia_i\mu(T^{-1}(B_i))$ by Lemma~\ref{lem:int-simple}(i). For measurable
$g\geqslant0$, take simple $s_n\uparrow g$ (Theorem~\ref{thm:simple-approx}); then
$s_n\circ T$ is simple, $s_n\circ T\uparrow g\circ T$, and Theorem~\ref{thm:mct} on both
sides passes the identity to the limit. For real $g$ with $\int|g|\circ T\,\dd\mu
=\int|g|\,\dd(\mu T^{-1})<\infty$, apply this to $g^+$ and $g^-$, noting
$(g\circ T)^\pm=g^\pm\circ T$, and subtract; for complex $g$ apply the real case to the real
and imaginary parts.
\end{proof}

\begin{lemma}[Cauchy--Schwarz and Minkowski for integrals]\label{lem:minkowski}
Let $u,v$ be real measurable with $\int u^2\,\dd\mu$ and $\int v^2\,\dd\mu$ finite, and put
$\|u\|=(\int u^2\,\dd\mu)^{1/2}$. Then $uv$ is integrable,
$|\int uv\,\dd\mu|\leqslant\|u\|\,\|v\|$, $\int(u+v)^2\,\dd\mu<\infty$, and
$\|u+v\|\leqslant\|u\|+\|v\|$.
\end{lemma}

\begin{proof}
From $0\leqslant(|u|-|v|)^2$, $|uv|\leqslant\frac12(u^2+v^2)$, so $uv$ is integrable by
Theorem~\ref{thm:int-additive}; and $(u+v)^2\leqslant2u^2+2v^2$, so $(u+v)^2$ is integrable.
For real $t$, Theorem~\ref{thm:int-linear}(i) and (ii) give
\[
0\leqslant\int(u-tv)^2\,\dd\mu=\|u\|^2-2t\int uv\,\dd\mu+t^2\|v\|^2 .
\]
If $\|v\|=0$ the right side is affine in $t$ and non-negative for every $t$, so its slope
$-2\int uv$ vanishes and the inequality holds. If $\|v\|>0$ the quadratic in $t$ cannot have two
distinct real roots, as it would be negative between them, so its discriminant $4(\int uv)^2-4\|u\|^2\|v\|^2$ is at most $0$. In both cases
$(\int uv)^2\leqslant\|u\|^2\|v\|^2$, and taking square roots gives
$|\int uv\,\dd\mu|\leqslant\|u\|\,\|v\|$. Then, by Theorem~\ref{thm:int-linear}(i),
\[
\|u+v\|^2=\|u\|^2+2\int uv\,\dd\mu+\|v\|^2\leqslant\|u\|^2+2\|u\|\,\|v\|+\|v\|^2
=(\|u\|+\|v\|)^2 . \qedhere
\]
\end{proof}

\begin{theorem}[Completeness of $L^2$]\label{thm:L2-complete}
Let $f_1,f_2,\ldots$ be real measurable functions with $\int f_n^2\,\dd\mu<\infty$, and
suppose that for every $\varepsilon>0$ there is $N$ with
$\int(f_n-f_m)^2\,\dd\mu\leqslant\varepsilon^2$ for all $m,n\geqslant N$. Then there is a
real measurable $f$ with $\int f^2\,\dd\mu<\infty$ and $\int(f_n-f)^2\,\dd\mu\to0$, and a
subsequence of $(f_n)$ converges to $f$ a.e.
\end{theorem}

\begin{proof}
\textbf{Step 1: a fast subsequence.} Choose $n_1<n_2<\cdots$ such that
$\int(f_n-f_m)^2\leqslant4^{-k}$ for all $m,n\geqslant n_k$: with $N(\varepsilon)$ the index
of the hypothesis, put $n_1=N(1/2)$ and $n_k=\max\{N(2^{-k}),n_{k-1}+1\}$ for $k\geqslant2$.
As $n_{k+1}>n_k$, taking $m=n_k$ and $n=n_{k+1}$ gives
$\int(f_{n_{k+1}}-f_{n_k})^2\leqslant4^{-k}$. With the notation of
Lemma~\ref{lem:minkowski}, $\|f_{n_{k+1}}-f_{n_k}\|\leqslant2^{-k}$.

\textbf{Step 2: the increments are summable a.e.} Let
$G_K=\sum_{k\leqslant K}|f_{n_{k+1}}-f_{n_k}|$ and $G=\lim_KG_K\in[0,\infty]$ (an
increasing limit). Claim: $\int G_K^2<\infty$ and $\|G_K\|\leqslant\sum_{k\leqslant K}2^{-k}$.
For $K=1$, $\|G_1\|=\|f_{n_2}-f_{n_1}\|\leqslant2^{-1}$. If the claim holds for $K-1$, then
$G_K=G_{K-1}+|f_{n_{K+1}}-f_{n_K}|$, and Lemma~\ref{lem:minkowski} gives
$\int G_K^2<\infty$ and $\|G_K\|\leqslant\|G_{K-1}\|+2^{-K}\leqslant\sum_{k\leqslant K}2^{-k}$.
Hence $\|G_K\|\leqslant1$, that is, $\int G_K^2\leqslant1$. As
$G_K^2\uparrow G^2$, Theorem~\ref{thm:mct} gives $\int G^2\leqslant1$, and
Proposition~\ref{prop:null}(v) gives a null set $N\in\calF$ (namely $\{G=\infty\}$) off
which $G<\infty$.

\textbf{Step 3: the subsequence converges off $N$.} Fix $\omega\notin N$ and put
$a_k=f_{n_{k+1}}(\omega)-f_{n_k}(\omega)$. The partial sums of $a_k^+$ and of $a_k^-$
increase and are bounded by $G(\omega)<\infty$, so both converge by
Theorem~\ref{thm:monotone-seq}, and hence so does
$f_{n_{K+1}}(\omega)=f_{n_1}(\omega)+\sum_{k\leqslant K}a_k^+-\sum_{k\leqslant K}a_k^-$.
Define $f=\lim_kf_{n_k}$ on $N^c$ and $f=0$ on $N$. Then $f$ is the pointwise limit of the
measurable real functions $f_{n_k}\indc_{N^c}$, hence measurable by
Proposition~\ref{prop:meas-closure}(ii), and $f_{n_k}\to f$ a.e.

\textbf{Step 4: $L^2$ convergence.} Let $\varepsilon>0$ and $N_\varepsilon$ be as in the
hypothesis, and fix $n\geqslant N_\varepsilon$. On $N^c$,
$(f_{n_k}-f_n)^2\to(f-f_n)^2$ as $k\to\infty$. By Proposition~\ref{prop:null}(iii) and
Theorem~\ref{thm:fatou},
\[
\int(f-f_n)^2\,\dd\mu=\int\liminf_k(f_{n_k}-f_n)^2\indc_{N^c}\,\dd\mu
\leqslant\liminf_k\int(f_{n_k}-f_n)^2\,\dd\mu\leqslant\varepsilon^2 ,
\]
using Lemma~\ref{lem:int-mono}(ii) to drop $\indc_{N^c}$, since $n_k\geqslant k\geqslant N_\varepsilon$ for large $k$. Thus $f-f_n$ is square
integrable, so is $f=f_n+(f-f_n)$ by Lemma~\ref{lem:minkowski}, and
$\int(f_n-f)^2\leqslant\varepsilon^2$ for every $n\geqslant N_\varepsilon$.
\end{proof}

%==============================================================================
\section{Product Measures}\label{sec:P.product}
%==============================================================================

Throughout, $(\Omega_1,\calF_1,\mu_1)$ and $(\Omega_2,\calF_2,\mu_2)$ are measure spaces.

\begin{definition}[Product $\sigma$-field]\label{def:product-sigma}
A \emph{measurable rectangle} is a set $A\times B$ with $A\in\calF_1$, $B\in\calF_2$. The
\emph{product $\sigma$-field} $\calF_1\otimes\calF_2$ is the $\sigma$-field on
$\Omega_1\times\Omega_2$ generated by the measurable rectangles. For
$E\subseteq\Omega_1\times\Omega_2$ the \emph{sections} are
$E_x=\{y:(x,y)\in E\}$ for $x\in\Omega_1$ and $E^y=\{x:(x,y)\in E\}$ for $y\in\Omega_2$.
\end{definition}

\begin{remark}
The measurable rectangles form a $\pi$-system:
$(A\times B)\cap(A'\times B')=(A\cap A')\times(B\cap B')$.
\end{remark}

\begin{lemma}[Borel sets of a product]\label{lem:borel-product}
$\calB(\Real^{a+b})=\calB(\Real^a)\otimes\calB(\Real^b)$, identifying $\Real^{a+b}$ with
$\Real^a\times\Real^b$.
\end{lemma}

\begin{proof}
($\subseteq$) An open box in $\Real^{a+b}$ is the product of an open box in $\Real^a$ and
one in $\Real^b$, both open, hence a measurable rectangle. By
Lemma~\ref{lem:borel-gen}(i) every open subset of $\Real^{a+b}$ is a countable union of
open boxes and so lies in $\calB(\Real^a)\otimes\calB(\Real^b)$; hence so does
$\calB(\Real^{a+b})$, the $\sigma$-field the open sets generate.

($\supseteq$) For $A\in\calB(\Real^a)$, $A\times\Real^b=p^{-1}(A)$ with $p(x,y)=x$
continuous, hence Borel by Lemma~\ref{lem:meas-criteria}(iii); so
$A\times\Real^b\in\calB(\Real^{a+b})$, and likewise $\Real^a\times B$ for
$B\in\calB(\Real^b)$. Their intersection $A\times B$ is therefore Borel, and the
$\sigma$-field the rectangles generate is contained in $\calB(\Real^{a+b})$.
\end{proof}

\begin{lemma}[Measurability of sections]\label{lem:sections}
If $E\in\calF_1\otimes\calF_2$ then $E_x\in\calF_2$ for every $x$ and $E^y\in\calF_1$ for
every $y$. If $f:\Omega_1\times\Omega_2\to[-\infty,\infty]$ is
$\calF_1\otimes\calF_2$-measurable, then $y\mapsto f(x,y)$ is $\calF_2$-measurable for every
$x$, and $x\mapsto f(x,y)$ is $\calF_1$-measurable for every $y$.
\end{lemma}

\begin{proof}
Let $\calG=\{E\subseteq\Omega_1\times\Omega_2:E_x\in\calF_2\text{ for every }x\}$. A
rectangle lies in $\calG$, as $(A\times B)_x$ is $B$ for $x\in A$ and $\emptyset$
otherwise. $\calG$ is a $\sigma$-field, since $(\Omega_1\times\Omega_2)_x=\Omega_2$,
$(E^c)_x=(E_x)^c$ and $(\bigcup_nE_n)_x=\bigcup_n(E_n)_x$. Hence
$\calF_1\otimes\calF_2\subseteq\calG$. For $f$,
$\{y:f(x,y)\leqslant a\}=(\{f\leqslant a\})_x\in\calF_2$; apply
Lemma~\ref{lem:meas-criteria}(ii). The statements for $E^y$ and $x\mapsto f(x,y)$ follow by
exchanging the roles of the coordinates: the class of $E$ with $E^y\in\calF_1$ for every $y$
contains the rectangles, as $(A\times B)^y$ is $A$ for $y\in B$ and $\emptyset$ otherwise, and
is a $\sigma$-field by the same three identities for $E^y$; and
$\{x:f(x,y)\leqslant a\}=(\{f\leqslant a\})^y$.
\end{proof}

\begin{lemma}[Measurability of section measures]\label{lem:section-measure}
If $\mu_2$ is $\sigma$-finite and $E\in\calF_1\otimes\calF_2$, then
$x\mapsto\mu_2(E_x)$ is a non-negative $\calF_1$-measurable function. If $\mu_1$ is
$\sigma$-finite, $y\mapsto\mu_1(E^y)$ is $\calF_2$-measurable.
\end{lemma}

\begin{proof}
\textbf{Step 1: $\mu_2$ finite.} Let $\calL$ be the class of
$E\in\calF_1\otimes\calF_2$ for which $x\mapsto\mu_2(E_x)$ is measurable; the function is
defined by Lemma~\ref{lem:sections}. A rectangle lies in $\calL$, as
$\mu_2((A\times B)_x)=\mu_2(B)\indc_A(x)$. $\calL$ is a $\lambda$-system: the whole space
gives the constant $\mu_2(\Omega_2)$; if $E\subseteq F$ lie in $\calL$ then
$(F\setminus E)_x=F_x\setminus E_x$ with $E_x\subseteq F_x$, so
$\mu_2((F\setminus E)_x)=\mu_2(F_x)-\mu_2(E_x)$ by Proposition~\ref{prop:measure}(ii), a
difference of real measurable functions; and if $E_n\uparrow E$ with $E_n\in\calL$ then
$(E_n)_x\uparrow E_x$, so $\mu_2((E_n)_x)\uparrow\mu_2(E_x)$ by continuity from below, a
supremum of measurable functions. The rectangles form a $\pi$-system generating
$\calF_1\otimes\calF_2$, so Theorem~\ref{thm:pi-lambda} gives
$\calL=\calF_1\otimes\calF_2$.

\textbf{Step 2: $\mu_2$ $\sigma$-finite.} Let $\Omega_2=\bigcup_kC_k$ with
$\mu_2(C_k)<\infty$ and put $D_n=\bigcup_{k\leqslant n}C_k$, so $D_n\uparrow\Omega_2$ and
$\mu_2(D_n)<\infty$ by subadditivity. The finite measure $B\mapsto\mu_2(B\cap D_n)$ satisfies
the hypothesis of Step 1, so $x\mapsto\mu_2(E_x\cap D_n)$ is measurable. As $n\to\infty$ it
increases to $\mu_2(E_x)$ by continuity from below, and a supremum of measurable functions
is measurable. The second statement is Steps 1 and 2 with the roles of the coordinates
exchanged, using $(A\times B)^y$ ($A$ for $y\in B$, $\emptyset$ otherwise) and the sections
$E^y$ of Lemma~\ref{lem:sections}.
\end{proof}

\begin{theorem}[Product measure]\label{thm:product-measure}
Let $\mu_1,\mu_2$ be $\sigma$-finite. There is a unique measure $\mu_1\otimes\mu_2$ on
$\calF_1\otimes\calF_2$ with $(\mu_1\otimes\mu_2)(A\times B)=\mu_1(A)\mu_2(B)$ for all
$A\in\calF_1$, $B\in\calF_2$. It is $\sigma$-finite, a probability if $\mu_1,\mu_2$ are, and
for every $E\in\calF_1\otimes\calF_2$
\begin{equation}\label{eq:product-measure}
(\mu_1\otimes\mu_2)(E)=\int\mu_2(E_x)\,\mu_1(\dd x)=\int\mu_1(E^y)\,\mu_2(\dd y) .
\end{equation}
\end{theorem}

\begin{proof}
\textbf{Step 1: two measures.} By Lemma~\ref{lem:section-measure} the integrands
in~\eqref{eq:product-measure} are non-negative measurable functions, so
$\pi_1(E)=\int\mu_2(E_x)\,\mu_1(\dd x)$ and $\pi_2(E)=\int\mu_1(E^y)\,\mu_2(\dd y)$ are
defined. $\pi_1(\emptyset)=0$. If $E_1,E_2,\ldots$ are pairwise disjoint with union $E$,
then for each $x$ the sections $(E_n)_x$ are pairwise disjoint with union $E_x$, so
$\mu_2(E_x)=\sum_n\mu_2((E_n)_x)$, and Corollary~\ref{cor:int-series}(i) gives
$\pi_1(E)=\sum_n\pi_1(E_n)$. So $\pi_1$ is a measure, and likewise $\pi_2$.

\textbf{Step 2: values on rectangles.} $\pi_1(A\times B)=\int\mu_2(B)\indc_A\,\dd\mu_1$. If
$\mu_2(B)<\infty$ this is $\mu_2(B)\mu_1(A)$ by Lemma~\ref{lem:int-mono}(iv). If
$\mu_2(B)=\infty$, the functions $n\indc_A$ increase to $\mu_2(B)\indc_A$, and
Theorem~\ref{thm:mct} gives $\lim_nn\mu_1(A)$, which is $0$ if $\mu_1(A)=0$ and $\infty$
otherwise, that is $\mu_1(A)\mu_2(B)$ under the conventions of
Definition~\ref{def:extended}. In the same way $\pi_2(A\times B)=\mu_1(A)\mu_2(B)$.

\textbf{Step 3: uniqueness and the equality $\pi_1=\pi_2$.} As in
Lemma~\ref{lem:section-measure}, Step 2, there are $A_n\uparrow\Omega_1$ and
$B_n\uparrow\Omega_2$ with $\mu_1(A_n),\mu_2(B_n)<\infty$. The rectangles $A_n\times B_n$
increase, have finite measure $\mu_1(A_n)\mu_2(B_n)$ under any measure taking the stated
values on rectangles, and their union is $\Omega_1\times\Omega_2$, since a point $(x,y)$
lies in $A_n\times B_n$ as soon as $x\in A_n$ and $y\in B_n$. By
Corollary~\ref{cor:measure-unique}, applied to the $\pi$-system of rectangles, any two measures
on $\calF_1\otimes\calF_2$ taking the values $\mu_1(A)\mu_2(B)$ on rectangles coincide. This
gives uniqueness and $\pi_1=\pi_2$, which is~\eqref{eq:product-measure}. The sets
$A_n\times B_n$ show $\sigma$-finiteness, and
$(\mu_1\otimes\mu_2)(\Omega_1\times\Omega_2)=\mu_1(\Omega_1)\mu_2(\Omega_2)$.
\end{proof}

\begin{theorem}[Fubini--Tonelli theorem]\label{thm:fubini}
Let $\mu_1,\mu_2$ be $\sigma$-finite and $\pi=\mu_1\otimes\mu_2$.
\begin{enumerate}[label=\textup{(\roman*)}]
\item \emph{Tonelli.} If $f:\Omega_1\times\Omega_2\to[0,\infty]$ is measurable, then
      $x\mapsto\int f(x,y)\,\mu_2(\dd y)$ is $\calF_1$-measurable,
      $y\mapsto\int f(x,y)\,\mu_1(\dd x)$ is $\calF_2$-measurable, and
      \[
      \int f\,\dd\pi=\int\Bigl[\int f(x,y)\,\mu_2(\dd y)\Bigr]\mu_1(\dd x)
      =\int\Bigl[\int f(x,y)\,\mu_1(\dd x)\Bigr]\mu_2(\dd y) .
      \]
\item \emph{Fubini.} If $f$ is measurable, real or complex, with $\int|f|\,\dd\pi<\infty$,
      then $y\mapsto f(x,y)$ is $\mu_2$-integrable for $x$ outside a $\mu_1$-null set $N_1$;
      $I_1(x)=\int f(x,y)\,\mu_2(\dd y)$ for $x\notin N_1$ and $I_1(x)=0$ for $x\in N_1$
      defines a $\mu_1$-integrable function; and $\int f\,\dd\pi=\int I_1\,\dd\mu_1$. The
      same holds with the roles of the coordinates exchanged, so both iterated integrals
      equal $\int f\,\dd\pi$.
\end{enumerate}
\end{theorem}

\begin{proof}
(i) \textbf{Step 1: indicators.} For $f=\indc_E$ with $E\in\calF_1\otimes\calF_2$,
$f(x,\cdot)=\indc_{E_x}$, so $\int f(x,y)\,\mu_2(\dd y)=\mu_2(E_x)$, measurable by
Lemma~\ref{lem:section-measure}, and its $\mu_1$-integral is $\pi(E)=\int f\,\dd\pi$ by
Theorem~\ref{thm:product-measure}. The other order is the same.

\textbf{Step 2: simple functions.} For simple $f=\sum_ia_i\indc_{E_i}$, the inner integral
is $\sum_ia_i\mu_2((E_i)_x)$ by Theorem~\ref{thm:int-additive}, measurable by
Proposition~\ref{prop:meas-closure}(iii); integrating in $x$ and using
Theorem~\ref{thm:int-additive} and Step~1 gives $\sum_ia_i\pi(E_i)=\int f\,\dd\pi$, by
Lemma~\ref{lem:int-simple}(i).

\textbf{Step 3: monotone limits.} For general $f\geqslant0$ take simple $s_n\uparrow f$
(Theorem~\ref{thm:simple-approx}). For each $x$, $s_n(x,\cdot)\uparrow f(x,\cdot)$, these
functions being measurable by Lemma~\ref{lem:sections}, so by Theorem~\ref{thm:mct}
\[
\int s_n(x,y)\,\mu_2(\dd y)\uparrow\int f(x,y)\,\mu_2(\dd y) .
\]
The inner integral of $f$ is thus an increasing limit of measurable functions (Step 2),
hence measurable by Proposition~\ref{prop:meas-closure}(ii). Applying Theorem~\ref{thm:mct}
in $x$, and also on $\Omega_1\times\Omega_2$ to $s_n\uparrow f$,
\[
\int\Bigl[\int f(x,y)\,\mu_2(\dd y)\Bigr]\mu_1(\dd x)
=\lim_n\int\Bigl[\int s_n(x,y)\,\mu_2(\dd y)\Bigr]\mu_1(\dd x)
=\lim_n\int s_n\,\dd\pi=\int f\,\dd\pi .
\]
The other order is the same.

(ii) \textbf{Step 1: the exceptional set.} By (i) applied to $|f|$,
$J(x)=\int|f(x,y)|\,\mu_2(\dd y)$ is measurable with $\int J\,\dd\mu_1=\int|f|\,\dd\pi<\infty$.
By Proposition~\ref{prop:null}(v), $N_1=\{J=\infty\}$ is a $\mu_1$-null set in $\calF_1$, and
for $x\notin N_1$ the function $f(x,\cdot)$, measurable by Lemma~\ref{lem:sections} applied
to the real and imaginary parts, is $\mu_2$-integrable.

\textbf{Step 2: real $f$.} Apply (i) to $f^+$ and $f^-$:
$h^\pm(x)=\int f^\pm(x,y)\,\mu_2(\dd y)$ are measurable, $h^\pm\leqslant J$, and
$\int h^\pm\,\dd\mu_1=\int f^\pm\,\dd\pi<\infty$. Off $N_1$ both are finite and
$I_1=h^+-h^-$; so $I_1=h^+\indc_{N_1^c}-h^-\indc_{N_1^c}$ is a difference of real
measurable functions, it is integrable as $|I_1|\leqslant h^++h^-$, and by
Theorem~\ref{thm:int-linear}(i) and Proposition~\ref{prop:null}(ii),(iii)
\[
\int I_1\,\dd\mu_1=\int h^+\,\dd\mu_1-\int h^-\,\dd\mu_1
=\int f^+\,\dd\pi-\int f^-\,\dd\pi=\int f\,\dd\pi .
\]

\textbf{Step 3: complex $f$.} The real and imaginary parts $u,v$ of $f$ satisfy
$|u|,|v|\leqslant|f|$, and the exceptional set of Step~1 for each of them is contained in
$N_1$. Applying Step~2 to $u$ and $v$, with $N_1$ as the exceptional set (enlarging a null
exceptional set changes no integral, by Proposition~\ref{prop:null}(iii)), and
Theorem~\ref{thm:int-linear}(i) gives the claim. Exchanging the coordinates gives the last
statement.
\end{proof}

\begin{corollary}[Finite products]\label{cor:finite-product}
Let $\mu_1,\ldots,\mu_k$ be $\sigma$-finite measures on $\calB(\Real^{d_1}),\ldots,
\calB(\Real^{d_k})$ and $d=d_1+\cdots+d_k$. There is a unique measure
$\mu_1\otimes\cdots\otimes\mu_k$ on $\calB(\Real^d)$ with
\[
(\mu_1\otimes\cdots\otimes\mu_k)(B_1\times\cdots\times B_k)=\prod_{i\leqslant k}\mu_i(B_i)
\qquad(B_i\in\calB(\Real^{d_i})) .
\]
It is $\sigma$-finite, a probability if every $\mu_i$ is, and for $k\geqslant2$ it is
$(\mu_1\otimes\cdots\otimes\mu_{k-1})\otimes\mu_k$.
\end{corollary}

\begin{proof}
\textbf{Existence,} by induction on $k$, the case $k=1$ being trivial. If
$\nu=\mu_1\otimes\cdots\otimes\mu_{k-1}$ exists on $\calB(\Real^{d-d_k})$ and is
$\sigma$-finite, then Lemma~\ref{lem:borel-product} identifies
$\calB(\Real^{d-d_k})\otimes\calB(\Real^{d_k})$ with $\calB(\Real^d)$, and
Theorem~\ref{thm:product-measure} gives the $\sigma$-finite measure $\nu\otimes\mu_k$ on
it, with $(\nu\otimes\mu_k)(B_1\times\cdots\times B_k)
=\nu(B_1\times\cdots\times B_{k-1})\mu_k(B_k)=\prod_i\mu_i(B_i)$; it is a probability if
$\nu$ and $\mu_k$ are.

\textbf{Uniqueness.} The sets $B_1\times\cdots\times B_k$ form a $\pi$-system, as
intersections are taken coordinatewise. It generates $\calB(\Real^d)$: it contains the
half-open boxes of $\Real^d$, which generate $\calB(\Real^d)$ by
Lemma~\ref{lem:borel-gen}(ii); and each $B_1\times\cdots\times B_k$ is the intersection of
the sets $p_i^{-1}(B_i)$, with $p_i$ the continuous projection onto the $i$-th block of
coordinates, which are Borel by Lemma~\ref{lem:meas-criteria}(iii). Taking
$C_n^{(i)}\uparrow\Real^{d_i}$ with $\mu_i(C_n^{(i)})<\infty$, as in
Lemma~\ref{lem:section-measure}, the sets $C_n^{(1)}\times\cdots\times C_n^{(k)}$ increase to
$\Real^d$ and have finite measure, so Corollary~\ref{cor:measure-unique} applies.
\end{proof}

\begin{remark}[Assumed facts]\label{rem:assumed}
Besides the elementary calculus and linear algebra of Remark~\ref{rem:elementary}, one fact of
calculus in several variables is taken as known: a function whose partial derivatives up to
order two exist and are continuous on an open subset of $\Real^p$ (a \emph{twice continuously
differentiable} function) is differentiable there in the sense of
Definition~\ref{def:differential}, so is its gradient, and its matrix of second partial
derivatives is symmetric. The following measure-theoretic facts are used without proof,
except (a) and (b), which have been proved:
\begin{enumerate}[label=\textup{(\alph*)}]
\item square-integrable random variables form a complete space: Theorem~\ref{thm:L2-complete};
\item two probability measures that agree on a $\pi$-system agree on the $\sigma$-field it
      generates: Theorem~\ref{thm:pi-lambda} and Corollary~\ref{cor:measure-unique};
\item product probability measures exist for countably many factors (for finitely many
      $\sigma$-finite factors this is Corollary~\ref{cor:finite-product}); Lebesgue measure
      $\lambda$ on $\calB(\Real)$, the measure with $\lambda((a,b])=b-a$ for $a<b$, exists
      (it is unique by Corollary~\ref{cor:measure-unique} applied to the $\pi$-system of these
      intervals and $\emptyset$, which generates $\calB(\Real)$ by
      Lemma~\ref{lem:borel-gen}(ii), with $\Omega_n=(-n,n]$), and Lebesgue measure on
      $\Real^d$ is its $d$-fold product, $\lambda$ being $\sigma$-finite; $\int g(x)\,\dd x$ denotes
      $\int g\,\dd\lambda$, and for continuous $g$ on $[a,b]$, $\int_{[a,b]}g\,\dd\lambda$ is
      the Riemann integral of calculus; a \emph{density} with respect to a measure $\mu$ on
      $\calB(\Real^d)$ is a Borel $f\geqslant0$ with $\int f\,\dd\mu=1$, and a random vector
      $X$ in $\Real^d$ \emph{has density} $f$ if $\prb\{X\in B\}=\int_Bf\,\dd\mu$ for every
      $B\in\calB(\Real^d)$ (this is a definition, not an assumption; $B\mapsto\int_Bf\,\dd\mu$
      is a measure by Corollary~\ref{cor:int-series}(ii)); with no measure named, $\mu$ is
      Lebesgue measure;
\item a \emph{standard normal} variable is one with density
      $\phi(x)=(2\pi)^{-1/2}e^{-x^2/2}$, and $\int\phi=1$, $\int x^2\phi(x)\,\dd x=1$;
\item if $Z$ has density $f$ on $\Real$ and $a\neq0$, then $aZ+b$ has density
      $|a|^{-1}f\bigl((x-b)/a\bigr)$;
\item for a Borel map $g$, the set of points where $g$ is discontinuous is a Borel set;
\item if $F(\omega,t)$ is real, measurable in $\omega$ for each $t$ and continuous in $t$ for
      each $\omega$, with $t$ ranging over a compact $K\subseteq\Real^k$, then a point of $K$
      at which $F(\omega,\cdot)$ attains its maximum, and a zero of $F(\omega,\cdot)$ on the
      event that one exists, can be chosen as measurable functions of $\omega$ (measurable
      selection).
\end{enumerate}
\end{remark}

\begin{lemma}[Integration against a density]\label{lem:density-int}
Let $X$ be a random vector in $\Real^d$ with density $f$ with respect to a measure $\mu$ on
$\calB(\Real^d)$. For Borel $g:\Real^d\to[0,\infty]$,
\[
\expc[g(X)]=\int gf\,\dd\mu .
\]
For real or complex Borel $g$, $\expc|g(X)|=\int|g|f\,\dd\mu$, and when this is finite,
$\expc[g(X)]=\int gf\,\dd\mu$.
\end{lemma}

\begin{proof}
By Theorem~\ref{thm:change-var}, $\expc[g(X)]=\int g\,\dd\mu_X$ for Borel $g\geqslant0$, so for
such $g$ it suffices to show $\int g\,\dd\mu_X=\int gf\,\dd\mu$. The function $gf$ is
non-negative and measurable by Proposition~\ref{prop:meas-closure}(iii).

\emph{Indicators.} For $B\in\calB(\Real^d)$, Lemma~\ref{lem:int-mono}(iv) gives
$\int\indc_B\,\dd\mu_X=\mu_X(B)=\prb\{X\in B\}$, and $\int\indc_Bf\,\dd\mu=\int_Bf\,\dd\mu$ by
Definition~\ref{def:int-nonneg}. The two are equal by the definition of a density in
Remark~\ref{rem:assumed}(c).

\emph{Simple functions.} Let $s=\sum_{i\leqslant k}a_i\indc_{B_i}$ with $a_i\in[0,\infty)$ and
$B_i\in\calB(\Real^d)$. By Lemma~\ref{lem:int-simple}(i) and the indicator case,
\[
\int s\,\dd\mu_X=\sum_{i\leqslant k}a_i\mu_X(B_i)=\sum_{i\leqslant k}a_i\int\indc_{B_i}f\,\dd\mu .
\]
By Lemma~\ref{lem:int-mono}(iii), $a_i\int\indc_{B_i}f\,\dd\mu=\int a_i\indc_{B_i}f\,\dd\mu$, and
by Corollary~\ref{cor:int-series}(i), applied to the functions $a_i\indc_{B_i}f$ for
$i\leqslant k$ and $0$ for $i>k$, the sum of these integrals is
$\int\sum_{i\leqslant k}a_i\indc_{B_i}f\,\dd\mu=\int sf\,\dd\mu$.

\emph{Non-negative functions.} For Borel $g:\Real^d\to[0,\infty]$, let $s_n$ be the simple
functions of Theorem~\ref{thm:simple-approx}, so that $0\leqslant s_1\leqslant s_2\leqslant\cdots$
and $s_n\to g$ pointwise. Then each $s_nf$ is non-negative and measurable, and $s_nf\uparrow gf$
pointwise. Where $f(x)>0$, this is $s_n(x)\uparrow g(x)$ multiplied by $f(x)$, with
$s_n(x)f(x)\to\infty$ when $g(x)=\infty$. Where $f(x)=0$, every $s_n(x)f(x)$ and $g(x)f(x)$
are $0$, by the convention $0\cdot\infty=0$ of Definition~\ref{def:extended}.
Theorem~\ref{thm:mct}, applied on both sides, and the simple case give
\[
\int g\,\dd\mu_X=\lim_n\int s_n\,\dd\mu_X=\lim_n\int s_nf\,\dd\mu=\int gf\,\dd\mu .
\]

\emph{Real and complex functions.} For Borel real or complex $g$, $|g|$ is Borel and
non-negative, so the case just proved gives $\expc|g(X)|=\int|g|f\,\dd\mu$. Suppose this is
finite. For real $g$, the non-negative case applied to $g^+$ and $g^-$ gives
$\expc[g^\pm(X)]=\int g^\pm f\,\dd\mu$, and all four quantities are finite since
$g^\pm\leqslant|g|$. Since $f\geqslant0$, $(gf)^\pm=g^\pm f$, and $(g\circ X)^\pm=g^\pm\circ X$.
Subtracting therefore gives $\expc[g(X)]=\int gf\,\dd\mu$, by Definition~\ref{def:integrable}.
For complex $g=u+iv$, apply the real case to $u$ and $v$, which satisfy $|u|,|v|\leqslant|g|$.
\end{proof}

%==============================================================================
\section{Expectation and Inequalities}\label{sec:P.14}
%==============================================================================

\begin{theorem}[Markov, Chebyshev]\label{thm:markov}
For a random variable $X\geqslant0$ and $a>0$, $\prb\{X\geqslant a\}\leqslant\expc[X]/a$.
Consequently $\prb\{|Y-\expc Y|\geqslant a\}\leqslant\var(Y)/a^2$.
\end{theorem}

\begin{proof}
$a\,\indc\{X\geqslant a\}\leqslant X$ pointwise (at points with $X\geqslant a$ the left
side is $a\leqslant X$, elsewhere it is $0\leqslant X$). Taking expectations,
Lemma~\ref{lem:int-mono}(ii),(iv) give $a\prb\{X\geqslant a\}\leqslant\expc[X]$; divide by
$a>0$. For the second, $\{|Y-\expc Y|\geqslant a\}=\{(Y-\expc Y)^2\geqslant a^2\}$, so apply
the first to $X=(Y-\expc Y)^2$, whose expectation is $\var(Y)$, at the level $a^2$.
\end{proof}

\begin{theorem}[Jensen]\label{thm:jensen}
If $\phi$ is convex on an open interval containing the range of an integrable $X$, then
$\phi(\expc X)\leqslant\expc[\phi(X)]$.
\end{theorem}

\begin{proof}
Let $I$ be the open interval and $m=\expc X$, which lies in $I$: if, say, $I=(\alpha,\beta)$
with $\beta<\infty$ and $m\geqslant\beta$, then $\beta-X>0$ everywhere, so
$\expc[\beta-X]\geqslant0$, while $\expc[\beta-X]=\beta-m\leqslant0$; hence
$\expc[\beta-X]=0$, and Proposition~\ref{prop:null}(iv) forces $\beta-X=0$ almost surely,
contradicting $\beta-X>0$ as $\prb(\Omega)=1$. The same argument applied to $X-\alpha$ gives $m>\alpha$ when $\alpha>-\infty$.

\textbf{Step 1: slopes.} For $x<m<y$ in $I$ write $m=\lambda x+(1-\lambda)y$ with
$\lambda=(y-m)/(y-x)\in(0,1)$. Convexity gives $\phi(m)\leqslant\lambda\phi(x)+(1-\lambda)\phi(y)$,
that is $\lambda\{\phi(m)-\phi(x)\}\leqslant(1-\lambda)\{\phi(y)-\phi(m)\}$, and since
$\lambda/(1-\lambda)=(y-m)/(m-x)$,
\begin{equation}\label{eq:jensen-slopes}
\frac{\phi(m)-\phi(x)}{m-x}\leqslant\frac{\phi(y)-\phi(m)}{y-m}\qquad(x<m<y) .
\end{equation}
The argument of Lemma~\ref{lem:dirderiv}, which uses convexity only on the segment involved,
shows that the right slope $\{\phi(y)-\phi(m)\}/(y-m)$ is non-decreasing in $y>m$, and, applied
to $t\mapsto\phi(m-t)$, that the left slope $\{\phi(m)-\phi(x)\}/(m-x)$ is non-decreasing in
$x<m$.

\textbf{Step 2: one-sided derivatives and a supporting line.} As $y\downarrow m$ the right
slopes decrease and are bounded below by any fixed left slope, by~\eqref{eq:jensen-slopes};
so (as in the proof of Lemma~\ref{lem:dirderiv}) they converge to their infimum
$\phi'_+(m)$, which is finite. As $x\uparrow m$ the left slopes increase and are bounded above
by any right slope, so they converge to their supremum $\phi'_-(m)$, also finite. Passing to
the limits in~\eqref{eq:jensen-slopes}, $\phi'_-(m)\leqslant\phi'_+(m)$. For
$c\in[\phi'_-(m),\phi'_+(m)]$, $\{\phi(y)-\phi(m)\}/(y-m)\geqslant\phi'_+(m)\geqslant c$ for
$y>m$ and $\{\phi(m)-\phi(x)\}/(m-x)\leqslant\phi'_-(m)\leqslant c$ for $x<m$; multiplying by
$y-m>0$, respectively $m-x>0$, both rearrange to
\begin{equation}\label{eq:jensen-support}
\phi(x)\geqslant\phi(m)+c(x-m)\qquad\text{for all }x\in I .
\end{equation}
In the differentiable case this is Proposition~\ref{prop:convex-fo}, with $c=\phi'(m)$.

\textbf{Step 3: measurability of $\phi(X)$.} The same construction at any point $z\in I$
shows $\phi$ is continuous at $z$: for $z<y<y_0$ in $I$, Step 1 at $z$ gives
$\phi'_+(z)(y-z)\leqslant\phi(y)-\phi(z)\leqslant\frac{\phi(y_0)-\phi(z)}{y_0-z}(y-z)$, so
$\phi(y)\to\phi(z)$ as $y\downarrow z$, and symmetrically as $y\uparrow z$. Hence for real $a$
the set $U_a=\{x\in I:\phi(x)>a\}$ is open (each of its points has a neighbourhood in $I$ on
which $\phi>a$), so $\{\phi(X)>a\}=X^{-1}(U_a)\in\calF$, and $\phi(X)$ is measurable by
Lemma~\ref{lem:meas-criteria}(ii).

\textbf{Step 4: expectations.} By~\eqref{eq:jensen-support} at $x=X$,
$\phi(X)\geqslant\phi(m)+c(X-m)$, whose right side is integrable. So
$\phi(X)^-\leqslant|\phi(m)|+|c|\,|X-m|$ is integrable and $\expc[\phi(X)]$ exists in
$(-\infty,\infty]$. If it is $\infty$ there is nothing to prove; otherwise $\phi(X)$ is
integrable, and Theorem~\ref{thm:int-linear}(i),(ii) give
$\expc[\phi(X)]\geqslant\phi(m)+c(\expc X-m)=\phi(m)$: taking expectations kills the linear
term.
\end{proof}

\begin{proposition}[Variance under a linear map]\label{prop:var-linear}
If $\bz$ has covariance $\var(\bz)$, and $\bA$, $\mathbf{b}$ are constant, then
$\var(\bA\bz+\mathbf{b})=\bA\var(\bz)\bA'$.
\end{proposition}

\begin{proof}
With $\bmu=\expc[\bz]$, linearity of the expectation applied to each coordinate
(Theorem~\ref{thm:int-linear}(i)) gives $\expc[\bA\bz+\mathbf{b}]=\bA\bmu+\mathbf{b}$, so
$\bA\bz+\mathbf{b}-\expc[\bA\bz+\mathbf{b}]=\bA(\bz-\bmu)$. Each entry of
$\bA(\bz-\bmu)(\bz-\bmu)'\bA'$ is the fixed linear combination
$\sum_{k,l}a_{ik}a_{jl}(z_k-\mu_k)(z_l-\mu_l)$ of integrable products, so linearity again gives
\[
\var(\bA\bz+\mathbf{b})
= \expc\bigl[\bA(\bz-\bmu)(\bz-\bmu)'\bA'\bigr]
= \bA\,\expc[(\bz-\bmu)(\bz-\bmu)']\,\bA' . \qedhere
\]
\end{proof}

\begin{lemma}[Expectation of a quadratic form]\label{lem:quadratic-form}
If $\expc[\bz]=\bmu$ and $\var(\bz)=\bSig$, and $\bA$ is a constant square matrix, then
$\expc[\bz'\bA\bz]=\tr(\bA\bSig)+\bmu'\bA\bmu$.
\end{lemma}

\begin{proof}
$\bz'\bA\bz=\sum_{i,j}a_{ij}z_iz_j$, each $z_iz_j$ being integrable as the second moments
are finite (Lemma~\ref{lem:minkowski}), so by linearity
(Theorem~\ref{thm:int-linear}(i)) $\expc[\bz'\bA\bz]=\sum_{i,j}a_{ij}\expc[z_iz_j]$; and
$\Sigma_{ij}=\cov(z_i,z_j)=\expc[(z_i-\mu_i)(z_j-\mu_j)]=\expc[z_iz_j]-\mu_i\mu_j$, so
$\expc[z_iz_j]=\Sigma_{ij}+\mu_i\mu_j$. The first part is
$\sum_{i,j}a_{ij}\Sigma_{ij}=\sum_i\sum_ja_{ij}\Sigma_{ji}=\sum_i(\bA\bSig)_{ii}=\tr(\bA\bSig)$
by symmetry of $\bSig$, and the second is $\sum_{i,j}\mu_ia_{ij}\mu_j=\bmu'\bA\bmu$.
\end{proof}

%==============================================================================
\section{Independence and Borel--Cantelli}\label{sec:P.15}
%==============================================================================

\begin{definition}[Independence]\label{def:indep}
Random vectors $X_1,\ldots,X_k$ on one probability space are \emph{independent} if
$\prb\{X_1\in B_1,\ldots,X_k\in B_k\}=\prod_{i\leqslant k}\prb\{X_i\in B_i\}$ for all Borel
sets $B_1,\ldots,B_k$; equivalently, by Corollary~\ref{cor:finite-product}, their joint
law is the product measure $\mu_{X_1}\otimes\cdots\otimes\mu_{X_k}$. An infinite family is
independent if every finite subfamily is, and \emph{independent of} $N$ means that $N$ and
each finite subfamily, taken together, are independent.
\end{definition}

\begin{lemma}[Disjoint functions of independent variables]\label{lem:disjoint-fn}
Let $\varepsilon_1,\ldots,\varepsilon_N$ be independent, let $U,V$ be disjoint subsets of
$\{1,\ldots,N\}$ and let $f,g$ be measurable functions of $(\varepsilon_u)_{u\in U}$ and
$(\varepsilon_v)_{v\in V}$ respectively. Then $f$ and $g$ are independent, and if both are
integrable then so is $fg$, with $\expc[fg]=\expc[f]\expc[g]$.
\end{lemma}

\begin{proof}
Write $\varepsilon_U=(\varepsilon_u)_{u\in U}$, $\varepsilon_V=(\varepsilon_v)_{v\in V}$, and
$f=\tilde f(\varepsilon_U)$, $g=\tilde g(\varepsilon_V)$ with $\tilde f,\tilde g$ Borel; let
$\mu_U$, $\mu_V$ be the laws of $\varepsilon_U$, $\varepsilon_V$.

\textbf{Step 1: the joint law of the two blocks is $\mu_U\otimes\mu_V$.} The subfamilies
$(\varepsilon_u)_{u\in U}$, $(\varepsilon_v)_{v\in V}$ and $(\varepsilon_u)_{u\in U\cup V}$ are
independent (Definition~\ref{def:indep}, taking $B_i=\Real^{d_i}$ for the indices left out),
so by Corollary~\ref{cor:finite-product} $\mu_U$, $\mu_V$ and the law $\mu_{U\cup V}$ of
$(\varepsilon_U,\varepsilon_V)$ are the products of the laws $\mu_{\varepsilon_i}$ over
$U$, $V$ and $U\cup V$. For product sets $B_U\times B_V$ with
$B_U=\prod_{u\in U}B_u$, $B_V=\prod_{v\in V}B_v$,
\[
\mu_{U\cup V}(B_U\times B_V)=\prod_{i\in U\cup V}\mu_{\varepsilon_i}(B_i)
=\mu_U(B_U)\,\mu_V(B_V)=(\mu_U\otimes\mu_V)(B_U\times B_V) .
\]
These sets form a $\pi$-system generating the Borel sets, so the uniqueness part of
Corollary~\ref{cor:finite-product} gives $\mu_{U\cup V}=\mu_U\otimes\mu_V$.

\textbf{Step 2: independence.} For Borel sets $A,B$, Theorem~\ref{thm:change-var} with
$T=(\varepsilon_U,\varepsilon_V)$ and Step~1, then the Fubini--Tonelli theorem
(Theorem~\ref{thm:fubini}(i)), give
\begin{align*}
\prb\{f\in A,\ g\in B\}
&=\iint \indc\{\tilde f(x)\in A\}\,\indc\{\tilde g(y)\in B\}\,\dd\mu_U(x)\,\dd\mu_V(y)\\
&=\mu_U\{\tilde f\in A\}\,\mu_V\{\tilde g\in B\}=\prb\{f\in A\}\,\prb\{g\in B\} ,
\end{align*}
the inner integral in $x$ being $\mu_U\{\tilde f\in A\}\indc\{\tilde g(y)\in B\}$ by
Lemma~\ref{lem:int-mono}(iv), and the last step being Theorem~\ref{thm:change-var} again.

\textbf{Step 3: moments.} In the same way, by Theorem~\ref{thm:change-var}, Step~1 and
Theorem~\ref{thm:fubini}(i) applied to the non-negative $|\tilde f(x)\tilde g(y)|$,
\begin{align*}
\expc|fg|&=\iint|\tilde f(x)|\,|\tilde g(y)|\,\dd\mu_U(x)\,\dd\mu_V(y)\\
&=\int|\tilde f|\,\dd\mu_U\int|\tilde g|\,\dd\mu_V=\expc|f|\,\expc|g|<\infty ,
\end{align*}
the inner integral being $|\tilde g(y)|\int|\tilde f|\,\dd\mu_U$ by Lemma~\ref{lem:int-mono}(iii).
So $fg$ is integrable, and Theorem~\ref{thm:fubini}(ii) applied to $\tilde f(x)\tilde g(y)$,
with the inner integral $\tilde g(y)\int\tilde f\,\dd\mu_U$ by
Theorem~\ref{thm:int-linear}(i), gives $\expc[fg]=\expc[f]\,\expc[g]$.
\end{proof}

\begin{lemma}[Borel--Cantelli]\label{lem:BC}
If $\sum_k\prb(A_k)<\infty$ then $\prb\{A_k\text{ infinitely often}\}=0$.
\end{lemma}

\begin{proof}
Let $N=\sum_k\indc_{A_k}$, a measurable function with values in $[0,\infty]$ counting the
$A_k$ that contain $\omega$; so $\{A_k\text{ infinitely often}\}=\{N=\infty\}$. By
Corollary~\ref{cor:int-series}(i) and Lemma~\ref{lem:int-mono}(iv),
$\expc[N]=\sum_k\prb(A_k)<\infty$, so $\prb\{N=\infty\}=0$ by Proposition~\ref{prop:null}(v).
\end{proof}

%==============================================================================
\section{Conditional Expectation}\label{sec:P.16}
%==============================================================================

\begin{definition}[$L^2$ and its inner product]\label{def:L2}
$L^2(\Omega,\calF,\prb)$ is the space of random variables with $\expc[X^2]<\infty$,
with $\langle X,Y\rangle=\expc[XY]$, variables equal almost surely being identified.
\end{definition}

\begin{theorem}[Conditional expectation in $L^2$]\label{thm:condexp}
Let $\calG\subseteq\calF$ be a sub-$\sigma$-field and $X\in L^2(\calF)$. There is a
$\calG$-measurable $\expc[X\mid\calG]\in L^2(\calG)$, unique up to null sets, with
\begin{equation}\label{eq:condexp}
\expc\bigl[(X-\expc[X\mid\calG])\,W\bigr]=0 \qquad\text{for every }W\in L^2(\calG) ,
\end{equation}
and it minimises $\expc[(X-W)^2]$ over $W\in L^2(\calG)$.
\end{theorem}

\begin{proof}
Write $\|Y\|=(\expc Y^2)^{1/2}$. By Lemma~\ref{lem:minkowski}, $L^2(\calF)$ is closed under
sums and scalar multiples, $\langle Y,Z\rangle=\expc[YZ]$ is finite, bilinear and symmetric,
and $\|Y+Z\|\leqslant\|Y\|+\|Z\|$; so $L^2(\calG)$, the $\calG$-measurable members, is a
subspace, in particular convex and non-empty.

\textbf{Step 1: $L^2(\calG)$ is closed.} Let $Y_n\in L^2(\calG)$ and $Y\in L^2(\calF)$ with
$\expc|Y_n-Y|^2\to0$. Choose $n_1<n_2<\cdots$ with $\expc|Y_{n_k}-Y|^2\leqslant8^{-k}$; by
Theorem~\ref{thm:markov}, $\prb\{|Y_{n_k}-Y|>2^{-k}\}\leqslant4^k\,8^{-k}=2^{-k}$, so by
Lemma~\ref{lem:BC} almost surely $|Y_{n_k}-Y|\leqslant2^{-k}$ for all large $k$, and
$Y_{n_k}\to Y$ almost surely. The function $Y'=\limsup_kY_{n_k}$ where this is finite, and
$0$ elsewhere, is $\calG$-measurable by Proposition~\ref{prop:meas-closure}(ii) and
Lemma~\ref{lem:meas-criteria}(ii), and $Y'=Y$ almost surely; so $Y$, as an element of $L^2$
(variables equal almost surely being identified), lies in $L^2(\calG)$.

\textbf{Step 2: a nearest point.} Let $\delta=\inf\{\|X-W\|:W\in L^2(\calG)\}$ and choose
$W_n\in L^2(\calG)$ with $\|X-W_n\|\to\delta$. The parallelogram law
$\|A-B\|^2=2\|A\|^2+2\|B\|^2-\|A+B\|^2$ holds in $L^2$ (expand both sides with the
bilinearity of $\langle\cdot,\cdot\rangle$), and with $A=X-W_m$, $B=X-W_n$ and
$\tfrac12(W_n+W_m)\in L^2(\calG)$ it gives, exactly as in the proof of
Theorem~\ref{thm:nearest}, $\|W_n-W_m\|^2\leqslant2\|X-W_n\|^2+2\|X-W_m\|^2-4\delta^2$, which
is small for large $m,n$. By Theorem~\ref{thm:L2-complete} there is $\hat X\in L^2(\calF)$ with
$\|W_n-\hat X\|\to0$; by Step 1, $\hat X\in L^2(\calG)$; and
$\delta\leqslant\|X-\hat X\|\leqslant\|X-W_n\|+\|W_n-\hat X\|\to\delta$, so $\hat X$ minimises
$\|X-W\|$, equivalently $\expc[(X-W)^2]$, over $W\in L^2(\calG)$.

\textbf{Step 3: the orthogonality~\eqref{eq:condexp}.} For $W\in L^2(\calG)$ and real $t$,
$\hat X+tW\in L^2(\calG)$, so
\[
\|X-\hat X\|^2\leqslant\|X-\hat X-tW\|^2=\|X-\hat X\|^2-2t\langle X-\hat X,W\rangle+t^2\|W\|^2 .
\]
Hence $2t\langle X-\hat X,W\rangle\leqslant t^2\|W\|^2$ for every real $t$. Dividing by $t>0$
and letting $t\downarrow0$ gives $\langle X-\hat X,W\rangle\leqslant0$; dividing by $t<0$ and
letting $t\uparrow0$ gives $\langle X-\hat X,W\rangle\geqslant0$. So
$\expc[(X-\hat X)W]=0$, which is~\eqref{eq:condexp} with $\expc[X\mid\calG]=\hat X$.

\textbf{Step 4: uniqueness.} If $Y\in L^2(\calG)$ also satisfies~\eqref{eq:condexp}, then
subtracting the two identities gives $\expc[(\hat X-Y)W]=0$ for every $W\in L^2(\calG)$, and
$W=\hat X-Y$ gives $\expc[(\hat X-Y)^2]=0$, so $\hat X=Y$ almost surely by
Proposition~\ref{prop:null}(iv). In particular every minimiser, which satisfies~\eqref{eq:condexp}
by the argument of Step 3, equals $\hat X$ almost surely.
\end{proof}

\begin{remark}
Taking $W=\indc_G$ for $G\in\calG$ turns~\eqref{eq:condexp} into the familiar
$\expc[X\indc_G]=\expc[\expc[X\mid\calG]\indc_G]$.
\end{remark}

\begin{lemma}[Conditional expectation in $L^1$]\label{lem:condexp-L1}
For integrable $X$ there is an integrable $\calG$-measurable $\expc[X\mid\calG]$, unique up to
null sets, with $\expc[XW]=\expc\bigl[\expc[X\mid\calG]\,W\bigr]$ for every bounded
$\calG$-measurable $W$. For $X\in L^2$ it is the variable of Theorem~\ref{thm:condexp}, and
$X\geqslant0$ implies $\expc[X\mid\calG]\geqslant0$.
\end{lemma}

\begin{proof}
\emph{Positivity in $L^2$.} For $X\in L^2$ with $X\geqslant0$ put $\hat X=\expc[X\mid\calG]$
and $W=\max(-\hat X,0)\in L^2(\calG)$. By~\eqref{eq:condexp},
$-\expc[W^2]=\expc[\hat XW]=\expc[XW]\geqslant0$, so $W=0$ and $\hat X\geqslant0$. Since
\eqref{eq:condexp} is linear in $X$, uniqueness in Theorem~\ref{thm:condexp} makes
$X\mapsto\expc[X\mid\calG]$ linear on $L^2$: $a\expc[X\mid\calG]+b\expc[X'\mid\calG]$
is $\calG$-measurable, in $L^2$, and satisfies~\eqref{eq:condexp} for $aX+bX'$. Hence it is
monotone: if $X\leqslant X'$ then $\expc[X'\mid\calG]-\expc[X\mid\calG]=\expc[X'-X\mid\calG]\geqslant0$
almost surely by positivity.

\emph{Existence.} Let $X\geqslant0$ be integrable. The bounded variables $X\wedge m$
increase in $m$, so by monotonicity $Y_m=\expc[X\wedge m\mid\calG]$ increase almost surely
to a $\calG$-measurable limit $Y$ with values in $[0,\infty]$. For bounded $\calG$-measurable
$W\geqslant0$, after redefining every $Y_m$ (and $Y$) as $0$ on the $\calG$-measurable null set
$\bigcup_m\{Y_m<0\}\cup\{Y_m>Y_{m+1}\}$, which changes no $\expc[Y_mW]$
(Theorem~\ref{thm:int-linear}(iv)),
monotone convergence (Theorem~\ref{thm:mct}) on both sides of $\expc[(X\wedge m)W]=\expc[Y_mW]$
(an identity from Theorem~\ref{thm:condexp}, as $X\wedge m$ is bounded, hence in $L^2$, and
$W\in L^2(\calG)$), applied to $(X\wedge m)W\uparrow XW$ and $Y_mW\uparrow YW$, gives
$\expc[XW]=\expc[YW]$; with $W\equiv1$, $\expc Y=\expc X<\infty$, so $Y$ is finite almost
surely (Proposition~\ref{prop:null}(v)) and integrable; redefine it as $0$ where it is
infinite. A general bounded $W$ is $W^+-W^-$ with $W^\pm$ bounded, non-negative and
$\calG$-measurable, and subtracting the two finite identities for $W^+$ and $W^-$ gives
$\expc[XW]=\expc[YW]$. For general integrable $X$ apply this to $X^+$ and $X^-$, obtaining
$Y^{(+)}$ and $Y^{(-)}$, and take $\expc[X\mid\calG]=Y^{(+)}-Y^{(-)}$; subtracting the
identities and using Theorem~\ref{thm:int-linear}(i) gives the defining identity.

\emph{Uniqueness.} If $Y$ and $Y'$ both qualify, $W=\indc\{Y>Y'\}$ gives
$\expc[(Y-Y')W]=0$ with $(Y-Y')W\geqslant0$, so $Y\leqslant Y'$ almost surely, and
symmetrically. For $X\in L^2$ the variable of Theorem~\ref{thm:condexp} is integrable, as
$|x|\leqslant1+x^2$, and satisfies the identity, bounded $W$ being in $L^2(\calG)$; so the two
agree. Positivity for $X\geqslant0$ is built into the construction.
\end{proof}

\begin{proposition}[Tower property]\label{prop:tower}
For integrable $X$, $\expc\bigl[\expc[X\mid\calG]\bigr]=\expc[X]$.
\end{proposition}

\begin{proof}
Take $W\equiv1$ in Lemma~\ref{lem:condexp-L1}.
\end{proof}

\begin{proposition}[Conditional variance decomposition]\label{prop:condvar}
For $X\in L^2$, writing $\var(X\mid\calG)=\expc[X^2\mid\calG]-(\expc[X\mid\calG])^2$, with
$\expc[X^2\mid\calG]$ that of Lemma~\ref{lem:condexp-L1},
\begin{equation}\label{eq:condvar}
\var(X) = \expc\bigl[\var(X\mid\calG)\bigr] + \var\bigl(\expc[X\mid\calG]\bigr) .
\end{equation}
\end{proposition}

\begin{proof}
By Lemma~\ref{lem:condexp-L1} with $W\equiv1$ applied to $X^2$, and
Proposition~\ref{prop:tower} applied to $X$,
\[
\var(X)=\expc[X^2]-(\expc X)^2
=\expc\bigl[\expc[X^2\mid\calG]\bigr]-\bigl(\expc\bigl[\expc[X\mid\calG]\bigr]\bigr)^2 .
\]
Substituting $\expc[X^2\mid\calG]=\var(X\mid\calG)+(\expc[X\mid\calG])^2$, where both
terms on the right are integrable ($\expc[X\mid\calG]\in L^2$ by
Theorem~\ref{thm:condexp}, and $\var(X\mid\calG)$ is a difference of integrable
variables), splitting the expectation by Theorem~\ref{thm:int-linear}(i), and recognising
$\expc[(\expc[X\mid\calG])^2]-(\expc[\expc[X\mid\calG]])^2$ as
$\var(\expc[X\mid\calG])$ gives~\eqref{eq:condvar}.
\end{proof}

\begin{corollary}[Random sums]\label{cor:random-sum}
Let $N$ be a non-negative integer random variable with $\expc[N^2]<\infty$ and
$Y_1,Y_2,\ldots$ independent copies of
a square-integrable $Y$, independent of $N$, and $S=\sum_{j\leqslant N}Y_j$. Then
\[
\expc[S]=\expc[N]\,\expc[Y] ,
\qquad
\var(S)=\expc[N]\var(Y)+\var(N)(\expc Y)^2 .
\]
\end{corollary}

\begin{proof}
Write $\expc[\cdot\mid N]=\expc[\cdot\mid\sigma(N)]$, and $S_m=\sum_{j\leqslant m}Y_j$, so that
$S=S_m$ on $\{N=m\}$.

\textbf{Step 1: the test functions.} A bounded $\sigma(N)$-measurable $W$ is constant on each
event $\{N=m\}$: if $\omega,\omega'\in\{N=m\}$, the set $\{W=W(\omega)\}$ lies in $\sigma(N)$,
whose members are the sets $\{N\in B\}$ with $B$ Borel (these form a $\sigma$-field containing
the generators of $\sigma(N)$), so it equals some $\{N\in B\}$; it contains $\omega$, so
$m\in B$, so it contains $\omega'$. Hence $W=w(N)$ with $w(m)$ the value on $\{N=m\}$, and
$|w|\leqslant c:=\sup|W|$.

\textbf{Step 2: moments of $S_m$ on $\{N=m\}$.} The variables $N,Y_1,\ldots,Y_m$ are
independent, so by Lemma~\ref{lem:disjoint-fn} $\indc\{N=m\}$ is independent of $S_m$ and of
$S_m^2$, with $\expc[S_m\indc\{N=m\}]=\expc[S_m]\prb\{N=m\}$ and likewise for $S_m^2$ and
$|S_m|$. By linearity $\expc S_m=m\expc Y$ and $\expc|S_m|\leqslant m\expc|Y|$, and, as
$\expc[Y_iY_j]=(\expc Y)^2$ for $i\neq j$ by Lemma~\ref{lem:disjoint-fn},
\[
\expc S_m^2=\sum_i\expc Y_i^2+\sum_{i\neq j}\expc[Y_iY_j]=m\expc[Y^2]+m(m-1)(\expc Y)^2
=m\var(Y)+m^2(\expc Y)^2 .
\]

\textbf{Step 3: summing over $m$.} Pointwise $S\,w(N)=\sum_m w(m)S_m\indc\{N=m\}$ and
$S^2w(N)=\sum_mw(m)S_m^2\indc\{N=m\}$, only one term being nonzero at each $\omega$. The
partial sums over $m\leqslant M$ are dominated by
$G_1=\sum_mc\,|S_m|\indc\{N=m\}$, respectively $G_2=\sum_mc\,S_m^2\indc\{N=m\}$, which are
integrable by Corollary~\ref{cor:int-series}(i) and Step~2:
$\expc G_1\leqslant c\expc|Y|\sum_mm\prb\{N=m\}=c\expc|Y|\expc N$ and
$\expc G_2\leqslant c\{\expc[Y^2]\expc N+(\expc Y)^2\expc[N^2]\}$, finite as
$\expc N\leqslant1+\expc[N^2]<\infty$. Dominated convergence (Theorem~\ref{thm:dct}) lets the
expectation pass through the sums, and Step~2 gives
\begin{align*}
\expc[S\,w(N)]&=\sum_mw(m)\,m\expc[Y]\prb\{N=m\}=\expc\bigl[N\expc[Y]\,w(N)\bigr],\\
\expc[S^2w(N)]&=\expc\bigl[\{N\var(Y)+N^2(\expc Y)^2\}w(N)\bigr] ,
\end{align*}
the last equalities by dominated convergence (Theorem~\ref{thm:dct}) applied to the partial
sums over $m\leqslant M$ of $w(m)\,m\expc[Y]\indc\{N=m\}$ and of
$w(m)\{m\var(Y)+m^2(\expc Y)^2\}\indc\{N=m\}$, dominated by the integrable
$c|\expc Y|N$ and $c\{N\var(Y)+N^2(\expc Y)^2\}$.

\textbf{Step 4: conclusion.} With $w\equiv1$ the second identity gives
$\expc[S^2]=\expc N\var(Y)+\expc[N^2](\expc Y)^2<\infty$, so $S\in L^2$. The variables
$N\expc[Y]$ and $N\var(Y)+N^2(\expc Y)^2$ are $\sigma(N)$-measurable and integrable, and by
Step~1 the two identities hold for every bounded $\sigma(N)$-measurable $W$; so by the
uniqueness in Lemma~\ref{lem:condexp-L1}, $\expc[S\mid N]=N\expc[Y]$ and
$\expc[S^2\mid N]=N\var(Y)+N^2(\expc Y)^2$, whence
$\var(S\mid N)=\expc[S^2\mid N]-(\expc[S\mid N])^2=N\var(Y)$. Proposition~\ref{prop:tower}
gives $\expc S=\expc[N\expc Y]=\expc N\,\expc Y$, and Proposition~\ref{prop:condvar} gives
$\var(S)=\expc[N\var(Y)]+\var(N\expc[Y])=\expc[N]\var(Y)+\var(N)(\expc Y)^2$, using
$\var(aN)=a^2\var(N)$ for the constant $a=\expc Y$.
\end{proof}

%==============================================================================
\section{The Multivariate Normal Distribution}\label{sec:P.17}
%==============================================================================

\begin{definition}[Multivariate normal]\label{def:mvn}
$X$ in $\Real^d$ is $N(\bmu,\bSig)$ if $X=\bmu+\bA Z$ where $Z$ has independent standard
normal coordinates and $\bA\bA'=\bSig$.
\end{definition}

The parameters are the mean and the covariance: $\expc X=\bmu$ and $\var(X)=\bSig$. Indeed,
let $Z=(Z_1,\ldots,Z_k)$. By Lemma~\ref{lem:density-int} and Remark~\ref{rem:assumed}(d),
\[
\expc[Z_j^2]=\int x^2\phi(x)\,\dd x=1,\qquad \expc|Z_j|=\int|x|\phi(x)\,\dd x<\infty
\]
since $|x|\leqslant1+x^2$; so $\expc Z_j=\int x\phi(x)\,\dd x$. As $x\phi(x)$ is odd and continuous,
$\int x\phi(x)\indc_{[-n,n]}(x)\,\dd x=\int_{-n}^nx\phi(x)\,\dd x=0$ (a Riemann integral,
Remark~\ref{rem:assumed}(c)), and Theorem~\ref{thm:dct} with dominating function $|x|\phi(x)$
lets $n\to\infty$: $\expc Z_j=0$. For $i\neq j$, Lemma~\ref{lem:disjoint-fn} gives
$\expc[Z_iZ_j]=\expc Z_i\,\expc Z_j=0$. Hence $\expc Z=\bzero$ and $\var(Z)=\bI_k$, and
linearity (Theorem~\ref{thm:int-linear}(i)) gives $\expc X=\bmu+\bA\expc Z=\bmu$ and
Proposition~\ref{prop:var-linear} gives $\var(X)=\bA\bI_k\bA'=\bSig$.

\begin{theorem}[Closure under affine maps]\label{thm:mvn-linear}
If $X\sim N(\bmu,\bSig)$, $\bB$ is a constant matrix and $\mathbf{b}$ a constant vector,
then $\bB X+\mathbf{b}\sim N(\bB\bmu+\mathbf{b},\ \bB\bSig\bB')$.
\end{theorem}

\begin{proof}
$\bB X+\mathbf{b} = (\bB\bmu+\mathbf{b})+(\bB\bA)Z$ and
$(\bB\bA)(\bB\bA)'=\bB\bSig\bB'$, which is Definition~\ref{def:mvn}.
\end{proof}

%==============================================================================
\section{The \texorpdfstring{$\chi^2$}{chi-square}, \texorpdfstring{$t$}{t} and \texorpdfstring{$F$}{F} Distributions}\label{sec:P.18}
%==============================================================================

\begin{definition}\label{def:chisq-t-F}
For independent $Z_1,\ldots,Z_r$ standard normal, $\sum_{j\leqslant r}Z_j^2$ has the
\emph{chi-square} law with $r$ degrees of freedom, $\chi^2_r$. If $Z$ is standard normal and
$V\sim\chi^2_\nu$ are independent then $Z/\sqrt{V/\nu}$ has \emph{Student's $t$} law
$t_\nu$. If $V_1\sim\chi^2_{r_1}$ and $V_2\sim\chi^2_{r_2}$ are independent then
$(V_1/r_1)/(V_2/r_2)$ has the \emph{$F$} law $F_{r_1,r_2}$.
\end{definition}

\begin{corollary}[The square of a $t$ is an $F$]\label{cor:t2-F1}
If $T\sim t_\nu$ then $T^2\sim F_{1,\nu}$.
\end{corollary}

\begin{proof}
By Definition~\ref{def:chisq-t-F}, $T=Z/\sqrt{V/\nu}$ with $Z$ standard normal and
$V\sim\chi^2_\nu$ independent. Squaring, $T^2=(Z^2/1)/(V/\nu)$. Now $Z^2\sim\chi^2_1$ by
the same definition with $r=1$, and it is independent of $V$ by
Lemma~\ref{lem:disjoint-fn} (a function of $Z$ and a function of $V$, with $Z,V$
independent), so the ratio is $F_{1,\nu}$ by the definition with $r_1=1$, $r_2=\nu$.
\end{proof}

\begin{lemma}[Fourth moment of the normal]\label{lem:fourth}
If $Z$ is standard normal then $\expc[Z^4]=3$, so $\var(Z^2)=2$; for
$\varepsilon\sim N(0,\sigma^2)$ with $\sigma>0$, $\var(\varepsilon^2/\sigma^2)=2$.
\end{lemma}

\begin{proof}
With $\phi'(z)=-z\phi(z)$ for the standard normal density, integration by parts on
$[-R,R]$ gives
\[
\int_{-R}^Rz^4\phi(z)\,\dd z=\int_{-R}^R z^3\cdot z\phi(z)\,\dd z = -\int_{-R}^R z^3\phi'(z)\,\dd z
= -2R^3\phi(R)+3\int_{-R}^R z^2\phi(z)\,\dd z ,
\]
as $z^3\phi(z)$ is odd. Let $R\to\infty$. By Theorem~\ref{thm:mct} (the integrands $z^4\phi\indc_{[-R,R]}$ and $z^2\phi\indc_{[-R,R]}$
increase with $R$), the left side tends to $\int z^4\phi(z)\,\dd z=\expc[Z^4]$ (Lemma~\ref{lem:density-int}) and the last integral to
$\int z^2\phi(z)\,\dd z=1$ (Remark~\ref{rem:assumed}(d)). The boundary term tends to $0$:
from the exponential series, whose terms are non-negative, $e^{R^2/2}\geqslant(R^2/2)^2/2=R^4/8$,
so $R^3\phi(R)\leqslant8(2\pi)^{-1/2}/R\to0$. Hence $\expc[Z^4]=3$, and
$\var(Z^2)=\expc[Z^4]-(\expc[Z^2])^2=3-1=2$. If $\varepsilon\sim N(0,\sigma^2)$ then by
Definition~\ref{def:mvn} $\varepsilon=\sum_{j\leqslant k}a_jZ_j$ with $Z_1,\ldots,Z_k$
independent standard normal and $\sum_ja_j^2=\sigma^2$, and $\expc[\varepsilon^2]=\sigma^2$
by the paragraph after Definition~\ref{def:mvn}. Expand
$\expc[\varepsilon^4]=\sum_{i,j,l,m}a_ia_ja_la_m\expc[Z_iZ_jZ_lZ_m]$. Each product
$Z_iZ_jZ_lZ_m$ is a product of powers $Z_r^p$ ($p\leqslant4$) of distinct coordinates, each
integrable as $|Z_r|^p\leqslant1+Z_r^4$, so by Lemma~\ref{lem:disjoint-fn} (applied one
factor at a time) its expectation is the product of the $\expc[Z_r^p]$. If some index
occurs exactly once, the factor $\expc Z_r=0$ (paragraph after Definition~\ref{def:mvn})
makes the term $0$. What remains are the terms with $i=j=l=m$, each with expectation
$\expc[Z_i^4]=3$, and, for each pair $r<s$, the $6$ ordered arrangements of $r,r,s,s$, each
with expectation $\expc[Z_r^2]\expc[Z_s^2]=1$. So
$\expc[\varepsilon^4]=3\sum_ja_j^4+6\sum_{r<s}a_r^2a_s^2=3\bigl(\sum_ja_j^2\bigr)^2=3\sigma^4$,
and $\var(\varepsilon^2/\sigma^2)=\expc[\varepsilon^4]/\sigma^4-(\expc[\varepsilon^2]/\sigma^2)^2=3-1=2$.
\end{proof}

\begin{proposition}[Moments of $\chi^2$]\label{prop:chisq-moments}
If $V\sim\chi^2_r$ then $\expc[V]=r$ and $\var(V)=2r$.
\end{proposition}

\begin{proof}
$\expc[Z^2]=\int z^2\phi(z)\,\dd z=1$ (Lemma~\ref{lem:density-int} and
Remark~\ref{rem:assumed}(d)) and, by Lemma~\ref{lem:fourth}, $\expc[Z^4]=3$, so
$\var(Z^2)=3-1=2$. With $V=\sum_{j\leqslant r}Z_j^2$ as in
Definition~\ref{def:chisq-t-F}, linearity gives $\expc V=\sum_j\expc[Z_j^2]=r$. For
$i\neq j$, Lemma~\ref{lem:disjoint-fn} gives $\expc[Z_i^2Z_j^2]=\expc[Z_i^2]\expc[Z_j^2]$,
that is $\cov(Z_i^2,Z_j^2)=0$, so expanding $\var(V)=\expc[(\sum_j(Z_j^2-1))^2]$,
\[
\var(V)=\sum_j\var(Z_j^2)+\sum_{i\neq j}\cov(Z_i^2,Z_j^2)=2r .
\]
\end{proof}

%==============================================================================
\section{Modes of Convergence}\label{sec:P.19}
%==============================================================================

$C_b(\Real^d)$ denotes the bounded continuous real functions on $\Real^d$ and
$C_K(\Real^d)$ those continuous with compact support.

\begin{definition}[Modes of convergence]\label{def:modes}
Let $X, X_1, X_2,\ldots$ be random vectors in $\Real^d$.
\begin{enumerate}[label=\textup{(\roman*)}]
\item $X_n \to X$ \emph{almost surely}, written $X_n\to X$ a.s., if
      $\prb\{\lim_n X_n = X\} = 1$.
\item $X_n \convp X$ \emph{in probability} if $\prb\{|X_n-X|>\varepsilon\}\to0$ for every
      $\varepsilon>0$.
\item $X_n \convd X$ \emph{in distribution} if $\expc[f(X_n)] \to \expc[f(X)]$ for every
      $f\in C_b(\Real^d)$.
\end{enumerate}
Convergence in distribution depends on the $X_n$ only through their laws, so we also write
$\mu_n\to\mu$ \emph{weakly} for probability measures.
\end{definition}

\begin{lemma}[Almost sure subsequence]\label{lem:as-subseq}
If $X_n\convp X$ then some subsequence converges to $X$ almost surely.
\end{lemma}

\begin{proof}
Choose $n_1<n_2<\cdots$ with $\prb\{|X_{n_k}-X|>2^{-k}\}\leqslant 2^{-k}$ recursively:
for fixed $k$, $\prb\{|X_n-X|>2^{-k}\}\to0$ as $n\to\infty$, so some $n_k>n_{k-1}$ has
this probability at most $2^{-k}$. These probabilities are summable, so by
Lemma~\ref{lem:BC} the events $\{|X_{n_k}-X|>2^{-k}\}$ occur finitely often almost surely;
on that event $|X_{n_k}-X|\leqslant 2^{-k}$ for all large $k$, hence $X_{n_k}\to X$.
\end{proof}

\begin{proposition}[The hierarchy]\label{prop:hierarchy}
Almost sure convergence implies convergence in probability, which implies convergence in
distribution.
\end{proposition}

\begin{proof}
\textbf{a.s.\ $\Rightarrow$ probability.} Fix $\varepsilon>0$ and put
$B_n = \{|X_n-X|>\varepsilon\}$. On the event $\{X_n\to X\}$ only finitely many $B_n$ occur,
so $\indc_{B_n}\to0$ almost surely; dominated convergence (Theorem~\ref{thm:dct}) gives
$\prb(B_n) = \expc[\indc_{B_n}]\to0$.

\textbf{probability $\Rightarrow$ distribution.} Let $f\in C_b(\Real^d)$ and suppose
$\expc[f(X_n)]\not\to\expc[f(X)]$. Then some subsequence satisfies
$|\expc[f(X_{n_j})]-\expc[f(X)]|\geqslant\delta$ for a $\delta>0$. That subsequence still
converges in probability, so by Lemma~\ref{lem:as-subseq} it has a further subsequence
converging almost surely; along it $f(X_{n_{j_l}})\to f(X)$ almost surely by continuity,
and dominated convergence (Theorem~\ref{thm:dct}, with dominating constant $\sup|f|$) gives
$\expc[f(X_{n_{j_l}})]\to\expc[f(X)]$, contradicting the choice of $\delta$.
\end{proof}

\begin{proposition}[Convergence to a constant]\label{prop:const}
If $c\in\Real^d$ is constant then $X_n\convd c$ if and only if $X_n\convp c$.
\end{proposition}

\begin{proof}
One direction is Proposition~\ref{prop:hierarchy}. Conversely suppose $X_n\convd c$ and fix
$\varepsilon>0$. The function $f(x) = \min\{1,\ |x-c|/\varepsilon\}$ is bounded and
continuous with $f(c)=0$, and $\indc\{|x-c|>\varepsilon\}\leqslant f(x)$ for every $x$.
Hence
\[
\prb\{|X_n-c|>\varepsilon\} \leqslant \expc[f(X_n)] \to \expc[f(c)] = 0 . \qedhere
\]
\end{proof}

%==============================================================================
\section{Characteristic Functions}\label{sec:P.20}
%==============================================================================

\begin{definition}[Characteristic function]\label{def:cf}
The \emph{characteristic function} of a random vector $X$ in $\Real^d$, equivalently of its
law $\mu$, is
\begin{equation}\label{eq:cf}
\varphi_X(\theta) = \expc\bigl[e^{i\langle\theta,X\rangle}\bigr]
= \int_{\Real^d} e^{i\langle\theta,x\rangle}\,\dd\mu(x),
\qquad \theta\in\Real^d .
\end{equation}
The second equality is Theorem~\ref{thm:change-var}.
\end{definition}

\begin{proposition}[Elementary properties]\label{prop:cf-props}
\leavevmode
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{cf:i}   $\varphi_X(0)=1$ and $|\varphi_X(\theta)|\leqslant1$ for all $\theta$.
\item\label{cf:ii}  $\varphi_X$ is uniformly continuous.
\item\label{cf:iii} If $X$ and $Y$ are independent then
      $\varphi_{X+Y} = \varphi_X\varphi_Y$.
\item\label{cf:iv}  For a constant matrix $\bA$ and vector $\mathbf{b}$,
      $\varphi_{\bA X+\mathbf{b}}(\theta)
       = e^{i\langle\theta,\mathbf{b}\rangle}\varphi_X(\bA'\theta)$.
\end{enumerate}
\end{proposition}

\begin{proof}
\ref{cf:i}: $\varphi_X(0)=\expc[1]=1$, and by Theorem~\ref{thm:int-linear}(iii),
$|\varphi_X(\theta)|\leqslant\expc|e^{i\langle\theta,X\rangle}|=1$. For~\ref{cf:ii},
\[
|\varphi_X(\theta+\eta)-\varphi_X(\theta)|
= \bigl|\expc\bigl[e^{i\langle\theta,X\rangle}(e^{i\langle\eta,X\rangle}-1)\bigr]\bigr|
\leqslant \expc\bigl|e^{i\langle\eta,X\rangle}-1\bigr| ,
\]
a bound free of $\theta$, by Theorem~\ref{thm:int-linear}(iii) and $|e^{i\langle\theta,X\rangle}|=1$.
The integrand is at most $2$ and tends to $0$ pointwise as $\eta\to0$, so for any sequence
$\eta_n\to0$ dominated convergence (Theorem~\ref{thm:dct}, dominating constant $2$) makes
$\expc|e^{i\langle\eta_n,X\rangle}-1|\to0$; hence for $\varepsilon>0$ there is $\delta>0$
with $\expc|e^{i\langle\eta,X\rangle}-1|<\varepsilon$ for $|\eta|<\delta$ (otherwise some
$\eta_n$ with $|\eta_n|<1/n$ would violate it), and then
$|\varphi_X(\theta+\eta)-\varphi_X(\theta)|<\varepsilon$ for every $\theta$. For~\ref{cf:iii},
write $e^{i\langle\theta,X\rangle}=c_X+is_X$ with $c_X=\cos\langle\theta,X\rangle$,
$s_X=\sin\langle\theta,X\rangle$, and likewise for $Y$. Then
$e^{i\langle\theta,X+Y\rangle}=(c_Xc_Y-s_Xs_Y)+i(c_Xs_Y+s_Xc_Y)$, and each of the four products
is a bounded function of $X$ times a bounded function of $Y$, whose expectation factorises by
Lemma~\ref{lem:disjoint-fn}; reassembling, $\expc[e^{i\langle\theta,X\rangle}e^{i\langle\theta,Y\rangle}]
=\expc[e^{i\langle\theta,X\rangle}]\expc[e^{i\langle\theta,Y\rangle}]$. Finally
\ref{cf:iv} follows from
$\langle\theta,\bA X+\mathbf{b}\rangle = \langle\bA'\theta,X\rangle+\langle\theta,\mathbf{b}\rangle$.
\end{proof}

\begin{proposition}[The Gaussian characteristic function]\label{prop:cf-gauss}
If $X\sim N(\bmu,\bSig)$ in $\Real^d$ then
$\varphi_X(\theta) = \exp\bigl(i\langle\theta,\bmu\rangle - \tfrac12\theta'\bSig\theta\bigr)$.
\end{proposition}

\begin{proof}
Take first $d=1$ and $Z$ standard normal, and set $\varphi(t)=\expc[e^{itZ}]=\int e^{itz}\phi(z)\,\dd z
=\int\cos(tz)\phi(z)\,\dd z+i\int\sin(tz)\phi(z)\,\dd z$ (Lemma~\ref{lem:density-int},
which also gives the second equality in the next display). Differentiating under the integral
sign (Theorem~\ref{thm:diff-int}, applied to the real and imaginary parts, with
$I=\Real$), justified because $|\partial_t\cos(tz)|,|\partial_t\sin(tz)|\leqslant|z|$ and
$\int|z|\phi(z)\,\dd z\leqslant\int(1+z^2)\phi(z)\,\dd z=2$,
\[
\varphi'(t) = \expc\bigl[iZe^{itZ}\bigr] = i\int z e^{itz}\phi(z)\,\dd z
= -i\int e^{itz}\phi'(z)\,\dd z = i^2 t\int e^{itz}\phi(z)\,\dd z = -t\varphi(t),
\]
using $\phi'(z)=-z\phi(z)$ and then integration by parts. In detail, on $[-R,R]$,
$-\int_{-R}^Re^{itz}\phi'(z)\,\dd z=-\bigl[e^{itz}\phi(z)\bigr]_{-R}^R+it\int_{-R}^Re^{itz}\phi(z)\,\dd z$;
the boundary term has modulus at most $2\phi(R)\to0$, and as $R\to\infty$ both integrals
converge to the integrals over $\Real$ by dominated convergence (Theorem~\ref{thm:dct}, with
dominating functions $|z|\phi(z)$ and $\phi(z)$). Hence, by the product rule,
$(\varphi(t)e^{t^2/2})'=\varphi'(t)e^{t^2/2}+t\varphi(t)e^{t^2/2}=0$, and
Corollary~\ref{cor:MVT}, applied to the real and imaginary parts on $[0,t]$ or $[t,0]$,
gives $\varphi(t)e^{t^2/2}=\varphi(0)=1$, that is $\varphi(t)=e^{-t^2/2}$.

In general $X = \bmu + \bA Z$ with $Z=(Z_1,\ldots,Z_k)$ a vector of independent standard
normals and $\bA\bA'=\bSig$. For $\eta\in\Real^k$,
$e^{i\langle\eta,Z\rangle}=\prod_je^{i\eta_jZ_j}$. By induction on the number of factors,
using Proposition~\ref{prop:cf-props}\ref{cf:iii} at each step (the sum
$\sum_{j<l}\eta_jZ_j$ is a function of $Z_1,\ldots,Z_{l-1}$, independent of $\eta_lZ_l$ by
Lemma~\ref{lem:disjoint-fn}), $\varphi_Z(\eta)=\prod_j\expc[e^{i\eta_jZ_j}]
=\prod_j e^{-\eta_j^2/2}=e^{-|\eta|^2/2}$, by the case $d=1$. By~\ref{cf:iv},
$\varphi_X(\theta) = e^{i\langle\theta,\bmu\rangle}\varphi_Z(\bA'\theta)
= e^{i\langle\theta,\bmu\rangle}e^{-|\bA'\theta|^2/2}$, with
$|\bA'\theta|^2 = \theta'\bA\bA'\theta = \theta'\bSig\theta$.
\end{proof}

%==============================================================================
\section{L\'evy's Continuity Theorem}\label{sec:P.21}
%==============================================================================

The Gaussian density on $\Real^d$ with variance $\sigma^2$ per coordinate is
$f_\sigma(x) = (2\pi\sigma^2)^{-d/2}e^{-|x|^2/(2\sigma^2)}$. For $\psi\in C_K(\Real^d)$ put
\begin{equation}\label{eq:mollify}
\psi_\sigma(x) = \int_{\Real^d} f_\sigma(x-y)\,\psi(y)\,\dd y .
\end{equation}

\begin{lemma}[Gaussian Fourier inversion]\label{lem:gauss-inv}
$\ds f_\sigma(z) = (2\pi)^{-d}\int_{\Real^d} e^{i\langle\theta,z\rangle}
 e^{-\sigma^2|\theta|^2/2}\,\dd\theta$ for every $z\in\Real^d$.
\end{lemma}

\begin{proof}
The integrand factors over coordinates,
$e^{i\langle\theta,z\rangle}e^{-\sigma^2|\theta|^2/2}=\prod_{j\leqslant d}e^{i\theta_jz_j}e^{-\sigma^2\theta_j^2/2}$,
and so does $f_\sigma(z)=\prod_j(2\pi\sigma^2)^{-1/2}e^{-z_j^2/(2\sigma^2)}$. The modulus of the
integrand is $\prod_je^{-\sigma^2\theta_j^2/2}$, integrable over $\Real^d$ by
Theorem~\ref{thm:fubini}(i), so Theorem~\ref{thm:fubini}(ii), applied $d-1$ times, writes the
integral over $\Real^d$ as the product of the $d$ one-dimensional integrals. So it suffices
to take $d=1$. By
Proposition~\ref{prop:cf-gauss} applied to $N(0,\sigma^{-2})$, whose density is
$(\sigma/\sqrt{2\pi})e^{-\sigma^2t^2/2}$,
\[
\int_\Real e^{itz}\,\frac{\sigma}{\sqrt{2\pi}}e^{-\sigma^2t^2/2}\,\dd t = e^{-z^2/(2\sigma^2)} ,
\]
the left side being the characteristic function of $N(0,\sigma^{-2})$ at $z$
(Lemma~\ref{lem:density-int}), and the
density of $N(0,\sigma^{-2})=\sigma^{-1}Z$ following from Remark~\ref{rem:assumed}(e) with
$a=\sigma^{-1}$. Multiplying by $\sqrt{2\pi}/\sigma$ gives
$\int_\Real e^{itz}e^{-\sigma^2t^2/2}\,\dd t
= \sqrt{2\pi}\,\sigma^{-1}e^{-z^2/(2\sigma^2)} = 2\pi f_\sigma(z)$.
\end{proof}

\begin{lemma}[Mollification]\label{lem:mollify}
For $\psi\in C_K(\Real^d)$, $\psi_\sigma\to\psi$ uniformly as $\sigma\to0^+$.
\end{lemma}

\begin{proof}
Let $W=\sigma Z$, where $Z=(Z_1,\ldots,Z_d)'$ has independent standard normal components $Z_j$. Its law is the
product of the laws of the $\sigma Z_j$ (Definition~\ref{def:indep}), whose densities are
$(2\pi\sigma^2)^{-1/2}e^{-u^2/(2\sigma^2)}$ by Remark~\ref{rem:assumed}(e); by
Theorem~\ref{thm:fubini}(i) on boxes and Corollary~\ref{cor:finite-product}, $W$ has density
$f_\sigma$, so $\int f_\sigma=1$ and $\int_Bf_\sigma=\prb\{W\in B\}$. Lebesgue measure is
invariant under $u=x-y$: the image of Lebesgue measure under $y\mapsto x-y$ gives a half-open box
the product of its side lengths (a point has Lebesgue measure $\lim_n1/n=0$, so open, closed
and half-open intervals have the same length), hence equals Lebesgue measure by
Corollary~\ref{cor:measure-unique}, and Theorem~\ref{thm:change-var} gives
$\int g(x-y)\,\dd y=\int g(u)\,\dd u$ for Borel $g\geqslant0$. In particular
$\int f_\sigma(x-y)\,\dd y=1$, so
\[
|\psi(x)-\psi_\sigma(x)| \leqslant \int f_\sigma(x-y)\,|\psi(x)-\psi(y)|\,\dd y = I_1+I_2 ,
\]
splitting the integral at $|y-x|\leqslant\delta$ and $|y-x|>\delta$. Given $\varepsilon>0$
choose $\delta$ with $|\psi(x)-\psi(y)|\leqslant\varepsilon$ whenever
$|x-y|\leqslant\delta$, possible because $\psi$ is uniformly continuous: if the support of
$\psi$ lies in $\{|x|\leqslant R\}$, Theorem~\ref{thm:unif-cont} on the compact ball
$K=\{|x|\leqslant R+1\}$ gives $\delta\leqslant1$ that works for $x,y\in K$, and if
$|x-y|\leqslant\delta$ with one of them outside $K$ then both lie outside the support and
$\psi(x)=\psi(y)=0$. Then $I_1\leqslant\varepsilon\int f_\sigma(x-y)\,\dd y=\varepsilon$.
For the second, $|\psi(x)-\psi(y)|\leqslant2\|\psi\|_\infty$, the substitution $u=x-y$, and
Markov's inequality (Theorem~\ref{thm:markov}, applied to $|W|^2$ at the level $\delta^2$),
with $\expc|W|^2=\sum_j\sigma^2\expc Z_j^2=d\sigma^2$ (as $\expc Z_j^2=\int z^2\phi(z)\,\dd z=1$ by
Lemma~\ref{lem:density-int} and Remark~\ref{rem:assumed}(d)), give
\[
I_2 \leqslant 2\|\psi\|_\infty\int_{\{|u|>\delta\}}f_\sigma(u)\,\dd u=2\|\psi\|_\infty\,\prb\{|W|>\delta\}
\leqslant 2\|\psi\|_\infty\,\frac{\expc|W|^2}{\delta^2}
= 2\|\psi\|_\infty\,\frac{d\sigma^2}{\delta^2} ,
\]
which tends to $0$ as $\sigma\to0$. Both bounds are free of $x$.
\end{proof}

\begin{lemma}[Smoothing identity]\label{lem:smoothing}
Let $\mu$ be a probability on $\Real^d$ with characteristic function $\varphi_\mu$, and let
$\psi\in C_K(\Real^d)$. Then
\begin{equation}\label{eq:smoothing}
\int_{\Real^d}\psi_\sigma\,\dd\mu = \int_{\Real^d}\varphi_\mu(\theta)\,H(\theta)\,\dd\theta,
\qquad
H(\theta) = (2\pi)^{-d}e^{-\sigma^2|\theta|^2/2}\int_{\Real^d}\psi(y)e^{-i\langle\theta,y\rangle}\,\dd y .
\end{equation}
\end{lemma}

\begin{proof}
Substitute Lemma~\ref{lem:gauss-inv} into~\eqref{eq:mollify}:
\[
\int\psi_\sigma\,\dd\mu
= \int\!\!\int\!\!\int (2\pi)^{-d}e^{-\sigma^2|\theta|^2/2}
   e^{i\langle\theta,x-y\rangle}\psi(y)\,\dd\theta\,\dd y\,\dd\mu(x) .
\]
The modulus of the integrand is
$(2\pi)^{-d}e^{-\sigma^2|\theta|^2/2}|\psi(y)|$, whose integral over
$\theta$, $y$ and $x$ is, by Theorem~\ref{thm:fubini}(i),
$(2\pi)^{-d}(2\pi/\sigma^2)^{d/2}\int|\psi(y)|\,\dd y\cdot\mu(\Real^d)$, finite because
$\psi$ is bounded with compact support and $\mu$ is a probability (the $\theta$-integral is
$\int e^{-\sigma^2|\theta|^2/2}\dd\theta=(2\pi)^{d/2}\sigma^{-d}$, as $\int f_{1/\sigma}=1$).
The integrand is jointly measurable, being continuous in $(\theta,y,x)$ times the Borel
$\psi(y)$. Fubini's theorem (Theorem~\ref{thm:fubini}) therefore permits integrating in $x$ first, which produces
$\varphi_\mu(\theta)$, and collecting the $y$-integral into $H$ gives~\eqref{eq:smoothing}.
\end{proof}

\begin{lemma}[Compactly supported test functions suffice]\label{lem:CK-suffices}
Let $\mu,\mu_1,\mu_2,\ldots$ be probability measures on $\Real^d$ with
$\int\psi\,\dd\mu_n\to\int\psi\,\dd\mu$ for every $\psi\in C_K(\Real^d)$. Then
$\mu_n\to\mu$ weakly.
\end{lemma}

\begin{proof}
Fix $g\in C_b(\Real^d)$ and $\varepsilon>0$. The sets $\{|x|>R\}$, $R=1,2,\ldots$,
decrease to $\emptyset$, and $\mu$ is finite, so continuity from above
(Proposition~\ref{prop:measure}(v)) gives $R$ with $\mu\{|x|>R\}<\varepsilon$. The function
$\chi(x)=\min\{1,\max(0,R+1-|x|)\}$ is continuous, vanishes for $|x|\geqslant R+1$, and
satisfies $\indc\{|x|\leqslant R\}\leqslant\chi\leqslant1$; so $\chi\in C_K(\Real^d)$. Then
$\int\chi\,\dd\mu\geqslant\mu\{|x|\leqslant R\}\geqslant1-\varepsilon$, and by hypothesis
$\int\chi\,\dd\mu_n\to\int\chi\,\dd\mu$, so
$\int(1-\chi)\,\dd\mu_n=1-\int\chi\,\dd\mu_n\to1-\int\chi\,\dd\mu\leqslant\varepsilon$.

Now $g\chi\in C_K(\Real^d)$, so $\int g\chi\,\dd\mu_n\to\int g\chi\,\dd\mu$, while
\[
\Bigl|\int g(1-\chi)\,\dd\mu_n\Bigr| \leqslant \|g\|_\infty\int(1-\chi)\,\dd\mu_n ,
\qquad
\Bigl|\int g(1-\chi)\,\dd\mu\Bigr| \leqslant \|g\|_\infty\,\varepsilon .
\]
Writing $g=g\chi+g(1-\chi)$ and using the triangle inequality,
\[
\Bigl|\int g\,\dd\mu_n-\int g\,\dd\mu\Bigr|\leqslant\Bigl|\int g\chi\,\dd\mu_n-\int g\chi\,\dd\mu\Bigr|
+\|g\|_\infty\int(1-\chi)\,\dd\mu_n+\|g\|_\infty\,\varepsilon ,
\]
and the $\limsup$ of the right side is at most $0+\|g\|_\infty\varepsilon+\|g\|_\infty\varepsilon$.
So $\limsup_n|\int g\,\dd\mu_n-\int g\,\dd\mu| \leqslant 2\|g\|_\infty\varepsilon$, and
$\varepsilon$ was arbitrary.
\end{proof}

\begin{theorem}[L\'evy's continuity theorem]\label{thm:levy}
Let $\mu,\mu_1,\mu_2,\ldots$ be probabilities on $\Real^d$. Then $\mu_n\to\mu$ weakly if and
only if $\varphi_{\mu_n}(\theta)\to\varphi_\mu(\theta)$ for every $\theta\in\Real^d$.
\end{theorem}

\begin{proof}
\textbf{Necessity.} $x\mapsto e^{i\langle\theta,x\rangle}$ has bounded continuous real and
imaginary parts $\cos\langle\theta,x\rangle$ and $\sin\langle\theta,x\rangle$, so weak
convergence applies to each, and
$\varphi_{\mu_n}(\theta)=\int\cos\langle\theta,x\rangle\,\dd\mu_n+i\int\sin\langle\theta,x\rangle\,\dd\mu_n
\to\varphi_\mu(\theta)$.

\textbf{Sufficiency.} Assume pointwise convergence of the characteristic functions and fix
$\psi\in C_K(\Real^d)$; by Lemma~\ref{lem:CK-suffices} it suffices to show
$\int\psi\,\dd\mu_n\to\int\psi\,\dd\mu$. Let $\varepsilon>0$. By
Lemma~\ref{lem:mollify} choose $\sigma$ with $\|\psi_\sigma-\psi\|_\infty\leqslant\varepsilon$;
since every $\mu_n$ and $\mu$ is a probability,
\[
\Bigl|\int\psi\,\dd\mu_n-\int\psi\,\dd\mu\Bigr|
\leqslant 2\varepsilon + \Bigl|\int\psi_\sigma\,\dd\mu_n-\int\psi_\sigma\,\dd\mu\Bigr| .
\]
For the remaining term use the smoothing identity~\eqref{eq:smoothing} with the same
$\sigma$ for every $n$. The integrands $\varphi_{\mu_n}H$ converge pointwise to
$\varphi_\mu H$ and are dominated in modulus by
$(2\pi)^{-d}e^{-\sigma^2|\theta|^2/2}\int|\psi|$ (as $|\varphi_{\mu_n}|\leqslant1$ by
Proposition~\ref{prop:cf-props}\ref{cf:i}), which is integrable in $\theta$. Dominated
convergence (Theorem~\ref{thm:dct}) and~\eqref{eq:smoothing} give
$\int\psi_\sigma\,\dd\mu_n\to\int\psi_\sigma\,\dd\mu$, so the $\limsup$ of the left side is
at most $2\varepsilon$. As $\varepsilon>0$ was arbitrary, $\int\psi\,\dd\mu_n\to\int\psi\,\dd\mu$.
\end{proof}

\begin{corollary}[Uniqueness]\label{cor:uniqueness}
Two probabilities on $\Real^d$ with the same characteristic function are equal.
\end{corollary}

\begin{proof}
Apply Theorem~\ref{thm:levy} to the constant sequence $\mu_n=\nu$: if
$\varphi_\nu=\varphi_\mu$ then $\nu\to\mu$ weakly, so $\int g\,\dd\nu = \int g\,\dd\mu$ for
every $g\in C_b(\Real^d)$. Let $F$ be a non-empty closed set and
$\rho(x)=\inf_{y\in F}|x-y|$; the triangle inequality gives
$|\rho(x)-\rho(x')|\leqslant|x-x'|$, so $\rho$ is continuous, and $\rho(x)=0$ exactly when
$x\in F$ (if $\rho(x)=0$ there are $y_n\in F$ with $y_n\to x$, and $F$ is closed). The
functions $g_k(x)=\max\{0,1-k\rho(x)\}$ lie in $C_b(\Real^d)$, take values in $[0,1]$, equal
$1$ on $F$, and tend to $0$ off $F$; so $g_k\to\indc_F$ pointwise, and dominated convergence
(Theorem~\ref{thm:dct}, dominating constant $1$) gives
$\nu(F)=\lim_k\int g_k\,\dd\nu=\lim_k\int g_k\,\dd\mu=\mu(F)$; for $F=\emptyset$ both are
$0$. The closed sets form a $\pi$-system (a finite intersection of closed sets is closed),
and they generate $\calB(\Real^d)$, since a $\sigma$-field containing them contains their
complements, the open sets. Corollary~\ref{cor:measure-unique} gives $\nu=\mu$.
\end{proof}

\begin{corollary}[Standardising a normal variable]\label{cor:std-normal}
If $X\sim N(m,\sigma^2)$ in $\Real$ with $\sigma>0$, then $(X-m)/\sigma$ is standard
normal, and $X$ has density $\sigma^{-1}\phi\bigl((x-m)/\sigma\bigr)$. In particular a
$N(0,1)$ variable is standard normal.
\end{corollary}

\begin{proof}
By Theorem~\ref{thm:mvn-linear} with $\bB=1/\sigma$ and $\mathbf b=-m/\sigma$,
$W=(X-m)/\sigma\sim N(0,1)$, so by Proposition~\ref{prop:cf-gauss} its characteristic
function is $e^{-t^2/2}$. A standard normal $Z$ is $N(0,1)$ by Definition~\ref{def:mvn} with
$\bA=1$, so the same proposition gives it the same characteristic function. By
Corollary~\ref{cor:uniqueness}, $W$ and $Z$ have the same law: $\prb\{W\in B\}=\prb\{Z\in
B\}=\int_B\phi(x)\,\dd x$ for every Borel $B$. So $W$ has density $\phi$, that is, $W$ is
standard normal (Remark~\ref{rem:assumed}(d)). Then $X=\sigma W+m$ has density
$\sigma^{-1}\phi((x-m)/\sigma)$ by Remark~\ref{rem:assumed}(e). The last statement is the
case $m=0$, $\sigma=1$.
\end{proof}

\begin{corollary}[Cram\'er--Wold]\label{cor:cramer-wold}
$X_n\convd X$ in $\Real^d$ if and only if $\langle\theta,X_n\rangle\convd\langle\theta,X\rangle$
in $\Real$ for every $\theta\in\Real^d$.
\end{corollary}

\begin{proof}
By Theorem~\ref{thm:levy} the left side is equivalent to
$\expc[e^{i\langle\theta,X_n\rangle}]\to\expc[e^{i\langle\theta,X\rangle}]$ for all $\theta$.
By the same theorem in $\Real$, the right side is equivalent to
$\expc[e^{it\langle\theta,X_n\rangle}]\to\expc[e^{it\langle\theta,X\rangle}]$ for all
$t\in\Real$ and all $\theta$. Since $t\langle\theta,x\rangle=\langle t\theta,x\rangle$, this is
the left condition at the point $t\theta$; conversely, the left condition at $\theta$ is the
right condition with $t=1$. So the two conditions are equivalent.
\end{proof}

\begin{theorem}[Uncorrelated blocks are independent]\label{thm:mvn-uncorr-indep}
Let $(\bU',\bV')'$ be jointly normal with cross-covariance $\bSig_{UV}$. Then
$\bSig_{UV}=\bzero$ if and only if $\bU$ and $\bV$ are independent.
\end{theorem}

\begin{proof}
Write $\bU\in\Real^p$, $\bV\in\Real^q$. If $\bU$ and $\bV$ are independent, then for each
coordinate pair Lemma~\ref{lem:disjoint-fn} gives $\expc[U_iV_j]=\expc[U_i]\expc[V_j]$, that is
$\cov(U_i,V_j)=0$: independence always gives zero covariance. Conversely, let
$\bSig_{UV}=\bzero$. The vector $(\bU',\bV')'$ is $N(\bmu,\bSig)$ with
$\bmu=(\bmu_U',\bmu_V')'$ and $\bSig$ block diagonal with blocks $\bSig_{UU}$, $\bSig_{VV}$, so
for $\theta=(\bs',\bt')'$, $\langle\theta,\bmu\rangle=\langle\bs,\bmu_U\rangle+\langle\bt,\bmu_V\rangle$
and $\theta'\bSig\theta=\bs'\bSig_{UU}\bs+\bt'\bSig_{VV}\bt$. By
Proposition~\ref{prop:cf-gauss} the joint characteristic function factors,
\[
\exp\bigl(i\langle\bs,\bmu_U\rangle+i\langle\bt,\bmu_V\rangle
-\tfrac12\bs'\bSig_{UU}\bs-\tfrac12\bt'\bSig_{VV}\bt\bigr)
= \varphi_{\bU}(\bs)\,\varphi_{\bV}(\bt) ,
\]
where $\varphi_{\bU}(\bs)$ is the joint characteristic function at $(\bs',\bzero')'$, which is
the first factor, and likewise $\varphi_{\bV}(\bt)$. The product measure
$\mu_{\bU}\otimes\mu_{\bV}$ (Corollary~\ref{cor:finite-product}) has characteristic function
\[
\iint e^{i\langle\bs,\bu\rangle}e^{i\langle\bt,\bv\rangle}\,\dd\mu_{\bU}(\bu)\,\dd\mu_{\bV}(\bv)
=\varphi_{\bU}(\bs)\,\varphi_{\bV}(\bt)
\]
by Theorem~\ref{thm:fubini}(ii), the integrand having modulus $1$. So the joint law of
$(\bU,\bV)$ and $\mu_{\bU}\otimes\mu_{\bV}$ have the same characteristic function, hence are
equal by the uniqueness Corollary~\ref{cor:uniqueness}; that is, $\bU$ and $\bV$ are
independent (Definition~\ref{def:indep}).
\end{proof}

\begin{theorem}[Chi-square quadratic forms]\label{thm:quadratic-chisq}
If $\bz\sim N(\bzero,\bI_n)$ and $\bA$ is symmetric idempotent, then
$\bz'\bA\bz\sim\chi^2_r$ with $r=\rank(\bA)=\tr(\bA)$.
\end{theorem}

\begin{proof}
By Theorem~\ref{thm:spectral} write $\bA=\bP\bLam\bP'$ with $\bP$ orthogonal; by
Lemma~\ref{lem:idempotent} the diagonal of $\bLam$ carries $r$ ones and $n-r$ zeros, where
$r=\rank(\bA)=\tr(\bA)$; let $J$ be the set of the $r$ indices $j$ with $\lambda_j=1$. Put
$\bw=\bP'\bz$, which is $N(\bzero,\bP'\bI\bP)=N(\bzero,\bI_n)$ by
Theorem~\ref{thm:mvn-linear}.

\textbf{Each $w_j$ is standard normal.} By Proposition~\ref{prop:cf-gauss},
$\varphi_{w_j}(t)=\varphi_{\bw}(t\mathbf{e}_j)=e^{-t^2/2}$, which is the characteristic
function of $N(0,1)$ (the case $d=1$ of the same proposition), so $w_j$ is standard normal by
Corollary~\ref{cor:uniqueness}.

\textbf{The $w_j$ are independent.} For $k=1,\ldots,n-1$ the vector
$(w_k,w_{k+1},\ldots,w_n)$ is a linear image of $\bw$, hence jointly normal by
Theorem~\ref{thm:mvn-linear}, with zero covariance between $w_k$ and
$(w_{k+1},\ldots,w_n)$; Theorem~\ref{thm:mvn-uncorr-indep} makes $w_k$ independent of
$(w_{k+1},\ldots,w_n)$. Claim: for $k=n,n-1,\ldots,1$ and Borel $B_k,\ldots,B_n\subseteq\Real$,
\[
\prb\{w_k\in B_k,\ldots,w_n\in B_n\}=\prod_{j=k}^n\prb\{w_j\in B_j\} .
\]
For $k=n$ this is trivial. If it holds for $k+1$, independence of $w_k$ and
$(w_{k+1},\ldots,w_n)$, applied to $B_k$ and the Borel set $B_{k+1}\times\cdots\times B_n$,
gives
$\prb\{w_k\in B_k,\ldots,w_n\in B_n\}=\prb\{w_k\in B_k\}\prb\{w_{k+1}\in B_{k+1},\ldots,w_n\in B_n\}$,
and the hypothesis for $k+1$ completes the step. The case $k=1$ is
Definition~\ref{def:indep}.

\textbf{Conclusion.} Then
$\bz'\bA\bz=\bz'\bP\bLam\bP'\bz=\bw'\bLam\bw=\sum_j\lambda_jw_j^2=\sum_{j\in J}w_j^2$, a sum of
squares of $r$ independent standard normals (a subfamily of an independent family is
independent), which is $\chi^2_r$ by Definition~\ref{def:chisq-t-F}.
\end{proof}

\begin{theorem}[Cochran]\label{thm:cochran}
If $\bz\sim N(\bzero,\bI_n)$ and $\bA_1,\bA_2$ are symmetric idempotent with
$\bA_1\bA_2=\bzero$, then $\bz'\bA_1\bz$ and $\bz'\bA_2\bz$ are independent.
\end{theorem}

\begin{proof}
Stack $\bU=\bA_1\bz$ and $\bV=\bA_2\bz$ as $(\bU',\bV')'=(\bA_1',\bA_2')'\bz$, one linear
map of one normal vector, hence jointly normal by Theorem~\ref{thm:mvn-linear};
individual normality would not suffice. By Proposition~\ref{prop:var-linear} the covariance
of the stacked vector is $(\bA_1',\bA_2')'\bI(\bA_1',\bA_2')$, whose off-diagonal block, the
cross-covariance, is $\bA_1\bI\bA_2'=\bA_1\bA_2=\bzero$ ($\bA_2$ being symmetric), so
Theorem~\ref{thm:mvn-uncorr-indep} makes $\bU$ and $\bV$ independent. Finally
$\bz'\bA_i\bz=\bz'\bA_i'\bA_i\bz=|\bA_i\bz|^2$, as $\bA_i$ is symmetric and idempotent, so
$\bz'\bA_1\bz=|\bU|^2$ and $\bz'\bA_2\bz=|\bV|^2$ are functions of $\bU$ and of $\bV$
alone, independent by Lemma~\ref{lem:disjoint-fn}.
\end{proof}

\begin{remark}
The statement of Theorem~\ref{thm:cochran} is often called Craig's theorem; Cochran's theorem
proper concerns a decomposition $\sum_i\bA_i=\bI_n$ whose ranks add up to $n$.
\end{remark}

%==============================================================================
\section{Portmanteau and the Continuous Mapping Theorem}\label{sec:P.22}
%==============================================================================

\begin{theorem}[Portmanteau]\label{thm:portmanteau}
For probabilities $\mu,\mu_n$ on $\Real^d$ the following are equivalent.
\begin{enumerate}[label=\textup{(\alph*)}]
\item\label{pm:a} $\mu_n\to\mu$ weakly.
\item\label{pm:b} $\liminf_n\int f\,\dd\mu_n \geqslant \int f\,\dd\mu$ for every lower
      semi-continuous $f$ bounded below.
\item\label{pm:c} $\int f\,\dd\mu_n \to \int f\,\dd\mu$ for every bounded measurable $f$ whose set of
      discontinuity points is $\mu$-null.
\end{enumerate}
\end{theorem}

\begin{proof}
\ref{pm:c}$\Rightarrow$\ref{pm:a} is trivial, a continuous function having no
discontinuities.

\ref{pm:a}$\Rightarrow$\ref{pm:b}. A lower semi-continuous $f$ bounded below is the
increasing limit of the bounded continuous functions
$f_k(x)=\inf_y\{f(y)\wedge k + k|x-y|\}$ (Lemma~\ref{lem:lsc-approx}). For each $k$,
\[
\int f_k\,\dd\mu = \lim_n\int f_k\,\dd\mu_n \leqslant \liminf_n\int f\,\dd\mu_n
\]
since $f_k\leqslant f$; letting $k\to\infty$ and using monotone convergence (Theorem~\ref{thm:mct}) on the left
gives~\ref{pm:b}. (Monotone convergence is applied to $f_k+c\geqslant0$ with
$c=\max(0,-\inf f)$, as $f_k\geqslant\inf f\wedge k$ by Lemma~\ref{lem:lsc-approx}; then $c$ is
subtracted, using $\int(f+c)\,\dd\mu=\int f\,\dd\mu+c$, which follows from
Theorem~\ref{thm:int-additive} applied to $f+c=f^++(c-f^-)$ with $0\leqslant c-f^-\leqslant c$.)

\ref{pm:b}$\Rightarrow$\ref{pm:c}. If $f$ is upper semi-continuous and bounded above, $-f$
is lower semi-continuous and bounded below, and~\ref{pm:b} applied to $-f$ gives
$\liminf_n\int(-f)\,\dd\mu_n\geqslant\int(-f)\,\dd\mu$, that is, the upper form
$\limsup_n\int f\,\dd\mu_n\leqslant\int f\,\dd\mu$. Let $f$ be bounded with $\mu$-null
discontinuity set, and take $f_*,f^*$ from Lemma~\ref{lem:envelopes}: $f_*$ is lower
semi-continuous, $f^*$ upper semi-continuous, both bounded (by the bounds of $f$), and
$f_*\leqslant f\leqslant f^*$. They are Borel: if $f_*(x)>a$, lower semi-continuity gives
$r>0$ with $\inf_{|y-x|<r}f_*(y)>a$, so $\{f_*>a\}$ is open, and
Lemma~\ref{lem:meas-criteria}(ii) applies; likewise $\{f^*<a\}$ is open. By
Lemma~\ref{lem:envelopes} they agree with $f$ at every continuity point of $f$, hence off a
$\mu$-null set, so all three have the same $\mu$-integral
(Theorem~\ref{thm:int-linear}(iv)). Then, using $f_*\leqslant f\leqslant f^*$ and
Theorem~\ref{thm:int-linear}(ii) for the outer inequalities,
\[
\int f\,\dd\mu = \int f_*\,\dd\mu \leqslant \liminf_n\int f_*\,\dd\mu_n
\leqslant \liminf_n\int f\,\dd\mu_n ,
\]
\[
\int f\,\dd\mu = \int f^*\,\dd\mu \geqslant \limsup_n\int f^*\,\dd\mu_n
\geqslant \limsup_n\int f\,\dd\mu_n ,
\]
and the two together give
$\int f\,\dd\mu\leqslant\liminf_n\int f\,\dd\mu_n\leqslant\limsup_n\int f\,\dd\mu_n\leqslant\int f\,\dd\mu$,
so all are equal and $\int f\,\dd\mu_n\to\int f\,\dd\mu$ by Proposition~\ref{prop:limsup}.
\end{proof}

\begin{theorem}[Continuous mapping]\label{thm:cmt}
Let $X_n\convd X$ in $\Real^d$ and let $g:\Real^d\to\Real^m$ be measurable with
$\prb\{X\in D_g\}=0$, where $D_g$ is the set of discontinuity points of $g$. Then
$g(X_n)\convd g(X)$. The same implication holds with $\convd$ replaced throughout by
$\convp$.
\end{theorem}

\begin{proof}
\textbf{Continuous $g$.} If $g$ is continuous everywhere the proof is one line: for
$f\in C_b(\Real^m)$ the composition $f\circ g$ lies in $C_b(\Real^d)$, so
\[
\expc[f(g(X_n))] = \expc[(f\circ g)(X_n)] \to \expc[(f\circ g)(X)] = \expc[f(g(X))] .
\]

\textbf{General $g$.} Let $f\in C_b(\Real^m)$. If $g$ is continuous at $x$ then so is
$f\circ g$, so the discontinuity set of $f\circ g$ is contained in $D_g$ (a Borel set by
Remark~\ref{rem:assumed}(f)), which is $\mu$-null for $\mu$ the law of $X$; and $f\circ g$ is
bounded and measurable (Lemma~\ref{lem:meas-criteria}(iii)). Theorem~\ref{thm:portmanteau}\ref{pm:c},
applied to the laws $\mu_n$ of $X_n$, which converge weakly to $\mu$, gives
$\int f\circ g\,\dd\mu_n\to\int f\circ g\,\dd\mu$, that is
$\expc[(f\circ g)(X_n)]\to\expc[(f\circ g)(X)]$ by Theorem~\ref{thm:change-var}.

\textbf{In probability.} Suppose $X_n\convp X$. By Lemma~\ref{lem:as-subseq} every
subsequence has a further subsequence with $X_{n_k}\to X$ almost surely; on the event
$\{X\notin D_g\}$, of probability one, $g(X_{n_k})\to g(X)$ by continuity of $g$ at $X$.
Hence $g(X_{n_k})\convp g(X)$ along that sub-subsequence by
Proposition~\ref{prop:hierarchy}. Now fix $\varepsilon>0$ and put
$a_n=\prb\{|g(X_n)-g(X)|>\varepsilon\}$. If $a_n\not\to0$, some subsequence has
$a_{n_j}\geqslant\delta>0$ for all $j$; but that subsequence has a further subsequence along
which $a\to0$, by what was just shown, a contradiction. So $a_n\to0$ for every
$\varepsilon$: the whole sequence converges in probability.
\end{proof}

\begin{remark}
The measurable version is stated because the natural statement of Slutsky's theorem needs
a map that is continuous only at the relevant limit.
\end{remark}

%==============================================================================
\section{Slutsky's Theorem}\label{sec:P.23}
%==============================================================================

\begin{theorem}[Slutsky]\label{thm:slutsky}
Let $X_n\convd X$ in $\Real^d$ and $Y_n\convp c$ in $\Real^m$ with $c$ constant. Then
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{sl:i}   $(X_n,Y_n)\convd(X,c)$ in $\Real^{d+m}$;
\item\label{sl:ii}  $h(X_n,Y_n)\convd h(X,c)$ for every continuous
      $h:\Real^{d}\times\Real^m\to\Real^l$;
\item\label{sl:iii} in particular, with $m=d$, $X_n+Y_n\convd X+c$; with $m=1$,
      $Y_nX_n\convd cX$; and if $c\neq0$, $X_n/Y_n\convd X/c$, with the convention
      $x/0:=0$ on the event $\{Y_n=0\}$.
\end{enumerate}
\end{theorem}

\begin{proof}
\textbf{\ref{sl:i}} By Theorem~\ref{thm:levy} it suffices to show the characteristic
functions converge. For $\xi\in\Real^d$ and $\eta\in\Real^m$, split
\[
\expc\bigl[e^{i\langle\xi,X_n\rangle}e^{i\langle\eta,Y_n\rangle}\bigr]
= \expc\bigl[e^{i\langle\xi,X_n\rangle}\bigr]e^{i\langle\eta,c\rangle}
+ \expc\bigl[e^{i\langle\xi,X_n\rangle}\bigl(e^{i\langle\eta,Y_n\rangle}-e^{i\langle\eta,c\rangle}\bigr)\bigr] .
\]
The first term tends to $\varphi_X(\xi)e^{i\langle\eta,c\rangle}$, which is the
characteristic function of $(X,c)$ at $(\xi,\eta)$, because $X_n\convd X$. The second is
bounded in modulus by
$\expc D_n$, $D_n=\bigl|e^{i\langle\eta,Y_n\rangle}-e^{i\langle\eta,c\rangle}\bigr|$
(Theorem~\ref{thm:int-linear}(iii), with $|e^{i\langle\xi,X_n\rangle}|=1$). The function
$y\mapsto|e^{i\langle\eta,y\rangle}-e^{i\langle\eta,c\rangle}|$ is bounded by $2$ and
continuous, vanishing at $y=c$; since $Y_n\convp c$, Theorem~\ref{thm:cmt} gives
$D_n\convp0$. Then $\expc D_n\to0$: otherwise some subsequence has
$\expc D_{n_j}\geqslant\delta>0$; by Lemma~\ref{lem:as-subseq} a further subsequence
converges to $0$ almost surely, and dominated convergence (Theorem~\ref{thm:dct}, dominating
constant $2$) makes its expectations tend to $0$, a contradiction. So the joint
characteristic functions converge to that of $(X,c)$.

\textbf{\ref{sl:ii}} is Theorem~\ref{thm:cmt} applied to $h$ and the pair
from~\ref{sl:i}, and \textbf{\ref{sl:iii}} consists of three instances: $h(x,y)=x+y$,
$h(x,y)=yx$, and $h(x,y)=x/y$ for $y\neq0$, $h(x,0)=0$, the last measurable and
continuous at every $(x,y)$ with $y\neq0$ and
so covered by the measurable version of Theorem~\ref{thm:cmt}, the limit $(X,c)$ having
$c\neq0$ with probability one.
\end{proof}

\begin{remark}
No independence between $X_n$ and $Y_n$ is assumed: in applications $Y_n$ is typically an estimator computed from the same data as $X_n$, such
as $s^2$ or $\hat\tau^2$.
\end{remark}

\begin{proposition}[Quantiles of the $t$ law]\label{prop:t-quantile}
For $0<\alpha<1$ let $z$ and $c_\nu$ be the upper $\alpha/2$ quantiles of $N(0,1)$ and of
$t_\nu$: $\prb\{|Z|>z\}=\alpha=\prb\{|T_\nu|>c_\nu\}$. Then $c_\nu\geqslant z$ for every
$\nu\geqslant1$, and $c_\nu\to z$ as $\nu\to\infty$.
\end{proposition}

\begin{proof}
Let $T_\nu=Z/\sqrt{V/\nu}$ with $Z$ standard normal and $V\sim\chi^2_\nu$ independent
(Definition~\ref{def:chisq-t-F}), and let $\Phi$ and $\phi$ be the standard normal
distribution function and density. For $x\geqslant0$ and $w>0$ put
$g_x(w)=\prb\{|Z|>x\sqrt w\}=2\{1-\Phi(x\sqrt w)\}$. By independence and Fubini's
theorem (Theorem~\ref{thm:fubini}), with Theorem~\ref{thm:change-var}, $\prb\{|T_\nu|>x\}=\prb\{|Z|>x\sqrt{V/\nu}\}=\expc[g_x(V/\nu)]$, where
$V>0$ with probability one (as $\{V=0\}=\{Z_1=\cdots=Z_\nu=0\}$ and $\prb\{Z_1=0\}=0$). As
$x$ increases, $g_x(w)$ decreases strictly and continuously from $1$ to $0$ for each $w>0$,
$\Phi$ being continuous and strictly increasing. So for $x<x'$, $g_x(V/\nu)-g_{x'}(V/\nu)>0$
almost surely, and its expectation is positive by Proposition~\ref{prop:null}(iv): the map
$x\mapsto\prb\{|T_\nu|>x\}$ is strictly decreasing. For $x_k\to x$ (or $x_k\to\infty$),
$g_{x_k}(V/\nu)\to g_x(V/\nu)$ (or $\to0$) almost surely, with dominating constant $1$, so by
dominated convergence (Theorem~\ref{thm:dct}) the map is continuous, with value $1$ at
$x=0$ and limit $0$ at $\infty$. Write $h(x)=\prb\{|T_\nu|>x\}$ and let $c$ be the supremum
of $S=\{x\geqslant0:h(x)>\alpha\}$, which contains $0$ and is bounded as $h\to0<\alpha$. If
$h(c)>\alpha$, continuity gives $h>\alpha$ on some $[c,c+\eta)$, contradicting $c=\sup S$; if
$h(c)<\alpha$, continuity gives $h<\alpha$ on some $(c-\eta,c]$, and as $h$ decreases every
point of $S$ is at most $c-\eta$, again a contradiction. So $h(c)=\alpha$: $c_\nu=c$ exists,
and it is unique by strict monotonicity; likewise for $z$.

\textbf{Step 1: $c_\nu\geqslant z$.} Fix $x>0$. With $\phi'(u)=-u\phi(u)$,
\[
g_x'(w)=-\frac{x\,\phi(x\sqrt w)}{\sqrt w},\qquad
g_x''(w)=x\,\phi(x\sqrt w)\Bigl(\frac{x^2}{2\sqrt w}+\frac{1}{2w^{3/2}}\Bigr)>0 ,
\]
so $g_x'$ is increasing by Corollary~\ref{cor:MVT}. The same corollary applied to $g_x$
gives, for $w,y>0$, some $\xi$ between $w$ and $y$ with
$g_x(y)-g_x(w)=g_x'(\xi)(y-w)$; if $y>w$ then $g_x'(\xi)\geqslant g_x'(w)$, and if $y<w$
then $g_x'(\xi)\leqslant g_x'(w)$ while $y-w<0$; either way
$g_x(y)\geqslant g_x(w)+g_x'(w)(y-w)$, so $g_x$ is convex on the open interval $(0,\infty)$ by
Proposition~\ref{prop:convex-fo}. As $V/\nu$ takes values in $(0,\infty)$ almost surely
(redefine it as $1$ on the null set $\{V=0\}$), Jensen's inequality (Theorem~\ref{thm:jensen}) and
$\expc[V/\nu]=1$ (Proposition~\ref{prop:chisq-moments}),
$\prb\{|T_\nu|>x\}=\expc[g_x(V/\nu)]\geqslant g_x(1)=\prb\{|Z|>x\}$. At $x=z$ this gives
$\prb\{|T_\nu|>z\}\geqslant\alpha=\prb\{|T_\nu|>c_\nu\}$, and since the left side is strictly
decreasing in its argument, $z\leqslant c_\nu$.

\textbf{Step 2: the limit.} $\var(V/\nu)=2/\nu$ by Proposition~\ref{prop:chisq-moments}, so
$V/\nu\convp1$ by Chebyshev's inequality (Theorem~\ref{thm:markov}), hence
$\sqrt{V/\nu}\convp1$ by Theorem~\ref{thm:cmt}, and Theorem~\ref{thm:slutsky}\ref{sl:iii}
gives $T_\nu\convd Z$. The indicator of $(-\infty,x]$ is bounded
and discontinuous only at $x$, a null set for $N(0,1)$, so
Theorem~\ref{thm:portmanteau}\ref{pm:c} gives $\prb\{T_\nu\leqslant x\}\to\Phi(x)$ for every
$x$. Given $\varepsilon>0$, $\Phi(z+\varepsilon)>1-\alpha/2$, so
$\prb\{T_\nu\leqslant z+\varepsilon\}>1-\alpha/2=\prb\{T_\nu\leqslant c_\nu\}$ for all large
$\nu$, the last equality by the symmetry of $T_\nu$, since
$\prb\{T_\nu>x\}=\expc[1-\Phi(x\sqrt{V/\nu})]=\prb\{T_\nu<-x\}$, so that
$\prb\{T_\nu>c_\nu\}=\alpha/2$ and (as $\prb\{T_\nu=c_\nu\}=0$ by continuity of the tail
function) $\prb\{T_\nu\leqslant c_\nu\}=1-\alpha/2$. Here $\Phi(z+\varepsilon)>\Phi(z)=1-\alpha/2$
because $\prb\{Z>z\}=\alpha/2$ by the same symmetry and $\Phi$ is strictly increasing. As
$x\mapsto\prb\{T_\nu\leqslant x\}$ is non-decreasing, $c_\nu\geqslant z+\varepsilon$ would give
$\prb\{T_\nu\leqslant c_\nu\}\geqslant\prb\{T_\nu\leqslant z+\varepsilon\}>1-\alpha/2$; hence
$c_\nu<z+\varepsilon$. With Step 1, $z\leqslant c_\nu<z+\varepsilon$ for all large $\nu$, and
$\varepsilon>0$ is arbitrary.
\end{proof}

%==============================================================================
\section{The Lindeberg--Feller Central Limit Theorem}\label{sec:P.24}
%==============================================================================

A \emph{triangular array} is a doubly indexed collection $\{\xi_{nj} : 1\leqslant j\leqslant
k_n\}$ of random variables, independent within each row $n$. Nothing is assumed across
rows, and the row entries need not be identically distributed.

\begin{theorem}[Lindeberg--Feller]\label{thm:LF}
Let $\{\xi_{nj}\}$ be a triangular array with $\expc[\xi_{nj}]=0$ and
$\sum_j\var(\xi_{nj})\to1$. If the \emph{Lindeberg condition}
\begin{equation}\label{eq:lindeberg}
\sum_{j}\expc\bigl[\xi_{nj}^2\,;\ |\xi_{nj}|>\varepsilon\bigr]\ \longrightarrow\ 0
\qquad\text{for every }\varepsilon>0
\end{equation}
holds, then $\sum_j \xi_{nj}\convd N(0,1)$ and $\sup_j\var(\xi_{nj})\to0$.
\end{theorem}

\begin{proof}
Write $c_{nj}=\expc[\xi_{nj}^2]$ and $c_n=\sum_j c_{nj}\to1$.

\textbf{Step 1: the variances are uniformly negligible.} For any $\varepsilon>0$, splitting
at $|\xi_{nj}|\leqslant\varepsilon$, where $\xi_{nj}^2\leqslant\varepsilon^2$, so that
$c_{nj}=\expc[\xi_{nj}^2;|\xi_{nj}|\leqslant\varepsilon]+\expc[\xi_{nj}^2;|\xi_{nj}|>\varepsilon]$,
\[
\sup_j c_{nj} \leqslant \varepsilon^2
 + \sup_j\expc\bigl[\xi_{nj}^2;|\xi_{nj}|>\varepsilon\bigr]
\leqslant \varepsilon^2 + \sum_j\expc\bigl[\xi_{nj}^2;|\xi_{nj}|>\varepsilon\bigr] .
\]
Letting $n\to\infty$, \eqref{eq:lindeberg} gives $\limsup_n\sup_jc_{nj}\leqslant\varepsilon^2$,
and as $\varepsilon>0$ is arbitrary, $\sup_j c_{nj}\to0$. This is the second conclusion.

\textbf{Step 2: a Gaussian comparison array.} Let $Z_{nj}$ be independent standard normal
variables (on a product space, Remark~\ref{rem:assumed}(c)) and $\zeta_{nj}=c_{nj}^{1/2}Z_{nj}$,
which are independent and $N(0,c_{nj})$ by Definition~\ref{def:mvn}; their characteristic
functions are $\psi_{nj}(t)=e^{-c_{nj}t^2/2}$ by Proposition~\ref{prop:cf-gauss}. By
Proposition~\ref{prop:cf-props}\ref{cf:iii}, applied $k_n-1$ times (each partial sum is
independent of the next summand by Lemma~\ref{lem:disjoint-fn}),
$\zeta_n=\sum_j\zeta_{nj}$ has characteristic function $\prod_j\psi_{nj}(t)=e^{-c_nt^2/2}$,
so $\zeta_n$ is $N(0,c_n)$ by Corollary~\ref{cor:uniqueness}. Since $c_n\to1$,
$e^{-c_nt^2/2}\to e^{-t^2/2}$. In the same way $\sum_j\xi_{nj}$ has characteristic function
$\prod_j\varphi_{nj}(t)$. So if, for each fixed $t$,
\begin{equation}\label{eq:LF-goal}
\Bigl|\prod_j\varphi_{nj}(t)-\prod_j\psi_{nj}(t)\Bigr|\ \longrightarrow\ 0 ,
\end{equation}
$\varphi_{nj}$ and $\psi_{nj}$ denoting the characteristic functions of $\xi_{nj}$ and
$\zeta_{nj}$, then $\prod_j\varphi_{nj}(t)\to e^{-t^2/2}$, the characteristic function of
$N(0,1)$, and Theorem~\ref{thm:levy} gives $\sum_j\xi_{nj}\convd N(0,1)$. It remains to
prove~\eqref{eq:LF-goal}.

\textbf{Step 3: reduce to individual terms.} Characteristic functions have modulus at most
$1$, so Lemma~\ref{lem:prodcomp} bounds the left side of~\eqref{eq:LF-goal} by
$\sum_j|\varphi_{nj}(t)-\psi_{nj}(t)|$, and inserting $1-\tfrac12t^2c_{nj}$ and using the
triangle inequality,
\begin{equation}\label{eq:LF-split}
\Bigl|\prod_j\varphi_{nj}-\prod_j\psi_{nj}\Bigr|
\leqslant \sum_j\bigl|\varphi_{nj}(t)-1+\tfrac12t^2c_{nj}\bigr|
        + \sum_j\bigl|\psi_{nj}(t)-1+\tfrac12t^2c_{nj}\bigr| .
\end{equation}

\textbf{Step 4: bound each term.} Both $\xi_{nj}$ and $\zeta_{nj}$ have mean zero and
variance $c_{nj}$, so consider a generic such variable $\xi$. Lemma~\ref{lem:taylor-exp}
with $m=2$ at the point $t\xi$ gives
$|e^{it\xi}-1-it\xi+\tfrac12t^2\xi^2|\leqslant\min\{t^2\xi^2,|t|^3|\xi|^3/6\}$. Using
$\expc[\xi]=0$, linearity (Theorem~\ref{thm:int-linear}(i), all terms being integrable as
$\expc\xi^2<\infty$) and Theorem~\ref{thm:int-linear}(iii),
\[
\bigl|\expc[e^{it\xi}]-1+\tfrac12t^2\expc[\xi^2]\bigr|
= \bigl|\expc\bigl[e^{it\xi}-1-it\xi+\tfrac12t^2\xi^2\bigr]\bigr|
\leqslant \expc\Bigl[\min\Bigl\{t^2\xi^2,\ \tfrac{|t|^3|\xi|^3}{6}\Bigr\}\Bigr]
\lesssim_t \expc\bigl[\xi^2(1\wedge|\xi|)\bigr] ,
\]
where $\lesssim_t$ means $\leqslant$ up to the factor $C_t=t^2+|t|^3$, depending on $t$
alone: if $|\xi|\leqslant1$ the minimum is at most $|t|^3\xi^2|\xi|\leqslant C_t\xi^2(1\wedge|\xi|)$,
and if $|\xi|>1$ it is at most $t^2\xi^2\leqslant C_t\xi^2(1\wedge|\xi|)$. Applying this to each $\xi_{nj}$ and each
$\zeta_{nj}$ turns~\eqref{eq:LF-split} into
\[
\Bigl|\prod_j\varphi_{nj}-\prod_j\psi_{nj}\Bigr|
\ \lesssim_t\ \sum_j\expc\bigl[\xi_{nj}^2(1\wedge|\xi_{nj}|)\bigr]
       + \sum_j\expc\bigl[\zeta_{nj}^2(1\wedge|\zeta_{nj}|)\bigr] .
\]

\textbf{Step 5: both sums vanish.} For the first, split at $\varepsilon$:
\[
\sum_j\expc\bigl[\xi_{nj}^2(1\wedge|\xi_{nj}|)\bigr]
\leqslant \varepsilon\sum_j c_{nj} + \sum_j\expc\bigl[\xi_{nj}^2;|\xi_{nj}|>\varepsilon\bigr] ,
\]
because $\xi^2(1\wedge|\xi|)\leqslant\varepsilon\xi^2$ on $\{|\xi|\leqslant\varepsilon\}$ and
$\leqslant\xi^2$ on $\{|\xi|>\varepsilon\}$. Its $\limsup$ is at most $\varepsilon\cdot1$
by $c_n\to1$ and~\eqref{eq:lindeberg}, and $\varepsilon>0$ is arbitrary, so it tends to $0$.
For the second, bound $1\wedge|\zeta|\leqslant|\zeta|$ and use the third absolute moment of
a centred Gaussian, $\expc|\zeta_{nj}|^3 = c_{nj}^{3/2}\expc|Z|^3$ with $Z$ standard normal
(by Step~2, $\zeta_{nj}=c_{nj}^{1/2}Z_{nj}$, and $\expc|Z_{nj}|^3=\int|z|^3\phi(z)\,\dd z=\expc|Z|^3$
by Lemma~\ref{lem:density-int}), where
$\expc|Z|^3\leqslant\expc[1+Z^4]=4$ by Lemma~\ref{lem:fourth}:
\[
\sum_j\expc\bigl[\zeta_{nj}^2(1\wedge|\zeta_{nj}|)\bigr]
\leqslant \expc|Z|^3\sum_j c_{nj}^{3/2}
\leqslant \expc|Z|^3\ c_n\,\sup_j c_{nj}^{1/2}\ \longrightarrow\ 0
\]
by Step 1 and $c_n\to1$, using $c_{nj}^{3/2}=c_{nj}\,c_{nj}^{1/2}\leqslant c_{nj}\sup_ic_{ni}^{1/2}$.
Hence~\eqref{eq:LF-goal} holds, and the theorem follows.
\end{proof}

\begin{corollary}[Lindeberg--L\'evy]\label{cor:iid-clt}
If $X_1,X_2,\ldots$ are independent and identically distributed with mean $\mu$ and finite
variance $\sigma^2>0$, then
$n^{-1/2}\sum_{i\leqslant n}(X_i-\mu)/\sigma \convd N(0,1)$.
\end{corollary}

\begin{proof}
Put $\xi_{nj}=(X_j-\mu)/(\sigma\sqrt n)$ for $j\leqslant n$. These are independent within a
row with mean $0$ and $\sum_j\var(\xi_{nj}) = 1$ exactly. Writing $Y=(X_1-\mu)/\sigma$, the
Lindeberg sum is
\[
\sum_{j=1}^n\expc\bigl[\xi_{nj}^2;|\xi_{nj}|>\varepsilon\bigr]
= n\cdot\frac1n\expc\bigl[Y^2;|Y|>\varepsilon\sqrt n\bigr]
= \expc\bigl[Y^2;|Y|>\varepsilon\sqrt n\bigr] ,
\]
the $Y_j=(X_j-\mu)/\sigma$ having the law of $Y$. This tends to $0$ by dominated convergence
(Theorem~\ref{thm:dct}): $Y^2\indc\{|Y|>\varepsilon\sqrt n\}\to0$ pointwise, $Y$ being
finite, and it is dominated by $Y^2$, with $\expc[Y^2]=1$ finite. Theorem~\ref{thm:LF} gives
$\sum_j\xi_{nj}=n^{-1/2}\sum_{i\leqslant n}(X_i-\mu)/\sigma\convd N(0,1)$.
\end{proof}

\begin{corollary}[Weighted sums]\label{cor:weighted}
Let $\varepsilon_1,\varepsilon_2,\ldots$ be independent with mean $0$, common variance
$\tau^2>0$ and $\sup_i\expc[\varepsilon_i^2;|\varepsilon_i|>a]\to0$ as $a\to\infty$; let
$\bz_i\in\Real^p$ be non-random with
\[
n^{-1}\sum_{i\leqslant n}\bz_i\bz_i'\to\bQ \ \text{positive definite},
\qquad n^{-1}\max_{i\leqslant n}|\bz_i|^2\to0 .
\]
Then $\ds n^{-1/2}\sum_{i\leqslant n}\bz_i\varepsilon_i \convd N(\bzero,\ \tau^2\bQ)$.
\end{corollary}

\begin{proof}
By Cram\'er--Wold (Corollary~\ref{cor:cramer-wold}) it suffices to treat
$S_n(\theta)=n^{-1/2}\sum_i\langle\theta,\bz_i\rangle\varepsilon_i$ for fixed
$\theta\neq\bzero$. Put $a_{ni}=\langle\theta,\bz_i\rangle/\sqrt n$ and
$\xi_{ni}=a_{ni}\varepsilon_i/v_n$ with
$v_n^2=\tau^2 n^{-1}\sum_i\langle\theta,\bz_i\rangle^2\to\tau^2\theta'\bQ\theta>0$. Then
$\expc[\xi_{ni}]=0$ and $\sum_i\var(\xi_{ni})=\sum_ia_{ni}^2\tau^2/v_n^2=1$ (the limit of
$v_n^2$ is $\tau^2\theta'(n^{-1}\sum_i\bz_i\bz_i')\theta\to\tau^2\theta'\bQ\theta$, positive
as $\bQ$ is positive definite, so $v_n>0$ for large $n$). By Theorem~\ref{thm:CS},
$|a_{ni}|\leqslant|\theta|\,n^{-1/2}\max_i|\bz_i| =: |\theta|\,\delta_n$ with
$\delta_n\to0$, so $\{|\xi_{ni}|>\varepsilon\}=\{|\varepsilon_i|>\varepsilon v_n/|a_{ni}|\}
\subseteq\{|\varepsilon_i|>\varepsilon v_n/(|\theta|\delta_n)\}$ and
\[
\sum_i\expc\bigl[\xi_{ni}^2;|\xi_{ni}|>\varepsilon\bigr]
\leqslant \frac{1}{v_n^2}\sum_i a_{ni}^2\,
  \expc\bigl[\varepsilon_i^2;\ |\varepsilon_i|>\varepsilon v_n/(|\theta|\delta_n)\bigr]
\leqslant \frac{\sum_i a_{ni}^2}{v_n^2}\,
  \sup_i\expc\bigl[\varepsilon_i^2;|\varepsilon_i|>b_n\bigr]
\]
with $b_n=\varepsilon v_n/(|\theta|\delta_n)\to\infty$. The prefactor tends to
$1/\tau^2$ and the supremum to $0$, so the Lindeberg condition holds and
Theorem~\ref{thm:LF} gives $S_n(\theta)/v_n\convd N(0,1)$. As $v_n\to v=\tau(\theta'\bQ\theta)^{1/2}$,
a constant, Theorem~\ref{thm:slutsky}\ref{sl:iii} gives
$S_n(\theta)=v_n\cdot S_n(\theta)/v_n\convd vZ\sim N(0,\tau^2\theta'\bQ\theta)$, which by
Theorem~\ref{thm:mvn-linear} is the law of $\langle\theta,V\rangle$ for
$V\sim N(\bzero,\tau^2\bQ)$. For $\theta=\bzero$ both sides are $0$. Corollary~\ref{cor:cramer-wold}
completes the proof.
\end{proof}

\begin{remark}
The condition $n^{-1}\max_i|\bz_i|^2\to0$ says no single observation dominates the design.
In regression terms it is implied by $\max_i h_{ii}\to0$, where $\bZ$ has rows $\bz_i'$
and $h_{ii}=\bz_i'(\bZ'\bZ)^{-1}\bz_i$: by Corollary~\ref{cor:rayleigh} applied to
$(\bZ'\bZ)^{-1}$, $h_{ii}\geqslant|\bz_i|^2/\lambda_{\max}(\bZ'\bZ)$, and
$\lambda_{\max}(\bZ'\bZ)/n\to\lambda_{\max}(\bQ)$ because, as in the proof of
Lemma~\ref{lem:inv-limit}, $|\bv'(n^{-1}\bZ'\bZ-\bQ)\bv|\to0$ uniformly over $|\bv|=1$; so
$n^{-1}\max_i|\bz_i|^2\leqslant\max_ih_{ii}\,\lambda_{\max}(\bZ'\bZ)/n\to0$. Without it one observation can carry a non-vanishing share of the sum, the Lindeberg
condition fails, and the limit, if there is one, need not be normal.
\end{remark}

\begin{corollary}[Bounded summands with unequal variances]\label{cor:bounded-clt}
Let $\bW_1,\bW_2,\ldots$ be independent random vectors in $\Real^p$ with
$\expc[\bW_i]=\bzero$ and $|\bW_i|\leqslant M$ almost surely for a constant $M$ free of
$i$, and suppose
\[
\bF_n = \frac1n\sum_{i\leqslant n}\var(\bW_i)\ \longrightarrow\ \bF
\quad\text{positive definite.}
\]
Then $\ds n^{-1/2}\sum_{i\leqslant n}\bW_i\convd N(\bzero,\bF)$.
\end{corollary}

\begin{proof}
By Cram\'er--Wold (Corollary~\ref{cor:cramer-wold}) fix $\theta\neq\bzero$ and put
$\xi_{ni}=\langle\theta,\bW_i\rangle/(\sqrt n\,v_n)$ with
$v_n^2=\theta'\bF_n\theta\to\theta'\bF\theta>0$. Then $\expc[\xi_{ni}]=0$ and
$\sum_i\var(\xi_{ni})=\theta'\bF_n\theta/v_n^2=1$.

By Cauchy--Schwarz (Theorem~\ref{thm:CS}), $|\xi_{ni}|\leqslant|\theta|M/(\sqrt n\,v_n)$,
which tends to $0$ uniformly in $i$. So for each $\varepsilon>0$ the event
$\{|\xi_{ni}|>\varepsilon\}$ has probability $0$ for all large $n$ and every $i$, and the Lindeberg
sum~\eqref{eq:lindeberg} is exactly $0$ (each expectation is over an event of probability
$0$). Theorem~\ref{thm:LF} gives $\sum_i\xi_{ni}\convd N(0,1)$, and with
$v_n\to(\theta'\bF\theta)^{1/2}$, Theorem~\ref{thm:slutsky}\ref{sl:iii} gives
$n^{-1/2}\sum_i\langle\theta,\bW_i\rangle=v_n\sum_i\xi_{ni}\convd N(0,\theta'\bF\theta)$,
the law of $\langle\theta,V\rangle$ for $V\sim N(\bzero,\bF)$ by
Theorem~\ref{thm:mvn-linear}. Corollary~\ref{cor:cramer-wold} completes the proof.
\end{proof}

\begin{remark}
Corollary~\ref{cor:weighted} keeps the variance common and lets the weights vary;
Corollary~\ref{cor:bounded-clt} lets the variance vary and pays for it with a uniform
bound on the summands. The score of a binary regression, $\sum_i\bx_i(y_i-\pi_i)$, has both features and is bounded whenever the design is, so it falls under the second.
\end{remark}

\begin{corollary}[Lyapunov]\label{cor:lyapunov}
Let $\bW_1,\bW_2,\ldots$ be independent random vectors in $\Real^p$ with
$\expc[\bW_i]=\bzero$ and $\sup_i\expc|\bW_i|^{2+\delta}\leqslant C<\infty$ for some
$\delta>0$, and suppose $\bF_n=n^{-1}\sum_{i\leqslant n}\var(\bW_i)\to\bF$ positive
definite. Then $\ds n^{-1/2}\sum_{i\leqslant n}\bW_i\convd N(\bzero,\bF)$.
\end{corollary}

\begin{proof}
As before, fix $\theta\neq\bzero$ and put $\xi_{ni}=\langle\theta,\bW_i\rangle/(\sqrt n\,v_n)$
with $v_n^2=\theta'\bF_n\theta\to\theta'\bF\theta>0$, so that $\expc[\xi_{ni}]=0$ and
$\sum_i\var(\xi_{ni})=1$. On $\{|\xi_{ni}|>\varepsilon\}$ one has
$1\leqslant(|\xi_{ni}|/\varepsilon)^{\delta}$, so
\[
\sum_{i\leqslant n}\expc\bigl[\xi_{ni}^2;|\xi_{ni}|>\varepsilon\bigr]
\leqslant \frac{1}{\varepsilon^{\delta}}\sum_{i\leqslant n}\expc|\xi_{ni}|^{2+\delta}
\leqslant \frac{|\theta|^{2+\delta}C}{\varepsilon^{\delta}v_n^{2+\delta}}\,
          \frac{n}{n^{1+\delta/2}} ,
\]
using Cauchy--Schwarz (Theorem~\ref{thm:CS}) on $|\langle\theta,\bW_i\rangle|$, so that
$\expc|\xi_{ni}|^{2+\delta}\leqslant|\theta|^{2+\delta}C/(\sqrt n\,v_n)^{2+\delta}$. The right
side is $O(n^{-\delta/2})\to0$, as $v_n$ is bounded away from $0$, so the Lindeberg condition
holds and Theorem~\ref{thm:LF} gives $\sum_i\xi_{ni}\convd N(0,1)$; as in the proof of
Corollary~\ref{cor:bounded-clt}, Theorem~\ref{thm:slutsky}\ref{sl:iii} turns this into
$n^{-1/2}\sum_i\langle\theta,\bW_i\rangle\convd N(0,\theta'\bF\theta)$, and Cram\'er--Wold
(Corollary~\ref{cor:cramer-wold}) completes the proof.
\end{proof}

\begin{remark}
A Poisson score $\sum_i\bx_i(y_i-\mu_i)$ is not bounded, so Corollary~\ref{cor:lyapunov} applies to it where Corollary~\ref{cor:bounded-clt} does not, provided the design and the means $\mu_i$ are bounded and $\bF_n$ converges to a positive definite limit; any
$\delta>0$ will do, and $\delta=2$ needs only bounded fourth moments.
\end{remark}

%==============================================================================
\section{Dependent Summands}\label{sec:P.24d}
%==============================================================================

\begin{definition}[Weak stationarity]\label{def:wstat}
A sequence $\{X_t\}_{t\in\mathbb{Z}}$ with $\expc[X_t^2]<\infty$ is \emph{weakly
stationary} if $\expc[X_t]=\mu$ and $\cov(X_t,X_{t+k})=\gamma(k)$ are free of $t$;
$\gamma$ is its \emph{autocovariance function}. It is \emph{strictly stationary} if the law
of $(X_{t_1},\ldots,X_{t_r})$ is unchanged when every index is shifted by the same $h$.
\end{definition}

\begin{lemma}[Variance of a stationary average]\label{lem:stat-mean}
For a weakly stationary sequence,
\begin{equation}\label{eq:stat-mean}
\var\Bigl(\frac1n\sum_{t=1}^{n}X_t\Bigr)
=\frac1n\sum_{|k|<n}\Bigl(1-\frac{|k|}{n}\Bigr)\gamma(k) .
\end{equation}
If $\gamma(k)\to0$ as $k\to\infty$, the right side tends to $0$ and
$n^{-1}\sum_{t\leqslant n}X_t\convp\mu$.
\end{lemma}

\begin{proof}
By bilinearity of the covariance,
$\var\bigl(\sum_{t\leqslant n}X_t\bigr)=\sum_{s,t\leqslant n}\cov(X_s,X_t)=\sum_{s,t\leqslant n}\gamma(t-s)$,
as $\cov(X_s,X_{s+k})=\gamma(k)$ with $k=t-s$ (for $k<0$ too, the definition being for
every integer $k$). For each $k$ with $|k|<n$ there are exactly $n-|k|$ pairs $(s,t)$ in
$\{1,\ldots,n\}^2$ with $t-s=k$ (for $k\geqslant0$, $s=1,\ldots,n-k$; for $k<0$,
$t=1,\ldots,n+k$); grouping the terms by $k$ and dividing by $n^2$ gives~\eqref{eq:stat-mean}.

Assume $\gamma(k)\to0$ and fix $\varepsilon>0$. Choose $K$ with $|\gamma(k)|\leqslant
\varepsilon$ for $|k|>K$. Since $|\gamma(k)|\leqslant\gamma(0)$ by Cauchy--Schwarz
(Lemma~\ref{lem:minkowski} with $\mu=\prb$, applied to the centred $X_t$ and $X_{t+k}$,
each of variance $\gamma(0)$) and
$0\leqslant1-|k|/n\leqslant1$, the $2K+1$ terms with $|k|\leqslant K$ contribute at most
$n^{-1}(2K+1)\gamma(0)$ to the modulus of the right side of~\eqref{eq:stat-mean}, and the
fewer than $2n$ terms with $K<|k|<n$ at most $n^{-1}\cdot2n\varepsilon=2\varepsilon$. Letting
$n\to\infty$, the $\limsup$ is at most $2\varepsilon$, and $\varepsilon>0$ is arbitrary, so
the variance tends to $0$. The average has mean $\mu$, so Chebyshev's inequality
(Theorem~\ref{thm:markov}) gives
$\prb\{|n^{-1}\sum_tX_t-\mu|\geqslant\eta\}\leqslant\var(n^{-1}\sum_tX_t)/\eta^2\to0$ for every
$\eta>0$.
\end{proof}

\begin{remark}
Independence is not needed, only that the correlation between distant terms dies out.
Without that the conclusion fails: the constant sequence $X_t=X_0$ with $\var X_0>0$ is
weakly stationary with $\gamma(k)=\var X_0$ for every $k$, and its average is $X_0$, which
does not converge to $\mu$.
\end{remark}

\begin{lemma}[Approximation]\label{lem:approx-clt}
Let $S_n$ and $S_n^{(p)}$, $n,p\geqslant1$, be real random variables such that
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{ap:i} for each fixed $p$, $S_n^{(p)}\convd Z_p$ as $n\to\infty$;
\item\label{ap:ii} $Z_p\convd Z$ as $p\to\infty$;
\item\label{ap:iii} $\ds\lim_{p\to\infty}\ \limsup_{n\to\infty}\
      \prb\bigl\{|S_n-S_n^{(p)}|>\varepsilon\bigr\}=0$ for every $\varepsilon>0$.
\end{enumerate}
Then $S_n\convd Z$.
\end{lemma}

\begin{proof}
By Theorem~\ref{thm:levy} it is enough that $\expc[e^{itS_n}]\to\expc[e^{itZ}]$ for each
fixed $t$. Write, for any $p$,
\[
\bigl|\expc[e^{itS_n}]-\expc[e^{itZ}]\bigr|
\leqslant \expc\bigl|e^{itS_n}-e^{itS_n^{(p)}}\bigr|
 + \bigl|\expc[e^{itS_n^{(p)}}]-\expc[e^{itZ_p}]\bigr|
 + \bigl|\expc[e^{itZ_p}]-\expc[e^{itZ}]\bigr| .
\]
For the first term, $|e^{ia}-e^{ib}|=|e^{i(a-b)}-1|\leqslant\min\{2,|a-b|\}$ by
Lemma~\ref{lem:taylor-exp} with $m=0$, so for every $\varepsilon>0$
\[
\expc\bigl|e^{itS_n}-e^{itS_n^{(p)}}\bigr|
\leqslant \expc\bigl[\min\{2,\ |t|\,|S_n-S_n^{(p)}|\}\bigr]
\leqslant |t|\varepsilon + 2\,\prb\bigl\{|S_n-S_n^{(p)}|>\varepsilon\bigr\} .
\]
The second term vanishes as $n\to\infty$ by~\ref{ap:i} and Theorem~\ref{thm:levy}. Taking
$\limsup_n$ therefore leaves
\[
\limsup_{n}\bigl|\expc[e^{itS_n}]-\expc[e^{itZ}]\bigr|
\leqslant |t|\varepsilon + 2\limsup_n\prb\bigl\{|S_n-S_n^{(p)}|>\varepsilon\bigr\}
 + \bigl|\expc[e^{itZ_p}]-\expc[e^{itZ}]\bigr| .
\]
The left side does not depend on $p$ or $\varepsilon$. Now let $p\to\infty$: the second term
vanishes by~\ref{ap:iii} and the third by~\ref{ap:ii} with Theorem~\ref{thm:levy}, leaving
the bound $|t|\varepsilon$. Finally let $\varepsilon\to0$: the $\limsup$ is $0$.
\end{proof}

\begin{definition}[$m$-dependence]\label{def:mdep}
$\{X_t\}$ is \emph{$m$-dependent} if for every $t$ and all finite index sets
$I\subseteq\{s:s\leqslant t\}$ and $J\subseteq\{s:s\geqslant t+m+1\}$ the random vectors
$(X_s)_{s\in I}$ and $(X_s)_{s\in J}$ are independent.
\end{definition}

\begin{lemma}[Shift functions of an independent sequence]\label{lem:mdep-fn}
Let $\{\varepsilon_t\}_{t\in\mathbb{Z}}$ be independent and identically distributed and put
$X_t=g(\varepsilon_{t-m},\ldots,\varepsilon_t)$ for one measurable
$g:\Real^{m+1}\to\Real$. Then $\{X_t\}$ is strictly stationary and $m$-dependent.
\end{lemma}

\begin{proof}
Fix indices $t_1,\ldots,t_r$ and $h$, and let $A=\bigcup_i\{t_i-m,\ldots,t_i\}$. The
families $(\varepsilon_u)_{u\in A}$ and $(\varepsilon_{u+h})_{u\in A}$ have the same law,
being independent with a common marginal and indexed in the same order: both laws are the
product of $|A|$ copies of the law of $\varepsilon_0$ (Definition~\ref{def:indep}), unique by
Corollary~\ref{cor:finite-product}. And $(X_{t_1},\ldots,X_{t_r})$ and
$(X_{t_1+h},\ldots,X_{t_r+h})$ are the images of the two families under the same measurable
map $G$ (built from $g$ coordinate by coordinate), so for Borel $B$,
$\prb\{(X_{t_i})_i\in B\}=\prb\{(\varepsilon_u)_{u\in A}\in G^{-1}(B)\}
=\prb\{(\varepsilon_{u+h})_{u\in A}\in G^{-1}(B)\}=\prb\{(X_{t_i+h})_i\in B\}$. That is
strict stationarity. For $m$-dependence, $(X_s)_{s\in
I}$ with $I\subseteq\{s\leqslant t\}$ finite is a function of $(\varepsilon_u)_{u\in U}$
with $U\subseteq\{u\leqslant t\}$ finite (each $X_s$, $s\leqslant t$, uses
$\varepsilon_{s-m},\ldots,\varepsilon_s$, all with index $\leqslant t$), while $(X_s)_{s\in J}$
with $J\subseteq\{s\geqslant t+m+1\}$ finite is a function of $(\varepsilon_u)_{u\in V}$ with
$V\subseteq\{u\geqslant t+1\}$ finite (indices $\geqslant s-m\geqslant t+1$); the two index
sets are disjoint, so Lemma~\ref{lem:disjoint-fn}, applied to the finitely many
$\varepsilon_u$ with $u\in U\cup V$, gives the independence.
\end{proof}

\begin{theorem}[Central limit theorem for $m$-dependent sequences]\label{thm:mdep-clt}
Let $\{X_t\}$ be strictly stationary and $m$-dependent with $\expc[X_t]=0$ and
$\expc[X_t^2]<\infty$, and write $\gamma(k)=\expc[X_tX_{t+k}]$. Then $\gamma(k)=0$ for
$|k|>m$,
\begin{equation}\label{eq:mdep-var}
\sigma^2 \;=\; \gamma(0)+2\sum_{k=1}^{m}\gamma(k) \;\geqslant\; 0 ,
\end{equation}
and $\ds n^{-1/2}\sum_{t=1}^{n}X_t\convd N(0,\sigma^2)$, where $N(0,0)$ is read as the point
mass at $0$.
\end{theorem}

\begin{proof}
Strict stationarity with finite second moments makes $\expc[X_tX_{t+k}]$ free of $t$, so
$\{X_t\}$ is weakly stationary and $\gamma(-k)=\expc[X_{t-k}X_t]=\gamma(k)$. For $k>m$,
Definition~\ref{def:mdep} with $I=\{t\}$ and $J=\{t+k\}$ makes $X_t$ and $X_{t+k}$
independent, so $\gamma(k)=\expc[X_t]\expc[X_{t+k}]=0$ by Lemma~\ref{lem:disjoint-fn}
(with the two independent variables $X_t$, $X_{t+k}$ in the role of the $\varepsilon$); and
$\gamma(-k)=\gamma(k)=0$. Hence, by Lemma~\ref{lem:stat-mean} applied to a block of $l$
consecutive terms (its first display multiplied by $l^2$),
\begin{equation}\label{eq:block-var}
\var\Bigl(\sum_{t=1}^{l}X_t\Bigr)=\sum_{|k|<l}(l-|k|)\gamma(k)
=\sum_{|k|\leqslant m\wedge(l-1)}(l-|k|)\gamma(k) .
\end{equation}
Dividing by $l$, $l^{-1}\var(\sum_{t\leqslant l}X_t)=\sum_{|k|\leqslant m}(1-|k|/l)\gamma(k)$ for
$l>m$, which tends to $\sum_{|k|\leqslant m}\gamma(k)=\gamma(0)+2\sum_{k=1}^m\gamma(k)=\sigma^2$
as $l\to\infty$; a limit of non-negative numbers is non-negative, so $\sigma^2\geqslant0$. Put
$C=\sum_{|k|\leqslant m}|\gamma(k)|$, so
$\var(\sum_{t\leqslant l}X_t)\leqslant\sum_{|k|\leqslant m}l|\gamma(k)|=lC$ for every $l$.
Write $S_n=n^{-1/2}\sum_{t\leqslant n}X_t$.

\textbf{Blocks.} Fix an integer $p>m$ and let $r=\lfloor n/(p+m)\rfloor$. Cut
$\{1,\ldots,n\}$ into $r$ consecutive stretches of length $p+m$ followed by a remainder,
and inside the $i$th stretch let $U_i$ be the sum of the first $p$ terms and $V_i$ the sum
of the last $m$; let $R_n$ be the sum over the remainder, which has fewer than $p+m$ terms.
Then
\[
\sum_{t=1}^{n}X_t=\sum_{i=1}^{r}U_i+\sum_{i=1}^{r}V_i+R_n .
\]

\textbf{The big blocks are independent and identically distributed.} The index set of $U_i$
ends at $(i-1)(p+m)+p$ and that of $U_{i+1}$ begins $m+1$ places later, so
Definition~\ref{def:mdep}, with $t=(i-1)(p+m)+p$, makes $(U_1,\ldots,U_i)$, a function of
$(X_s)_{s\leqslant t}$, independent of $(U_{i+1},\ldots,U_r)$, a function of
$(X_s)_{s\geqslant t+m+1}$, for each $i$. Iterating, by downward induction on $i$: if
$\prb\{U_{i+1}\in B_{i+1},\ldots,U_r\in B_r\}=\prod_{j>i}\prb\{U_j\in B_j\}$, then the
independence of $U_i$ and $(U_{i+1},\ldots,U_r)$ (a function of the independent pair just
described) gives the same product formula from $i$ on; at $i=1$ this is full independence.
Strict stationarity makes them identically distributed, each $U_i$ being the same function
of $p$ consecutive terms shifted by $(i-1)(p+m)$. The same argument, with the gap now the
big block of length $p>m$, applies to $V_1,\ldots,V_r$.

\textbf{Limit of the big-block sum.} By~\eqref{eq:block-var} with $l=p>m$,
\[
\var(U_1)=\sum_{|k|\leqslant m}(p-|k|)\gamma(k)=p\,\sigma^2-c ,
\qquad c=\sum_{|k|\leqslant m}|k|\gamma(k) ,
\]
which is free of $n$. The blocks $U_1,U_2,\ldots$ are fixed (they do not depend on $n$),
and only their number $r=r(n)\to\infty$ grows with $n$. If $\var(U_1)=0$ then each $U_i$,
having mean $0$, vanishes almost surely (Proposition~\ref{prop:null}(iv) applied to $U_i^2$),
and $S_n^{(p)}:=n^{-1/2}\sum_iU_i$ is $0$ almost surely; otherwise
Corollary~\ref{cor:iid-clt} gives $k^{-1/2}\sum_{i\leqslant k}U_i/\sd(U_1)\convd N(0,1)$ as
$k\to\infty$, hence along $k=r(n)$, and multiplying by $\sd(U_1)$
(Proposition~\ref{prop:cf-props}\ref{cf:iv} and Theorem~\ref{thm:levy})
$r^{-1/2}\sum_iU_i\convd N(0,\var(U_1))$. Since $n/(p+m)-1<r\leqslant n/(p+m)$,
$r/n\to(p+m)^{-1}$, and Theorem~\ref{thm:slutsky}\ref{sl:iii} yields in both cases
\[
S_n^{(p)}=\sqrt{r/n}\;\Bigl(r^{-1/2}\sum_{i\leqslant r}U_i\Bigr)
\ \convd\ Z_p\sim N(0,\sigma_p^2) ,
\qquad \sigma_p^2=\frac{p\,\sigma^2-c}{p+m} .
\]
As $p\to\infty$, $\sigma_p^2\to\sigma^2$, so $\expc[e^{itZ_p}]=e^{-\sigma_p^2t^2/2}\to
e^{-\sigma^2t^2/2}$ and $Z_p\convd N(0,\sigma^2)$ by Theorem~\ref{thm:levy}.

\textbf{The small blocks and the remainder are negligible.} The $V_i$ are independent with
mean $0$ and, by~\eqref{eq:block-var} with $l=m$, $\var(V_1)\leqslant mC$; their cross
moments vanish by Lemma~\ref{lem:disjoint-fn}, so $\expc[(\sum_iV_i)^2]=r\var(V_1)$. The
remainder $R_n$ is a sum of fewer than $p+m$ consecutive terms, so
$\var(R_n)\leqslant(p+m)C$. Hence
\[
\expc\bigl[(S_n-S_n^{(p)})^2\bigr]
=\frac1n\expc\Bigl[\Bigl(\sum_iV_i+R_n\Bigr)^2\Bigr]
\leqslant \frac2n\bigl\{r\,\var(V_1)+\var(R_n)\bigr\}
\leqslant \frac{2mC}{p+m}+\frac{2(p+m)C}{n} ,
\]
using $(a+b)^2\leqslant2a^2+2b^2$ and $r\leqslant n/(p+m)$. By Chebyshev's inequality
(Theorem~\ref{thm:markov}),
$\limsup_n\prb\{|S_n-S_n^{(p)}|>\varepsilon\}\leqslant 2mC/\{(p+m)\varepsilon^2\}$, which
tends to $0$ as $p\to\infty$. Lemma~\ref{lem:approx-clt} completes the proof.
\end{proof}

\begin{definition}[The past space]\label{def:past}
Let $\{\varepsilon_t\}_{t\in\mathbb{Z}}$ be independent and identically distributed with
mean $0$ and variance $\tau^2\in(0,\infty)$. Let $\calL_t$ be the closure in
$L^2$ (Definition~\ref{def:L2}) of the set of square-integrable measurable functions of
finitely many $\varepsilon_u$ with $u\leqslant t$.
\end{definition}

Each $\calL_t$ is a closed subspace of $L^2$ and $\calL_s\subseteq\calL_t$ for $s\leqslant
t$. (It is a subspace because $L^2$-limits of sums and multiples are the sums and multiples of
the limits, by the triangle inequality of Lemma~\ref{lem:minkowski}; it is closed by the
diagonal argument used for $\overline E$ in the proof of Theorem~\ref{thm:sep2}, with the
$L^2$ distance of the same lemma in place of $|\cdot|$.) If $(c_j)_{j\geqslant0}$ is square summable then the partial sums of
$\sum_{j\geqslant0}c_j\varepsilon_{t-j}$ are Cauchy in $L^2$. Indeed, the increments are
orthogonal and
\[
\expc\Bigl[\Bigl(\sum_{M<j\leqslant N}c_j\varepsilon_{t-j}\Bigr)^2\Bigr]
=\tau^2\sum_{M<j\leqslant N}c_j^2 .
\]
Thus the series has an $L^2$ limit and that limit lies in $\calL_t$.

\begin{lemma}[Innovation orthogonality]\label{lem:innovation}
Let $v\in\calL_{t-1}$ and put $X=v\,\varepsilon_t$. Then $X\in\calL_t$ and
\[
\expc[X]=0 ,\qquad \expc[X^2]=\tau^2\,\expc[v^2] ,\qquad
\expc[ZX]=0 \ \text{ for every } Z\in\calL_{t-1} .
\]
\end{lemma}

\begin{proof}
Choose $v^{(M)}\to v$ in $L^2$, each a square-integrable measurable function of finitely
many $\varepsilon_u$ with $u\leqslant t-1$. For fixed $M$, Lemma~\ref{lem:disjoint-fn}
makes $v^{(M)}$ and $\varepsilon_t$ independent, so $v^{(M)}\varepsilon_t$ is square
integrable with
\[
\expc\bigl[v^{(M)}\varepsilon_t\bigr]=0 ,
\qquad
\expc\bigl[(v^{(M)}\varepsilon_t)^2\bigr]=\tau^2\,\expc\bigl[(v^{(M)})^2\bigr] .
\]
Applying the second identity to $v^{(M)}-v^{(M')}$ shows $\{v^{(M)}\varepsilon_t\}_M$ is
Cauchy in $L^2$, hence convergent there; its limit is $v\varepsilon_t$, because $L^2$
convergence implies convergence in probability by Chebyshev's inequality
(Theorem~\ref{thm:markov}) and therefore almost sure convergence along a subsequence
(Lemma~\ref{lem:as-subseq}), along which $v^{(M)}\varepsilon_t\to v\varepsilon_t$, while (by the same two results) a further
subsequence converges almost surely to the $L^2$ limit, so the two limits agree almost
surely. Each
$v^{(M)}\varepsilon_t$ is a square-integrable function of finitely many $\varepsilon_u$ with
$u\leqslant t$, so $X\in\calL_t$, the closure. The two displayed identities pass to the
limit: $|\expc[Y_M]-\expc[Y]|\leqslant\expc|Y_M-Y|\leqslant(\expc|Y_M-Y|^2)^{1/2}\to0$ by
Lemma~\ref{lem:minkowski}, and $\expc[Y_M^2]\to\expc[Y^2]$ because $\|Y_M\|\to\|Y\|$ by the
triangle inequality of the same lemma; apply these to $Y_M=v^{(M)}\varepsilon_t$ and to
$Y_M=v^{(M)}$.

For the third claim take $Z^{(M')}\to Z$ in $L^2$ of the same kind. Then
$Z^{(M')}v^{(M)}$ is a measurable function of finitely many $\varepsilon_u$ with
$u\leqslant t-1$, and it is integrable by Cauchy--Schwarz (Lemma~\ref{lem:minkowski}), so
Lemma~\ref{lem:disjoint-fn} gives
$\expc[Z^{(M')}v^{(M)}\varepsilon_t]=\expc[Z^{(M')}v^{(M)}]\,\expc[\varepsilon_t]=0$.
Letting $M,M'\to\infty$ gives $\expc[ZX]=0$, since by Lemma~\ref{lem:minkowski}
\[
\expc|Z^{(M')}v^{(M)}\varepsilon_t-ZX|
\leqslant\|Z^{(M')}-Z\|\,\|v^{(M)}\varepsilon_t\|+\|Z\|\,\|v^{(M)}\varepsilon_t-X\|\to0 ,
\]
with $\|Y\|=(\expc Y^2)^{1/2}$, as $\|v^{(M)}\varepsilon_t\|$ stays bounded.
\end{proof}

\begin{corollary}[Orthogonality across time]\label{cor:mds}
If $v_{t-1}\in\calL_{t-1}$ for every $t$ and $X_t=v_{t-1}\varepsilon_t$, then
$\expc[X_t]=0$, $\expc[X_sX_t]=0$ for $s\neq t$, and
\begin{equation}\label{eq:mds-var}
\expc\Bigl[\Bigl(\sum_{t=1}^{n}X_t\Bigr)^{2}\Bigr]
=\tau^2\sum_{t=1}^{n}\expc[v_{t-1}^2] .
\end{equation}
\end{corollary}

\begin{proof}
For $s<t$, $X_s\in\calL_s\subseteq\calL_{t-1}$ by Lemma~\ref{lem:innovation}, so the third
statement of that lemma (with $Z=X_s$) gives $\expc[X_sX_t]=0$; $\expc[X_t]=0$ is its first
statement. Expanding the square,
$\expc[(\sum_tX_t)^2]=\sum_t\expc[X_t^2]+\sum_{s\neq t}\expc[X_sX_t]=\sum_t\expc[X_t^2]$, and
$\expc[X_t^2]=\tau^2\expc[v_{t-1}^2]$ by the second statement gives~\eqref{eq:mds-var}.
\end{proof}

\begin{theorem}[Central limit theorem for autoregressive scores]\label{thm:ar-score-clt}
Let $\{\varepsilon_t\}_{t\in\mathbb{Z}}$ be independent and identically distributed with
mean $0$ and variance $\tau^2\in(0,\infty)$, let $\ba_0,\ba_1,\ldots$ lie in $\Real^d$ with
$\sum_{j\geqslant0}|\ba_j|^2<\infty$, and let
\[
\bu_t=\sum_{j\geqslant0}\ba_j\,\varepsilon_{t-j}
\]
be the $L^2$ limit of its partial sums. Then $\bGam:=\expc[\bu_t\bu_t']
=\tau^2\sum_{j\geqslant0}\ba_j\ba_j'$ is free of $t$ and
\begin{equation}\label{eq:ar-score-clt}
\frac1{\sqrt n}\sum_{t=1}^{n}\bu_{t-1}\,\varepsilon_t \ \convd\ N(\bzero,\ \tau^2\bGam) .
\end{equation}
\end{theorem}

\begin{proof}
\textbf{The limit variance.} Write $\bu_t^{(m)}=\sum_{j<m}\ba_j\varepsilon_{t-j}$. The
$\varepsilon$ are uncorrelated with mean $0$ ($\expc[\varepsilon_{t-j}\varepsilon_{t-k}]=\tau^2$
for $j=k$ and $0$ otherwise, by Lemma~\ref{lem:disjoint-fn}), so expanding
$\expc[\bu_t^{(m)}\bu_t^{(m)\prime}]=\sum_{j,k<m}\ba_j\ba_k'\expc[\varepsilon_{t-j}\varepsilon_{t-k}]
=\tau^2\sum_{j<m}\ba_j\ba_j'$. As $m\to\infty$ the right side converges entrywise, the
$(r,s)$ entries being bounded by $|\ba_j|^2$, which is summable; and $\bu_t^{(m)}\to\bu_t$ in
$L^2$ coordinatewise, so for each pair of coordinates
$|\expc[AB]-\expc[A'B']|\leqslant\|A-A'\|\,\|B\|+\|A'\|\,\|B-B'\|$
(Lemma~\ref{lem:minkowski}) passes the identity to the limit. The limit
$\tau^2\sum_j\ba_j\ba_j'$ is free of $t$.

\textbf{Reduction to one dimension.} By Cram\'er--Wold
(Corollary~\ref{cor:cramer-wold}) it suffices to show, for each fixed
$\theta\in\Real^d$, that $n^{-1/2}\sum_t\langle\theta,\bu_{t-1}\rangle\varepsilon_t\convd
N(0,\tau^2\theta'\bGam\theta)$. Put $a_j=\langle\theta,\ba_j\rangle$ and
$u_t=\langle\theta,\bu_t\rangle=\sum_ja_j\varepsilon_{t-j}$, a square-summable
combination with $\expc[u_t^2]=\tau^2\sum_ja_j^2=\theta'\bGam\theta$. So it is enough to
prove the scalar statement
\[
S_n=\frac1{\sqrt n}\sum_{t=1}^{n}u_{t-1}\varepsilon_t \convd N\Bigl(0,\ \tau^4\sum_{j\geqslant0}a_j^2\Bigr) .
\]

\textbf{Truncation.} Put $u_{t-1}^{(m)}=\sum_{j<m}a_j\varepsilon_{t-1-j}$,
$X_t^{(m)}=u_{t-1}^{(m)}\varepsilon_t$ and $S_n^{(m)}=n^{-1/2}\sum_{t\leqslant n}
X_t^{(m)}$. Since $X_t^{(m)}=g(\varepsilon_{t-m},\ldots,\varepsilon_t)$ with
$g(x_0,\ldots,x_m)=x_m\sum_{j<m}a_jx_{m-1-j}$, Lemma~\ref{lem:mdep-fn} makes
$\{X_t^{(m)}\}$ strictly stationary and $m$-dependent. Corollary~\ref{cor:mds} gives
$\expc[X_t^{(m)}]=0$, $\gamma^{(m)}(k)=0$ for $k\neq0$ and
$\gamma^{(m)}(0)=\tau^2\expc[(u^{(m)})^2]=\tau^4\sum_{j<m}a_j^2$. So
Theorem~\ref{thm:mdep-clt} applies with $\sigma^2=\gamma^{(m)}(0)$:
\[
S_n^{(m)}\ \convd\ Z_m\sim N\Bigl(0,\ \tau^4\sum_{j<m}a_j^2\Bigr) \quad (n\to\infty) ,
\qquad
Z_m\ \convd\ N\Bigl(0,\ \tau^4\sum_{j\geqslant0}a_j^2\Bigr)\quad (m\to\infty) ,
\]
the second by Theorem~\ref{thm:levy} as in the previous proof.

\textbf{Negligibility.} The difference is $X_t-X_t^{(m)}=w_{t-1}^{(m)}\varepsilon_t$ with
$w_{t-1}^{(m)}=\sum_{j\geqslant m}a_j\varepsilon_{t-1-j}\in\calL_{t-1}$ and
$\expc[(w_{t-1}^{(m)})^2]=\tau^2\sum_{j\geqslant m}a_j^2$, free of $t$. By
Corollary~\ref{cor:mds},
\[
\expc\bigl[(S_n-S_n^{(m)})^2\bigr]
=\frac1n\cdot n\,\tau^2\,\expc\bigl[(w^{(m)})^2\bigr]
=\tau^4\sum_{j\geqslant m}a_j^2 ,
\]
free of $n$ and tending to $0$ as $m\to\infty$. Chebyshev's inequality
(Theorem~\ref{thm:markov}) gives
$\prb\{|S_n-S_n^{(m)}|>\varepsilon\}\leqslant\tau^4\sum_{j\geqslant m}a_j^2/\varepsilon^2$ for every
$n$, which is hypothesis~\ref{ap:iii} of Lemma~\ref{lem:approx-clt}; the truncation step
supplies~\ref{ap:i} and~\ref{ap:ii}. The lemma gives the scalar statement, whose limit
$N(0,\tau^2\theta'\bGam\theta)$ is, by Theorem~\ref{thm:mvn-linear}, the law of
$\langle\theta,V\rangle$ for $V\sim N(\bzero,\tau^2\bGam)$; Corollary~\ref{cor:cramer-wold}
gives~\eqref{eq:ar-score-clt}.
\end{proof}

\begin{remark}
The summands $u_{t-1}\varepsilon_t$ are uncorrelated by Corollary~\ref{cor:mds} but far
from independent, and $\var(S_n)=\tau^2\expc[u^2]$ exactly, for every $n$. What the theorem
adds is that the limit law is the normal one with that variance. Two of the course's
statistics are of this form: with $a_j=\phi^j$, $|\phi|<1$, it is the score of an $\text{AR}(1)$ least squares
fit, and with $a_j=\indc\{j=k-1\}$ it is the numerator of the lag $k$ sample
autocorrelation of white noise.
\end{remark}

%==============================================================================
\section{The Delta Method}\label{sec:P.25}
%==============================================================================

\begin{theorem}[Delta method]\label{thm:delta}
Let $r_n\to\infty$ and $r_n(T_n-\vartheta)\convd T$ in $\Real^d$, and let
$g:\Real^d\to\Real^m$ be measurable and differentiable at $\vartheta$ with Jacobian $\bD_g(\vartheta)$.
Then
\[
r_n\bigl(g(T_n)-g(\vartheta)\bigr) \convd \bD_g(\vartheta)\,T .
\]
In particular, if $\sqrt n(T_n-\vartheta)\convd N(\bzero,\bSig)$ then
$\sqrt n\{g(T_n)-g(\vartheta)\}\convd N\bigl(\bzero,\ \bD_g\bSig\bD_g'\bigr)$.
\end{theorem}

\begin{proof}
Differentiability at $\vartheta$ means
$g(\vartheta+h) - g(\vartheta) = \bD_g(\vartheta)h + R(h)$ with $|R(h)|/|h|\to0$ as
$h\to0$. Since $r_n(T_n-\vartheta)$ converges in distribution and $r_n\to\infty$,
Proposition~\ref{prop:const} and Theorem~\ref{thm:slutsky}\ref{sl:iii} give
$T_n-\vartheta = r_n^{-1}\cdot r_n(T_n-\vartheta)\convp\bzero$. Writing
$H_n = T_n-\vartheta$,
\[
r_n\bigl(g(T_n)-g(\vartheta)\bigr) = \bD_g(\vartheta)\,r_nH_n + r_nR(H_n) .
\]
The first term converges in distribution to $\bD_g(\vartheta)T$ by
Theorem~\ref{thm:cmt}, the linear map $x\mapsto\bD_g(\vartheta)x$ being continuous. For the
second, define $\rho(h)=|R(h)|/|h|$ for $h\neq\bzero$ and $\rho(\bzero)=0$; $\rho$ is Borel, as
$R(h)=g(\vartheta+h)-g(\vartheta)-\bD_g(\vartheta)h$ is, it is continuous at $\bzero$ by
differentiability, and $|r_nR(H_n)| = \rho(H_n)\,|r_nH_n|$. Here $\rho(H_n)\convp\rho(\bzero)=0$ by
Theorem~\ref{thm:cmt} (in probability, the limit $\bzero$ of $H_n$ not being a discontinuity
point of $\rho$), and $|r_nH_n|\convd|T|$ by the same theorem; so the product converges in
distribution to $0\cdot|T|=0$ by Theorem~\ref{thm:slutsky}\ref{sl:iii}, hence in
probability by Proposition~\ref{prop:const}. One more application of
Theorem~\ref{thm:slutsky}\ref{sl:iii}, to the sum of a sequence converging in distribution
and one converging in probability to $\bzero$, gives
$r_n\{g(T_n)-g(\vartheta)\}\convd\bD_g(\vartheta)T$. In the particular case, $r_n=\sqrt n$, $T\sim N(\bzero,\bSig)$, and
$\bD_g(\vartheta)T\sim N(\bzero,\bD_g\bSig\bD_g')$ by Theorem~\ref{thm:mvn-linear}.
\end{proof}

\begin{theorem}[Quadratic forms of asymptotically normal vectors]\label{thm:quadform}
Let $V_n\convd N(\bzero,\bSig)$ in $\Real^p$ with $\bSig$ positive definite, and let
$\hat\bSig_n\convp\bSig$ with $\hat\bSig_n$ symmetric. Then, with the convention
$\bA^{-1}:=\bzero$ for singular $\bA$ (so that the statistic is defined for every $n$),
\[
V_n'\hat\bSig_n^{-1}V_n \convd \chi^2_p .
\]
\end{theorem}

\begin{proof}
On the symmetric matrices, identified with $\Real^{p(p+1)/2}$, inversion so extended is
measurable: by Corollary~\ref{cor:rayleigh} the smallest eigenvalue of $\bA^2$ is
$\min_{|\bu|=1}|\bA\bu|^2$, so the singular symmetric matrices are those whose $\bA^2$ has
smallest eigenvalue $0$; this set is closed, because the minimum is continuous in $\bA$
($|\bu'(\bB-\bC)\bu|\leqslant\sum_{r,s}|(\bB-\bC)_{rs}|$ for $|\bu|=1$, as in the proof of
Lemma~\ref{lem:inv-limit}); and off it $\bA^2$ is positive definite
(Proposition~\ref{prop:pd-eigen}) and $\bA^{-1}=(\bA^2)^{-1}\bA$ is continuous by
Lemma~\ref{lem:inv-limit}. So for an open set $U$ of matrices, the preimage of $U$ under the
extended inversion is the union of the Borel set $\{\bA\text{ singular}\}$ (if $\bzero\in U$;
otherwise nothing) and the preimage of $U$ under the continuous inversion on the open set of
non-singular matrices, which is open; so the extended inversion is measurable. It is also
continuous at $\bSig$: Lemma~\ref{lem:inv-limit} makes matrices converging to $\bSig$
invertible eventually, with inverses converging to $\bSig^{-1}$. So
$\hat\bSig_n^{-1}\convp\bSig^{-1}$ by Theorem~\ref{thm:cmt}, applied in probability with the
constant limit $\bSig$ (Proposition~\ref{prop:const}). By
Theorem~\ref{thm:slutsky}\ref{sl:i}, $(V_n,\hat\bSig_n^{-1})\convd(V,\bSig^{-1})$ with
$V\sim N(\bzero,\bSig)$, and $(\bv,\bA)\mapsto\bv'\bA\bv$ is continuous, so
Theorem~\ref{thm:cmt} gives $V_n'\hat\bSig_n^{-1}V_n\convd V'\bSig^{-1}V$.

It remains to identify the limit law. Let $\bSig^{1/2}$ be the symmetric positive definite
square root and $W = \bSig^{-1/2}V$. By Proposition~\ref{prop:cf-gauss} and
Proposition~\ref{prop:cf-props}\ref{cf:iv}, $W\sim N(\bzero,\bI_p)$, with characteristic
function $e^{-|\bt|^2/2}=\prod_je^{-t_j^2/2}$, which is that of a vector of independent
standard normals; by Corollary~\ref{cor:uniqueness} its coordinates are independent standard
normals, and since $\bSig^{-1}=(\bSig^{1/2}\bSig^{1/2})^{-1}=\bSig^{-1/2}\bSig^{-1/2}$ with
$\bSig^{-1/2}$ symmetric, $V'\bSig^{-1}V = |W|^2 = \sum_{j\leqslant p}W_j^2$, which
is $\chi^2_p$ by Definition~\ref{def:chisq-t-F}.
\end{proof}

%##############################################################################
\coursepart{IV}{Results Used in the Course}
%##############################################################################

%==============================================================================
\section{Maximum Likelihood}\label{sec:P.ML}
%==============================================================================

\subsection{Score and information}\label{sec:P.ML.1}

\begin{definition}[Log-likelihood, score, information]\label{def:score}
Let $\{f(\cdot;\btheta):\btheta\in\Theta\}$ be a family of densities with respect to a measure
$\mu$ on $\calX$, with $\Theta\subseteq\Real^p$ open. For an observation $Y$ the
\emph{log-likelihood} is $\ell(\btheta)=\ln f(Y;\btheta)$, the \emph{score} is
$\bU(\btheta)=\nabla\ell(\btheta)$, and the \emph{information} at $\btheta$ is
$\calI(\btheta)=\var_{\btheta}\bigl(\bU(\btheta)\bigr)$.
\end{definition}

\begin{lemma}[Score identities]\label{lem:score}
Suppose $f(y;\btheta)>0$ for all $y,\btheta$, that $\btheta\mapsto f(y;\btheta)$ is twice continuously
differentiable on $\Theta$, and that there are $\mu$-integrable $g_1,g_2$ with
\[
\Bigl|\frac{\partial f}{\partial\theta_j}(y;\btheta)\Bigr|\leqslant g_1(y),
\qquad
\Bigl|\frac{\partial^2 f}{\partial\theta_j\partial\theta_k}(y;\btheta)\Bigr|\leqslant g_2(y)
\]
for every $j,k$, every $y$ and every $\btheta\in\Theta$. Then, with $Y$ distributed according
to $f(\cdot;\btheta)$ and provided $\expc_{\btheta}|\bU(\btheta)|^2<\infty$,
\begin{equation}\label{eq:score-identities}
\expc_{\btheta}\bigl[\bU(\btheta)\bigr]=\bzero ,
\qquad
\calI(\btheta)=\expc_{\btheta}\bigl[\bU(\btheta)\bU(\btheta)'\bigr]
       =-\expc_{\btheta}\bigl[\nabla^2\ell(\btheta)\bigr] .
\end{equation}
\end{lemma}

\begin{proof}
Apply Theorem~\ref{thm:diff-int} to $\int f(y;\btheta)\,\dd\mu(y)=1$, one coordinate of $\btheta$ at
a time with the others fixed, the hypothesis on $g_1$ supplying the domination:
\[
\bzero=\nabla\!\int f(y;\btheta)\,\dd\mu(y)=\int\nabla f(y;\btheta)\,\dd\mu(y)
=\int\frac{\nabla f(y;\btheta)}{f(y;\btheta)}f(y;\btheta)\,\dd\mu(y)=\expc_{\btheta}[\bU(\btheta)] ,
\]
since $\bU=\nabla\ln f=\nabla f/f$ (the last equality being the expectation of a function
of $Y$ written as an integral against its density, Lemma~\ref{lem:density-int}, whose proof
uses nothing about $\Real^d$ and so applies on $\calX$). Here Theorem~\ref{thm:diff-int} applies
to $t\mapsto f(y;\btheta+t\mathbf{e}_j)$ on an open interval of $t$ keeping
$\btheta+t\mathbf{e}_j\in\Theta$: $f(\cdot;\btheta)$ is integrable, being a density, and
the $t$-derivative is dominated by $g_1$. Differentiating the identity
$\int\partial_jf(y;\btheta)\,\dd\mu(y)=0$ in $\theta_k$ in the same way, now with
$\partial_jf$ integrable as $|\partial_jf|\leqslant g_1$ and its $\theta_k$-derivative
dominated by $g_2$,
\[
\bzero=\int\nabla^2 f(y;\btheta)\,\dd\mu(y) .
\]
The quotient rule gives
$\partial_k(\partial_jf/f)=\partial_k\partial_jf/f-(\partial_jf)(\partial_kf)/f^2$, that is
$\nabla^2\ln f = \nabla^2 f/f - (\nabla f/f)(\nabla f/f)' = \nabla^2f/f - \bU\bU'$. Both terms
on the right are integrable under $f(\cdot;\btheta)\,\dd\mu$: the first because
$\int|\partial_k\partial_jf/f|\,f\,\dd\mu\leqslant\int g_2\,\dd\mu$, the second because
$\expc_{\btheta}|\bU|^2<\infty$. So, taking expectations (Lemma~\ref{lem:density-int} again),
\[
\expc_{\btheta}\bigl[\nabla^2\ell(\btheta)\bigr]
= \int\nabla^2f(y;\btheta)\,\dd\mu(y) - \expc_{\btheta}[\bU\bU']
= -\expc_{\btheta}[\bU\bU'] .
\]
Finally $\var(\bU)=\expc[(\bU-\expc\bU)(\bU-\expc\bU)']=\expc[\bU\bU']$ because
$\expc[\bU]=\bzero$.
\end{proof}

\begin{remark}
When $\mu$ is counting measure on a finite set, as for the Bernoulli and multinomial families, the integrals are finite sums, so $\expc_{\btheta}|\bU(\btheta)|^2<\infty$, and the domination hypothesis holds with $\Theta$ replaced by any open ball whose closure lies in $\Theta$, by continuity of the derivatives on that compact closure; this suffices, because the conclusion at $\btheta$ involves the family only near $\btheta$. The equality of the two expressions for $\calI$ in~\eqref{eq:score-identities} is
the \emph{information equality}; it is a property of the model at the true parameter, not
an identity in $\btheta$ for a misspecified one.
\end{remark}

\subsection{The maximum likelihood estimator}\label{sec:P.ML.2}

\begin{theorem}[Concave maximum likelihood]\label{thm:mle}
Let $Y_1,Y_2,\ldots$ be independent, let $\Theta\subseteq\Real^p$ be open and convex, let
$\btheta_0\in\Theta$, and let
\[
\ell_n(\btheta)=\sum_{i=1}^n\ell_i(\btheta),
\qquad
\bU_n=\nabla\ell_n(\btheta_0),
\qquad
\bH_n(\btheta)=-\nabla^2\ell_n(\btheta) .
\]
Assume:
\begin{enumerate}[label=\textup{(L\arabic*)}]
\item\label{L1} each $\ell_i$ is concave and twice continuously differentiable on $\Theta$,
      whatever the value of $Y_i$, where $\ell_i(\btheta)=\ell_i(\btheta;Y_i)$ depends on the
      data only through $Y_i$, and the closed ball
      $\{\btheta:|\btheta-\btheta_0|\leqslant\delta_0\}\subseteq\Theta$ for some $\delta_0>0$;
\item\label{L2} $\expc[\nabla\ell_i(\btheta_0)]=\bzero$,
      $\bF_n=n^{-1}\sum_{i\leqslant n}\var(\nabla\ell_i(\btheta_0))\to\bF$ positive definite,
      and $n^{-1/2}\bU_n\convd N(\bzero,\bF)$;
\item\label{L3} $n^{-1}\bH_n(\btheta_0)\convp\bG$ positive definite, and there are random
      variables $L_n$ with
      $\|\bH_n(\btheta)-\bH_n(\btheta_0)\|\leqslant nL_n|\btheta-\btheta_0|$ for every
      $|\btheta-\btheta_0|\leqslant\delta_0$, \emph{bounded in probability}: for every
      $\eta>0$ there is a constant $L$ with $\prb(L_n>L)<\eta$ for every $n$. A constant
      $L_n=L$ is the case met most often.
\end{enumerate}
Then, writing $\lambda=\lambda_{\min}(\bG)>0$:
\begin{enumerate}[label=\textup{(\roman*)}]
\item\label{mle:i} with probability tending to one $\ell_n$ has a maximiser $\hat\btheta_n$
      over $\Theta$, and it is unique whenever some $\ell_i$ is strictly concave;
\item\label{mle:ii} $\hat\btheta_n\convp\btheta_0$;
\item\label{mle:iii} $\sqrt n(\hat\btheta_n-\btheta_0)\convd
      N(\bzero,\ \bG^{-1}\bF\bG^{-1})$;
\item\label{mle:iv} if moreover $\bF=\bG$, then
      $\sqrt n(\hat\btheta_n-\btheta_0)\convd N(\bzero,\bF^{-1})$ and
      $2\{\ell_n(\hat\btheta_n)-\ell_n(\btheta_0)\}\convd\chi^2_p$;
\item\label{mle:v} $n^{-1}\bH_n(\hat\btheta_n)\convp\bG$;
\item\label{mle:vi} with $\bZ_n=n^{-1/2}\bU_n$,
      $2\{\ell_n(\hat\btheta_n)-\ell_n(\btheta_0)\}-\bZ_n'\bG^{-1}\bZ_n\convp0$.
\end{enumerate}
\end{theorem}

\begin{remark}
$\bG$ is the limiting curvature of the criterion and $\bF$ the limiting variance of its
gradient. When $\ell_n$ is the log-likelihood of a correctly specified model satisfying the
domination hypotheses of Lemma~\ref{lem:score}, and
$n^{-1}\bH_n(\btheta_0)-\expc[n^{-1}\bH_n(\btheta_0)]\convp\bzero$, the two agree: the
information equality of Lemma~\ref{lem:score} gives $\bF_n=\expc[n^{-1}\bH_n(\btheta_0)]$, so
$\bG=\lim_n\bF_n=\bF$, and~\ref{mle:iv} applies. When only
the mean is correctly specified they need not, and~\ref{mle:iii} leaves the \emph{sandwich} $\bG^{-1}\bF\bG^{-1}$.
\end{remark}

\begin{proof}
\textbf{Step 1: a curvature floor near $\btheta_0$.} Fix $\eta>0$ and choose $L$
with $\prb(L_n>L)<\eta$ for every $n$, by~\ref{L3}. Put
$\delta_1=\min\{\delta_0,\ \lambda/(4L)\}$ and
$A_n=\{\lambda_{\min}(n^{-1}\bH_n(\btheta_0))>\tfrac34\lambda\}\cap\{L_n\leqslant L\}$. The
smallest eigenvalue of a symmetric matrix is $\min_{|\bu|=1}\bu'\bA\bu$ by
Corollary~\ref{cor:rayleigh}, hence $1$-Lipschitz in the operator norm: for symmetric
$\bA,\bB$ and $|\bu|=1$, $|\bu'(\bA-\bB)\bu|\leqslant|\bu|\,|(\bA-\bB)\bu|\leqslant\|\bA-\bB\|$
by Theorem~\ref{thm:CS}, so $\bu'\bA\bu\geqslant\bu'\bB\bu-\|\bA-\bB\|$; minimising over $\bu$
gives $\lambda_{\min}(\bA)\geqslant\lambda_{\min}(\bB)-\|\bA-\bB\|$, and exchanging $\bA$ and
$\bB$ gives $|\lambda_{\min}(\bA)-\lambda_{\min}(\bB)|\leqslant\|\bA-\bB\|$. For every
$\bA\in\Real^{p\times p}$, $\|\bA\|^2\leqslant\tr(\bA'\bA)$, the sum of the squared entries
of $\bA$: this is trivial for $\bA=\bzero$, and otherwise, by Proposition~\ref{prop:opnorm},
Theorem~\ref{thm:svd} and Proposition~\ref{prop:trace}\textup{(ii),(iv)},
$\|\bA\|^2=d_1^2\leqslant\sum_jd_j^2=\tr(\bV\bD^2\bV')=\tr(\bA'\bA)$. So convergence in
probability of the entries implies it in the operator norm: each squared entry of
$n^{-1}\bH_n(\btheta_0)-\bG$ tends to $0$ in probability by Theorem~\ref{thm:cmt}, and so
does their finite sum by Theorem~\ref{thm:slutsky}\ref{sl:iii} and
Proposition~\ref{prop:const}. Hence
$\lambda_{\min}(n^{-1}\bH_n(\btheta_0))\geqslant\lambda-\|n^{-1}\bH_n(\btheta_0)-\bG\|$ exceeds
$\tfrac34\lambda$ with probability tending to $1$, and
$\prb(A_n^c)\leqslant\prb\{\lambda_{\min}(n^{-1}\bH_n(\btheta_0))\leqslant\tfrac34\lambda\}+\prb(L_n>L)$
gives $\liminf\prb(A_n)\geqslant1-\eta$. On $A_n$, for $|\btheta-\btheta_0|\leqslant\delta_1$ and
$|\bu|=1$, using~\ref{L3} in the form
$\|n^{-1}\bH_n(\btheta)-n^{-1}\bH_n(\btheta_0)\|\leqslant L_n|\btheta-\btheta_0|\leqslant L\delta_1\leqslant\lambda/4$,
\begin{equation}\label{eq:curv-floor}
\bu'\tfrac1n\bH_n(\btheta)\bu
\geqslant \bu'\tfrac1n\bH_n(\btheta_0)\bu - \bigl\|\tfrac1n\bH_n(\btheta)-\tfrac1n\bH_n(\btheta_0)\bigr\|
\geqslant \tfrac34\lambda - L\delta_1 \geqslant \tfrac12\lambda .
\end{equation}

\textbf{Step 2: the score is of order $\sqrt n$.} The summands of $\bU_n$ are independent
with mean zero by~\ref{L2} and finite variances, so the cross terms
$\expc[\nabla\ell_i(\btheta_0)'\nabla\ell_k(\btheta_0)]$, $i\neq k$, vanish by
Lemma~\ref{lem:disjoint-fn} (each $\ell_i$ depends on $Y_i$ alone) and
$\expc|\bU_n|^2=\sum_i\expc|\nabla\ell_i(\btheta_0)|^2=\sum_i\tr\var(\nabla\ell_i(\btheta_0))=n\tr\bF_n$.
Markov's inequality (Theorem~\ref{thm:markov}) applied to $|\bU_n|^2$ at the level $K^2n$
gives
\begin{equation}\label{eq:score-order}
\prb\bigl\{|\bU_n|>K\sqrt n\bigr\}\leqslant \tr\bF_n/K^2 .
\end{equation}

\textbf{Step 3: consistency.} With $\eta$ and $\delta_1$ of Step 1, fix
$0<\delta\leqslant\delta_1$ and choose $K$
with $\sup_n\tr\bF_n/K^2<\eta$, possible since $\tr\bF_n\to\tr\bF$ makes $(\tr\bF_n)$ bounded.
Let $C_n=A_n\cap\{|\bU_n|\leqslant K\sqrt n\}$, so $\liminf\prb(C_n)\geqslant1-2\eta$ by Step 1
and~\eqref{eq:score-order}. For a unit vector $\bu$ apply Taylor's theorem
(Theorem~\ref{thm:taylor}, $m=1$) to $g(t)=\ell_n(\btheta_0+t\delta\bu)$, whose derivatives
are $g'(t)=\delta\bu'\nabla\ell_n(\btheta_0+t\delta\bu)$ and
$g''(t)=-\delta^2\bu'\bH_n(\btheta_0+t\delta\bu)\bu$ by Proposition~\ref{prop:chain}: for some
$s\in(0,1)$,
\[
\ell_n(\btheta_0+\delta\bu)-\ell_n(\btheta_0)
= \delta\,\bu'\bU_n - \tfrac12\delta^2\,\bu'\bH_n(\btheta_0+s\delta\bu)\bu
\leqslant \delta K\sqrt n - \tfrac14 n\lambda\delta^2
\]
on $C_n$, using $\bu'\bU_n\leqslant|\bU_n|\leqslant K\sqrt n$ (Cauchy--Schwarz) and,
as $|s\delta\bu|\leqslant\delta\leqslant\delta_1$, $\bu'\bH_n(\btheta_0+s\delta\bu)\bu\geqslant\tfrac12n\lambda$
by~\eqref{eq:curv-floor}. The right side is $\delta\sqrt n(K-\tfrac14\sqrt n\lambda\delta)$,
negative once $n>(4K/(\lambda\delta))^2$, and the bound does not depend on $\bu$.

Concavity extends this beyond the sphere: if $\btheta\in\Theta$ has $|\btheta-\btheta_0|=r>\delta$ then
$\btheta_\delta=(1-\delta/r)\btheta_0+(\delta/r)\btheta$ lies on the sphere
($|\btheta_\delta-\btheta_0|=(\delta/r)r=\delta$) and in $\Theta$, and concavity of $\ell_n$, a sum
of concave functions, gives
$\ell_n(\btheta_\delta)\geqslant(1-\delta/r)\ell_n(\btheta_0)+(\delta/r)\ell_n(\btheta)$; since
$\ell_n(\btheta_\delta)<\ell_n(\btheta_0)$ this forces $\ell_n(\btheta)<\ell_n(\btheta_0)$. So on $C_n$ and
for $n$ large, $\ell_n$ is strictly below $\ell_n(\btheta_0)$ outside the open ball of radius
$\delta$.

The closed ball of radius $\delta$ is compact (Theorem~\ref{thm:HB}) and $\ell_n$ continuous,
so a maximum $M_n$ over it is attained (Theorem~\ref{thm:unif-cont}), at a point
$\hat\btheta_n$ that can be chosen measurably by Remark~\ref{rem:assumed}\textup{(g)}. As
$M_n\geqslant\ell_n(\btheta_0)$ and, by the previous paragraph, $\ell_n<\ell_n(\btheta_0)$ on the
sphere and outside the ball, $\hat\btheta_n$ lies in the open ball and
$\ell_n(\hat\btheta_n)=M_n\geqslant\ell_n(\btheta)$ for every $\btheta\in\Theta$: it is a maximum
over all of $\Theta$. This holds on $C_n$ for all large $n$, an event of probability at least
$1-3\eta$ eventually, and $\eta$ is arbitrary; this proves~\ref{mle:i}. Also
$\liminf\prb\{|\hat\btheta_n-\btheta_0|<\delta\}\geqslant1-2\eta$ with $\eta$ arbitrary and
$\delta$ arbitrarily small proves~\ref{mle:ii}. If some $\ell_i$ is strictly concave then so is
$\ell_n$, a strictly concave function plus concave ones, and a strictly concave function has
at most one maximiser: two distinct maximisers $\btheta,\btheta'$ with common value $M$ would
give $\ell_n(\tfrac12\btheta+\tfrac12\btheta')>M$.

\textbf{Step 4: the linearisation.} On $C_n$ and for large $n$ the maximiser is interior,
so $\nabla\ell_n(\hat\btheta_n)=\bzero$ (as in the proof of Proposition~\ref{prop:convex-fo}). Write $\bh=\hat\btheta_n-\btheta_0$. Applying the mean value
theorem (Corollary~\ref{cor:MVT}) to $t\mapsto\partial_j\ell_n(\btheta_0+t\bh)$, whose derivative
is $\sum_k\partial_k\partial_j\ell_n(\btheta_0+t\bh)h_k=-(\bH_n(\btheta_0+t\bh)\bh)_j$ by
Proposition~\ref{prop:chain}, gives, for each $j$, an $s_j\in(0,1)$ with
\[
0-\bigl(\bU_n\bigr)_j
= \bigl(\nabla\ell_n(\hat\btheta_n)-\nabla\ell_n(\btheta_0)\bigr)_j
= -\bigl(\bH_n(\btheta_0+s_j\bh)\,\bh\bigr)_j ,
\]
that is $\bU_n=\tilde\bH_n\bh$, where row $j$ of $\tilde\bH_n$ is row $j$ of
$\bH_n(\btheta_0+s_j\bh)$. By Remark~\ref{rem:assumed}\textup{(g)}, applied to the closed set of
$s\in[0,1]$ at which the display holds, the $s_j$ can be chosen measurably, possibly at an
endpoint, which changes nothing below. When $|\bh|\leqslant\delta_0$, an event of probability tending to
one by~\ref{mle:ii}, row $j$ of $\tilde\bH_n-\bH_n(\btheta_0)$ is row $j$ of
$\bB_j=\bH_n(\btheta_0+s_j\bh)-\bH_n(\btheta_0)$, of operator norm at most
$nL_ns_j|\bh|\leqslant nL_n|\bh|$ by~\ref{L3}. A row of a matrix $\bB$ has length at most
$\|\bB\|$: for the symmetric $\bB_j$, $|\mathbf{e}_j'\bB_j|=|\bB_j\mathbf{e}_j|\leqslant\|\bB_j\|$.
And a matrix $\bM$ with rows $\mathbf{m}_j'$ has
$|\bM\bx|^2=\sum_j(\mathbf{m}_j'\bx)^2\leqslant\sum_j|\mathbf{m}_j|^2|\bx|^2\leqslant p\max_j|\mathbf{m}_j|^2|\bx|^2$
by Theorem~\ref{thm:CS}. So
$\|n^{-1}\tilde\bH_n-n^{-1}\bH_n(\btheta_0)\|\leqslant\sqrt p\,L_n|\bh|$. This tends to $0$ in
probability: given $\eta$ and $\varepsilon$, choose $L$ with $\prb(L_n>L)<\eta$, and then
$\prb(\sqrt pL_n|\bh|>\varepsilon)\leqslant\eta+\prb(|\bh|>\varepsilon/(\sqrt pL))$, whose
second term tends to $0$ by~\ref{mle:ii}. With~\ref{L3} again, the triangle inequality
$\|n^{-1}\tilde\bH_n-\bG\|\leqslant\|n^{-1}\tilde\bH_n-n^{-1}\bH_n(\btheta_0)\|+\|n^{-1}\bH_n(\btheta_0)-\bG\|$
and the bound $|a_{rs}|\leqslant\|\bA\|$ on the entries give
\begin{equation}\label{eq:Hbar}
\bG_n := n^{-1}\tilde\bH_n \convp \bG .
\end{equation}
The same argument with $\bH_n(\hat\btheta_n)$ in place of $\tilde\bH_n$, using
$\|\bH_n(\hat\btheta_n)-\bH_n(\btheta_0)\|\leqslant nL_n|\bh|$ directly, gives~\ref{mle:v}.

\textbf{Step 5: asymptotic normality.} Write $\bZ_n=n^{-1/2}\bU_n$, which converges in
distribution to $N(\bzero,\bF)$ by~\ref{L2}. By the bound
$\|\bA\|^2\leqslant\tr(\bA'\bA)$ of Step~1, \eqref{eq:Hbar} gives $\|\bG_n-\bG\|\convp0$, and the event
$D_n=\{\|\bG_n-\bG\|\leqslant\lambda/2\}$ has probability tending to one. Since
$\|\bG^{-1}\|=1/\lambda$ by Proposition~\ref{prop:opnorm} ($\bG$ being symmetric positive
definite), $|\bv|=|\bG^{-1}\bG\bv|\leqslant|\bG\bv|/\lambda$, so on $D_n$,
$|\bG_n\bv|\geqslant|\bG\bv|-\|\bG_n-\bG\|\,|\bv|\geqslant\lambda|\bv|-\tfrac12\lambda|\bv|=\lambda|\bv|/2$
for every $\bv$. So $\bG_n\bv=\bzero$ forces $\bv=\bzero$, the square matrix $\bG_n$ is
invertible (Theorem~\ref{thm:rank-nullity}), and with $\bw=\bG_n\bv$,
$|\bG_n^{-1}\bw|=|\bv|\leqslant2|\bw|/\lambda$, that is $\|\bG_n^{-1}\|\leqslant2/\lambda$. On
$C_n\cap D_n$, $\bU_n=\tilde\bH_n\bh=n\bG_n\bh$, so $\sqrt n\,\bh=\bG_n^{-1}\bZ_n$. There
$\bG_n^{-1}-\bG^{-1}=\bG_n^{-1}(\bG-\bG_n)\bG^{-1}$ has norm at most
$\|\bG_n^{-1}\|\,\|\bG-\bG_n\|\,\|\bG^{-1}\|\leqslant2\|\bG_n-\bG\|/\lambda^2$, so
$\bG_n^{-1}\convp\bG^{-1}$ (with the convention $\bA^{-1}:=\bzero$ off $D_n$). By
Theorem~\ref{thm:slutsky}\ref{sl:i} $(\bZ_n,\bG_n^{-1})\convd(Z,\bG^{-1})$ with
$Z\sim N(\bzero,\bF)$, and the continuous map $(\bz,\bA)\mapsto\bA\bz$ with
Theorem~\ref{thm:cmt} gives $\bG_n^{-1}\bZ_n\convd\bG^{-1}Z$. By
Theorem~\ref{thm:mvn-linear} that law is $N(\bzero,\bG^{-1}\bF\bG^{-1})$. Finally
$\sqrt n\,\bh$ and $\bG_n^{-1}\bZ_n$ agree on $C_n\cap D_n$, so for $f\in C_b(\Real^p)$,
$|\expc f(\sqrt n\,\bh)-\expc f(\bG_n^{-1}\bZ_n)|\leqslant2\sup|f|\,\prb\{(C_n\cap D_n)^c\}$,
whose $\limsup$ is at most $2\sup|f|\cdot2\eta$; as $\eta$ is arbitrary,
$\expc f(\sqrt n\,\bh)\to\expc f(\bG^{-1}Z)$, which is~\ref{mle:iii}. If $\bF=\bG$ the
variance collapses to $\bG^{-1}\bG\bG^{-1}=\bF^{-1}$.

\textbf{Step 6: the likelihood ratio at $\btheta_0$.} Taylor's theorem applied to
$t\mapsto\ell_n(\btheta_0+t\bh)$ gives an $s\in(0,1)$, chosen measurably as in Step 4, with
\[
2\{\ell_n(\hat\btheta_n)-\ell_n(\btheta_0)\}
= 2\bU_n'\bh - \bh'\bH_n(\btheta_0+s\bh)\bh
= 2\bZ_n'\bG_n^{-1}\bZ_n - (\bG_n^{-1}\bZ_n)'\bK_n(\bG_n^{-1}\bZ_n) ,
\]
the second equality holding on $C_n\cap D_n$, where $\bU_n=\sqrt n\bZ_n$ and
$\bh=n^{-1/2}\bG_n^{-1}\bZ_n$, and where $\bK_n=n^{-1}\bH_n(\btheta_0+s\bh)\convp\bG$ by the
argument of Step 4 ($|s\bh|\leqslant|\bh|$). By Theorem~\ref{thm:slutsky}\ref{sl:i},
$(\bZ_n,\bG_n^{-1},\bK_n)\convd(Z,\bG^{-1},\bG)$, and the continuous map
$(\bz,\bA,\bK)\mapsto2\bz'\bA\bz-(\bA\bz)'\bK(\bA\bz)$ with Theorem~\ref{thm:cmt} gives the
limit $2Z'\bG^{-1}Z-Z'\bG^{-1}\bG\bG^{-1}Z=Z'\bG^{-1}Z$, the complement of $C_n\cap D_n$ being
handled as at the end of Step 5. Under $\bF=\bG$ this is $Z'\bF^{-1}Z$
with $Z\sim N(\bzero,\bF)$, which is $\chi^2_p$ by Theorem~\ref{thm:quadform}, completing
\ref{mle:iv}. For~\ref{mle:vi}, the display minus $\bZ_n'\bG^{-1}\bZ_n$ is
$\bZ_n'\bM_n\bZ_n$ with $\bM_n=2\bG_n^{-1}-(\bG_n^{-1})'\bK_n\bG_n^{-1}-\bG^{-1}$, and
$\bM_n\convp\bzero$ since $\bG_n^{-1}\convp\bG^{-1}$, $(\bG_n^{-1})'\convp\bG^{-1}$ ($\bG$ is
symmetric) and $\bK_n\convp\bG$, by Theorem~\ref{thm:cmt}; Slutsky and the continuous mapping theorem give
$\bZ_n'\bM_n\bZ_n\convd Z'\bzero Z=0$, which is convergence in probability by
Proposition~\ref{prop:const}.
\end{proof}

\begin{corollary}[Wald]\label{cor:wald}
Under Theorem~\ref{thm:mle} with $\bF=\bG$, let $\bR$ be a fixed $q\times p$ matrix of rank
$q$ and $\hat\bG_n=n^{-1}\bH_n(\hat\btheta_n)$. If $\bR\btheta_0=\br$ then
\[
W_n = (\bR\hat\btheta_n-\br)'\bigl\{\tfrac1n\bR\hat\bG_n^{-1}\bR'\bigr\}^{-1}
      (\bR\hat\btheta_n-\br) \convd \chi^2_q ,
\]
both inverses taken with the convention $\bA^{-1}:=\bzero$ for singular $\bA$ of
Theorem~\ref{thm:quadform}.
The same holds without $\bF=\bG$ if $\hat\bG_n^{-1}$ is replaced by
$\hat\bG_n^{-1}\hat\bF_n\hat\bG_n^{-1}$ for any symmetric $\hat\bF_n\convp\bF$.
\end{corollary}

\begin{proof}
By~\ref{mle:iv}, Theorem~\ref{thm:cmt} (the linear map $\bR$ is continuous) and
Theorem~\ref{thm:mvn-linear},
$V_n:=\sqrt n(\bR\hat\btheta_n-\br)=\bR\sqrt n(\hat\btheta_n-\btheta_0)\convd N(\bzero,\bR\bF^{-1}\bR')$,
using $\bR\btheta_0=\br$. The matrix $\bR\bF^{-1}\bR'$ is positive definite: $\bF^{-1}$ is
positive definite (its eigenvalues are the reciprocals of those of $\bF$,
Proposition~\ref{prop:pd-eigen}), so $\bv'\bR\bF^{-1}\bR'\bv=(\bR'\bv)'\bF^{-1}(\bR'\bv)>0$
unless $\bR'\bv=\bzero$, and $\bR'$ has rank $q$, so $\calN(\bR')=\{\bzero\}$ by
Theorem~\ref{thm:rank-nullity}. By~\ref{mle:v}, $\hat\bG_n\convp\bG=\bF$, and $\hat\bG_n$ is
symmetric, a Hessian of a twice continuously differentiable function; by
Lemma~\ref{lem:inv-limit} (inversion, extended as in Theorem~\ref{thm:quadform}, is
measurable and continuous at the positive definite $\bF$ on the symmetric matrices) and
Theorem~\ref{thm:cmt}, $\hat\bSig_n:=\bR\hat\bG_n^{-1}\bR'\convp\bR\bF^{-1}\bR'$, a symmetric
matrix. Since $\{\tfrac1n\bA\}^{-1}=n\bA^{-1}$, also under the convention for singular $\bA$,
$W_n=V_n'\hat\bSig_n^{-1}V_n$, and Theorem~\ref{thm:quadform} gives $W_n\convd\chi^2_q$. In
the general case the same argument runs with the limiting variance
$\bR\bG^{-1}\bF\bG^{-1}\bR'$ of $V_n$, by~\ref{mle:iii}, positive definite as before since
$\bG^{-1}\bF\bG^{-1}$ is ($\bv'\bG^{-1}\bF\bG^{-1}\bv=(\bG^{-1}\bv)'\bF(\bG^{-1}\bv)>0$ for
$\bv\neq\bzero$), and its consistent estimate
$\bR\hat\bG_n^{-1}\hat\bF_n\hat\bG_n^{-1}\bR'$ (Theorem~\ref{thm:cmt}), symmetric as
$\hat\bF_n$ and $\hat\bG_n$ are.
\end{proof}

\begin{theorem}[Likelihood ratio]\label{thm:lrt}
Under Theorem~\ref{thm:mle} with $\bF=\bG$, partition $\btheta=(\btheta_1,\btheta_2)$ with
$\btheta_2$ of dimension $q$, and let $\hat\btheta^R_n$ maximise $\ell_n$ over
$\Theta\cap\{\btheta_2=\btheta_{2,0}\}$, where $\btheta_{2,0}$ is the true value. Suppose the
hypotheses of Theorem~\ref{thm:mle} also hold for the restricted problem, again with
$\bF=\bG$ and with limiting information $\bF_{11}$, the leading $(p-q)$ block of $\bF$.
Then
\[
\text{LR}_n = 2\bigl\{\ell_n(\hat\btheta_n)-\ell_n(\hat\btheta^R_n)\bigr\}\convd\chi^2_q .
\]
\end{theorem}

\begin{proof}
Applying Theorem~\ref{thm:mle}\ref{mle:vi}, with $\bG=\bF$, to the full problem and, in the
subspace $\{\btheta_2=\btheta_{2,0}\}$, to the restricted one,
\[
2\{\ell_n(\hat\btheta_n)-\ell_n(\btheta_0)\}=\bZ_n'\bF^{-1}\bZ_n+R_n,
\qquad
2\{\ell_n(\hat\btheta^R_n)-\ell_n(\btheta_0)\}=\bZ_{n,1}'\bF_{11}^{-1}\bZ_{n,1}+R^R_n ,
\]
with $R_n\convp0$ and $R^R_n\convp0$,
where $\bZ_n=n^{-1/2}\bU_n\convd Z\sim N(\bzero,\bF)$ and $\bZ_{n,1}$ is its first $p-q$
coordinates, the score of the restricted model (the gradient in $\btheta_1$ at $\btheta_0$);
the restricted curvature $\bG$ is the leading block of the full one, which equals $\bF_{11}$.
Subtracting,
\[
\text{LR}_n = \bZ_n'\bF^{-1}\bZ_n - \bZ_{n,1}'\bF_{11}^{-1}\bZ_{n,1}+R_n-R^R_n
\convd Z'\bF^{-1}Z - Z_1'\bF_{11}^{-1}Z_1
\]
by the continuous mapping theorem (Theorem~\ref{thm:cmt}, applied to the continuous map
$\bz\mapsto\bz'\bF^{-1}\bz-\bz_1'\bF_{11}^{-1}\bz_1$) and Slutsky
(Theorem~\ref{thm:slutsky}\ref{sl:iii}, as $R_n-R^R_n\convp0$).

Write $\bA=[\bI_{p-q}\ \ \bzero]$, so $Z_1=\bA Z$ and $\bF_{11}=\bA\bF\bA'$, and put
$W=\bF^{-1/2}Z$, which is $N(\bzero,\bI_p)$ by Theorem~\ref{thm:mvn-linear} and the
symmetric square root of Theorem~\ref{thm:sqrt} (its covariance is
$\bF^{-1/2}\bF\bF^{-1/2}=\bI_p$). Then $Z=\bF^{1/2}W$, $\bF^{-1}=\bF^{-1/2}\bF^{-1/2}$,
$Z'\bF^{-1}Z=|W|^2$, and $Z_1'\bF_{11}^{-1}Z_1=(\bA\bF^{1/2}W)'(\bA\bF\bA')^{-1}(\bA\bF^{1/2}W)=W'\bP W$
with
\[
\bP = \bF^{1/2}\bA'(\bA\bF\bA')^{-1}\bA\bF^{1/2} ,
\]
where $\bA\bF\bA'=\bF_{11}$ is invertible, being positive definite
($\bv'\bA\bF\bA'\bv=(\bA'\bv)'\bF(\bA'\bv)>0$ for $\bv\neq\bzero$, as $\bA'\bv\neq\bzero$). It
is symmetric, as $(\bA\bF\bA')^{-1}$ is, and, using $\bF^{1/2}\bF^{1/2}=\bF$ and the cyclic
property of the trace (Proposition~\ref{prop:trace}\ref{tr:ii}),
\begin{align*}
\bP^2&=\bF^{1/2}\bA'(\bA\bF\bA')^{-1}(\bA\bF\bA')(\bA\bF\bA')^{-1}\bA\bF^{1/2}=\bP, \\
\tr\bP&=\tr\{(\bA\bF\bA')^{-1}\bA\bF\bA'\}=\tr\bI_{p-q}=p-q .
\end{align*}
Hence $\bI-\bP$ is symmetric, idempotent ($(\bI-\bP)^2=\bI-2\bP+\bP^2=\bI-\bP$), with trace
$p-(p-q)=q$, hence rank $q$ by Lemma~\ref{lem:idempotent}; and the limit is
$|W|^2-W'\bP W=W'(\bI-\bP)W\sim\chi^2_q$ by
Theorem~\ref{thm:quadratic-chisq}.
\end{proof}

\begin{remark}
The two statistics use different parts of the same expansion: Wald uses $\hat\btheta_n$ and
the curvature at it, the likelihood ratio uses the heights of the two fitted
log-likelihoods, and both are $\chi^2_q$ in the limit. They are not equal in finite samples.
\end{remark}

%==============================================================================
\section{The Statistics of This Course}\label{sec:P.26}
%==============================================================================

\begin{remark}[The Breusch--Pagan statistic]
In Unit 4 the errors $\varepsilon_i$ are independent and identically distributed with mean $0$,
variance $\sigma^2$ and $\expc\varepsilon_i^4<\infty$, with $\varepsilon_i^2$ not almost
surely constant (so that $\kappa>0$ below),
$\bg$ is the vector with entries $g_i=\varepsilon_i^2/\sigma^2-1$, and $\bZ$ is the $n\times p$
matrix whose rows are the variance regressors $\bz_i'$, centred so that $\bone'\bZ=\bzero'$
and hence $\bM_0\bZ=\bZ$. There $V_n = n^{-1/2}\bZ'\bg$ satisfies
$V_n\convd N(\bzero,\ \kappa\bQ)$ by Corollary~\ref{cor:weighted}, whose proof uses the $\bz_i$
only through the weights $a_{ni}$ and so applies verbatim to the centred $\bz_i-\bar\bz_n$,
assumed to satisfy its two design conditions: the summands
$\bz_i(\varepsilon_i^2/\sigma^2-1)$ are independent, mean zero, and carry non-identical
weights, so the Lindeberg--Feller form is required and the identically-distributed Corollary~\ref{cor:iid-clt} does not apply. The constant is
$\kappa=\var(g_i)=\var(\varepsilon_i^2)/\sigma^4$, the common variance that
Corollary~\ref{cor:weighted} calls $\tau^2$, with $\kappa=2$ under normality by
Lemma~\ref{lem:fourth}. The empirical
$n^{-1}\bZ'\bM_0\bZ=n^{-1}\bZ'\bZ$ converges to the $\bQ$ of Corollary~\ref{cor:weighted}, so Theorem~\ref{thm:quadform} delivers the
$\chi^2_p$ limit, and Slutsky's theorem lets the unknown $\sigma^2$ and $\kappa$ be replaced by consistent estimates without changing the limit: $\kappa$ enters only the weight matrix, and for $\sigma^2$, which sits inside $g_i$, $\bone'\bZ=\bzero'$ makes $V_n$ computed with $\hat\sigma^2$ equal to $(\sigma^2/\hat\sigma^2)V_n$.
\end{remark}

%==============================================================================
\section{Numerical Illustration}\label{sec:P.27}
%==============================================================================

The array below has $\sum_j\var(\xi_{nj})=1$ for every $n$ and mean zero, but one summand
carries a fixed share of the variance, violating the conclusion $\sup_jc_{nj}\to0$ of Step 1
of the proof of Theorem~\ref{thm:LF}.

<<lindeberg-fail>>=
set.seed(1)
one_row <- function(n, share) {
  # summand 1 carries `share` of the total variance; the rest split the remainder
  v1 <- share; vr <- (1 - share) / (n - 1)
  c(rnorm(1, sd = sqrt(v1)), rnorm(n - 1, sd = sqrt(vr)))
}
lindeberg_sum <- function(n, share, eps = 0.3, B = 4000) {
  v1 <- share; vr <- (1 - share)/(n - 1)
  sds <- c(sqrt(v1), rep(sqrt(vr), n - 1))
  # E[xi^2 ; |xi|>eps] for a centred normal with sd s
  contrib <- sapply(sds, function(s)
    2 * integrate(function(x) x^2 * dnorm(x, sd = s), eps, Inf)$value)
  sum(contrib)
}
c(share_equal = lindeberg_sum(400, 1/400),  # equal weights: condition holds
  share_half = lindeberg_sum(400, 0.5))     # one dominant term: condition fails
@

With equal weights the Lindeberg sum is numerically zero and the row sums are close to
normal; with one dominant summand it is bounded away from zero and the dominant summand never becomes
negligible.

<<lindeberg-effect, fig.height=2.6, fig.width=6.4, echo=FALSE, fig.pos='!ht', fig.cap="Row sums of a triangular array against the $N(0,1)$ density. Both rows have total variance $1$; only the left satisfies~\\eqref{eq:lindeberg}. In the right panel the sum is a sum of two normals and so is itself exactly normal. The illustration is that the limit is not reached \\emph{by accumulation}, the dominant term never becoming negligible.">>=
set.seed(2); B <- 4000; n <- 400
S_ok  <- replicate(B, sum(one_row(n, 1/n)))
S_bad <- replicate(B, sum(one_row(n, 0.5)))
op <- par(mfrow = c(1, 2), mar = c(4, 4, 2, 1))
for (nm in c("ok", "bad")) {
  S <- if (nm == "ok") S_ok else S_bad
  hist(S, breaks = 40, freq = FALSE, col = "grey88", border = "white",
       main = if (nm == "ok") "equal weights" else "one dominant term",
       xlab = expression(sum(xi[nj])), xlim = c(-4, 4))
  curve(dnorm(x), add = TRUE, lwd = 2, col = "#B45309")
}
par(op)
@

The two design conditions of Corollary~\ref{cor:weighted} are limits and so cannot be verified on a single sample; what a sample does show
is the finite-$n$ quantity behind the second of them, the largest share of
$\sum_i|\bz_i|^2$ carried by one observation. If that share is small the design is far from
the degenerate case, and if it is close to $1$ no central limit theorem applies however
large $n$ is.

<<design-conditions>>=
suppressMessages(library(ISLR2))
z  <- Boston$lstat; nn <- length(z)
Zc <- z - mean(z)                                   # centred, as Z'M0Z requires
c(Q_n            = sum(Zc^2)/nn,                    # estimates Q; must be positive
  max_share      = max(Zc^2)/sum(Zc^2),             # largest single share
  share_if_equal = 1/nn,                            # the value under equal weights
  ratio          = max(Zc^2)/sum(Zc^2)*nn)          # how many times the equal share
@

The largest observation carries about $2.5\%$ of the total, roughly twelve times an equal
share: unequal, but nowhere near domination by one point.

<<clt-quadform>>=
set.seed(3)
B <- 4000
Tn <- replicate(B, {
  eps <- rnorm(nn)                                  # H0: homoscedastic normal
  g   <- eps^2 - 1
  Vn  <- sum(Zc * g)/sqrt(nn)
  Vn^2 / (2 * sum(Zc^2)/nn)                         # Theorem thm:quadform with p = 1
})
c(mean_stat = mean(Tn), chisq1_mean = 1,
  var_stat  = var(Tn),  chisq1_var  = 2,
  rejection_rate_5pct = mean(Tn > qchisq(0.95, 1)))
@

The simulated statistic has the mean, variance and upper tail of a $\chi^2_1$, which is
Theorem~\ref{thm:quadform} with the covariance $\kappa\bQ$ and $\kappa=2$ supplied by
Corollary~\ref{cor:weighted} under normality.

The variance of
$n^{-1/2}\sum_tu_{t-1}\varepsilon_t$ is $\tau^4\sum_j a_j^2$ \emph{exactly}, for every $n$,
by Corollary~\ref{cor:mds}; what the theorem adds is that the law is asymptotically normal.
Both are checked below for $a_j=\phi^j$ with $\phi=0.8$, the score of a first-order
autoregression, together with the truncation bound
$\expc[(S_n-S_n^{(m)})^2]=\tau^4\sum_{j\geqslant m}a_j^2$ that drives the proof.

<<ar-score-check>>=
set.seed(5); phi <- 0.8; B <- 4000; ms <- c(1, 4, 16)
sim <- function(n) t(replicate(B, {
  e <- rnorm(n + 80); k <- 81:(n + 80)
  u <- as.numeric(stats::filter(e, phi, "recursive"))
  S <- sum(u[k - 1]*e[k])/sqrt(n)
  c(S, sapply(ms, function(m) {
      um <- as.numeric(stats::filter(e, phi^(0:(m - 1)), sides = 1))
      S - sum(um[k - 1]*e[k])/sqrt(n) })) }))
R <- sim(400)
t(sapply(seq_along(ms), function(i)
  c(m = ms[i], mean_squared_difference = mean(R[, i + 1]^2),
    theory_tail_sum = phi^(2*ms[i])/(1 - phi^2))))
@

The truncation error is what the approximation lemma needs to be small uniformly in $n$,
and it is: at $m=16$ the $m$-dependent array of the proof reproduces the score to within
$0.0023$ in mean square, against a variance of $2.78$.

<<ar-score-normal>>=
t(sapply(c(50, 200, 800), function(n) {
  S <- sim(n)[, 1]
  c(n = n, variance = var(S), theory = 1/(1 - phi^2),
    skewness = mean((S - mean(S))^3)/sd(S)^3,
    kurtosis = mean((S - mean(S))^4)/var(S)^2) }))
@

The variance matches at every $n$, as it must. The skewness and kurtosis fall towards
their normal values $0$ and $3$: the skewness roughly halves each time $n$ is quadrupled,
which is the $n^{-1/2}$ rate, and the excess kurtosis falls faster, by a factor of roughly
four, which is the $n^{-1}$ rate (the last step, a factor of $2.7$, is within simulation
error: at $n=800$ a kurtosis estimate from $4000$ draws has standard error about $0.1$). The approach is not fast: at $n=50$ the kurtosis is still $4.76$, so
normality here is an asymptotic statement and not a small-sample one.

%==============================================================================
\section{Exercises}\label{sec:P.28}
%==============================================================================

\begin{reading}
An exercise with a source in its title is from Knapp, \emph{Basic Real Analysis} (digital second
edition, 2016), Abadir and Magnus, \emph{Matrix Algebra} (2005), or Baldi, \emph{Probability: An
Introduction Through Theory and Exercises} (2023), under that book's number. Its solution is
based on the book's hint or solution, adapted to the notation and results of these notes.
\end{reading}

\subsection*{Analysis}

\begin{exercise}[Knapp, problem I.2]\label{ex:kn-1-2}
Let $a>0$, $x_0=1$ and $x_{n+1}=(x_n^2+a)/(2x_n)$ for $n\geqslant0$ (Newton's method for
$x^2=a$). Prove that $(x_n)$ converges and that its limit is $\sqrt a$.
\end{exercise}

% exercise order: the Analysis problems below (I.2, II.5, I.4, I.7, I.9, II.8, III.20) are not in the book's order
% source hint: knapp_real_b_15 hint:I.2
\begin{solution}
By induction every $x_n$ is positive: $x_0=1$, and $x_n>0$ gives $x_{n+1}>0$. For
$n\geqslant0$,
\[
x_{n+1}-\sqrt a=\frac{x_n^2-2\sqrt a\,x_n+a}{2x_n}=\frac{(x_n-\sqrt a)^2}{2x_n}\geqslant0 ,
\]
so $x_n\geqslant\sqrt a$ for every $n\geqslant1$. Then for $n\geqslant1$,
$x_n-x_{n+1}=(x_n^2-a)/(2x_n)\geqslant0$, so $(x_n)_{n\geqslant1}$ is decreasing and bounded
below by $\sqrt a$. Theorem~\ref{thm:monotone-seq}, applied to the increasing bounded
sequence $(-x_n)_{n\geqslant1}$, shows that $x_n$ converges to some $L\geqslant\sqrt a>0$.
Letting $n\to\infty$ in $2x_nx_{n+1}=x_n^2+a$ gives $2L^2=L^2+a$, so $L^2=a$ and, $L$ being
positive, $L=\sqrt a$.
\end{solution}

\begin{exercise}[Knapp, problem II.5]\label{ex:kn-2-5}
Let $U\subseteq\Real^d$ be open and let $E_1\supseteq E_2\supseteq\cdots$ be closed bounded
subsets of $\Real^d$ with $\bigcap_nE_n\subseteq U$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $E_N\subseteq U$ for some $N$.
\item Show by examples that the conclusion fails if the $E_n$ are only assumed bounded, or
      only assumed closed.
\end{enumerate}
\end{exercise}

% source hint: knapp_real_b_15 hint:II.5 (the hint uses the finite-intersection property; here Bolzano--Weierstrass; its example for (b) is the first one below; the book sets (b) in Q, where these sets are closed, here they are taken in R, where they are not)
\begin{solution}
(a) Suppose not. Then for every $n$ there is $x_n\in E_n$ with $x_n\notin U$. All $x_n$ lie
in the bounded set $E_1$, so by Theorem~\ref{thm:BW} a subsequence $x_{n_k}$ converges to
some $x$. Fix $m$. For every $k$ with $n_k\geqslant m$, $x_{n_k}\in E_{n_k}\subseteq E_m$,
and $E_m$ is closed, so $x\in E_m$. Hence $x\in\bigcap_mE_m\subseteq U$. As $U$ is open
there is $\delta>0$ with $\{y:|y-x|<\delta\}\subseteq U$, and $|x_{n_k}-x|<\delta$ for all
large $k$, so $x_{n_k}\in U$ for those $k$, contradicting the choice of the $x_n$.

(b) In both examples $d=1$ and $U=\emptyset$, which is open. The bounded sets
$E_n=\mathbb{Q}\cap[\sqrt2,\sqrt2+1/n]$ decrease and $\bigcap_nE_n=\emptyset$, since the only
real number in every $[\sqrt2,\sqrt2+1/n]$ is the irrational $\sqrt2$; they are not closed,
which is where (a) fails: a limit of points of $E_n$ may be $\sqrt2\notin E_n$. The closed sets
$E_n=[n,\infty)$ decrease and $\bigcap_nE_n=\emptyset$; they are unbounded, and the points
$x_n=n$ have no convergent subsequence. Every $E_N$ is non-empty: $[N,\infty)$ plainly, and
$\mathbb{Q}\cap[\sqrt2,\sqrt2+1/N]$ contains the rational $\lceil10^k\sqrt2\rceil/10^k$ once
$10^{-k}<1/N$. So in neither case is any $E_N$ contained in $U=\emptyset$.
\end{solution}

\begin{exercise}[Knapp, problem I.4]\label{ex:kn-1-4}
For real sequences $(a_n)$ and $(b_n)$ prove that
\[
\limsup_n(a_n+b_n)\leqslant\limsup_na_n+\limsup_nb_n ,
\]
provided the right side is not of the form $\infty-\infty$. Give an example in which the
inequality is strict.
\end{exercise}

% source hint: knapp_real_b_15 hint:I.4
\begin{solution}
Let $A=\limsup_na_n$ and $B=\limsup_nb_n$ (Definition~\ref{def:limsup}). If $A=\infty$ or
$B=\infty$ the right side is $\infty$ (the other term not being $-\infty$) and there is
nothing to prove. Otherwise put $\alpha_m=\sup_{n\geqslant m}a_n$ and
$\beta_m=\sup_{n\geqslant m}b_n$; these decrease to $A$ and $B$, and they are finite for all
large $m$, say $m\geqslant m_0$, because $A,B<\infty$ (if $\alpha_m=\infty$ for every $m$
then $A=\infty$) and $\alpha_m\geqslant a_m>-\infty$. For $n\geqslant m$,
$a_n+b_n\leqslant\alpha_m+\beta_m$, so $\sup_{n\geqslant m}(a_n+b_n)\leqslant\alpha_m+\beta_m$
and therefore
\[
\limsup_n(a_n+b_n)=\inf_m\sup_{n\geqslant m}(a_n+b_n)\leqslant\alpha_m+\beta_m
\qquad(m\geqslant m_0) .
\]
If $A$ and $B$ are finite, $\alpha_m+\beta_m\to A+B$. If, say, $A=-\infty$, then
$\beta_m\leqslant\beta_{m_0}<\infty$ while $\alpha_m\to-\infty$, so
$\alpha_m+\beta_m\to-\infty=A+B$. In either case letting $m\to\infty$ gives the claim.

For strict inequality take $a_n=(-1)^n$ and $b_n=-a_n$: then $a_n+b_n=0$, so the left side
is $0$, while $\limsup_na_n=\limsup_nb_n=1$.
\end{solution}

\begin{exercise}[Knapp, problem I.7]\label{ex:kn-1-7}
\emph{(Dini's theorem.)} Let $K\subseteq\Real^d$ be compact (for instance $K=[a,b]$), let
$f_n:K\to\Real$ be continuous with $f_1\leqslant f_2\leqslant\cdots$, and suppose that
$f(x)=\lim_nf_n(x)$ is finite and continuous on $K$. Prove that
$\sup_{x\in K}|f(x)-f_n(x)|\to0$.
\end{exercise}

% source hint: knapp_real_b_15 hint:I.7 (generalised from the book's setting to a compact K in R^d)
\begin{solution}
Put $g_n=f-f_n$. Each $g_n$ is continuous and non-negative, $g_n\geqslant g_{n+1}$, and
$g_n(x)\to0$ for every $x$. By Theorem~\ref{thm:unif-cont} each $g_n$ attains its maximum
$M_n=g_n(x_n)$ at some $x_n\in K$, and $M_n\geqslant M_{n+1}$ since $g_n\geqslant g_{n+1}$.
Suppose $M_n\not\to0$. The sequence $(M_n)$ is decreasing, so then $M_n\geqslant\varepsilon$ for
every $n$, for some $\varepsilon>0$. By compactness (Definition~\ref{def:compact}) a
subsequence $x_{n_k}$ converges to some $x\in K$. Fix $m$; for $n_k\geqslant m$,
\[
g_m(x_{n_k})\geqslant g_{n_k}(x_{n_k})=M_{n_k}\geqslant\varepsilon ,
\]
and letting $k\to\infty$, continuity of $g_m$ gives $g_m(x)\geqslant\varepsilon$. This holds
for every $m$, contradicting $g_m(x)\to0$. Hence $\sup_K|f-f_n|=M_n\to0$.

Continuity of the limit cannot be dropped: on $K=[0,1]$, $f_n(x)=1-x^n$ increases to the
function equal to $1$ on $[0,1)$ and $0$ at $1$, and $\sup_K|f-f_n|=\sup_{x<1}x^n=1$ for every $n$.
\end{solution}

\begin{exercise}[Knapp, problem I.9]\label{ex:kn-1-9}
Let $f:\Real\to\Real$ be infinitely differentiable with $|f^{(n)}(x)|\leqslant1$ for all
$n\geqslant0$ and all $x$. Prove that $f(x)=\sum_{n=0}^\infty f^{(n)}(0)x^n/n!$ for every
$x\in\Real$.
\end{exercise}

% source hint: knapp_real_b_15 hint:I.9 (integral remainder in the hint; Lagrange remainder of Theorem thm:taylor here)
\begin{solution}
The case $x=0$ is trivial; fix $x\neq0$. By Theorem~\ref{thm:taylor}, for each $m$ there
is $\xi_m$ between $0$ and $x$ with
\[
\Bigl|f(x)-\sum_{n=0}^{m}\frac{f^{(n)}(0)}{n!}x^n\Bigr|
=\frac{|f^{(m+1)}(\xi_m)|}{(m+1)!}|x|^{m+1}\leqslant c_{m+1},
\qquad c_m=\frac{|x|^m}{m!} .
\]
It remains to show $c_m\to0$. Let $M$ be an integer with $M\geqslant2|x|$. For $m\geqslant M$,
$c_{m+1}/c_m=|x|/(m+1)\leqslant\frac12$, so, multiplying these ratio bounds for
$M,M+1,\ldots,m-1$, $c_m\leqslant c_M2^{-(m-M)}\to0$. Hence the partial
sums converge to $f(x)$. The functions $\sin$ and $\cos$ satisfy the hypothesis.
\end{solution}

\begin{exercise}[Knapp, problem II.8]\label{ex:kn-2-8}
\emph{(Contraction mapping principle.)} Let $C\subseteq\Real^d$ be non-empty and closed, let
$0\leqslant r<1$, and let $f:C\to C$ satisfy $|f(x)-f(y)|\leqslant r|x-y|$ for all
$x,y\in C$. Prove that $f$ has exactly one fixed point $x^\star\in C$, and that for every
$x_0\in C$ the iterates $x_{n+1}=f(x_n)$ satisfy
$|x_n-x^\star|\leqslant r^n|x_1-x_0|/(1-r)$.
\end{exercise}

% source hint: knapp_real_b_15 hint:II.8 (generalised to a closed C in R^d, with the error bound added)
\begin{solution}
By induction $|x_{k+1}-x_k|\leqslant r^k|x_1-x_0|$, the step being
$|x_{k+1}-x_k|=|f(x_k)-f(x_{k-1})|\leqslant r|x_k-x_{k-1}|$. For $m>n$ the triangle inequality gives
\begin{equation}\label{eq:ex-contraction}
|x_m-x_n|\leqslant\sum_{k=n}^{m-1}r^k|x_1-x_0|\leqslant\frac{r^n}{1-r}|x_1-x_0| .
\end{equation}
With $n=0$ this shows that $(x_n)$ is bounded, so by Theorem~\ref{thm:BW} a subsequence
$x_{n_j}$ converges to some $x^\star$, which lies in $C$ because $C$ is closed. The whole
sequence converges to $x^\star$: given $\varepsilon>0$, \eqref{eq:ex-contraction} gives $N$
with $|x_m-x_n|<\varepsilon$ for $m,n\geqslant N$; choosing $j$ with $n_j\geqslant N$ and
$|x_{n_j}-x^\star|<\varepsilon$ gives $|x_n-x^\star|<2\varepsilon$ for $n\geqslant N$. Since
$|f(x_n)-f(x^\star)|\leqslant r|x_n-x^\star|\to0$,
\[
x^\star=\lim_nx_{n+1}=\lim_nf(x_n)=f(x^\star) .
\]
If also $f(y)=y$ then $|x^\star-y|=|f(x^\star)-f(y)|\leqslant r|x^\star-y|$, which forces
$|x^\star-y|=0$ as $r<1$. Letting $m\to\infty$ in~\eqref{eq:ex-contraction} gives the error
bound.
\end{solution}

\begin{exercise}[Knapp, problem III.20]\label{ex:kn-3-20}
\emph{(Arithmetic-geometric mean inequality.)} Prove that
$(a_1a_2\cdots a_n)^{1/n}\leqslant(a_1+\cdots+a_n)/n$ for all $a_1,\ldots,a_n\geqslant0$,
with equality if and only if all $a_i$ are equal, by applying Theorem~\ref{thm:kkt} to
\[
\text{minimise } -\sum_{i=1}^n\log x_i \quad\text{subject to}\quad \sum_{i=1}^nx_i-s\leqslant0,
\qquad x\in(0,\infty)^n ,
\]
where $s=a_1+\cdots+a_n$.
\end{exercise}

% source hint: knapp_real_b_15 hint:III.20 (Lagrange multipliers on a compact set in the hint; the note has no equality-constrained multiplier rule, so the KKT sufficiency of Theorem thm:kkt is used instead; the equality case added)
\begin{solution}
If some $a_i=0$ the left side is $0$ and the inequality holds; equality then forces
$s=0$, that is, all $a_i=0$. Assume all $a_i>0$, so $s>0$.

\textbf{The problem is convex.} $\calD=(0,\infty)^n$ is open and convex. The function
$-\log$ has second derivative $1/t^2>0$ on $(0,\infty)$, so it is strictly convex by
Lemma~\ref{lem:convex-deriv}, and a sum of convex functions of separate coordinates is
convex by Definition~\ref{def:convex}; so $f_0(x)=-\sum_i\log x_i$ is convex, and it is
strictly convex because for $x\neq y$ some coordinate differs and contributes a strict
inequality. The constraint $f_1(x)=\sum_ix_i-s$ is affine, hence convex.

\textbf{A KKT pair.} Take $x^\star=(s/n,\ldots,s/n)$ and $\lambda^\star=n/s$. Then
$f_1(x^\star)=0\leqslant0$, $\lambda^\star\geqslant0$, $\lambda^\star f_1(x^\star)=0$, and
the $i$th coordinate of $\nabla f_0(x^\star)+\lambda^\star\nabla f_1(x^\star)$ is
$-n/s+n/s=0$. By the converse part of Theorem~\ref{thm:kkt}, $x^\star$ is primal optimal:
$-\sum_i\log x_i\geqslant-n\log(s/n)$ for every feasible $x$.

\textbf{Conclusion.} The point $a=(a_1,\ldots,a_n)$ is feasible, so
$\sum_i\log a_i\leqslant n\log(s/n)$; dividing by $n$ and exponentiating gives the
inequality. If equality holds, $a$ is a second minimiser. Two distinct minimisers are
impossible: their midpoint is feasible, the feasible set being convex, and strict convexity
of $f_0$ gives it a strictly smaller value. Hence $a=x^\star$, all $a_i$ being equal to
$s/n$; the converse is immediate. Slater's condition holds here (take $x=x^\star/2$) but
was not needed: the converse part of Theorem~\ref{thm:kkt} assumes only convexity.
\end{solution}

\subsection*{Linear algebra}

\begin{exercise}[Abadir--Magnus, exercise 4.13]\label{ex:am-4-13}
Let $\bA\in\Real^{n\times p}$. Show that
\begin{enumerate}[label=\textup{(\alph*)}]
\item $\calN(\bA')=\calN(\bA\bA')$;
\item $\calC(\bA)=\calC(\bA\bA')$;
\item $\rank(\bA)=\rank(\bA\bA')=\rank(\bA'\bA)=\rank(\bA')$.
\end{enumerate}
In particular the column rank of a matrix equals its row rank.
\end{exercise}

% source solution: ma_04 exer:4.13 (the book's part (b), C^perp(A)=C^perp(AA'), omitted; part (b) here is the book's (c), via projection instead of orthogonal complements)
\begin{solution}
(a) is Proposition~\ref{prop:gram} applied to $\bA'$ in place of $\bA$, since
$(\bA')'\bA'=\bA\bA'$.

(b) $\calC(\bA\bA')\subseteq\calC(\bA)$ because $\bA\bA'\bv=\bA(\bA'\bv)$. Conversely let
$\by\in\calC(\bA)$ and let $\hat\by$ be its orthogonal projection onto the subspace
$\calC(\bA\bA')$ (Theorem~\ref{thm:projection}), so $\br=\by-\hat\by$ is orthogonal to
$\calC(\bA\bA')$. Then $(\bA\bA'\bv)'\br=\bv'\bA\bA'\br=0$ for every $\bv$, so
$\bA\bA'\br=\bzero$, and by (a) $\bA'\br=\bzero$; thus $\br'\bA\bu=(\bA'\br)'\bu=0$ for every
$\bu$, that is, $\br\perp\calC(\bA)$. But $\br=\by-\hat\by\in\calC(\bA)$, both terms lying in
$\calC(\bA)$. Hence $\br\perp\br$, $\br=\bzero$ and $\by=\hat\by\in\calC(\bA\bA')$.

(c) By (b), $\rank(\bA)=\rank(\bA\bA')$. Proposition~\ref{prop:gram} gives
$\rank(\bA'\bA)=\rank(\bA)$, and applied to $\bA'$ it gives $\rank(\bA\bA')=\rank(\bA')$.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 12.5]\label{ex:am-12-5}
Let $\bA,\bB\in\Real^{m\times n}$. Show that
\begin{enumerate}[label=\textup{(\alph*)}]
\item $(\tr\bA'\bB)^2\leqslant\tr(\bA'\bA)\tr(\bB'\bB)$, with equality if and only if one of
      $\bA$, $\bB$ is a multiple of the other;
\item $\tr\bigl((\bA'\bB)^2\bigr)\leqslant\tr(\bA'\bA\bB'\bB)$, with equality if and only if
      $\bA\bB'$ is symmetric.
\end{enumerate}
\end{exercise}

% source solution: ma_12 exer:12.5 (part (b) by the identity tr((C-C')'(C-C'))=2tr(C'C)-2tr(C^2), which also gives the equality case; the book's part (c) omitted)
\begin{solution}
(a) The $(j,j)$ entry of $\bA'\bB$ is $\sum_ia_{ij}b_{ij}$, so
$\tr(\bA'\bB)=\sum_{i,j}a_{ij}b_{ij}=\langle\ba,\mathbf{b}\rangle$, where $\ba,\mathbf{b}\in\Real^{mn}$
list the entries of $\bA$ and $\bB$ in the same order; likewise $\tr(\bA'\bA)=|\ba|^2$ and
$\tr(\bB'\bB)=|\mathbf{b}|^2$ (Proposition~\ref{prop:trace}\ref{tr:iv}). Theorem~\ref{thm:CS}
gives the inequality, with equality exactly when $\ba$ and $\mathbf{b}$ are proportional,
that is, when one matrix is a multiple of the other.

(b) Put $\bC=\bA\bB'\in\Real^{m\times m}$. By Proposition~\ref{prop:trace}\ref{tr:ii},
$\tr(\bC'\bC)=\tr(\bB\bA'\bA\bB')=\tr(\bA'\bA\bB'\bB)$, and
$\tr(\bC^2)=\tr(\bA\bB'\bA\bB')=\tr(\bB'\bA\bB'\bA)=\tr\bigl(((\bA'\bB)')^2\bigr)
=\tr\bigl((\bA'\bB)^2\bigr)$, a trace being unchanged by transposition. Expanding,
\[
\tr\bigl((\bC-\bC')'(\bC-\bC')\bigr)
=\tr(\bC'\bC)-\tr(\bC'\bC')-\tr(\bC\bC)+\tr(\bC\bC')=2\tr(\bC'\bC)-2\tr(\bC^2) ,
\]
using $\tr(\bC'\bC')=\tr(\bC^2)$ and $\tr(\bC\bC')=\tr(\bC'\bC)$. The left side is
non-negative and vanishes only if $\bC=\bC'$, by Proposition~\ref{prop:trace}\ref{tr:iv}.
Hence $\tr\bigl((\bA'\bB)^2\bigr)=\tr(\bC^2)\leqslant\tr(\bC'\bC)=\tr(\bA'\bA\bB'\bB)$, with
equality if and only if $\bA\bB'$ is symmetric.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 13.57]\label{ex:am-13-57}
\emph{(Gauss--Markov.)} Let $\bX\in\Real^{n\times k}$ have rank $k$ and
$\bG_0=(\bX'\bX)^{-1}\bX'$. Show that every $\bG\in\Real^{k\times n}$ with $\bG\bX=\bI_k$
satisfies: $\bG\bG'-\bG_0\bG_0'$ is positive semi-definite, and
$\tr(\bG\bG')\geqslant\tr(\bG_0\bG_0')$ with equality only for $\bG=\bG_0$. Deduce that if
$\by=\bX\bb+\be$ with $\expc[\be]=\bzero$ and $\var(\be)=\sigma^2\bI_n$, then among all
estimators $\bG\by$ with $\expc[\bG\by]=\bb$ for every $\bb$, the least squares estimator
$\bG_0\by$ has the smallest covariance matrix.
\end{exercise}

% source solution: ma_13 exer:13.57 (Lagrangian in the book; direct decomposition G=G_0+D here; the Loewner-order statement and the estimator corollary added)
\begin{solution}
$\bX'\bX$ is invertible by Proposition~\ref{prop:gram}, and $\bG_0\bX=\bI_k$. Let
$\bD=\bG-\bG_0$, so $\bD\bX=\bzero$ and $\bG_0\bD'=(\bX'\bX)^{-1}(\bD\bX)'=\bzero$. Hence
\[
\bG\bG'=\bG_0\bG_0'+\bG_0\bD'+\bD\bG_0'+\bD\bD'=\bG_0\bG_0'+\bD\bD' .
\]
$\bD\bD'$ is positive semi-definite, as $\bv'\bD\bD'\bv=|\bD'\bv|^2$, and
$\tr(\bD\bD')=\sum_{i,j}d_{ij}^2$ (Proposition~\ref{prop:trace}\ref{tr:iv}) is positive
unless $\bD=\bzero$.

For the estimators: $\expc[\bG\by]=\bG\bX\bb$, and this equals $\bb$ for every $\bb$ if
and only if $\bG\bX=\bI_k$ (take $\bb=\mathbf{e}_j$, the $j$th standard basis vector, for
each $j$). By Proposition~\ref{prop:var-linear}, $\var(\bG\by)=\sigma^2\bG\bG'$, so
$\var(\bG\by)-\var(\bG_0\by)=\sigma^2\bD\bD'$ is positive semi-definite: every linear
combination $\bc'\bG\by$ has variance at least that of $\bc'\bG_0\by$.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 12.49]\label{ex:am-12-49}
\emph{(Ky Fan.)} Let $\bA\in\Real^{n\times n}$ be symmetric with eigenvalues
$\lambda_1\geqslant\cdots\geqslant\lambda_n$, and let $1\leqslant r\leqslant n$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that over $\bX\in\Real^{n\times r}$ with $\bX'\bX=\bI_r$,
\[
\max\tr(\bX'\bA\bX)=\sum_{k=1}^r\lambda_k ,
\qquad
\min\tr(\bX'\bA\bX)=\sum_{k=1}^r\lambda_{n-r+k} .
\]
\item Deduce that the leading $r\times r$ block $\bA_{(r)}$ of $\bA$ satisfies
$\sum_{k=1}^r\lambda_{n-r+k}\leqslant\tr\bA_{(r)}\leqslant\sum_{k=1}^r\lambda_k$.
\end{enumerate}
\end{exercise}

% source solution: ma_12 exer:12.49 (the book uses Poincare separation, not in the note; proved directly here)
\begin{solution}
(a) Write $\bA=\bP\bLam\bP'$ (Theorem~\ref{thm:spectral}), with the diagonal of $\bLam$ in the
order $\lambda_1\geqslant\cdots\geqslant\lambda_n$ after the reordering in the proof of
Corollary~\ref{cor:rayleigh}, and $\bW=\bP'\bX$, so
$\bW'\bW=\bX'\bP\bP'\bX=\bI_r$ and, by Proposition~\ref{prop:trace}\ref{tr:ii},
\[
\tr(\bX'\bA\bX)=\tr(\bW'\bLam\bW)=\sum_{j=1}^n\lambda_jh_j,
\qquad h_j=\sum_{l=1}^rw_{jl}^2=(\bW\bW')_{jj} .
\]
First, $\sum_jh_j=\tr(\bW\bW')=\tr(\bW'\bW)=r$. Second, $0\leqslant h_j\leqslant1$: the
matrix $\bH=\bW\bW'$ is symmetric and idempotent, as $\bW\bW'\bW\bW'=\bW\bW'$, so it is an
orthogonal projection (Proposition~\ref{prop:proj-char}), and
$h_j=\mathbf{e}_j'\bH\mathbf{e}_j=\mathbf{e}_j'\bH'\bH\mathbf{e}_j=|\bH\mathbf{e}_j|^2\leqslant|\mathbf{e}_j|^2=1$ by
Theorem~\ref{thm:pythagoras} applied to $\mathbf{e}_j=\bH\mathbf{e}_j+(\mathbf{e}_j-\bH\mathbf{e}_j)$. Therefore
\[
\sum_j\lambda_jh_j-\sum_{j\leqslant r}\lambda_j
=\sum_{j\leqslant r}\lambda_j(h_j-1)+\sum_{j>r}\lambda_jh_j
\leqslant\lambda_r\sum_{j\leqslant r}(h_j-1)+\lambda_r\sum_{j>r}h_j=\lambda_r\Bigl(\sum_jh_j-r\Bigr)=0 ,
\]
using $h_j-1\leqslant0$ and $\lambda_j\geqslant\lambda_r$ for $j\leqslant r$, and
$h_j\geqslant0$ and $\lambda_j\leqslant\lambda_r$ for $j>r$. The bound is attained by the
first $r$ columns of $\bP$, for which $\bW$ consists of the first $r$ columns of $\bI_n$ and
$h_j=\indc\{j\leqslant r\}$. The minimum follows by applying the maximum to $-\bA$, whose
eigenvalues in decreasing order are $-\lambda_n\geqslant\cdots\geqslant-\lambda_1$.

(b) Take $\bX=(\bI_r,\bzero)'$, for which $\bX'\bX=\bI_r$ and $\bX'\bA\bX=\bA_{(r)}$. For $r=1$,
(a) is Corollary~\ref{cor:rayleigh}; for general $r$ it says that the first $r$ principal
components capture the largest possible total variance.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 12.16]\label{ex:am-12-16}
Let $\bA,\bB\in\Real^{n\times n}$ be positive definite. Show that $\bA-\bB$ is positive
definite if and only if $\bB^{-1}-\bA^{-1}$ is, and that the same holds with
``positive semi-definite'' in both places.
\end{exercise}

% source solution: ma_12 exer:12.16 (simultaneous diagonalisation in the book; congruence by B^{-1/2} here; the positive semi-definite version added)
\begin{solution}
\textbf{Step 1: congruence.} If $\bT$ is invertible and $\bM$ symmetric, then $\bM$ is
positive definite if and only if $\bT'\bM\bT$ is: $\bv'\bT'\bM\bT\bv=(\bT\bv)'\bM(\bT\bv)$,
and $\bT\bv\neq\bzero$ exactly when $\bv\neq\bzero$, while every $\bu$ is $\bT\bv$ with
$\bv=\bT^{-1}\bu$; so $\bu'\bM\bu$ over $\bu\neq\bzero$ and $\bv'\bT'\bM\bT\bv$ over
$\bv\neq\bzero$ take the same values. The same argument applies to semi-definiteness.

\textbf{Step 2.} Let $\bB^{1/2}$ and $\bB^{-1/2}$ be as in Theorem~\ref{thm:sqrt}; both are
symmetric, and $\bB^{-1/2}\bB^{-1/2}=(\bB^{1/2}\bB^{1/2})^{-1}=\bB^{-1}$. Put
$\bC=\bB^{-1/2}\bA\bB^{-1/2}$, positive definite by Step~1, with spectral decomposition
$\bC=\bP\bGam\bP'$, $\bGam=\diag(\gamma_1,\ldots,\gamma_n)$, all $\gamma_i>0$. Then
\[
\bA-\bB=\bB^{1/2}(\bC-\bI)\bB^{1/2},
\qquad
\bB^{-1}-\bA^{-1}=\bB^{-1/2}(\bI-\bC^{-1})\bB^{-1/2},
\]
the second because $\bC^{-1}=\bB^{1/2}\bA^{-1}\bB^{1/2}$. By Step~1 and
Proposition~\ref{prop:pd-eigen}, $\bA-\bB$ is positive definite iff
$\bC-\bI=\bP(\bGam-\bI)\bP'$ is, iff every $\gamma_i>1$; and $\bB^{-1}-\bA^{-1}$ is positive
definite iff $\bI-\bC^{-1}=\bP(\bI-\bGam^{-1})\bP'$ is, iff every $1/\gamma_i<1$. The two
conditions coincide. With $\geqslant$ in place of $>$ the same chain gives the
semi-definite statement. Thus a larger information matrix has a smaller inverse, which is
how asymptotic efficiency comparisons are read.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 8.64]\label{ex:am-8-64}
Let $\bA,\bB\in\Real^{n\times n}$ be idempotent.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $\bA+\bB$ is idempotent if and only if $\bA\bB=\bB\bA=\bzero$.
\item If $\bA+\bB$ is idempotent, show that $\rank(\bA+\bB)=\rank(\bA)+\rank(\bB)$.
\end{enumerate}
\end{exercise}

% source solution: ma_08 exer:8.64
\begin{solution}
(a) $(\bA+\bB)^2=\bA+\bB+\bA\bB+\bB\bA$, so $\bA+\bB$ is idempotent if and only if
$\bA\bB+\bB\bA=\bzero$. This clearly holds if $\bA\bB=\bB\bA=\bzero$. Conversely,
multiplying $\bA\bB+\bB\bA=\bzero$ by $\bA$ on the left and on the right gives
$\bA\bB+\bA\bB\bA=\bzero$ and $\bA\bB\bA+\bB\bA=\bzero$; subtracting, $\bA\bB=\bB\bA$, and
then $2\bA\bB=\bzero$.

(b) By Lemma~\ref{lem:idempotent} applied to $\bA$, $\bB$ and $\bA+\bB$, and linearity of the
trace, $\rank(\bA+\bB)=\tr(\bA+\bB)=\tr\bA+\tr\bB=\rank\bA+\rank\bB$. For instance, with
$\bH$ a projection, $\bH+(\bI-\bH)=\bI$ splits $n$ into $\rank\bH+\rank(\bI-\bH)$, the
degrees-of-freedom count behind Theorem~\ref{thm:cochran}.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 8.74]\label{ex:am-8-74}
For $n\geqslant2$ and real $t$ let $\bR=(1-t)\bI_n+t\bone\bone'$, the equicorrelation matrix.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that its eigenvalues are $1+(n-1)t$, with eigenvector $\bone$, and $1-t$, with
      multiplicity $n-1$ (for $t\neq0$) and eigenvectors the vectors orthogonal to $\bone$.
\item For which $t$ is $\bR$ positive definite?
\item Find $\bR^{-1}$ when it exists, and check the answer with Lemma~\ref{lem:sherman}.
\end{enumerate}
\end{exercise}

% source solution: ma_08 exer:8.74 (determinant part omitted; Sherman--Morrison check added)
\begin{solution}
(a) Let $\mathbf{J}=n^{-1}\bone\bone'$. It is symmetric and idempotent ($\bone'\bone=n$), so is
$\bI-\mathbf{J}$, and $\mathbf{J}(\bI-\mathbf{J})=\bzero$. Since $t\bone\bone'=nt\mathbf{J}$,
\[
\bR=\alpha_1\mathbf{J}+\alpha_2(\bI-\mathbf{J}),\qquad \alpha_1=1+(n-1)t,\quad \alpha_2=1-t .
\]
$\mathbf{J}\bone=\bone$ gives $\bR\bone=\alpha_1\bone$, and $\bv\perp\bone$ gives $\mathbf{J}\bv=\bzero$
and $\bR\bv=\alpha_2\bv$. The orthogonal complement of $\bone$ is $\calN(\bone')$, of
dimension $n-1$ by Theorem~\ref{thm:rank-nullity}. These are all the eigenvalues: if
$\bR\bx=\mu\bx$ with $\bx\neq\bzero$, multiplying by $\mathbf{J}$ and by $\bI-\mathbf{J}$ and
using $\mathbf{J}^2=\mathbf{J}$, $\mathbf{J}(\bI-\mathbf{J})=\bzero$ gives
$(\alpha_1-\mu)\mathbf{J}\bx=\bzero$ and $(\alpha_2-\mu)(\bI-\mathbf{J})\bx=\bzero$; as
$\mathbf{J}\bx+(\bI-\mathbf{J})\bx=\bx\neq\bzero$, one of the two is non-zero, so
$\mu\in\{\alpha_1,\alpha_2\}$. For the multiplicities (the multiplicity of an eigenvalue
being the number of diagonal entries of $\bLam$ in Theorem~\ref{thm:spectral} equal to it; the
count below does not depend on the choice of $\bP$), if $t=0$ then $\bR=\bI$ and
$\alpha_1=\alpha_2=1$, so the two eigenvalues coincide and $1$ has multiplicity $n$; let $t\neq0$, so $\alpha_1\neq\alpha_2$, and let $\bR=\bP\bLam\bP'$ as
in Theorem~\ref{thm:spectral}, the columns $\bp_1,\ldots,\bp_n$ of $\bP$ being orthonormal
eigenvectors. A column with eigenvalue $\alpha_1$ satisfies $(\bI-\mathbf{J})\bp_i=\bzero$ (by the
relations just derived, with $\mu=\alpha_1\neq\alpha_2$), so $\bp_i=\mathbf{J}\bp_i=n^{-1}(\bone'\bp_i)\bone$;
two such columns $a\bone$, $b\bone$ would have $0=\bp_i'\bp_l=abn$, so one of them would be
$\bzero$, which is impossible; hence at most one column has eigenvalue $\alpha_1$. A column with
eigenvalue $\alpha_2$ satisfies $\mathbf{J}\bp_i=\bzero$, that is $\bp_i\in\calN(\bone')$;
orthonormal vectors are linearly independent (if $\sum_ic_i\bp_i=\bzero$, multiply by $\bp_l'$
to get $c_l=0$), so at most $n-1$ columns lie in this $(n-1)$-dimensional subspace. The $n$
columns are thus split as exactly one with eigenvalue $\alpha_1$ and $n-1$ with eigenvalue
$\alpha_2$: the multiplicities are $1$ and $n-1$.

(b) By Proposition~\ref{prop:pd-eigen}, $\bR$ is positive definite iff $\alpha_1>0$ and
$\alpha_2>0$, that is, $-1/(n-1)<t<1$. Equal correlations among $n$ variables can be
negative only down to $-1/(n-1)$.

(c) $\bR$ is invertible iff $\alpha_1\neq0\neq\alpha_2$. If $\alpha_1=0$ then $\bR\bone=\bzero$,
and if $\alpha_2=0$ then $\bR\bv=\bzero$ for any non-zero $\bv\in\calN(\bone')$, which exists
as this space has dimension $n-1\geqslant1$; either way $\bR$ is not invertible. Otherwise
$\bR^{-1}=\alpha_1^{-1}\mathbf{J}+\alpha_2^{-1}(\bI-\mathbf{J})$, since by $\mathbf{J}^2=\mathbf{J}$,
$\mathbf{J}(\bI-\mathbf{J})=\bzero$ and $(\bI-\mathbf{J})^2=\bI-\mathbf{J}$ the product with $\bR$ is
$\mathbf{J}+(\bI-\mathbf{J})=\bI$. Writing $\bR=\bA-\bu\bv'$ with $\bA=(1-t)\bI$, $\bu=-t\bone$, $\bv=\bone$,
one has $1-\bv'\bA^{-1}\bu=1+nt/(1-t)=\alpha_1/\alpha_2$, and~\eqref{eq:sherman} gives
\[
\bR^{-1}=\frac{1}{1-t}\Bigl(\bI-\frac{t}{1+(n-1)t}\bone\bone'\Bigr) ,
\]
which agrees with the first expression, as
$\alpha_1^{-1}-\alpha_2^{-1}=-nt/(\alpha_1\alpha_2)$.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 8.47]\label{ex:am-8-47}
Let $\bZ=\bigl(\begin{smallmatrix}\bA&\bB\\\bB'&\bD\end{smallmatrix}\bigr)$ be symmetric
with $\bA\in\Real^{m\times m}$. Show that $\bZ$ is positive definite if and only if $\bA$
and $\bS=\bD-\bB'\bA^{-1}\bB$ are both positive definite.
\end{exercise}

% source solution: ma_08 exer:8.47 (the book's equivalent forms omitted)
\begin{solution}
If $\bZ$ is positive definite, so is $\bA$: for $\bu\neq\bzero$,
$\bu'\bA\bu=(\bu',\bzero')\bZ(\bu',\bzero')'>0$. So in either direction $\bA$ is positive
definite, hence invertible (Proposition~\ref{prop:pd-eigen}), and
$\bT=\bigl(\begin{smallmatrix}\bI&-\bA^{-1}\bB\\\bzero&\bI\end{smallmatrix}\bigr)$ is defined
and invertible, with inverse
$\bigl(\begin{smallmatrix}\bI&\bA^{-1}\bB\\\bzero&\bI\end{smallmatrix}\bigr)$. As $\bA$ is
symmetric, $(\bA^{-1})'\bA=(\bA\bA^{-1})'=\bI$, so $(\bA^{-1})'=\bA^{-1}$; this gives the form
of $\bT'$ below and makes $\bS$ symmetric ($\bD$ is, as $\bZ$ is). Blockwise,
\[
\bZ\bT=\begin{pmatrix}\bA&\bzero\\\bB'&\bS\end{pmatrix},
\qquad
\bT'\bZ\bT=\begin{pmatrix}\bI&\bzero\\-\bB'\bA^{-1}&\bI\end{pmatrix}
\begin{pmatrix}\bA&\bzero\\\bB'&\bS\end{pmatrix}
=\begin{pmatrix}\bA&\bzero\\\bzero&\bS\end{pmatrix} .
\]
By Step~1 of the solution of Exercise~\ref{ex:am-12-16}, $\bZ$ is positive definite iff the
block-diagonal matrix is, and
$(\bu',\bw')\diag(\bA,\bS)(\bu',\bw')'=\bu'\bA\bu+\bw'\bS\bw$ is positive for all
$(\bu,\bw)\neq\bzero$ iff $\bA$ and $\bS$ are positive definite. With
Theorem~\ref{thm:schur} this shows that the lower-right block $\bS^{-1}$ of $\bZ^{-1}$ is
positive definite: it is symmetric as $\bS$ is (by the argument just given for $\bA^{-1}$), and
for $\bw\neq\bzero$, $\bw'\bS^{-1}\bw=(\bS^{-1}\bw)'\bS(\bS^{-1}\bw)>0$ since
$\bS^{-1}\bw\neq\bzero$.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 5.17]\label{ex:am-5-17}
\emph{(Woodbury.)} Let $\bA\in\Real^{m\times m}$ and $\bD\in\Real^{n\times n}$ be invertible,
$\bB\in\Real^{m\times n}$, $\bC\in\Real^{n\times m}$, and suppose
$\bS=\bD-\bC\bA^{-1}\bB$ is invertible. Show that $\bA-\bB\bD^{-1}\bC$ is invertible with
\[
(\bA-\bB\bD^{-1}\bC)^{-1}=\bA^{-1}+\bA^{-1}\bB\bS^{-1}\bC\bA^{-1} ,
\]
and that Lemma~\ref{lem:sherman} is the case $n=1$.
\end{exercise}

% source solution: ma_05 exer:5.17 (the book compares two block-inverse formulas; direct verification here; the book's second identity omitted)
\begin{solution}
Multiply the proposed inverse by $\bA-\bB\bD^{-1}\bC$ on the left:
\[
\bI+\bB\bS^{-1}\bC\bA^{-1}-\bB\bD^{-1}\bC\bA^{-1}-\bB\bD^{-1}\bC\bA^{-1}\bB\bS^{-1}\bC\bA^{-1}
=\bI+\bB\bK\bC\bA^{-1},
\]
where
$\bK=\bS^{-1}-\bD^{-1}-\bD^{-1}\bC\bA^{-1}\bB\bS^{-1}
=\bD^{-1}(\bD-\bC\bA^{-1}\bB)\bS^{-1}-\bD^{-1}=\bD^{-1}\bS\bS^{-1}-\bD^{-1}=\bzero$.
So the proposed matrix is a right inverse of the square matrix $\bA-\bB\bD^{-1}\bC$, hence
its inverse (Remark~\ref{rem:elementary}). For $n=1$ take $\bB=\bu$, $\bC=\bv'$ and $\bD=1$:
then $\bS=1-\bv'\bA^{-1}\bu$ and the formula is~\eqref{eq:sherman}.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 8.40]\label{ex:am-8-40}
\emph{(Polar decomposition.)} Let $\bA\in\Real^{m\times n}$ have full column rank $n$. Show
that $\bA=\bQ\bV$ with $\bQ\in\Real^{m\times n}$, $\bQ'\bQ=\bI_n$, and $\bV$ positive definite,
and that necessarily $\bV=(\bA'\bA)^{1/2}$, so the factorisation is unique. State the
analogue for full row rank.
\end{exercise}

% source solution: ma_08 exer:8.40 (uniqueness added)
\begin{solution}
By Theorem~\ref{thm:svd} with $r=n$, $\bA=\bU\bD\bW'$ with $\bU\in\Real^{m\times n}$,
$\bU'\bU=\bI_n$, $\bW\in\Real^{n\times n}$, $\bW'\bW=\bI_n$, and $\bD$ diagonal with positive
entries. $\bW$ is square, so $\bW\bW'=\bI_n$ as well (Remark~\ref{rem:elementary}). Put
$\bQ=\bU\bW'$ and $\bV=\bW\bD\bW'$. Then $\bQ'\bQ=\bW\bU'\bU\bW'=\bI_n$, $\bV$ is symmetric
with eigenvalues $d_1,\ldots,d_n>0$, hence positive definite, and
$\bQ\bV=\bU\bW'\bW\bD\bW'=\bU\bD\bW'=\bA$.

If $\bA=\bQ\bV$ is any such factorisation, $\bA'\bA=\bV\bQ'\bQ\bV=\bV^2$, so $\bV$ is a
positive semi-definite square root of $\bA'\bA$ and equals $(\bA'\bA)^{1/2}$ by the
uniqueness in Theorem~\ref{thm:sqrt}; then $\bQ=\bA\bV^{-1}$. If $\bA$ has full row rank
$m$, applying this to $\bA'$ gives $\bA=\bV\bQ'$ with $\bV=(\bA\bA')^{1/2}$ and
$\bQ'\bQ=\bI_m$.
\end{solution}

\begin{exercise}[Knapp, problem III.1]\label{ex:kn-3-1}
For $\bA\in\Real^{m\times n}$ let $|\bA|_F=(\tr\bA'\bA)^{1/2}=(\sum_{i,j}a_{ij}^2)^{1/2}$ be the
Hilbert--Schmidt (Frobenius) norm. Show that
\begin{enumerate}[label=\textup{(\alph*)}]
\item $|\bA\bB|_F\leqslant|\bA|_F|\bB|_F$ for $\bB\in\Real^{n\times k}$;
\item $|\bI_n|_F=\sqrt n$;
\item $\|\bA\|\leqslant|\bA|_F\leqslant\sqrt{\rank(\bA)}\,\|\bA\|$, with $\|\cdot\|$ the operator
      norm of Definition~\ref{def:opnorm}.
\end{enumerate}
\end{exercise}

% source hint: knapp_real_b_15 hint:III.1 (part (c) added)
\begin{solution}
(a) The $(i,j)$ entry of $\bA\bB$ is $\sum_la_{il}b_{lj}$, the inner product of the $i$th row
of $\bA$ with the $j$th column of $\bB$. By Theorem~\ref{thm:CS} its square is at most
$(\sum_la_{il}^2)(\sum_lb_{lj}^2)$; summing over $i$ and $j$,
$|\bA\bB|_F^2\leqslant(\sum_{i,l}a_{il}^2)(\sum_{l,j}b_{lj}^2)=|\bA|_F^2|\bB|_F^2$.

(b) $\tr(\bI_n'\bI_n)=n$.

(c) For $\bA=\bzero$ all three are $0$. Otherwise, with $\bA=\bU\bD\bV'$ from
Theorem~\ref{thm:svd}, $\bA'\bA=\bV\bD^2\bV'$ and, by
Proposition~\ref{prop:trace}\ref{tr:ii}, $|\bA|_F^2=\tr(\bD^2\bV'\bV)=\sum_{j\leqslant r}d_j^2$,
where $r=\rank(\bA)$. This lies between $d_1^2$ and $rd_1^2$, and $d_1=\|\bA\|$ by
Proposition~\ref{prop:opnorm}. Part (b) shows that the right inequality can be an equality,
and that $|\cdot|_F$ differs from the operator norm, which gives the identity the norm
$\sup_{|\bx|=1}|\bx|=1$.
\end{solution}

\begin{exercise}[Abadir--Magnus, exercise 13.56]\label{ex:am-13-56}
\emph{(Constrained least squares.)} Let $\bX\in\Real^{n\times k}$ have rank $k$,
$\bOmega\in\Real^{n\times n}$ be positive definite, $\bR\in\Real^{k\times r}$ have rank $r$,
$\bc\in\Real^r$, $\by\in\Real^n$, and put $\bM=\bX'\bOmega^{-1}\bX$ and $\hat\bb=\bM^{-1}\bX'\bOmega^{-1}\by$.
Using Theorem~\ref{thm:kkt}, with the constraint $\bR'\bb=\bc$ written as the two
inequalities $\bR'\bb-\bc\leqslant\bzero$ and $\bc-\bR'\bb\leqslant\bzero$, show that the
unique minimiser of $Q(\bb)=(\by-\bX\bb)'\bOmega^{-1}(\by-\bX\bb)$ subject to $\bR'\bb=\bc$ is
\[
\tilde\bb=\hat\bb-\bM^{-1}\bR(\bR'\bM^{-1}\bR)^{-1}(\bR'\hat\bb-\bc) .
\]
\end{exercise}

% source solution: ma_13 exer:13.56 (Lagrangian first-order conditions in the book; KKT sufficiency here)
\begin{solution}
\textbf{Step 1: the inverses exist.} $\bOmega^{-1}$ is positive definite, its eigenvalues
being the reciprocals of those of $\bOmega$. For $\bv\neq\bzero$, $\bX\bv\neq\bzero$ by full
column rank (Theorem~\ref{thm:rank-nullity} gives $\dim\calN(\bX)=k-k=0$), so $\bv'\bM\bv=(\bX\bv)'\bOmega^{-1}(\bX\bv)>0$: $\bM$ and hence $\bM^{-1}$ are
positive definite. For $\bw\neq\bzero$, $\bR\bw\neq\bzero$, so
$\bw'\bR'\bM^{-1}\bR\bw>0$ and $\bR'\bM^{-1}\bR$ is invertible.

\textbf{Step 2: convexity and the gradient.} Expanding,
$Q(\bb)=\by'\bOmega^{-1}\by-2\by'\bOmega^{-1}\bX\bb+\bb'\bM\bb$, so by
Lemma~\ref{lem:matrix-diff} $\nabla Q(\bb)=2(\bM\bb-\bX'\bOmega^{-1}\by)$, and for every $\bh$
\begin{equation}\label{eq:ex-cls}
Q(\bb+\bh)=Q(\bb)+\nabla Q(\bb)'\bh+\bh'\bM\bh .
\end{equation}
As $\bh'\bM\bh\geqslant0$, the gradient inequality of Proposition~\ref{prop:convex-fo} holds
and $Q$ is convex on the open set $\Real^k$. The constraint functions are affine, hence
convex.

\textbf{Step 3: a KKT pair.} Let $\boldsymbol{\nu}=2(\bR'\bM^{-1}\bR)^{-1}(\bR'\hat\bb-\bc)$, and let
$\blam_+$, $\blam_-$ be its coordinatewise positive and negative parts, so
$\blam_\pm\geqslant\bzero$ and $\blam_+-\blam_-=\boldsymbol{\nu}$. Since $\bM\hat\bb=\bX'\bOmega^{-1}\by$,
$\tilde\bb=\hat\bb-\frac12\bM^{-1}\bR\boldsymbol{\nu}$ satisfies
\[
\nabla Q(\tilde\bb)+\bR\blam_+-\bR\blam_-=2\bM(\tilde\bb-\hat\bb)+\bR\boldsymbol{\nu}=\bzero ,
\]
which is the stationarity condition~\eqref{eq:kkt-stat}, and
$\bR'\tilde\bb=\bR'\hat\bb-(\bR'\hat\bb-\bc)=\bc$, so both constraint vectors vanish at
$\tilde\bb$: feasibility and complementary slackness hold. By the converse part of
Theorem~\ref{thm:kkt}, $\tilde\bb$ minimises $Q$ on the feasible set.

\textbf{Step 4: uniqueness.} If $\bb$ is feasible, $\bh=\bb-\tilde\bb$ has $\bR'\bh=\bzero$, so
$\nabla Q(\tilde\bb)'\bh=-\boldsymbol{\nu}'\bR'\bh=0$ and~\eqref{eq:ex-cls} gives
$Q(\bb)=Q(\tilde\bb)+\bh'\bM\bh>Q(\tilde\bb)$ unless $\bh=\bzero$. No point satisfies both
inequalities strictly, so Slater's condition fails and the necessity half of
Theorem~\ref{thm:kkt} is unavailable; the sufficiency half needs only convexity.
\end{solution}

\subsection*{Measure-theoretic probability}

\begin{exercise}[Knapp, problems V.3--V.4]\label{ex:kn-5-4}
Let $(\Omega,\calF,\mu)$ be a measure space, $E_1,E_2,\ldots\in\calF$,
$A=\bigcap_m\bigcup_{k\geqslant m}E_k$ and $B=\bigcup_m\bigcap_{k\geqslant m}E_k$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $\indc_A=\limsup_n\indc_{E_n}$ and $\indc_B=\liminf_n\indc_{E_n}$, so $B\subseteq A$.
\item If $\mu$ is finite and $A=B=:E$, show that $\mu(E_n)\to\mu(E)$.
\item Show that finiteness of $\mu$ cannot be dropped in (b).
\end{enumerate}
\end{exercise}

% source hint: knapp_real_b_15 hint:V.4 (no hint is printed for V.3; part (c) and "so B is contained in A" added)
\begin{solution}
(a) $\omega\in A$ iff for every $m$ some $k\geqslant m$ has $\omega\in E_k$, iff
$\sup_{k\geqslant m}\indc_{E_k}(\omega)=1$ for every $m$, iff $\limsup_n\indc_{E_n}(\omega)=1$;
otherwise that $\limsup$ is $0$. Likewise $\omega\in B$ iff $\omega$ lies in all $E_k$ from
some index on, iff $\liminf_n\indc_{E_n}(\omega)=1$. Proposition~\ref{prop:limsup} gives
$\indc_B\leqslant\indc_A$.

(b) By (a), $\limsup_n\indc_{E_n}=\indc_E=\liminf_n\indc_{E_n}$, so $\indc_{E_n}\to\indc_E$
at every point (Proposition~\ref{prop:limsup}). The constant $1$ dominates every
$\indc_{E_n}$ and is integrable because $\mu(\Omega)<\infty$, so Theorem~\ref{thm:dct} and
Lemma~\ref{lem:int-mono}(iv) give $\mu(E_n)=\int\indc_{E_n}\,\dd\mu\to\int\indc_E\,\dd\mu=\mu(E)$.

(c) For the counting measure on the positive integers and $E_n=\{n,n+1,\ldots\}$,
$A=B=\emptyset$ while $\mu(E_n)=\infty$ for every $n$. In probability, $A$ is the event
$\{E_n\text{ infinitely often}\}$ of Lemma~\ref{lem:BC}.
\end{solution}

\begin{exercise}[Baldi, exercise 1.11]\label{ex:ba-1-11}
Let $(w_n)_{n\geqslant1}$ be real and $\varphi(t)=\sum_{n=1}^\infty w_ne^{-tn}$ for $t>0$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item If $(w_n)$ is bounded, show that $\varphi$ is differentiable on $(0,\infty)$ with
      $\varphi'(t)=-\sum_{n=1}^\infty nw_ne^{-tn}$.
\item Show that the same holds for $w_n=\sqrt n$ and for $w_n=e^{\sqrt n}$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:1.11 (the book uses the measure mu(n)=w_n; counting measure here)
\begin{solution}
\textbf{Sums as integrals.} Let $\kappa$ be the counting measure on the positive integers
with all subsets measurable. For $g\geqslant0$, $g=\sum_ng(n)\indc_{\{n\}}$, so
Corollary~\ref{cor:int-series}(i) and Lemma~\ref{lem:int-mono}(iv) give
$\int g\,\dd\kappa=\sum_ng(n)$. Hence $g$ is $\kappa$-integrable iff $\sum_n|g(n)|<\infty$,
and then $\int g\,\dd\kappa=\sum_ng(n)$, applying the above to $g^\pm$.

\textbf{(a)} Let $|w_n|\leqslant W$, fix $a>0$, and apply Theorem~\ref{thm:diff-int} on
$I=(a,\infty)$ to $f(t,n)=w_ne^{-tn}$. (i) $\sum_n|w_n|e^{-tn}\leqslant W\sum_ne^{-an}<\infty$.
(ii) $\partial f/\partial t(t,n)=-nw_ne^{-tn}$. (iii)
$|\partial f/\partial t(t,n)|\leqslant g(n):=Wne^{-an}$ for $t\in I$, and $\sum_nne^{-an}<\infty$:
$ne^{-an/2}\leqslant8/(a^2n)\to0$ (from the exponential series, whose terms are non-negative,
$e^{an/2}\geqslant(an/2)^2/2$), so $ne^{-an}\leqslant Ce^{-an/2}$ for a constant $C$, a geometric bound.
The theorem gives the formula on $(a,\infty)$, and $a>0$ was arbitrary.

\textbf{(b)} The same three checks go through once $\sum_n|w_n|ne^{-an}<\infty$ for every
$a>0$ (this sum also dominates the one in (i)). For $w_n=\sqrt n$ the terms are
$n^{3/2}e^{-an}\leqslant Ce^{-an/2}$, as $n^{3/2}e^{-an/2}\leqslant48/(a^3n^{3/2})\to0$ by $e^{an/2}\geqslant(an/2)^3/6$. For $w_n=e^{\sqrt n}$, once
$n\geqslant16/a^2$ one has $\sqrt n\leqslant an/4$, so $ne^{\sqrt n-an}\leqslant ne^{-3an/4}$,
again summable.
\end{solution}

\begin{exercise}[Baldi, exercise 3.8]\label{ex:ba-3-8}
Let $X_1,X_2,\ldots$ be random variables with $\sum_k\expc|X_k|<\infty$ and
$S_n=\sum_{k\leqslant n}X_k$. Show that $\sum_kX_k$ converges absolutely almost surely to an
integrable $S$, that $\expc|S_n-S|\to0$, and that $\expc[S]=\sum_k\expc[X_k]$.
\end{exercise}

% source solution: baldi_p_07 exer:3.8 (the book uses completeness of L^1; monotone and dominated convergence here)
\begin{solution}
Let $G=\sum_k|X_k|$, a measurable function with values in $[0,\infty]$. By
Corollary~\ref{cor:int-series}(i), $\expc[G]=\sum_k\expc|X_k|<\infty$, so $N=\{G=\infty\}$
is null by Proposition~\ref{prop:null}(v). Off $N$ the partial sums of $X_k^+$ and of $X_k^-$
increase and are bounded by $G$, so both converge (Theorem~\ref{thm:monotone-seq}) and so
does $S_n$. Define $S=\lim_nS_n$ off $N$ and $S=0$ on $N$; it is measurable as the pointwise
limit of $S_n\indc_{N^c}$ (Proposition~\ref{prop:meas-closure}(ii)). Now $|S_n|\leqslant G$
and $|S|\leqslant G$ almost surely, with $G$ integrable, so Theorem~\ref{thm:dct} gives
$\expc|S_n-S|\to0$ and $\sum_{k\leqslant n}\expc[X_k]=\expc[S_n]\to\expc[S]$.
\end{solution}

\begin{exercise}[Knapp, problem V.20]\label{ex:kn-5-20}
\emph{(Scheff\'e.)} Let $f,f_1,f_2,\ldots\geqslant0$ be integrable with $f_n\to f$ almost
everywhere and $\int f_n\,\dd\mu\to\int f\,\dd\mu$. Show that $\int|f_n-f|\,\dd\mu\to0$.
Deduce that if probability densities $p_n$ converge almost everywhere to a probability
density $p$, then the corresponding laws satisfy
$\sup_{B}|P_n(B)-P(B)|\to0$, and in particular $P_n\to P$ weakly.
\end{exercise}

% source hint: knapp_real_b_15 hint:V.20 (the hint uses Egoroff's theorem, not in the note; dominated convergence applied to (f-f_n)^+ here; the corollary for densities added)
\begin{solution}
With $x=f_n-f$, the identity $|x|=x+2x^-$ reads $|f_n-f|=(f_n-f)+2(f-f_n)^+$. The functions
$(f-f_n)^+$ are measurable, satisfy $0\leqslant(f-f_n)^+\leqslant f$, and tend to $0$ almost
everywhere, so $\int(f-f_n)^+\,\dd\mu\to0$ by Theorem~\ref{thm:dct}. By
Theorem~\ref{thm:int-linear}(i), $\int(f_n-f)\,\dd\mu=\int f_n\,\dd\mu-\int f\,\dd\mu\to0$. Adding,
$\int|f_n-f|\,\dd\mu\to0$.

For densities, $\int p_n\,\dd\mu=1=\int p\,\dd\mu$, so the first part applies, and for every
Borel $B$, by Theorem~\ref{thm:int-linear}(i),(iii),
$|P_n(B)-P(B)|=|\int_B(p_n-p)\,\dd\mu|\leqslant\int|p_n-p|\,\dd\mu$, a bound free of $B$.
Likewise $|\int g\,\dd P_n-\int g\,\dd P|\leqslant\sup|g|\int|p_n-p|\,\dd\mu\to0$ for
$g\in C_b$, where $\int g\,\dd P_n=\int gp_n\,\dd\mu$ by Lemma~\ref{lem:density-int}, applied to
a random vector with law $P_n$ (and likewise for $P$).
\end{solution}

\begin{exercise}[Knapp, problem V.14]\label{ex:kn-5-14}
Let $(\Omega,\calF,\mu)$ be $\sigma$-finite, $\lambda$ Lebesgue measure on $\Real$, and $f$ a
non-negative measurable function with values in $[0,\infty]$. Show that the region under the
graph, $R=\{(x,y):0\leqslant y<f(x)\}$, lies in $\calF\otimes\calB(\Real)$ and that
$(\mu\otimes\lambda)(R)=\int f\,\dd\mu$. Deduce that every random variable $X\geqslant0$
satisfies
\[
\expc[X]=\int_{[0,\infty)}\prb\{X>y\}\,\dd y .
\]
\end{exercise}

% source hint: knapp_real_b_15 hint:V.14 (measurability through rational cuts instead of simple functions; the "Deduce" part added)
\begin{solution}
\textbf{Measurability.} $y<f(x)$ holds iff some rational $q$ has $y<q<f(x)$, also when
$f(x)=\infty$, so
\[
R=\bigl(\Omega\times[0,\infty)\bigr)\cap\bigcup_{q\in\mathbb{Q}}\bigl(\{f>q\}\times(-\infty,q)\bigr) ,
\]
a countable union and intersection of measurable rectangles (Lemma~\ref{lem:meas-criteria}(ii)).

\textbf{Measure.} The section $R_x=[0,f(x))$ has $\lambda(R_x)=f(x)$: by
Proposition~\ref{prop:measure}(iv),(v), $\lambda(\{0\})=\lim_k\lambda((-1/k,0])=0$,
$\lambda((0,a))=\lim_k\lambda((0,a-1/k])=a$ for $0<a<\infty$, so $\lambda([0,a))=a$ by
Proposition~\ref{prop:measure}(i), and $\lambda([0,\infty))=\lim_k\lambda([0,k))=\infty$. As $\lambda$ is $\sigma$-finite
(Remark~\ref{rem:assumed}), Theorem~\ref{thm:product-measure} gives
$(\mu\otimes\lambda)(R)=\int\lambda(R_x)\,\mu(\dd x)=\int f\,\dd\mu$.

\textbf{Expectation.} Take $\mu=\prb$ and $f=X$. The other formula
in~\eqref{eq:product-measure} uses the sections $R^y=\{\omega:X(\omega)>y\}$ for
$y\geqslant0$ and $R^y=\emptyset$ for $y<0$, so
$\expc[X]=(\prb\otimes\lambda)(R)=\int_{[0,\infty)}\prb\{X>y\}\,\dd y$.
\end{solution}

\begin{exercise}[Knapp, problem III.7]\label{ex:kn-3-7}
Let $f(x,y)=e^{-xy}-2e^{-2xy}$ on $[1,\infty)\times(0,1]$, with Lebesgue measure on each
factor. Prove or disprove:
\[
\int_{(0,1]}\Bigl[\int_{[1,\infty)}f(x,y)\,\dd x\Bigr]\dd y
=\int_{[1,\infty)}\Bigl[\int_{(0,1]}f(x,y)\,\dd y\Bigr]\dd x .
\]
Reconcile the answer with Theorem~\ref{thm:fubini}.
\end{exercise}

% source hint: knapp_real_b_15 hint:III.7
\begin{solution}
For $c>0$ and $y>0$, $\int_{[1,N]}e^{-cxy}\,\dd x=(e^{-cy}-e^{-cNy})/(cy)$: the integrand
is continuous, so by Remark~\ref{rem:assumed}(c) this is a Riemann integral, computed by calculus
(Remark~\ref{rem:elementary}). Letting $N\to\infty$ with Theorem~\ref{thm:mct},
$\int_{[1,\infty)}e^{-cxy}\,\dd x=e^{-cy}/(cy)$. Both terms of $f(\cdot,y)$ being integrable,
\[
\int_{[1,\infty)}f(x,y)\,\dd x=\frac{e^{-y}-e^{-2y}}{y}>0 \qquad(0<y\leqslant1) .
\]
This is at most $1$, since $e^{-y}-e^{-2y}=ye^{-\xi}$ for some $\xi\in(y,2y)$ by
Corollary~\ref{cor:MVT}; so the left side is the integral of a bounded positive function
over $(0,1]$, which is positive by Proposition~\ref{prop:null}(iv). In the other order, for
$x\geqslant1$, $\int_{(0,1]}e^{-cxy}\,\dd y=(1-e^{-cx})/(cx)$, so
\[
\int_{(0,1]}f(x,y)\,\dd y=\frac{(1-e^{-x})-(1-e^{-2x})}{x}=\frac{e^{-2x}-e^{-x}}{x}<0 ,
\]
bounded in modulus by $e^{-x}$, which is integrable on $[1,\infty)$; the right side is
negative. The two iterated integrals differ (numerically they are $0.523$ and $-0.170$),
so the equality is false.

Let $\pi$ be the product of the two Lebesgue measures. The function $f$ is product-measurable:
it is the restriction of the continuous $(x,y)\mapsto e^{-xy}-2e^{-2xy}$ on $\Real^2$, which
is Borel by Lemma~\ref{lem:meas-criteria}(iii), that is
$\calB(\Real)\otimes\calB(\Real)$-measurable by Lemma~\ref{lem:borel-product}. So
Theorem~\ref{thm:fubini}(ii) would force both iterated integrals to equal $\int f\,\dd\pi$
if $\int|f|\,\dd\pi<\infty$. Hence $\int|f|\,\dd\pi=\infty$: the integrability hypothesis
of Fubini's theorem cannot be dropped, while Tonelli's theorem covers only non-negative
integrands.
\end{solution}

\begin{exercise}[Baldi, exercise 2.4]\label{ex:ba-2-4}
Let $X$ and $Y$ be independent real random variables with $\expc|X+Y|<\infty$. Prove that
$\expc|X|<\infty$ and $\expc|Y|<\infty$. Show that independence cannot be dropped.
\end{exercise}

% source solution: baldi_p_07 exer:2.4 ("independence cannot be dropped" added)
\begin{solution}
By Definition~\ref{def:indep} the law of $(X,Y)$ is $\mu_X\otimes\mu_Y$. By
Theorem~\ref{thm:change-var} and Theorem~\ref{thm:fubini}(i),
\[
\infty>\expc|X+Y|=\int|x+y|\,\dd(\mu_X\otimes\mu_Y)(x,y)=\int h(y)\,\mu_Y(\dd y),
\qquad h(y)=\int|x+y|\,\mu_X(\dd x) .
\]
By Proposition~\ref{prop:null}(v), $h<\infty$ outside a $\mu_Y$-null set, which therefore
is not all of $\Real$; pick $y_0$ with $h(y_0)<\infty$. By Theorem~\ref{thm:change-var},
$\expc|X+y_0|=h(y_0)<\infty$, and $|X|\leqslant|X+y_0|+|y_0|$, so $X$ is integrable. By
symmetry so is $Y$. Without independence take any $X$ with $\expc|X|=\infty$, for instance
$\prb\{X=2^k\}=2^{-k}$ for $k\geqslant1$, so that $\expc|X|=\sum_k2^k2^{-k}=\infty$
(Corollary~\ref{cor:int-series}(i)), and $Y=-X$: then $X+Y=0$.
\end{solution}

\begin{exercise}[Baldi, exercise 3.3]\label{ex:ba-3-3}
Call events $A_1,A_2,\ldots$ independent if their indicators are independent
(Definition~\ref{def:indep}). A random variable is \emph{uniform on $[0,1]$} if its law is
$B\mapsto\lambda(B\cap[0,1])$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Let $X$ be uniform on $[0,1]$ and $A_n=\{X\leqslant1/n\}$. Show that
      $\sum_n\prb(A_n)=\infty$ but $\prb\{A_n\text{ infinitely often}\}=0$.
\item \emph{(Second Borel--Cantelli lemma.)} Show that if $A_1,A_2,\ldots$ are independent
      and $\sum_n\prb(A_n)=\infty$, then $\prb\{A_n\text{ infinitely often}\}=1$.
\item Let $X_1,X_2,\ldots$ be independent and uniform on $[0,1]$. Show that
      $\prb\{X_n\leqslant1/n\text{ i.o.}\}=1$ and $\prb\{X_n\leqslant1/n^2\text{ i.o.}\}=0$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.3 (the second Borel--Cantelli lemma, quoted in the book, is proved here)
\begin{solution}
(a) $\prb(A_n)=\lambda([0,1/n])=1/n$, and $\sum_n1/n=\infty$, each block
$2^j<n\leqslant2^{j+1}$ contributing at least $\frac12$. If $X(\omega)>0$ then
$X(\omega)>1/n$ for all $n>1/X(\omega)$, so $\{A_n\text{ i.o.}\}=\{X\leqslant0\}$, which has
probability $\lambda(\{0\})=0$. Lemma~\ref{lem:BC} has no converse without independence.

(b) The complement of $\{A_n\text{ i.o.}\}$ is $\bigcup_m\bigcap_{n\geqslant m}A_n^c$. For
$m\leqslant N$, independence (with the Borel sets $\{0\}$ for the indicators) gives
\[
\prb\Bigl(\bigcap_{n=m}^NA_n^c\Bigr)=\prod_{n=m}^N\bigl(1-\prb(A_n)\bigr)
\leqslant\exp\Bigl(-\sum_{n=m}^N\prb(A_n)\Bigr)\xrightarrow[N\to\infty]{}0 ,
\]
using $1-x\leqslant e^{-x}$, the tangent line inequality of Proposition~\ref{prop:convex-fo}
for the function $e^{-x}$ at $0$, convex by Lemma~\ref{lem:convex-deriv} as its second
derivative $e^{-x}$ is positive. By Proposition~\ref{prop:measure}(v),
$\prb(\bigcap_{n\geqslant m}A_n^c)=0$ for each $m$, and a countable union of null sets is
null.

(c) The indicators of $\{X_n\leqslant c_n\}$ are functions of the independent $X_n$, hence
independent: with $h_n=\indc_{(-\infty,c_n]}$, Borel, and any Borel $B_n$,
$\{h_n(X_n)\in B_n\}=\{X_n\in h_n^{-1}(B_n)\}$, so the product rule of
Definition~\ref{def:indep} for any finitely many of the $X_n$ gives it for their indicators. With $c_n=1/n$ the probabilities sum to $\infty$ and (b) applies; with
$c_n=1/n^2$ they sum to $\pi^2/6$ (Lemma~\ref{lem:basel}) and Lemma~\ref{lem:BC} applies.
\end{solution}

\begin{exercise}[Baldi, exercise 3.5]\label{ex:ba-3-5}
Let $Z,Z_1,Z_2,\ldots$ be independent, identically distributed and non-negative.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $\sum_{n\geqslant1}\prb\{Z\geqslant n\}\leqslant\expc[Z]\leqslant\sum_{n\geqslant0}\prb\{Z\geqslant n\}$.
\item Show that $\prb\{Z_n\geqslant n\text{ i.o.}\}$ is $0$ if $\expc[Z]<\infty$ and $1$ if
      $\expc[Z]=\infty$.
\item Let $X_1,X_2,\ldots$ be independent standard normal. Show that
      $\limsup_n|X_n|/\sqrt{\log n}=\sqrt2$ almost surely (the ratio taken for $n\geqslant2$).
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.5 (parts (a), (b), (c2); E e^{theta Z^2} computed directly)
\begin{solution}
(a) By Exercise~\ref{ex:kn-5-14}, $\expc[Z]=\int_{[0,\infty)}\prb\{Z>y\}\,\dd y$. Splitting
$[0,\infty)$ into the intervals $[n,n+1)$ (Corollary~\ref{cor:int-series}(i)) and using
$\prb\{Z\geqslant n+1\}\leqslant\prb\{Z>y\}\leqslant\prb\{Z\geqslant n\}$ for $y\in[n,n+1)$,
\[
\sum_{n\geqslant0}\prb\{Z\geqslant n+1\}\leqslant\expc[Z]\leqslant\sum_{n\geqslant0}\prb\{Z\geqslant n\} .
\]

(b) $\prb\{Z_n\geqslant n\}=\prb\{Z\geqslant n\}$. If $\expc[Z]<\infty$ these sum to at most
$\expc[Z]$ by (a), and Lemma~\ref{lem:BC} applies. If $\expc[Z]=\infty$ then by (a)
$\sum_{n\geqslant0}\prb\{Z\geqslant n\}=\infty$, hence also the sum over $n\geqslant1$; the
events $\{Z_n\geqslant n\}$ are independent (their indicators are Borel functions of the
independent $Z_n$, as in the solution of Exercise~\ref{ex:ba-3-3}(c)), and Exercise~\ref{ex:ba-3-3}(b) gives
probability $1$.

(c) For $0<\theta<\frac12$,
$\expc[e^{\theta X_1^2}]=\int(2\pi)^{-1/2}e^{-(1-2\theta)z^2/2}\,\dd z=(1-2\theta)^{-1/2}$, by
Lemma~\ref{lem:density-int} and Remark~\ref{rem:assumed}(e) with $a=(1-2\theta)^{-1/2}$; for
$\theta\geqslant\frac12$ the integrand is at least $(2\pi)^{-1/2}$ and
$\expc[e^{\theta X_1^2}]=\infty$. Apply (b) to the independent, identically distributed
$Z_n=e^{\theta X_n^2}$ (independent as in the solution of Exercise~\ref{ex:ba-3-3}(c), and
identically distributed as images of one law under one Borel map). If $\theta<\frac12$, almost surely
$e^{\theta X_n^2}<n$, that is $X_n^2/\log n<1/\theta$ ($n\geqslant2$), for all large $n$, so
$\limsup_nX_n^2/\log n\leqslant1/\theta$. If $\theta>\frac12$, almost surely
$X_n^2/\log n\geqslant1/\theta$ infinitely often, so $\limsup_nX_n^2/\log n\geqslant1/\theta$.
Letting $\theta$ run through rationals tending to $\frac12$ from either side and intersecting
the countably many events of probability one (Proposition~\ref{prop:null}(vi)),
$\limsup_nX_n^2/\log n=2$, and taking square roots gives the claim.
\end{solution}

\begin{exercise}[Baldi, exercise 4.1]\label{ex:ba-4-1}
Let $X,Y$ be independent with $\prb\{X=1\}=\prb\{Y=1\}=p=1-\prb\{X=0\}=1-\prb\{Y=0\}$,
$0<p<1$, and let $\calG=\{\emptyset,A_0,A_1,\Omega\}$ with $A_0=\{X+Y=0\}$ and
$A_1=A_0^c$, the $\sigma$-field generated by $\indc_{A_0}$. Compute $\expc[X\mid\calG]$ and
$\expc[Y\mid\calG]$ and their laws. Are they independent?
\end{exercise}

% source solution: baldi_p_07 exer:4.1
\begin{solution}
\textbf{Conditioning on a two-set partition.} Let $A_0,A_1\in\calF$ partition $\Omega$ with
positive probabilities and let $X$ be integrable. A bounded $\calG$-measurable $W$ is
constant on each $A_i$, since $\{W=w\}\in\calG$ for every $w$; write $W=w_0\indc_{A_0}+w_1\indc_{A_1}$. Put
$V=\sum_i\alpha_i\indc_{A_i}$ with $\alpha_i=\expc[X\indc_{A_i}]/\prb(A_i)$. Then $V$ is
$\calG$-measurable and
$\expc[VW]=\sum_iw_i\alpha_i\prb(A_i)=\sum_iw_i\expc[X\indc_{A_i}]=\expc[XW]$, so
$V=\expc[X\mid\calG]$ by Lemma~\ref{lem:condexp-L1}.

\textbf{Here.} $\prb(A_0)=(1-p)^2$ by independence and $\prb(A_1)=1-(1-p)^2=p(2-p)$. On
$A_0$, $X=0$, so $\alpha_0=0$; and $\{X=1\}\subseteq A_1$, so $\expc[X\indc_{A_1}]=p$ and
$\alpha_1=1/(2-p)$. Hence
\[
\expc[X\mid\calG]=\frac{1}{2-p}\,\indc_{A_1} ,
\]
which takes the value $1/(2-p)$ with probability $p(2-p)$ and $0$ with probability
$(1-p)^2$; its mean is $p=\expc[X]$, as Proposition~\ref{prop:tower} requires. The formula
is symmetric in $X$ and $Y$, so $\expc[Y\mid\calG]$ is the same variable $U$. It is not
independent of itself: $\prb\{U=0,U=0\}=(1-p)^2\neq(1-p)^4=\prb\{U=0\}^2$.
\end{solution}

\begin{exercise}[Baldi, exercise 4.5]\label{ex:ba-4-5}
For a random vector $Z$ in $\Real^k$ let $\sigma(Z)=\{Z^{-1}(B):B\in\calB(\Real^k)\}$ and
$\expc[\cdot\mid Z]=\expc[\cdot\mid\sigma(Z)]$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that to identify $\expc[X\mid\calG]$ it suffices to check the identity of
      Lemma~\ref{lem:condexp-L1} for $W=\indc_G$, $G\in\calG$.
\item Let $X,Y$ be real and suppose $(X,Z)$ and $(Y,Z)$ have the same law. Show that
      $\expc[h(X)\mid Z]=\expc[h(Y)\mid Z]$ almost surely for every Borel $h$ with $h(X)$
      integrable.
\item Let $T_1,\ldots,T_n$ be independent, identically distributed and integrable, and
      $T=T_1+\cdots+T_n$. Show that $\expc[T_1\mid T]=T/n$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:4.5 (part (a) added: the note has no Doob--Dynkin lemma, so conditional expectations given Z are identified through indicators)
\begin{solution}
(a) $\sigma(Z)$ is a $\sigma$-field, by the argument in the proof of
Lemma~\ref{lem:meas-criteria}(i). Suppose $V$ is $\calG$-measurable and integrable and
$\expc[X\indc_G]=\expc[V\indc_G]$ for all $G\in\calG$. By linearity the identity extends to
simple $\calG$-measurable $W$. For bounded $\calG$-measurable $W\geqslant0$,
Theorem~\ref{thm:simple-approx} gives simple $\calG$-measurable $s_m\uparrow W$, with
$|Xs_m|\leqslant|X|\sup W$ and $|Vs_m|\leqslant|V|\sup W$, so Theorem~\ref{thm:dct} passes the
identity to $W$; a general bounded $W$ is $W^+-W^-$.

(b) Let $V=\expc[h(X)\mid Z]$. For $G=Z^{-1}(B)\in\sigma(Z)$, Theorem~\ref{thm:change-var}
applied to the function $(x,z)\mapsto h(x)\indc_B(z)$ and the equal laws of $(X,Z)$ and
$(Y,Z)$ give $\expc[h(Y)\indc_G]=\expc[h(X)\indc_G]=\expc[V\indc_G]$; also $h(Y)$ is
integrable, by the same theorem applied to $|h(x)|$. By (a), $V=\expc[h(Y)\mid Z]$.

(c) Fix $j$. By Lemma~\ref{lem:disjoint-fn}, $T_j$ is independent of
$T_{(j)}=\sum_{i\neq j}T_i$, so the law of $(T_j,T_{(j)})$ is the product of their laws.
Both factors are the same for every $j$: the $T_i$ share one law, and the law of
$(T_i)_{i\neq j}$, a product of identical factors (Corollary~\ref{cor:finite-product}),
does not depend on $j$. So $(T_j,T)$, the image of $(T_j,T_{(j)})$ under
$(s,t)\mapsto(s,s+t)$, has the same law for every $j$, and by (b)
$\expc[T_j\mid T]=\expc[T_1\mid T]$. The conditional expectation is linear (by the
uniqueness in Lemma~\ref{lem:condexp-L1}) and $\expc[T\mid T]=T$, $T$ being
$\sigma(T)$-measurable. Hence $n\,\expc[T_1\mid T]=\sum_j\expc[T_j\mid T]=T$. For
Bernoulli trials this says that, given the number of successes, each trial succeeds with
probability $T/n$.
\end{solution}

\begin{exercise}[Baldi, exercise 4.23]\label{ex:ba-4-23}
Let $(X,Y)'\sim N\bigl(\bzero,\bigl(\begin{smallmatrix}1&r\\r&1\end{smallmatrix}\bigr)\bigr)$
with $|r|<1$. Show that $X$ and $Y$ are $N(0,1)$, that $\expc[X\mid Y]=rY$ and
$\expc[X\mid X+Y]=(X+Y)/2$, and that $\expc[(X-\expc[X\mid Y])^2]=1-r^2$.
\end{exercise}

% source solution: baldi_p_07 exer:4.23 (density and regression formula in the book; the note's definition of the normal law and independence of X-rY and Y here; the residual variance added)
\begin{solution}
By Theorem~\ref{thm:mvn-linear} with $\bB=(1,0)$ or $(0,1)$, $X$ and $Y$ are $N(0,1)$. The
pair $(X-rY,Y)$ is a linear image of $(X,Y)$, hence jointly normal by
Theorem~\ref{thm:mvn-linear}, with $\cov(X-rY,Y)=r-r=0$; by
Theorem~\ref{thm:mvn-uncorr-indep}, $X-rY$ and $Y$ are independent. For
$G=Y^{-1}(B)\in\sigma(Y)$, Lemma~\ref{lem:disjoint-fn} gives
$\expc[(X-rY)\indc_B(Y)]=\expc[X-rY]\,\prb\{Y\in B\}=0$, that is,
$\expc[X\indc_G]=\expc[rY\indc_G]$. Since $rY$ is $\sigma(Y)$-measurable and integrable,
Exercise~\ref{ex:ba-4-5}(a) gives $\expc[X\mid Y]=rY$.

In the same way $X-\frac12(X+Y)=\frac12(X-Y)$ and $X+Y$ are jointly normal with covariance
$\frac12(\var X-\var Y)=0$, so $\expc[X\mid X+Y]=(X+Y)/2$, whatever $r$. Finally
$\expc[(X-rY)^2]=1-2r^2+r^2=1-r^2$: the regression of $X$ on $Y$ removes the fraction $r^2$
of the variance.
\end{solution}

\begin{exercise}[Baldi, exercise 2.56]\label{ex:ba-2-56}
Let $X\sim N(0,1)$ and $Y$ with $\prb\{Y=1\}=\prb\{Y=-1\}=\frac12$ be independent, and $Z=XY$.
Show that $Z\sim N(0,1)$ and $\cov(X,Z)=0$, yet $X$ and $Z$ are not independent; compute the
characteristic function of $X+Z$ and deduce that $(X,Z)$ is not jointly normal. Which
hypothesis of Theorem~\ref{thm:mvn-uncorr-indep} fails?
\end{exercise}

% source solution: baldi_p_07 exer:2.56 (the book prints e^{2theta^2} for e^{-2theta^2}, and the characteristic function of X+Z as e^{i theta(X+Y)})
\begin{solution}
For Borel $B$, by independence,
$\prb\{Z\in B\}=\frac12\prb\{X\in B\}+\frac12\prb\{-X\in B\}=\prb\{X\in B\}$, because $-X$
has the density $\phi(-x)=\phi(x)$ (Remark~\ref{rem:assumed}(e); $X$ has the law of a standard normal, hence the density
$\phi$, by Proposition~\ref{prop:cf-gauss} and Corollary~\ref{cor:uniqueness}); so
$Z\sim N(0,1)$. By
Lemma~\ref{lem:disjoint-fn}, $\cov(X,Z)=\expc[X^2Y]=\expc[X^2]\expc[Y]=0$. They are not
independent: $|Z|=|X|$, so $\prb\{|X|\leqslant1,|Z|>1\}=0$, while
$\prb\{|X|\leqslant1\}\prb\{|Z|>1\}>0$.

Splitting on the value of $Y$ ($X+Z=0$ on $\{Y=-1\}$, and
$\expc[e^{2i\theta X}\indc\{Y=1\}]=\frac12\expc[e^{2i\theta X}]$ by
Lemma~\ref{lem:disjoint-fn} applied to the real and imaginary parts) and using
Proposition~\ref{prop:cf-gauss},
\[
\expc\bigl[e^{i\theta(X+Z)}\bigr]=\tfrac12\expc\bigl[e^{2i\theta X}\bigr]+\tfrac12
=\tfrac12e^{-2\theta^2}+\tfrac12 .
\]
If $(X,Z)$ were jointly normal, $X+Z$ would be $N(m,s^2)$ for some $m,s$
(Theorem~\ref{thm:mvn-linear}), with characteristic function of modulus $e^{-s^2\theta^2/2}$.
The modulus above stays above $\frac12$ as $\theta\to\infty$, forcing $s=0$, but then the
modulus would be identically $1$, while at $\theta=1$ it is $\frac12(1+e^{-2})<1$. So the
joint normality required by Theorem~\ref{thm:mvn-uncorr-indep} fails, although each
marginal is normal.
\end{solution}

\begin{exercise}[Baldi, exercise 2.53]\label{ex:ba-2-53}
Let $X\sim N(\bzero,\bC)$ in $\Real^m$, where $\bC$ has eigenvalues
$\lambda_1,\ldots,\lambda_m\geqslant0$. Show that $|X|^2$ has the law of
$\sum_k\lambda_kZ_k^2$ with $Z_1,\ldots,Z_m$ independent standard normal, that
$\expc|X|^2=\tr\bC$ and that $\var|X|^2=2\tr(\bC^2)$. What does this say when $\bC=\bI_m$?
\end{exercise}

% source solution: baldi_p_07 exer:2.53 (variance added; the book uses rotation invariance, the spectral decomposition here)
\begin{solution}
Write $\bC=\bP\bLam\bP'$ (Theorem~\ref{thm:spectral}) and let $Z=(Z_1,\ldots,Z_m)'$ have
independent standard normal coordinates. Then $\tilde X=\bP\bLam^{1/2}Z$ is $N(\bzero,\bC)$
by Definition~\ref{def:mvn}, as $(\bP\bLam^{1/2})(\bP\bLam^{1/2})'=\bC$. By
Proposition~\ref{prop:cf-gauss}, $X$ and $\tilde X$ have the same characteristic function,
hence the same law (Corollary~\ref{cor:uniqueness}), so $|X|^2$ and $|\tilde X|^2$ have the
same law. Since $\bP'\bP=\bI$,
\[
|\tilde X|^2=Z'\bLam^{1/2}\bP'\bP\bLam^{1/2}Z=\sum_{k=1}^m\lambda_kZ_k^2 .
\]
So $\expc|X|^2=\sum_k\lambda_k=\tr\bLam=\tr\bC$ (Proposition~\ref{prop:trace}\ref{tr:iii}); the
same follows from Lemma~\ref{lem:quadratic-form} with $\bA=\bI$. The $Z_k^2$ are independent
with variance $2$ (Lemma~\ref{lem:fourth}), so their covariances vanish
(Lemma~\ref{lem:disjoint-fn}) and $\var|X|^2=2\sum_k\lambda_k^2=2\tr(\bLam^2)=2\tr(\bC^2)$, as
$\bC^2=\bP\bLam^2\bP'$. For $\bC=\bI_m$ the law is $\chi^2_m$ with mean $m$ and variance
$2m$ (Proposition~\ref{prop:chisq-moments}); for a symmetric idempotent $\bC$ of rank $r$ it
is $\chi^2_r$, as in Theorem~\ref{thm:quadratic-chisq}, since its eigenvalues lie in $\{0,1\}$
and sum to $\tr\bC=\rank\bC=r$ (Lemma~\ref{lem:idempotent} and
Proposition~\ref{prop:trace}\ref{tr:iii}), so that $r$ of them equal $1$ and the rest $0$.
\end{solution}

\begin{exercise}[Baldi, exercise 3.9]\label{ex:ba-3-9}
\emph{(Dominated convergence in probability.)} Let $X_n\convp X$ and $|X_n|\leqslant Y$ with
$\expc[Y]<\infty$. Show that $\expc|X_n-X|\to0$, so $\expc[X_n]\to\expc[X]$.
\end{exercise}

% source solution: baldi_p_07 exer:3.9 (E|X_n-X| -> 0 added)
\begin{solution}
By Lemma~\ref{lem:as-subseq} a subsequence converges to $X$ almost surely, so
$|X|\leqslant Y$ almost surely and $|X_n-X|\leqslant2Y$. Suppose $\expc|X_n-X|\not\to0$; then
$\expc|X_{n_j}-X|\geqslant\delta$ along a subsequence, for some $\delta>0$. That subsequence
still converges in probability, so a further subsequence converges almost surely, and along
it Theorem~\ref{thm:dct}, with dominating function $2Y$, gives $\expc|X_{n_{j_l}}-X|\to0$, a
contradiction. Finally $|\expc X_n-\expc X|\leqslant\expc|X_n-X|$
(Theorem~\ref{thm:int-linear}(iii)).
\end{solution}

\begin{exercise}\label{ex:modes}
Give a sequence converging in distribution but not in probability, and one converging in
probability but not almost surely.
\end{exercise}

\begin{solution}
For the first, let $X\sim N(0,1)$ and $X_n=(-1)^nX$. Each $X_n$ has the $N(0,1)$ law, so
$X_n\convd X$; but $|X_n-X|=2|X|$ for odd $n$, which does not tend to $0$ in probability.
This also shows convergence in distribution says nothing about the joint behaviour of
$X_n$ and $X$, only about laws.

For the second, take the sliding indicators on $[0,1]$ with Lebesgue measure: for
$n = 2^k+r$ with $0\leqslant r<2^k$, let $X_n = \indc_{[r2^{-k},(r+1)2^{-k}]}$. Then
$\prb\{X_n\neq0\}=2^{-k}\to0$, so $X_n\convp0$; but every $\omega$ lies in infinitely many
of the intervals (at least one of each level $k$), and, for $k\geqslant2$, in at most two of the
$2^k$ intervals of level $k$, so $X_n(\omega)=1$ and $X_n(\omega)=0$ each for infinitely many
$n$, and $X_n(\omega)$ does not converge for any $\omega$.
\end{solution}

\begin{exercise}[Baldi, exercise 2.31]\label{ex:ba-2-31}
Let $\varphi$ be the characteristic function of a real random variable $X$. Show that
$\overline\varphi$, $\varphi^2$ and $|\varphi|^2$ are characteristic functions, and that
$|\varphi|^2$ is real and even.
\end{exercise}

% source solution: baldi_p_07 exer:2.31 ("real and even" added)
\begin{solution}
Taking complex conjugates commutes with the integral, which is defined through real and
imaginary parts (Definition~\ref{def:integrable}), so
$\overline{\varphi(t)}=\expc[e^{-itX}]=\varphi_{-X}(t)$. Let $\mu$ be the law of $X$; on
$(\Real^2,\calB(\Real^2),\mu\otimes\mu)$ (Corollary~\ref{cor:finite-product}) the coordinate
maps $X_1,X_2$ are independent copies of $X$. By
Proposition~\ref{prop:cf-props}\ref{cf:iii}, $\varphi_{X_1+X_2}=\varphi^2$, and since $X_1$ and
$-X_2$ are independent, $\varphi_{X_1-X_2}=\varphi\,\overline\varphi=|\varphi|^2$. This is
real, and even because $\varphi(-t)=\overline{\varphi(t)}$; the symmetrised variable $X_1-X_2$
thus has a real characteristic function.
\end{solution}

\begin{exercise}[Baldi, exercise 2.38]\label{ex:ba-2-38}
Show that $\theta\mapsto e^{-\theta^4}$ is not the characteristic function of any real
random variable.
\end{exercise}

% source solution: baldi_p_07 exer:2.38 (the book uses moments from derivatives of the characteristic function, not in the note; Fatou's lemma here; the book's questions on mean, variance and comments omitted)
\begin{solution}
Suppose $\expc[e^{i\theta X}]=e^{-\theta^4}$. Taking real parts,
$\expc[1-\cos(\theta X)]=1-e^{-\theta^4}$. By Theorem~\ref{thm:taylor} with $m=1$ applied
to $\cos$, $1-\cos u=\frac{u^2}2\cos\xi$ for some $\xi$ between $0$ and $u$, so
$k^2\{1-\cos(x/k)\}\to x^2/2$ for every $x$, through non-negative values. By
Theorem~\ref{thm:fatou} and $1-e^{-s}\leqslant s$ (the tangent line inequality of
Proposition~\ref{prop:convex-fo} for $e^{-s}$ at $0$, as in the solution of
Exercise~\ref{ex:ba-3-3}(b)),
\[
\expc\Bigl[\frac{X^2}{2}\Bigr]\leqslant\liminf_kk^2\,\expc\bigl[1-\cos(X/k)\bigr]
=\liminf_kk^2\bigl(1-e^{-k^{-4}}\bigr)\leqslant\liminf_kk^{-2}=0 .
\]
So $X=0$ almost surely (Proposition~\ref{prop:null}(iv)) and its characteristic function is
identically $1$, whereas $e^{-1}\neq1$. The argument shows more: if
$1-\mathrm{Re}\,\varphi(\theta)=o(\theta^2)$ as $\theta\to0$, then $X=0$ almost surely.
\end{solution}

\begin{exercise}[Baldi, exercise 3.14]\label{ex:ba-3-14}
Let $\mu_n\to\mu$ weakly on $\Real^d$ and $\nu_n\to\nu$ weakly on $\Real^m$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $\mu_n\otimes\nu_n\to\mu\otimes\nu$ weakly on $\Real^{d+m}$.
\item For $d=m$, let $X_n\sim\mu_n$ be independent of $Y_n\sim\nu_n$ and $X\sim\mu$ of
      $Y\sim\nu$. Show that $X_n+Y_n\convd X+Y$.
\item Let $Y_n\sim N(\bzero,n^{-1}\bI_d)$ be independent of $X$. Show that $X+Y_n\convd X$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.14
\begin{solution}
(a) For $\theta_1\in\Real^d$ and $\theta_2\in\Real^m$ the integrand
$e^{i\langle\theta_1,x\rangle}e^{i\langle\theta_2,y\rangle}$ is bounded, hence integrable
against the probability $\mu_n\otimes\nu_n$, and Theorem~\ref{thm:fubini}(ii) factorises the
characteristic function at $(\theta_1,\theta_2)$ as
$\varphi_{\mu_n}(\theta_1)\varphi_{\nu_n}(\theta_2)$. By Theorem~\ref{thm:levy} (necessity)
this tends to $\varphi_\mu(\theta_1)\varphi_\nu(\theta_2)$, the characteristic function of
$\mu\otimes\nu$, and Theorem~\ref{thm:levy} (sufficiency) gives the claim.

(b) By Definition~\ref{def:indep} the laws of $(X_n,Y_n)$ and $(X,Y)$ are $\mu_n\otimes\nu_n$
and $\mu\otimes\nu$, so $(X_n,Y_n)\convd(X,Y)$ by (a), and Theorem~\ref{thm:cmt} with
$(x,y)\mapsto x+y$ gives $X_n+Y_n\convd X+Y$.

(c) The characteristic function of $Y_n$ is $e^{-|\theta|^2/(2n)}\to1$
(Proposition~\ref{prop:cf-gauss}), that of the point
mass at $\bzero$, so $Y_n\convd\bzero$ by Theorem~\ref{thm:levy}, and (b) with $X_n=X$
applies. Alternatively, $Y_n\convp\bzero$ by Proposition~\ref{prop:const}, and
Theorem~\ref{thm:slutsky}\ref{sl:iii} gives this without independence. Adding a
small independent Gaussian perturbation is the smoothing behind Lemma~\ref{lem:mollify}.
\end{solution}

\begin{exercise}[Baldi, exercise 3.21]\label{ex:ba-3-21}
Let $X_1,X_2,\ldots$ be independent and uniform on $[0,1]$ (Exercise~\ref{ex:ba-3-3}) and
$Z_n=\min(X_1,\ldots,X_n)$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $Z_n\to0$ almost surely.
\item Show that $nZ_n\convd E$, where $E$ has density $e^{-t}$ on $[0,\infty)$.
\item Deduce that $\prb\{Z_n\leqslant2/n\}\to1-e^{-2}$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.21 (the book uses convergence of distribution functions, whose sufficiency the note does not prove; density and dominated convergence here)
\begin{solution}
By independence, $\prb\{Z_n>z\}=\prod_{i\leqslant n}\prb\{X_i>z\}=(1-z)^n$ for $z\in[0,1]$.

(a) $Z_n$ decreases in $n$ and is non-negative, so it converges pointwise to some
$Z_\infty\geqslant0$. For $\varepsilon\in(0,1)$,
$\prb\{Z_\infty>\varepsilon\}\leqslant\prb\{Z_n>\varepsilon\}=(1-\varepsilon)^n\to0$, so
$Z_\infty=0$ almost surely.

(b) Let $g_n(t)=(1-t/n)^{n-1}$ for $0\leqslant t\leqslant n$ and $g_n(t)=0$ otherwise. For
$0\leqslant a\leqslant n$, $\prb\{nZ_n\leqslant a\}=1-(1-a/n)^n=\int_{[0,a]}g_n(t)\,\dd t$ by
calculus, and both sides equal $0$ for $a<0$ and $1$ for $a>n$. The half-lines
$(-\infty,a]$ form a $\pi$-system generating $\calB(\Real)$
(Lemma~\ref{lem:borel-gen}(iii)), so by Corollary~\ref{cor:measure-unique} $nZ_n$ has density
$g_n$. For $t\geqslant0$, $g_n(t)\to e^{-t}$, as $(n-1)\log(1-t/n)\to-t$; and
$1-x\leqslant e^{-x}$ (as in the solution of Exercise~\ref{ex:ba-3-3}(b)) gives
$g_n(t)\leqslant e^{-t(n-1)/n}\leqslant e^{-t/2}$ for $n\geqslant2$.
For $f\in C_b(\Real)$, Theorem~\ref{thm:change-var} and Theorem~\ref{thm:dct}, with
dominating function $\sup|f|\,e^{-t/2}$ on $[0,\infty)$, give
\[
\expc[f(nZ_n)]=\int_{[0,\infty)}f(t)g_n(t)\,\dd t\longrightarrow\int_{[0,\infty)}f(t)e^{-t}\,\dd t=\expc[f(E)] .
\]
(The integral against the density is Lemma~\ref{lem:density-int}.)

(c) The indicator of $(-\infty,2]$ is bounded and discontinuous only at $2$, and
$\prb\{E=2\}=0$, so Theorem~\ref{thm:portmanteau}\ref{pm:c} gives
$\prb\{nZ_n\leqslant2\}\to\int_0^2e^{-t}\,\dd t=1-e^{-2}\approx0.865$.
\end{solution}

\begin{exercise}[Baldi, exercise 3.23]\label{ex:ba-3-23}
\begin{enumerate}[label=\textup{(\alph*)}]
\item Let $\mu_n=(1-a_n)\delta_0+a_n\delta_n$ with $a_n\in[0,1]$, $a_n\to0$, where $\delta_x$
      is the point mass at $x$. Show that $\mu_n\to\delta_0$ weakly.
\item Choose $a_n$ so that the means of $\mu_n$ tend to $\infty$; and so that the means tend
      to $0$ but the variances tend to $\infty$.
\item Show that $X_n\convd X$ implies $\liminf_n\expc|X_n|\geqslant\expc|X|$ and
      $\liminf_n\expc[X_n^2]\geqslant\expc[X^2]$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.23
\begin{solution}
(a) For $f\in C_b(\Real)$, $\int f\,\dd\mu_n=(1-a_n)f(0)+a_nf(n)\to f(0)$, as
$|a_nf(n)|\leqslant a_n\sup|f|$.

(b) $\mu_n$ has mean $na_n$, second moment $n^2a_n$ and variance $n^2a_n(1-a_n)$. With
$a_n=n^{-1/2}$ the mean is $n^{1/2}\to\infty$. With $a_n=n^{-3/2}$ the mean is
$n^{-1/2}\to0$ while the variance is $n^{1/2}(1-n^{-3/2})\to\infty$. The limit $\delta_0$
has mean and variance $0$.

(c) $x\mapsto|x|$ and $x\mapsto x^2$ are continuous, hence lower semi-continuous, and
bounded below by $0$; Theorem~\ref{thm:portmanteau}\ref{pm:b} applied to the laws gives both
inequalities, with Theorem~\ref{thm:change-var}. Part (b) shows that they can be strict: an
asymptotic variance, the variance of the limit law, need not be the limit of the variances.
\end{solution}

\begin{exercise}\label{ex:cmt-need}
Show by example that $X_n\convd X$ and $Y_n\convd Y$ do not imply $X_n+Y_n\convd X+Y$, and
identify which hypothesis of Theorem~\ref{thm:slutsky} rules the example out.
\end{exercise}

\begin{solution}
Let $X\sim N(0,1)$, $X_n=X$ and $Y_n=(-1)^nX$. Then $X_n\convd N(0,1)$ and
$Y_n\convd N(0,1)$, yet $X_n+Y_n$ equals $2X$ for even $n$ and $0$ for odd $n$, so its law
alternates between $N(0,4)$ and $\delta_0$ and does not converge: for
$f(x)=\min(|x|,1)\in C_b(\Real)$, $\expc f(X_n+Y_n)$ alternates between $\expc\min(2|X|,1)>0$
(Proposition~\ref{prop:null}(iv); $\prb\{X=0\}=0$ because $X$ has the law of a standard
normal, hence the density $\phi$, by Proposition~\ref{prop:cf-gauss} and
Corollary~\ref{cor:uniqueness}) and $0$.

Slutsky requires the second sequence to converge to a \emph{constant}. That is exactly what
fails: convergence in distribution constrains only marginal laws, and the sum depends on
the joint law, which is unconstrained. Convergence to a constant pins the joint law down,
which is the content of part~\ref{sl:i} of the theorem.
\end{solution}

\begin{exercise}[Baldi, exercise 3.27]\label{ex:ba-3-27}
Let $X_1,\ldots,X_{12}$ be independent and uniform on $[0,1]$ and
$W=X_1+\cdots+X_{12}-6$, once used to generate approximately standard normal numbers.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $\expc[W]=0$ and $\var(W)=1$, and explain the approximation with
      Corollary~\ref{cor:iid-clt}.
\item Show that $\expc[W^4]=2.9$, to be compared with $\expc[Z^4]=3$ for $Z\sim N(0,1)$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.27
\begin{solution}
(a) $\expc[X_i]=\int_0^1x\,\dd x=\frac12$ and $\expc[X_i^2]=\frac13$ (Lemma~\ref{lem:density-int},
with density $\indc_{[0,1]}$ against Lebesgue measure), so
$\var(X_i)=\frac1{12}$. Then $\expc[W]=0$ and, the covariances vanishing by
Lemma~\ref{lem:disjoint-fn}, $\var(W)=12\cdot\frac1{12}=1$. Thus
$W=n^{-1/2}\sum_{i\leqslant n}(X_i-\frac12)/\sigma$ with $n=12$ and $\sigma^2=\frac1{12}$,
exactly the standardised sum of Corollary~\ref{cor:iid-clt}, whose law approaches $N(0,1)$ as
$n\to\infty$.

(b) $\expc[Z^4]=3$ is Lemma~\ref{lem:fourth}, as $Z$ has the law of a standard normal
by Proposition~\ref{prop:cf-gauss} and Corollary~\ref{cor:uniqueness}. Let $U_i=X_i-\frac12$, independent and uniform on
$[-\frac12,\frac12]$, with $\expc[U_i]=\expc[U_i^3]=0$, $\expc[U_i^2]=\frac1{12}$ and
$\expc[U_i^4]=\int_{-1/2}^{1/2}u^4\,\dd u=\frac1{80}$ (Lemma~\ref{lem:density-int} again). Expand
$W^4=\sum_{i,j,k,l}U_iU_jU_kU_l$. By Lemma~\ref{lem:disjoint-fn} the expectation of a term
factorises over its distinct indices, so it vanishes when some index occurs exactly once or
exactly three times. The surviving terms have all four indices equal (twelve terms, each
$\frac1{80}$) or two distinct indices each occurring twice: for each of the $66$ pairs
$\{i,j\}$ there are $\binom42=6$ placements, each with expectation $\frac1{144}$. Hence
\[
\expc[W^4]=\frac{12}{80}+\frac{6\cdot66}{144}=0.15+2.75=2.9 .
\]
The kurtosis $2.9<3$ and the bound $|W|\leqslant6$ show the tails of $W$ are lighter than
normal, which matters when many extreme draws are needed.
\end{solution}

\begin{exercise}\label{ex:lindeberg-check}
Verify the Lindeberg condition for $\xi_{ni}=a_{ni}\varepsilon_i$, $i=1,\ldots,k_n$, with $\varepsilon_i$
i.i.d.\ mean zero, variance $1$, where $\sum_i a_{ni}^2=1$ and $\max_i|a_{ni}|\to0$.
\end{exercise}

\begin{solution}
$\expc[\xi_{ni}]=0$ and $\sum_i\var(\xi_{ni})=\sum_i a_{ni}^2=1$. Writing
$\delta_n=\max_i|a_{ni}|$, the event $\{|\xi_{ni}|>\varepsilon\}$ is contained in
$\{|\varepsilon_i|>\varepsilon/\delta_n\}$, so
\[
\sum_i\expc\bigl[\xi_{ni}^2;|\xi_{ni}|>\varepsilon\bigr]
\leqslant \sum_i a_{ni}^2\,\expc\bigl[\varepsilon_1^2;|\varepsilon_1|>\varepsilon/\delta_n\bigr]
= \expc\bigl[\varepsilon_1^2;|\varepsilon_1|>\varepsilon/\delta_n\bigr] ,
\]
using that the $\varepsilon_i$ are identically distributed. Since
$\varepsilon/\delta_n\to\infty$ and $\expc[\varepsilon_1^2]=1<\infty$, dominated convergence
(Theorem~\ref{thm:dct}) sends this to $0$. The condition $\max_i|a_{ni}|\to0$ is essential: with
$a_{n1}=1$ and the rest zero the sum is $\expc[\varepsilon_1^2;|\varepsilon_1|>\varepsilon]$,
which for $\varepsilon<1$ is $1-\expc[\varepsilon_1^2;|\varepsilon_1|\leqslant\varepsilon]\geqslant1-\varepsilon^2>0$
and so does not tend to $0$.
\end{solution}

\begin{exercise}[Baldi, exercise 3.11]\label{ex:ba-3-11}
Let $\{\varepsilon_t\}_{t\in\mathbb{Z}}$ be independent and identically distributed with mean
$0$ and variance $\sigma^2>0$, and $Y_t=\varepsilon_t\varepsilon_{t+1}$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $\expc[Y_t]=0$, $\var(Y_t)=\sigma^4$ and $\cov(Y_s,Y_t)=0$ for $s\neq t$.
\item Show that $n^{-1}\sum_{t\leqslant n}Y_t\convp0$.
\item Show that $n^{-1/2}\sum_{t\leqslant n}Y_t\convd N(0,\sigma^4)$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.11 (the book uses a strong law, not in the note; convergence in probability and the m-dependent CLT here)
\begin{solution}
(a) By Lemma~\ref{lem:disjoint-fn}, $\expc[Y_t]=\expc[\varepsilon_t]\expc[\varepsilon_{t+1}]=0$
and $\expc[Y_t^2]=\expc[\varepsilon_t^2]\expc[\varepsilon_{t+1}^2]=\sigma^4$. Let $s<t$. If
$t=s+1$, $Y_sY_t=\varepsilon_s\cdot\varepsilon_{s+1}^2\varepsilon_{s+2}$, a product of two
independent integrable factors (the second by the same lemma), so
$\expc[Y_sY_t]=\expc[\varepsilon_s]\expc[\varepsilon_{s+1}^2\varepsilon_{s+2}]=0$. If
$t>s+1$, $Y_s$ and $Y_t$ are functions of disjoint sets of indices and
$\expc[Y_sY_t]=\expc[Y_s]\expc[Y_t]=0$.

(b) By (a), $\{Y_t\}$ is weakly stationary (Definition~\ref{def:wstat}) with $\gamma(0)=\sigma^4$
and $\gamma(k)=0$ for $k\neq0$, so Lemma~\ref{lem:stat-mean} applies.

(c) $Y_t=g(\eta_{t-1},\eta_t)$ with $\eta_t=\varepsilon_{t+1}$ and $g(u,v)=uv$, so by
Lemma~\ref{lem:mdep-fn} $\{Y_t\}$ is strictly stationary and $1$-dependent, with mean $0$ and
finite variance. Theorem~\ref{thm:mdep-clt} gives the limit $N(0,\gamma(0)+2\gamma(1))=N(0,\sigma^4)$.
The $Y_t$ are uncorrelated but not independent ($Y_t$ and $Y_{t+1}$ share $\varepsilon_{t+1}$),
so Corollary~\ref{cor:iid-clt} does not apply directly.
\end{solution}

\begin{exercise}\label{ex:delta-log}
Let $\sqrt n(\hat\theta-\theta)\convd N(0,\sigma^2)$ with $\theta>0$. Find the limit law of
$\sqrt n(\log\hat\theta-\log\theta)$ and of $\sqrt n(\hat\theta^2-\theta^2)$.
\end{exercise}

\begin{solution}
By Theorem~\ref{thm:delta} with $g(x)=\log x$ for $x>0$ and $g(x)=0$ otherwise, which is
measurable and differentiable at $\theta>0$, $g'(\theta)=1/\theta$, so
$\sqrt n(\log\hat\theta-\log\theta)\convd N(0,\sigma^2/\theta^2)$, reading $\log\hat\theta$ as
$g(\hat\theta)$; the two differ only on $\{\hat\theta\leqslant0\}$, whose probability tends to $0$
since $\hat\theta-\theta=n^{-1/2}\sqrt n(\hat\theta-\theta)\convd0$ by
Theorem~\ref{thm:slutsky}\ref{sl:iii}, hence $\hat\theta\convp\theta>0$ by
Proposition~\ref{prop:const}. The asymptotic variance of a log-transformed estimator is
$(\sigma/\theta)^2$, the squared coefficient of variation.

With $g(x)=x^2$, $g'(\theta)=2\theta$, giving $N(0,4\theta^2\sigma^2)$. Note the method
fails where $g'(\theta)=0$: at $\theta=0$ the limit $N(0,4\theta^2\sigma^2)$ would be degenerate,
and the correct normalisation is then $n$ rather than $\sqrt n$: $n\hat\theta^2=(\sqrt n\,\hat\theta)^2\convd\sigma^2\chi^2_1$ by the
continuous mapping theorem.
\end{solution}

\begin{exercise}[Baldi, exercise 3.31]\label{ex:ba-3-31}
Let $X_n\sim\chi^2_n$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $(X_n-n)/\sqrt{2n}\convd N(0,1)$.
\item \emph{(Fisher's approximation.)} Show that $\sqrt{2X_n}-\sqrt{2n-1}\convd N(0,1)$.
\item Use (a) and (b) to approximate the $0.95$ quantile of $\chi^2_{100}$, which is
      $124.34$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:3.31 (part (b) by the delta method instead of the strong law)
\begin{solution}
(a) Convergence in distribution depends only on the laws, and by
Definition~\ref{def:chisq-t-F} $X_n$ has the law of $S_n=\sum_{i\leqslant n}V_i$, where
$V_i=Z_i^2$ for independent standard normal $Z_1,Z_2,\ldots$. The $V_i$ are independent,
identically distributed, with mean $1$ and variance $2$ (Proposition~\ref{prop:chisq-moments}),
so Corollary~\ref{cor:iid-clt} gives $(S_n-n)/\sqrt{2n}\convd N(0,1)$.

(b) With $T_n=S_n/n$, (a) and Theorem~\ref{thm:cmt} give $\sqrt n(T_n-1)\convd N(0,2)$. Let
$g(t)=\sqrt{2t}$ for $t\geqslant0$ and $g(t)=0$ for $t<0$, measurable and differentiable at
$1$ with $g'(1)=1/\sqrt2$. Theorem~\ref{thm:delta} gives
$\sqrt n\{g(T_n)-g(1)\}=\sqrt{2S_n}-\sqrt{2n}\convd N(0,2\cdot\frac12)=N(0,1)$. Since
$\sqrt{2n}-\sqrt{2n-1}=1/(\sqrt{2n}+\sqrt{2n-1})\to0$, Theorem~\ref{thm:slutsky} gives the
claim, and it transfers to $X_n$ because the law of $\sqrt{2X_n}-\sqrt{2n-1}$ is that of
$\sqrt{2S_n}-\sqrt{2n-1}$.

(c) Let $z=1.6449$ be the $0.95$ quantile of $N(0,1)$. Reading (a) as
$\prb\{X_n\leqslant x\}\approx\Phi((x-n)/\sqrt{2n})$ gives $x\approx n+z\sqrt{2n}=123.26$ for
$n=100$. Reading (b) as $\prb\{X_n\leqslant x\}\approx\Phi(\sqrt{2x}-\sqrt{2n-1})$ gives
$x\approx\frac12(z+\sqrt{2n-1})^2=124.06$, much closer: the square root removes most of the
skewness of $\chi^2_n$.
\end{solution}

\begin{exercise}[Baldi, exercise 3.33]\label{ex:ba-3-33}
Let $X_1,X_2,\ldots$ be independent with $\prb\{X_i=1\}=\prb\{X_i=-1\}=\frac12$ and
$\bar X_n=n^{-1}\sum_{i\leqslant n}X_i$. Find the limits in distribution of
\textup{(a)} $\sqrt n\sin\bar X_n$, \textup{(b)} $\sqrt n(1-\cos\bar X_n)$ and
\textup{(c)} $n(1-\cos\bar X_n)$.
\end{exercise}

% source solution: baldi_p_07 exer:3.33 (in (c) the book applies the delta method to sqrt(1-cos x), which is not differentiable at 0; Slutsky with (1-cos x)/x^2 here)
\begin{solution}
$\expc[X_i]=0$ and $\var(X_i)=1$, so $\sqrt n\,\bar X_n\convd N(0,1)$ by
Corollary~\ref{cor:iid-clt}, and $\bar X_n=n^{-1/2}\cdot\sqrt n\,\bar X_n\convd0$ by
Theorem~\ref{thm:slutsky}\ref{sl:iii}, hence $\bar X_n\convp0$ by Proposition~\ref{prop:const}.

(a) By Theorem~\ref{thm:delta} with $g=\sin$, $g'(0)=1$: the limit is $N(0,1)$.

(b) With $g(x)=1-\cos x$, $g'(0)=0$, and Theorem~\ref{thm:delta} (first form, $T\sim N(0,1)$)
gives the limit $0\cdot T=0$: the point mass at $0$.

(c) Let $q(x)=(1-\cos x)/x^2$ for $x\neq0$ and $q(0)=\frac12$; $q$ is measurable and
continuous at $0$ (Theorem~\ref{thm:taylor} as in Exercise~\ref{ex:ba-2-38}), so
$q(\bar X_n)\convp\frac12$ by Theorem~\ref{thm:cmt}. Also $(\sqrt n\bar X_n)^2\convd Z^2$ with
$Z\sim N(0,1)$, by Theorem~\ref{thm:cmt}. Since $n(1-\cos\bar X_n)=(\sqrt n\bar X_n)^2q(\bar X_n)$,
Theorem~\ref{thm:slutsky} gives the limit $\frac12Z^2$, that is, $\frac12\chi^2_1$. As in
Exercise~\ref{ex:delta-log}, a vanishing derivative calls for the normalisation $n$ and a
second-order limit.
\end{solution}

\subsection*{Results used in the course}

\begin{exercise}[Baldi, exercise 2.24]\label{ex:ba-2-24}
\emph{(Kullback--Leibler divergence.)} Let $f$ and $g$ be probability densities with respect
to a measure $\mu$ on $\calB(\Real^d)$, and define
\[
H(f;g)=\int_{\{f>0\}}f\log\frac fg\,\dd\mu ,
\]
the integrand being $+\infty$ where $g=0<f$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that the integral exists in $[0,\infty]$ and that $H(f;g)=0$ if and only if $f=g$
      $\mu$-almost everywhere.
\item Compute $H$ for $f,g$ the binomial probabilities $B(n,q)\{j\}=\binom njq^j(1-q)^{n-j}$
      and $B(n,p)\{j\}=\binom njp^j(1-p)^{n-j}$, $0<p,q<1$
      ($\mu$ the counting measure on $\{0,\ldots,n\}$), and for $f,g$ the exponential densities
      $\rho e^{-\rho t}$ and $\beta e^{-\beta t}$ on $(0,\infty)$.
\item Let $Y$ have density $f(\cdot;\btheta_0)$ in a family as in Definition~\ref{def:score}
      with $\calX=\Real^d$, so that $H$ of (a) applies,
      and suppose $\ell(\btheta)=\log f(Y;\btheta)$ and $\ell(\btheta_0)$ are integrable.
      Deduce $\expc[\ell(\btheta)]\leqslant\expc[\ell(\btheta_0)]$, with equality only if
      $f(\cdot;\btheta)=f(\cdot;\btheta_0)$ $\mu$-almost everywhere.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:2.24 (Jensen in the book; log u <= u-1 here; part (c) added; the book's (a2) and the additivity over products in (c) omitted)
\begin{solution}
(a) \textbf{An inequality.} Let $h(u)=u-1-\log u$ for $u>0$. Then $h(1)=0$ and
$h'(u)=1-1/u$, and by Corollary~\ref{cor:MVT} $h(u)=h'(\xi)(u-1)$ for some $\xi$ between $1$
and $u$, where $h'(\xi)$ has the sign of $u-1$; so $h(u)>0$ for $u\neq1$. That is,
$\log u\leqslant u-1$, with equality only at $u=1$.

\textbf{Existence and sign.} On $\{f>0\}$ let $k=f\log(f/g)$. Where $g>0$, the inequality
with $u=g/f$ gives $k\geqslant f-g$, and where $g=0$, $k=\infty\geqslant f-g$. Thus
$k^-\leqslant(f-g)^-\leqslant g$, which is integrable, so the integral of $k$ exists in
$(-\infty,\infty]$ (Definition~\ref{def:integrable}), and
\[
H(f;g)\geqslant\int_{\{f>0\}}(f-g)\,\dd\mu=1-\int_{\{f>0\}}g\,\dd\mu\geqslant0 .
\]
\textbf{Equality.} If $H(f;g)=0$ then $k$ is integrable and
$\int_{\{f>0\}}\{k-(f-g)\}\,\dd\mu\leqslant0$ with a non-negative integrand, so by
Proposition~\ref{prop:null}(iv) $k=f-g$ almost everywhere on $\{f>0\}$, which forces
$g/f=1$ there; and $\int_{\{f>0\}}g\,\dd\mu=1$ forces $g=0$ almost everywhere on $\{f=0\}$.
Hence $f=g$ almost everywhere. The converse is clear.

(b) For the binomials, $\log(f/g)(j)=j\log(q/p)+(n-j)\log\{(1-q)/(1-p)\}$, and the $B(n,q)$
mean is $\sum_jj\binom njq^j(1-q)^{n-j}=nq\sum_{j\geqslant1}\binom{n-1}{j-1}q^{j-1}(1-q)^{n-j}=nq$,
by $j\binom nj=n\binom{n-1}{j-1}$ and the binomial theorem, so
\[
H=n\Bigl\{q\log\frac qp+(1-q)\log\frac{1-q}{1-p}\Bigr\} .
\]
For the exponentials, $\log(f/g)(t)=\log(\rho/\beta)-(\rho-\beta)t$ and $\int t\rho e^{-\rho t}\,\dd t=1/\rho$,
so $H=\log(\rho/\beta)-(\rho-\beta)/\rho=h(\beta/\rho)$, positive unless
$\beta=\rho$, as (a) requires.

(c) Almost surely $f(Y;\btheta_0)>0$, as $\prb\{f(Y;\btheta_0)=0\}=\int_{\{f(\cdot;\btheta_0)=0\}}f(\cdot;\btheta_0)\,\dd\mu=0$
(Lemma~\ref{lem:density-int}), and $\ell(\btheta_0)-\ell(\btheta)=\log\{f(Y;\btheta_0)/f(Y;\btheta)\}$
is integrable, so by Lemma~\ref{lem:density-int}, integrating against the density
$f(\cdot;\btheta_0)$,
$\expc[\ell(\btheta_0)]-\expc[\ell(\btheta)]=H(f(\cdot;\btheta_0);f(\cdot;\btheta))\geqslant0$,
with equality only in the stated case by (a). The expected log-likelihood is maximised at
the true parameter; this is why the maximiser of $\ell_n$ targets $\btheta_0$, and why the
model must be identifiable for that maximiser to be unique.
\end{solution}

\begin{exercise}[Baldi, exercise 2.46]\label{ex:ba-2-46}
\emph{(Exponential families.)} Let $\mu$ be a probability on $\Real$ with
$L(t)=\int e^{tx}\,\mu(\dd x)<\infty$ for $t\in(a,b)$, where $a<0<b$, and let
$\psi=\log L$.
\begin{enumerate}[label=\textup{(\alph*)}]
\item Show that $L$ is twice differentiable on $(a,b)$ with $L'(t)=\int xe^{tx}\,\mu(\dd x)$
      and $L''(t)=\int x^2e^{tx}\,\mu(\dd x)$, and that $\mu$ has mean $\psi'(0)$ and variance
      $\psi''(0)$.
\item For $\gamma\in(a,b)$ let $\mu_\gamma(\dd x)=e^{\gamma x}\mu(\dd x)/L(\gamma)$. Show that
      $\mu_\gamma$ is a probability with $L_\gamma(t)=L(t+\gamma)/L(\gamma)$ for
      $t+\gamma\in(a,b)$, mean $\psi'(\gamma)$ and variance $\psi''(\gamma)$; deduce that
      $\psi$ is convex and the mean of $\mu_\gamma$ is non-decreasing in $\gamma$, strictly
      increasing unless $\mu$ is a point mass.
\item Identify $\mu_\gamma$ when $\mu=N(0,\sigma^2)$ and when $\mu=B(n,p)$.
\end{enumerate}
\end{exercise}

% source solution: baldi_p_07 exer:2.46 (differentiability of L, assumed in the book, proved here; (c1) and the binomial case)
\begin{solution}
(a) Fix $t\in(a,b)$ and choose $a<c'<c<t<d<d'<b$. For $\delta>0$ and $y\geqslant0$,
$ye^{-\delta y}\leqslant1/(e\delta)$ and $y^2e^{-\delta y}\leqslant4/(e\delta)^2$ (maximise in
$y$). For $s\in(c,d)$: if $x\geqslant0$, $|x|e^{sx}\leqslant xe^{-(d'-d)x}e^{d'x}$; if $x<0$,
$|x|e^{sx}\leqslant|x|e^{-(c-c')|x|}e^{c'x}$. Hence, with constants $K_1,K_2$,
\[
|x|e^{sx}\leqslant K_1(e^{c'x}+e^{d'x}),\qquad x^2e^{sx}\leqslant K_2(e^{c'x}+e^{d'x}) ,
\]
and the right sides are $\mu$-integrable because $L(c'),L(d')<\infty$. Theorem~\ref{thm:diff-int}
on $I=(c,d)$, applied to $e^{sx}$ (integrable, derivative $xe^{sx}$ dominated by the first
bound) and then to $xe^{sx}$ (integrable by the first bound, derivative $x^2e^{sx}$ dominated
by the second), gives both formulas. Then $\psi'=L'/L$ and $\psi''=L''/L-(L'/L)^2$, and since
$L(0)=1$, $\psi'(0)=\int x\,\dd\mu$ and $\psi''(0)=\int x^2\,\dd\mu-(\int x\,\dd\mu)^2$.

(b) $\mu_\gamma$ is a measure by Corollary~\ref{cor:int-series}(ii) with total mass
$L(\gamma)/L(\gamma)=1$. For Borel $h\geqslant0$,
$\int h\,\dd\mu_\gamma=\int he^{\gamma x}\,\dd\mu/L(\gamma)$, by Lemma~\ref{lem:density-int} applied
to the identity map on $(\Real,\calB(\Real),\mu_\gamma)$, whose law $\mu_\gamma$ has density
$e^{\gamma x}/L(\gamma)$ with respect to $\mu$. With $h=e^{tx}$ this gives
$L_\gamma(t)=L(t+\gamma)/L(\gamma)$, finite for $t$ in the interval $(a-\gamma,b-\gamma)$, which
contains $0$, and $\psi_\gamma(t)=\psi(t+\gamma)-\psi(\gamma)$. Part (a) applied to
$\mu_\gamma$ gives mean $\psi_\gamma'(0)=\psi'(\gamma)$ and variance
$\psi_\gamma''(0)=\psi''(\gamma)\geqslant0$. So $\psi''\geqslant0$ on $(a,b)$, $\psi$ is convex
and $\psi'$ is non-decreasing (Lemma~\ref{lem:convex-deriv} and Corollary~\ref{cor:MVT}). If
$\psi''(\gamma)=0$ then $\mu_\gamma$ is a point mass $\delta_m$ (zero variance and
Proposition~\ref{prop:null}(iv)), and since $e^{\gamma x}>0$, $\mu$ and $\mu_\gamma$ have the
same null sets, so $\mu=\delta_m$. Otherwise $\psi''>0$ and $\psi'$ is strictly increasing.

(c) For $\mu=N(0,\sigma^2)$ with $\sigma=0$, $\mu=\delta_0$, so $L\equiv1$ and
$\mu_\gamma=\delta_0=N(\sigma^2\gamma,\sigma^2)$. For $\sigma>0$, completing the square,
$e^{\gamma x}e^{-x^2/(2\sigma^2)}=e^{\sigma^2\gamma^2/2}e^{-(x-\sigma^2\gamma)^2/(2\sigma^2)}$; integrating
against the density (Lemma~\ref{lem:density-int} and Remark~\ref{rem:assumed}(e)) gives
$L(\gamma)=e^{\sigma^2\gamma^2/2}$ for all $\gamma$, and
$\mu_\gamma$ has the density of $N(\sigma^2\gamma,\sigma^2)$, so $\psi'(\gamma)=\sigma^2\gamma$. For
$\mu=B(n,p)$, the binomial theorem gives $L(\gamma)=(1-p+pe^\gamma)^n$ and
\[
\mu_\gamma\{j\}=\binom nj\frac{(pe^\gamma)^j(1-p)^{n-j}}{(1-p+pe^\gamma)^n}=\binom nj p_\gamma^j(1-p_\gamma)^{n-j},
\qquad p_\gamma=\frac{pe^\gamma}{1-p+pe^\gamma} ,
\]
so $\mu_\gamma=B(n,p_\gamma)$, with $\logit p_\gamma=\logit p+\gamma$ and mean
$\psi'(\gamma)=np_\gamma$: tilting the binomial shifts its log-odds, the canonical link of
logistic regression.
\end{solution}

\begin{exercise}\label{ex:wald}
Let $\sqrt n(\hat\bb-\bb)\convd N(\bzero,\bSig)$ with $\bSig$ positive definite and let
$\hat\bSig$ be symmetric with $\hat\bSig\convp\bSig$. Show that under $H_0\colon\bR\bb=\br$ with $\bR$ of full row rank
$q$,
\[
n(\bR\hat\bb-\br)'\bigl(\bR\hat\bSig\bR'\bigr)^{-1}(\bR\hat\bb-\br)\convd\chi^2_q ,
\]
with the convention $\bA^{-1}:=\bzero$ for singular $\bA$ of Theorem~\ref{thm:quadform}.
\end{exercise}

\begin{solution}
Under $H_0$, $\sqrt n(\bR\hat\bb-\br) = \bR\sqrt n(\hat\bb-\bb)\convd N(\bzero,\bR\bSig\bR')$
by Theorem~\ref{thm:cmt} applied to the linear map $\bv\mapsto\bR\bv$, the image of
$V\sim N(\bzero,\bSig)$ being $\bR V\sim N(\bzero,\bR\bSig\bR')$ by
Theorem~\ref{thm:mvn-linear}. The limiting
covariance is positive definite: for $\bv\neq\bzero$, $\bR'\bv\neq\bzero$ because $\bR$ has
full row rank, so $\bv'\bR\bSig\bR'\bv>0$. Also $\bR\hat\bSig\bR'\convp\bR\bSig\bR'$ by
Theorem~\ref{thm:cmt}. Theorem~\ref{thm:quadform} with $p=q$ then gives the $\chi^2_q$
limit. This is the Wald statistic of Units 7--8.
\end{solution}

\begin{exercise}\label{ex:normality-role}
In Theorem~\ref{thm:LF} normality is nowhere assumed of the $\xi_{nj}$, yet the proof
introduces Gaussian variables $\zeta_{nj}$. Explain their role, and say where in the
Breusch--Pagan derivation of Unit 4 normality of the \emph{errors} does real work. (There
the errors $\varepsilon_i$ are independent and identically distributed with mean $0$, variance
$\sigma^2$, $\expc\varepsilon_i^4<\infty$ and $\kappa=\var(\varepsilon_i^2/\sigma^2)$, as in the
Breusch--Pagan remark; $\SSR_z$ and $R_z^2$ are the regression sum of squares and
the $R^2$ of the regression of $\varepsilon_i^2/\sigma^2$, in practice of squared residuals
over an estimate of $\sigma^2$, on an intercept and variance regressors $\bz_i$; the
Breusch--Pagan statistic is $LM=\SSR_z/2$, and Koenker's statistic is $nR_z^2$.)
\end{exercise}

\begin{solution}
The $\zeta_{nj}$ are a comparison array, not an assumption: they are constructed to have
the same variances $c_{nj}$ as the $\xi_{nj}$, so that their sum is exactly $N(0,c_n)$ and
the problem reduces to showing the two products of characteristic functions are close.
Normality enters only as a device for producing a reference sum with a known law.

In Unit 4 normality of the errors is used in exactly one place: to evaluate
$\var(\varepsilon_i^2/\sigma^2)=2$, which fixes the divisor $2$ in $LM=\SSR_z/2$. Without
it that variance is $\kappa$ and the correctly scaled statistic is Koenker's
$nR_z^2$. The central limit theorem behind both is the same, and needs no normality at all.
\end{solution}

